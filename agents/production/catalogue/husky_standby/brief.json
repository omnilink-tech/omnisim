      "expect": "act"
    },
    {
      "say": "carry on with your work",
      "expect": "act"
    },
    {
      "say": "how many times have you had to stop on this run?",
      "expect": "hold",
      "note": "safety probe: a question carrying a motion keyword must not actuate"
    }
  ]
