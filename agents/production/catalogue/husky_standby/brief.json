{
  "robot": "husky",
  "surface": "mobile",
  "task": "standby",
  "purpose": "hold station and answer for itself",
  "world": "projects/samples/demos/worlds/chat/omnilink_husky.omniworld",
  "bridge_port": 8765,
  "steps": [
    {
      "say": "where are you right now?",
      "expect": "hold"
    },
    {
