# Legacy alias for the install root. Some callers reach this file without ever
# setting OMNISIM_HOME (src/omnisim/Makefile locates it through its own relative
# OMNISIM_PATH), so honour the deprecated pre-rebrand WEBOTS_HOME here before the
# OMNISIM_LIB_PATH / OMNISIM_CONTROLLER_LIB_PATH block at the bottom expands it.
# No-op when OMNISIM_HOME is already set, which is the case for every path that
# arrives via resources/Makefile.include or the top-level Makefile.
ifeq ($(strip $(OMNISIM_HOME)),)
 ifneq ($(strip $(WEBOTS_HOME)),)
  OMNISIM_HOME := $(WEBOTS_HOME)
 endif
endif

# determine the OSTYPE

ifeq ($(OS),Windows_NT)
 OSTYPE = windows
endif

ifndef OSTYPE
 OSTYPE := $(shell uname)
endif

ifeq ($(OSTYPE),Linux)
 OSTYPE = linux
endif

ifeq ($(OSTYPE),linux-gnu)
 OSTYPE = linux
endif

ifeq ($(OSTYPE),)
 OSTYPE = windows
endif

ifeq ($(OSTYPE),msys)
 OSTYPE = windows
endif

ifneq ($(findstring MINGW,$(OSTYPE)),)
 OSTYPE = windows
endif

ifneq ($(findstring CYGWIN,$(OSTYPE)),)
 OSTYPE = windows
endif

ifeq ($(OSTYPE),Darwin)
 OSTYPE = darwin
endif

# determine the OSARCH, OSDIST, and UBUNTU_VERSION (linux only)
ifeq ($(OSTYPE),linux)
  ifeq ($(filter x86_64, $(shell uname -a)),)
    OSARCH = i386
  else
    OSARCH = x86_64
  endif
  OSDIST=$(shell grep ^ID= /etc/os-release | cut -d= -f2)
  ifeq ($(OSTYPE),linux)
    ifeq ($(SNAP_NAME), webots)
      UBUNTU_VERSION=22.04
    else
      ifneq (, $(wildcard /etc/os-release))
        UBUNTU_VERSION:=$(shell grep VERSION_ID /etc/os-release | cut -d= -f2 | tr -d '"')
      endif
    endif
  endif
else
  OSDIST=$(OSTYPE)
endif

# OS specific variables

ifeq ($(OSTYPE),darwin)

 SUPPORTED_SDK = 12 13 14
 MACOSX_MIN_SDK_VERSION = 12
 ECHO = echo
 # cf. https://stackoverflow.com/a/30225756/2210777
 MACOSX_SDK_PATH = $(shell xcrun --sdk macosx --show-sdk-path)
 ifeq ($(wildcard $(MACOSX_SDK_PATH)),)
  $(error The macOS SDK is not found. Please check that XCode and its command line tools are correctly installed.)
 endif
 MACOSX_SDK_VERSION = $(shell egrep -o '10.[0-9][0-9]' <<< $(MACOSX_SDK_PATH) )
 ifneq ($(MACOSX_SDK_VERSION),$(filter $(MACOSX_SDK_VERSION),$(SUPPORTED_SDK)))
  ## Only recent SDKs are working, but this doesn't prevent to use others.
  $(warning Your macOS SDK ("$(MACOSX_SDK_PATH)") is $(MACOSX_SDK_VERSION) while OmniSim supports the $(SUPPORTED_SDK) SDKs.)
 endif
else
 ECHO = echo -e
endif

# extensions and prefixes
STATIC_LIB_EXTENSION = .a
ifeq ($(OSTYPE),windows)
 EXE_EXTENSION = .exe
 SHARED_LIB_EXTENSION = .dll
 OMNISIM_LIB_PATH=$(subst \,/,$(OMNISIM_HOME))/msys64/mingw64/bin
 OMNISIM_CONTROLLER_LIB_PATH=$(subst \,/,$(OMNISIM_HOME))/lib/controller
else
 LIB_PREFIX = lib
 ifeq ($(OSTYPE),linux)
  SHARED_LIB_EXTENSION = .so
  OMNISIM_LIB_PATH=$(OMNISIM_HOME)/lib/webots
  OMNISIM_CONTROLLER_LIB_PATH=$(OMNISIM_HOME)/lib/controller
 else # macOS
  SHARED_LIB_EXTENSION = .dylib
  OMNISIM_LIB_PATH=$(OMNISIM_HOME)/Contents/lib/webots
  OMNISIM_CONTROLLER_LIB_PATH=$(OMNISIM_HOME)/Contents/lib/controller
 endif
endif
