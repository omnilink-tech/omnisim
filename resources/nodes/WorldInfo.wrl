# The WorldInfo node provides general information about the simulated world,
# e.g., gravity, the physics time step, ODE global parameters, plugins, etc.

WorldInfo {
  w3dField MFString                      info                           []
  w3dField SFString                      title                          ""
  field    SFString                      window                         "<none>"
  field    SFFloat                       gravity                        9.81      # along the down axis, expressed in m/s^2
  field    SFFloat                       CFM                            0.00001   # ODE world constraint force mixing parameter
  field    SFFloat                       ERP                            0.2       # ODE world error reduction parameter
  field    SFString                      physics                        "<none>"  # name of physics plugin
  w3dField SFFloat                       basicTimeStep                  32        # expressed in ms
  field    SFFloat                       FPS                            60        # maximum frame per second
  field    SFInt32                       optimalThreadCount             1         # maximum number of threads assigned to physics computation
  field    SFFloat                       physicsDisableTime             1         # time after which the objects are disabled if they are idle
  field    SFFloat                       physicsDisableLinearThreshold  0.01      # threshold determining if an object is idle or not [m/s]
  field    SFFloat                       physicsDisableAngularThreshold 0.01      # threshold determining if an object is idle or not [r/s]
  field    SFNode                        defaultDamping                 NULL      # default damping properties
  field    SFFloat                       inkEvaporation                 0         # make ground textures evaporate to white
  w3dField SFString{"ENU", "NUE", "EUN"} coordinateSystem               "ENU"     # X -> East, Y -> North, Z -> Up
  field    SFString{"local", "WGS84"}    gpsCoordinateSystem            "local"   # defines the world coordinate system (used by GPS node)
  field    SFVec3f                       gpsReference                   0 0 0     # defines the offset for each coordinate
  w3dField SFFloat                       lineScale                      0.1       # order of magnitude of the world in meters, used to display the optional rendering
  field    SFFloat                       dragForceScale                 30.0      # order of magnitude of the force applied to an object in the interface
  field    SFFloat                       dragTorqueScale                5.0       # order of magnitude of the torque applied to an object in the interface
  field    SFInt32                       randomSeed                     0         # defines the seed used internally by the random number generator
  field    MFNode                        contactProperties              []        # contact properties
  field    SFString{"simple", "sap", "quadtree", "auto"} broadphase     "simple"  # ODE broadphase choice (§8.4 of rendering-roadmap.md; landed). "simple" = current O(N^2) brute force; "sap" = sweep-and-prune (good for clustered worlds); "quadtree" = good for outdoor scenes; "auto" = pick quadtree when world AABB > 500 m on either horizontal axis, else sap. Default stays "simple" until the WbOdeContext side lands.
  field    SFString{"", "auto", "xpbd", "mujoco", "mujoco_warp"} newtonSolver       ""        # Newton physics solver. "" / "auto" / "xpbd" = SolverXPBD (GPU, the default perf path). "mujoco" = SolverMuJoCo (CPU mj_step, robust frictional contact) -- required for friction pinch grasps, which XPBD's soft positional contact structurally cannot hold. "mujoco_warp" = the same solver on the GPU (mujoco_warp); a fast-forward profile that needs a CUDA GPU and an EVEN newtonSubsteps (odd disables the CUDA-graph replay and runs slower than CPU). Ignored unless a Solid resolves to the Newton backend.
  field    SFInt32                        newtonSubsteps         1         # Newton XPBD sub-steps per physics tick (default-flip-plan.md §4.2 N3). 1 = one solver.step per tick (preserves the exact physics + determinism of every existing world + trained RL policy). N>1 splits the tick into N sub-steps of dt/N, re-colliding each -- required for high closing-speed contact (e.g. a head-on collision at full drive speed) where XPBD's positional solve otherwise diverges to NaN in one big step. Folds the OMNISIM_NEWTON_SUBSTEPS launch knob into the world file so legged/contact-heavy worlds need no env var (the env var still overrides). Ignored on ODE-backed Solids.
  field    SFBool                         newtonStatics          FALSE     # Register a world's top-level static colliders (have a boundingObject, no joint parent) as mass=0 Newton bodies so dynamic Newton bodies collide against them (default-flip-plan.md §4.2 N3 / P8.2). FALSE = statics stay ODE-side, so the husky / determinism paths are byte-unchanged. TRUE folds the OMNISIM_NEWTON_STATICS launch knob into the world file (the env var still forces it on). Ignored on ODE-backed Solids.
  field    SFBool                         newtonRobotColliders   FALSE     # Give robot-wrapper bodies (a URDFRobot chassis Solid) their OWN boundingObject as a Newton collider, so the robot BODY -- not just its wheels/feet -- collides with scene geometry. FALSE skips it: a chassis envelope box that engulfs the wheel space would pin the body and starve the wheels of load (P3.10i/j), so wheel-only collision is the safe default everywhere. TRUE folds the OMNISIM_NEWTON_WRAPPER_USES_OWN_SHAPE launch knob into the world file (the env var still forces it on) for chassis whose collider clears the wheels (e.g. the warehouse Husky). Ignored on ODE-backed Solids.
  field    SFBool                         newtonCompoundColliders FALSE    # Register EVERY collider in a compound boundingObject (a Group of offset primitives on ONE rigid body -- e.g. a movable bin's floor + 4 walls, or an L-tube of two boxes) as its own Newton shape, instead of only the first child. FALSE = first-child-only, keeping every existing world's physics byte-for-byte unchanged. TRUE folds the OMNISIM_NEWTON_COMPOUND_COLLIDERS launch knob into the world file (the env var still forces it on) so a multi-box bin / part "just works" in the GUI / launcher / headless without an env var. Ignored on ODE-backed Solids.
  field    SFString{"", "ode", "newton"}  defaultPhysicsBackend  ""        # World-level default physics backend (default-flip-plan.md §3.2). When set, supplies the backend for any Solid still on the "auto" default that has no explicit ancestor choice -- i.e. pin a whole world to "ode" (legacy fallback) or "newton" without editing every Solid. "" = inert. An explicit per-Solid / per-articulation-ancestor physicsBackend still wins.
  field    SFString{"", "wren", "wgpu"}   defaultRenderBackend   ""        # World-level default renderer (default-flip-plan.md §3.2). When set, supplies the backend for any Viewpoint/Camera whose renderBackend is empty or "auto" -- pin a whole world to "wren" (legacy fallback) or "wgpu" without editing every node. "" = inert. An explicit per-node renderBackend still wins. (Forward-looking: node defaults are still "wren" today, so this is inert until a node opts into the "auto" sentinel.)

  # deprecated fields
  deprecatedField SFVec3f                northDirection                 0 1 0     # north direction is now defined by the coordinate system
  deprecatedField SFString               fast2d                         ""        # name of fast2d simulation
}
