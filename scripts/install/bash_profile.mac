
#####################################################################################################
# Uncomment / edit the following environment variables when the corresponding software is installed #
#####################################################################################################

# source $HOME/emsdk/emsdk_env.sh >/dev/null 2>&1 # Activate PATH and other environment variables needed by Emscripten

################################################################
# Edit these WEBOTS_* environment variables (kept under the WEBOTS_
# prefix for upstream Webots compatibility — see CONTRIBUTING.md) #
################################################################

export WEBOTS_DISABLE_SAVE_SCREEN_PERSPECTIVE_ON_CLOSE=1  # If defined, OmniSim will not save screen specific perspective changes when closed.
export WEBOTS_ALLOW_MODIFY_INSTALLATION=1                 # If defined, you are allowed to modify files in the OmniSim home directory.

##########################################################################
# These environment variables are necessaries to compile and run OmniSim #
##########################################################################

export OMNISIM_HOME=$HOME/webots                        # Defines the path to OmniSim home (var name kept for upstream compatibility).
