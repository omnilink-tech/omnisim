#VRML_SIM R2025a utf8
# Omni Quest — OFF-ROAD course (generated by tools/gen_offroad_world.py).
# Rough rolling terrain + a tree obstacle field seeded across the route.
# Controller (omni_quest_nav, --course offroad) navigates GPS waypoints
# AND avoids obstacles via a modelled forward range sensor. Do not hand-edit;
# regenerate with: python projects/omni_quest/tools/gen_offroad_world.py
EXTERNPROTO "omnisim://projects/objects/backgrounds/protos/OmniSimSky.proto"
EXTERNPROTO "omnisim://projects/objects/lights/protos/OmniSimSun.proto"
EXTERNPROTO "omnisim://projects/objects/lights/protos/OmniSimSunMarker.proto"
EXTERNPROTO "omnisim://projects/appearances/protos/Grass.proto"
EXTERNPROTO "omnisim://projects/objects/floors/protos/UnevenTerrain.proto"
EXTERNPROTO "omnisim://projects/objects/trees/protos/Pine.proto"
EXTERNPROTO "omnisim://projects/objects/trees/protos/Oak.proto"

WorldInfo {
  basicTimeStep 16
  gpsCoordinateSystem "WGS84"
  gpsReference 40.67 -73.94 0.0
  contactProperties [
    ContactProperties { material1 "default" material2 "default" maxContactJoints 50 }
  ]
}
Viewpoint { orientation -0.32 0.33 0.89 1.66 position 6 -52 46 }
OmniSimSky { }
DEF SUN OmniSimSun { }
DEF SUN_MARKER OmniSimSunMarker { }
DirectionalLight { direction -0.5 0.4 -0.6 color 0.85 0.88 1.0 intensity 1.4 ambientIntensity 0.0 castShadows FALSE }
UnevenTerrain {
  name "terrain"
  size 70.0 70.0 0.7
  xDimension 60 yDimension 60
  perlinNOctaves 5
  randomSeed 7
  appearance Grass { textureTransform TextureTransform { scale 40 40 } }
}
DEF HUSKY URDFRobot {
  url "../../robots/clearpath/husky_description/urdf/husky.urdf"
  translation -25.0 -25.0 0.85
  rotation 0 0 1 0.3906
  name "husky"
  supervisor TRUE
  controller "omni_quest_nav"
  controllerArgs ["--course" "offroad"]
}
# Forward-camera sidecar. Device children mis-bind on an imported URDFRobot, so
# the camera rides a separate Robot that snaps onto the Husky each tick (the
# proven husky_eye pattern). Its controller (omni_quest_eye) runs the vision and
# writes _perception.json; the nav controller reads it. No physics = static.
DEF HUSKY_CAM Robot {
  translation -25.0 -25.0 0.85
  rotation 0 0 1 0.3906
  name "husky_cam"
  supervisor TRUE
  controller "omni_quest_eye"
  physics NULL
  children [
    Camera {
      name "front_camera"
      translation 0.32 0 0.35
      rotation 0 1 0 0.22
      width 128
      height 48
      fieldOfView 1.2
    }
  ]
}
DEF SOUTH_RIDGE Solid {
  translation -8.0 -18.0 0.6
  name "post_south_ridge"
  children [
    Shape {
      appearance PBRAppearance { baseColor 0.98 0.65 0.10 roughness 0.4 metalness 0 }
      geometry Cylinder { height 1.6 radius 0.09 }
    }
  ]
}

DEF SOUTH_POST Solid {
  translation 18.0 -20.0 0.6
  name "post_south_post"
  children [
    Shape {
      appearance PBRAppearance { baseColor 0.10 0.85 0.20 roughness 0.4 metalness 0 }
      geometry Cylinder { height 1.6 radius 0.09 }
    }
  ]
}

DEF EAST_BEND Solid {
  translation 24.0 8.0 0.6
  name "post_east_bend"
  children [
    Shape {
      appearance PBRAppearance { baseColor 0.10 0.30 0.95 roughness 0.4 metalness 0 }
      geometry Cylinder { height 1.6 radius 0.09 }
    }
  ]
}

DEF NORTH_GLADE Solid {
  translation -4.0 20.0 0.6
  name "post_north_glade"
  children [
    Shape {
      appearance PBRAppearance { baseColor 0.95 0.95 0.95 roughness 0.4 metalness 0 }
      geometry Cylinder { height 1.6 radius 0.09 }
    }
  ]
}

