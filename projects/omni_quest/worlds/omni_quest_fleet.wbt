#VRML_SIM R2025a utf8
# Omni Quest — CROSS-PLATFORM FLEET (generated by tools/gen_fleet.py).
# A Husky and a Jackal run the SAME GPS+camera nav algorithm at once, on
# parallel lanes through a shared obstacle field. Regenerate; don't edit.
EXTERNPROTO "omnisim://projects/objects/backgrounds/protos/OmniSimSky.proto"
EXTERNPROTO "omnisim://projects/objects/lights/protos/OmniSimSun.proto"
EXTERNPROTO "omnisim://projects/objects/lights/protos/OmniSimSunMarker.proto"
EXTERNPROTO "omnisim://projects/appearances/protos/Grass.proto"
EXTERNPROTO "omnisim://projects/objects/trees/protos/Pine.proto"
EXTERNPROTO "omnisim://projects/objects/trees/protos/Oak.proto"
EXTERNPROTO "omnisim://projects/objects/rocks/protos/Rock.proto"
EXTERNPROTO "omnisim://projects/objects/obstacles/protos/OilBarrel.proto"
EXTERNPROTO "omnisim://projects/objects/factory/containers/protos/WoodenBox.proto"
EXTERNPROTO "omnisim://projects/objects/traffic/protos/TrafficCone.proto"

WorldInfo {
  basicTimeStep 16
  gpsCoordinateSystem "WGS84"
  gpsReference 40.67 -73.94 0.0
  contactProperties [ ContactProperties { material1 "default" material2 "default" maxContactJoints 30 } ]
}
Viewpoint { orientation -0.30 0.32 0.90 1.66 position 2 -52 46 }
OmniSimSky { }
DEF SUN OmniSimSun { }
DEF SUN_MARKER OmniSimSunMarker { }
DirectionalLight { direction -0.5 0.4 -0.6 color 0.9 0.9 1.0 intensity 1.3 ambientIntensity 0.0 castShadows FALSE }
DEF GROUND Solid {
  name "ground"
  children [ Shape { appearance Grass { textureTransform TextureTransform { scale 50 50 } } geometry DEF G Plane { size 200 200 } } ]
  boundingObject USE G
  locked TRUE
}
DEF HUSKY_NAV URDFRobot {
  url "../../robots/clearpath/husky_description/urdf/husky.urdf"
  translation -28.0 -14.0 0.15
  rotation 0 0 1 0.0000
  name "husky_nav"
  supervisor TRUE
  controller "omni_quest_nav"
  controllerArgs ["--course" "fleet" "--route" "ROUTE_HUSKY" "--platform" "husky" "--id" "husky"]
}
DEF HUSKY_EYE Robot {
  translation -28.0 -14.0 0.15
  rotation 0 0 1 0.0000
  name "husky_cam"
  supervisor TRUE
  controller "omni_quest_eye"
  controllerArgs ["--target" "HUSKY_NAV" "--id" "husky"]
  physics NULL
  children [ Camera { name "front_camera" translation 0.32 0 0.35 rotation 0 1 0 0.22 width 128 height 48 fieldOfView 1.2 } ] }
DEF JACKAL_NAV URDFRobot {
  url "../../robots/clearpath/jackal_description/urdf/jackal.urdf"
  translation -28.0 14.0 0.1
  rotation 0 0 1 0.0000
  name "jackal_nav"
  supervisor TRUE
  controller "omni_quest_nav"
  controllerArgs ["--course" "fleet" "--route" "ROUTE_JACKAL" "--platform" "jackal" "--id" "jackal"]
}
DEF JACKAL_EYE Robot {
  translation -28.0 14.0 0.1
  rotation 0 0 1 0.0000
  name "jackal_cam"
  supervisor TRUE
  controller "omni_quest_eye"
  controllerArgs ["--target" "JACKAL_NAV" "--id" "jackal"]
  physics NULL
  children [ Camera { name "front_camera" translation 0.24 0 0.28 rotation 0 1 0 0.22 width 128 height 48 fieldOfView 1.2 } ] }
