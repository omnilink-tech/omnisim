Solid { translation 32.0 -6.0 0.8 name "post_a1" children [ Shape { appearance PBRAppearance { baseColor 0.98 0.65 0.10 roughness 0.4 metalness 0 } geometry Cylinder { height 1.6 radius 0.08 } } ] }
Solid { translation -32.0 -6.0 0.8 name "post_b1" children [ Shape { appearance PBRAppearance { baseColor 0.10 0.55 0.95 roughness 0.4 metalness 0 } geometry Cylinder { height 1.6 radius 0.08 } } ] }
Solid { translation 32.0 6.0 0.8 name "post_c1" children [ Shape { appearance PBRAppearance { baseColor 0.20 0.85 0.30 roughness 0.4 metalness 0 } geometry Cylinder { height 1.6 radius 0.08 } } ] }
