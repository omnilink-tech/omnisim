# --- static obstacles (clear of the crossing square) ---
Pine { name "obs_0" translation -22.00 -4.50 0 rotation 0 0 1 2.91 }
Rock { name "obs_1" translation 22.00 -7.50 0 scale 1.18 }
Oak { name "obs_2" translation -22.00 7.50 0 rotation 0 0 1 5.44 }
OilBarrel { name "obs_3" translation 22.00 4.50 0.44 }
