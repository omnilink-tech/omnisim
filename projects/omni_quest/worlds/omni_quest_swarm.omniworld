#OMNISIM R2025a utf8
# Omni Quest — INTERACTING SWARM (generated by tools/gen_swarm.py).
# Four robots (2 Husky + 2 Jackal) all run omni_quest_nav, on crossing
# lanes, so each avoids the OTHER moving robots by camera. Regenerate.
EXTERNPROTO "omnisim://projects/objects/backgrounds/protos/OmniSimSky.proto"
EXTERNPROTO "omnisim://projects/objects/lights/protos/OmniSimSun.proto"
EXTERNPROTO "omnisim://projects/objects/lights/protos/OmniSimSunMarker.proto"
EXTERNPROTO "omnisim://projects/appearances/protos/Grass.proto"
EXTERNPROTO "omnisim://projects/objects/trees/protos/Pine.proto"
EXTERNPROTO "omnisim://projects/objects/trees/protos/Oak.proto"
EXTERNPROTO "omnisim://projects/objects/rocks/protos/Rock.proto"
EXTERNPROTO "omnisim://projects/objects/obstacles/protos/OilBarrel.proto"
EXTERNPROTO "omnisim://projects/objects/factory/containers/protos/WoodenBox.proto"
EXTERNPROTO "omnisim://projects/objects/traffic/protos/TrafficCone.proto"

WorldInfo {
  basicTimeStep 16
  gpsCoordinateSystem "WGS84"
  gpsReference 40.67 -73.94 0.0
  contactProperties [ ContactProperties { material1 "default" material2 "default" maxContactJoints 30 } ]
}
Viewpoint { orientation -0.31 0.32 0.89 1.66 position 0 -56 50 }
OmniSimSky { }
DEF SUN OmniSimSun { }
DEF SUN_MARKER OmniSimSunMarker { }
DirectionalLight { direction -0.5 0.4 -0.6 color 0.9 0.9 1.0 intensity 1.3 ambientIntensity 0.0 castShadows FALSE }
DEF GROUND Solid {
  name "ground"
  children [ Shape { appearance Grass { textureTransform TextureTransform { scale 50 50 } } geometry DEF G Plane { size 200 200 } } ]
  boundingObject USE G
  locked TRUE
}
DEF N1_NAV URDFRobot {
  url "../../robots/clearpath/husky_description/urdf/husky.urdf"
  translation -32.0 -6.0 0.15
  rotation 0 0 1 0.0000
  name "n1_nav"
  supervisor TRUE
  controller "omni_quest_nav"
  controllerArgs ["--course" "swarm" "--route" "ROUTE_N1" "--platform" "husky" "--id" "n1" "--vmax" "0.6" "--coordinate"]
}
DEF N1_EYE Robot {
  translation -32.0 -6.0 0.15
  rotation 0 0 1 0.0000
  name "n1_cam"
  supervisor TRUE
  controller "omni_quest_eye"
  controllerArgs ["--target" "N1_NAV" "--id" "n1"]
  physics NULL
  children [ Camera { name "front_camera" translation 0.32 0 0.35 rotation 0 1 0 0.22 width 160 height 48 fieldOfView 1.9 } ] }
DEF N2_NAV URDFRobot {
  url "../../robots/clearpath/jackal_description/urdf/jackal.urdf"
  translation 32.0 -6.0 0.1
  rotation 0 0 1 3.1416
  name "n2_nav"
  supervisor TRUE
  controller "omni_quest_nav"
  controllerArgs ["--course" "swarm" "--route" "ROUTE_N2" "--platform" "jackal" "--id" "n2" "--vmax" "0.6" "--coordinate"]
