#VRML_SIM R2025a utf8

# G1 23-DOF walk on the ORIGINAL foot (g1_23dof_omnisim.urdf, foot box 0.17x0.06),
# NOT the enlarged "bigfoot" (0.26x0.09). Used to test whether the in-engine RL walk
# recipe (g1_walk_recipe.py) transfers from the bigfoot to the original G1 morphology.
# Identical to g1_walk_bigfoot.wbt except the URDF url.
# + DEF G1_GHOST: the SAME G1 model with physics stripped (g1_23dof_ghost.urdf, staticBase),
# driven kinematically by the historical g1_ghost controller (hologram tint + transparency),
# phase-locked beside the real robot: the visible gap between them IS the balance work.

EXTERNPROTO "omnisim://projects/objects/floors/protos/RectangleArena.proto"
EXTERNPROTO "omnisim://projects/objects/backgrounds/protos/OmniSimSky.proto"
EXTERNPROTO "omnisim://projects/objects/lights/protos/OmniSimSun.proto"
EXTERNPROTO "omnisim://projects/objects/lights/protos/OmniSimSunMarker.proto"

WorldInfo {
  newtonSolver "mujoco"
  basicTimeStep 16
  title "G1 humanized walk + ghost (WIDE demo arena: fits lateral drift)"
  contactProperties [
    ContactProperties {
      material1 "default"
      material2 "default"
      coulombFriction [ 1.5 ]
      bounce 0.0
      bounceVelocity 0.5
    }
  ]
}
Viewpoint {
  orientation -0.25 0.25 0.9354 1.6378
  position -2 -5 1.8
  follow "g1"
  followType "Tracking Shot"
}
OmniSimSky { }
DEF SUN OmniSimSun { }
DEF SUN_MARKER OmniSimSunMarker { }
RectangleArena {
  floorSize 26 14
  wallHeight 0.05
  floorAppearance PBRAppearance {
    baseColor 0.18 0.20 0.22
    roughness 0.95
    metalness 0
  }
}

DEF G1_REAL URDFRobot {
  url "../../robots/unitree/g1/urdf/g1_23dof_omnisim.urdf"
  translation 0 0 0.78
  name "g1"
  supervisor TRUE
  controller "humanoid_stand_deploy"
  physicsBackend "newton"
}

DEF G1_GHOST URDFRobot {
  url "../../robots/unitree/g1/urdf/g1_23dof_ghost.urdf"
  translation 0 1.1 0.78
  name "g1_ghost"
  supervisor TRUE
  controller "g1_ghost"
  controllerArgs ["follow"]
  staticBase TRUE
  physicsBackend "ode"
}

DEF HARNESS_RIG Robot {
  name "harness_rig"
  supervisor TRUE
  controller "harness_rig"
}
DEF HARNESS_LINE Solid {
  translation 0 0 1.6
  name "harness_line"
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.95 0.80 0.15
        transparency 0.35
        roughness 0.6
        metalness 0
      }
      geometry DEF HARNESS_CYL Cylinder {
        radius 0.012
        height 1.6
      }
    }
  ]
}
DEF CARRY_BOX Robot {
  translation 4.2 -0.95 0.965
  name "carry_box"
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.72 0.52 0.30
        roughness 0.9
        metalness 0
      }
      geometry DEF CARRY_BOX_GEO Box { size 0.20 0.26 0.18 }
    }
  ]
  boundingObject USE CARRY_BOX_GEO
  physics Physics {
    density -1
    mass 1.5
  }
  physicsBackend "ode"
}
DEF DELIVERY_CART_B Solid {
  translation 9.0 -1.4 0.44
  name "delivery_cart_b"
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.26 0.40 0.32
        roughness 0.7
        metalness 0.3
      }
      geometry DEF CART_B_GEO Box { size 0.5 0.4 0.86 }
    }
  ]
  boundingObject USE CART_B_GEO
}
DEF DELIVERY_CART Solid {
  translation 4.2 -0.95 0.44
  name "delivery_cart"
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.30 0.34 0.40
        roughness 0.7
        metalness 0.3
      }
      geometry DEF CART_GEO Box { size 0.5 0.4 0.86 }
    }
  ]
  boundingObject USE CART_GEO
}
DEF HARNESS_HOOK Solid {
  translation 0 0 2.4
  name "harness_hook"
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.95 0.80 0.15
        transparency 0.1
        roughness 0.4
        metalness 0.6
      }
      geometry Box { size 0.22 0.22 0.06 }
    }
  ]
}
