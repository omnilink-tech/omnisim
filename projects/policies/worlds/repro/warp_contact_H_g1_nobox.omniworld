#OMNISIM R2025a utf8

# WARP CONTACT REPRO D/E base: G1 (det stand only) + free box + carts.
# Derived from g1_book_grasp.wbt minus ghost/rig. G1 23-DOF walk on the ORIGINAL foot (g1_23dof_omnisim.urdf, foot box 0.17x0.06),
# NOT the enlarged "bigfoot" (0.26x0.09). Used to test whether the in-engine RL walk
# recipe (g1_walk_recipe.py) transfers from the bigfoot to the original G1 morphology.
# Identical to g1_walk_bigfoot.omniworld except the URDF url.
# + DEF G1_GHOST: the SAME G1 model with physics stripped (g1_23dof_ghost.urdf, staticBase),
# driven kinematically by the historical g1_ghost controller (hologram tint + transparency),
# phase-locked beside the real robot: the visible gap between them IS the balance work.

EXTERNPROTO "omnisim://projects/objects/floors/protos/RectangleArena.proto"
EXTERNPROTO "omnisim://projects/objects/backgrounds/protos/OmniSimSky.proto"
EXTERNPROTO "omnisim://projects/objects/lights/protos/OmniSimSun.proto"
EXTERNPROTO "omnisim://projects/objects/lights/protos/OmniSimSunMarker.proto"

WorldInfo {
  newtonSolver "mujoco"
  basicTimeStep 16
  title "G1 book-grasp arena: REAL Newton box, physics-only pick (no rig writes)"
  contactProperties [
    ContactProperties {
      material1 "default"
      material2 "default"
      coulombFriction [ 1.5 ]
      bounce 0.0
      bounceVelocity 0.5
    }
  ]
}
Viewpoint {
  orientation -0.25 0.25 0.9354 1.6378
  position -2 -5 1.8
  follow "g1"
  followType "Tracking Shot"
}
OmniSimSky { }
DEF SUN OmniSimSun { }
DEF SUN_MARKER OmniSimSunMarker { }
RectangleArena {
  floorSize 26 14
  wallHeight 0.05
  floorAppearance PBRAppearance {
    baseColor 0.18 0.20 0.22
    roughness 0.95
    metalness 0
  }
}

DEF G1_REAL URDFRobot {
  url "../../../robots/unitree/g1/urdf/g1_23dof_grasp.urdf"
  translation 0 0 0.78
  name "g1"
  supervisor TRUE
  controller "humanoid_stand_deploy"
  physicsBackend "newton"
}


# PHYS-GRASP BOX (2026-07-10): a REAL Newton body -- same physics world as the robot, so the
# hands make genuine contact and the pick is a friction grip (no supervisor writes, ever; the
# 40x dirty-solver lesson only applies to WRITES on Newton bodies -- an untouched free body is
# just physics). 1.0 kg for grip margin (the carry policy trained with 1.5 kg at the hands).
DEF DELIVERY_CART_B Solid {
  translation 9.0 -1.4 0.44
  name "delivery_cart_b"
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.26 0.40 0.32
        roughness 0.7
        metalness 0.3
      }
      geometry DEF CART_B_GEO Box { size 0.5 0.4 0.86 }
    }
  ]
  boundingObject USE CART_B_GEO
}
DEF DELIVERY_CART Solid {
  translation 4.2 -0.95 0.44
  name "delivery_cart"
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.30 0.34 0.40
        roughness 0.7
        metalness 0.3
      }
      geometry DEF CART_GEO Box { size 0.5 0.4 0.86 }
    }
  ]
  boundingObject USE CART_GEO
}
