#OMNISIM R2025a utf8

# STEP-TURN GHOST PREVIEW -- a single kinematic G1 ghost (no physics, staticBase) that
# REPLAYS the CONSTRUCTED step-turn ghost (build_step_turn_ghost.py: footstep plan + IK,
# COM-over-support). The lut is passed as the controllerArg so it loads reliably (no env).
# The ghost is kinematic -> it will NOT fall; this shows the reference 90-degree step-turn.

EXTERNPROTO "omnisim://projects/objects/floors/protos/RectangleArena.proto"
EXTERNPROTO "omnisim://projects/objects/backgrounds/protos/OmniSimSky.proto"
EXTERNPROTO "omnisim://projects/objects/lights/protos/OmniSimSun.proto"
EXTERNPROTO "omnisim://projects/objects/lights/protos/OmniSimSunMarker.proto"

WorldInfo {
  basicTimeStep 16
  title "Unitree G1 -- CONSTRUCTED step-turn ghost preview (90 deg, feasible)"
}
Viewpoint {
  orientation -0.278945 0.120681 0.952694 2.359689
  position 4.294 -4.571 5.547
  follow "g1_ghost"
  followType "Tracking Shot"
}
OmniSimSky { }
DEF SUN OmniSimSun { }
DEF SUN_MARKER OmniSimSunMarker { }
RectangleArena {
  floorSize 8 8
  wallHeight 0.05
  floorAppearance PBRAppearance {
    baseColor 0.18 0.20 0.22
    roughness 0.95
    metalness 0
  }
}

DEF G1_GHOST URDFRobot {
  url "../../robots/unitree/g1/urdf/g1_23dof_ghost.urdf"
  translation 0 0 0.78
  name "g1_ghost"
  supervisor TRUE
  controller "ghost_hologram"
  controllerArgs [ "ghost_step_turn_lut.json" ]
  staticBase TRUE
  physicsBackend "ode"
}
