#VRML_SIM R2025a utf8

# COMMANDO-CRAWL ghost-only preview (GHOST-FIRST: design -> show -> agree -> train).
# The G1 crawls alone on its forearms + knees: same G1 model, physics stripped
# (g1_23dof_ghost.urdf), hologram tint, self-walk mode (own clock, never falls).
# The crawl base attitude (torso ~horizontal) + low pelvis come from the lut
# (base_pitch / ghost_z), passed to the g1_ghost controller as a controllerArg.

EXTERNPROTO "omnisim://projects/objects/floors/protos/RectangleArena.proto"
EXTERNPROTO "omnisim://projects/objects/backgrounds/protos/OmniSimSky.proto"
EXTERNPROTO "omnisim://projects/objects/lights/protos/OmniSimSun.proto"
EXTERNPROTO "omnisim://projects/objects/lights/protos/OmniSimSunMarker.proto"

WorldInfo {
  newtonSolver "mujoco"
  basicTimeStep 16
  title "Unitree G1 commando-crawl ghost (draft v1)"
  contactProperties [
    ContactProperties {
      material1 "default"
      material2 "default"
      coulombFriction [ 1.5 ]
      bounce 0.0
      bounceVelocity 0.5
    }
  ]
}
Viewpoint {
  orientation -0.22 0.24 0.945 1.62
  position -1.6 -3.2 1.05
  follow "g1_ghost"
  followType "Tracking Shot"
}
OmniSimSky { }
DEF SUN OmniSimSun { }
DEF SUN_MARKER OmniSimSunMarker { }
RectangleArena {
  floorSize 20 6
  wallHeight 0.05
  floorAppearance PBRAppearance {
    baseColor 0.18 0.20 0.22
    roughness 0.95
    metalness 0
  }
}

DEF G1_GHOST URDFRobot {
  url "../../robots/unitree/g1/urdf/g1_23dof_ghost.urdf"
  translation 0 0 0.30
  name "g1_ghost"
  supervisor TRUE
  controller "g1_ghost"
  controllerArgs [ "ghost_crawl_v1_lut.json" ]
  staticBase TRUE
  physicsBackend "ode"
}
