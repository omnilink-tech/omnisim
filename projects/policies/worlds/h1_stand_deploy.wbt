#VRML_SIM R2025a utf8

# Deterministic pure-pose stand deploy for the Unitree H1 humanoid.
# Same recipe as the proven G1 stand (run_g1_standwave_pose_deploy.ps1):
# stiff Newton position hold (ke=400/kd=60) of a statically-stable squat
# NOMINAL, no RL policy, ankle PD off by default. Controller is the generic
# humanoid_stand_deploy, driven by specs/h1.json (set via HUMANOID_STAND_SPEC).
#
# Required Newton env (set by scripts/dev/run_humanoid_stand_deploy.ps1):
#   OMNISIM_NEWTON_STATICS=1 OMNISIM_NEWTON_SUBSTEPS=4 OMNISIM_URDF_USE_INERTIA=1
#   OMNISIM_NEWTON_FORCE_MUJOCO=1 OMNISIM_NEWTON_MJWARP=1 OMNISIM_NEWTON_SEED_POSE=1

EXTERNPROTO "omnisim://projects/objects/floors/protos/RectangleArena.proto"
EXTERNPROTO "omnisim://projects/objects/backgrounds/protos/OmniSimSky.proto"
EXTERNPROTO "omnisim://projects/objects/lights/protos/OmniSimSun.proto"
EXTERNPROTO "omnisim://projects/objects/lights/protos/OmniSimSunMarker.proto"

WorldInfo {
  newtonSolver "mujoco"
  basicTimeStep 16
  title "Unitree H1 deterministic stand"
  contactProperties [
    ContactProperties {
      material1 "default"
      material2 "default"
      coulombFriction [ 1.5 ]
      bounce 0.0
      bounceVelocity 0.5
    }
  ]
}
Viewpoint {
  orientation -0.5773 0.5773 0.5773 2.0944
  position 0 0 5
  follow ""
  followType "None"
}
OmniSimSky { }
DEF SUN OmniSimSun { }
DEF SUN_MARKER OmniSimSunMarker { }
RectangleArena {
  floorSize 20 6
  wallHeight 0.05
  floorAppearance PBRAppearance {
    baseColor 0.18 0.20 0.22
    roughness 0.95
    metalness 0
  }
}

URDFRobot {
  url "../../robots/unitree/h1/urdf/h1.urdf"
  translation 0 0 1.01
  name "h1"
  supervisor TRUE
  controller "humanoid_stand_deploy"
  physicsBackend "newton"
}
