#OMNISIM R2025a utf8

# Physics-equivalent, obstacle-free numerical evaluation world for the G1
# Shadowing deploy.  It intentionally omits the hologram, decorative harness and
# delivery props: headless tests score the physical G1, while the visible flagship
# remains g1_walk_puppet.omniworld.

EXTERNPROTO "omnisim://projects/objects/floors/protos/RectangleArena.proto"
EXTERNPROTO "omnisim://projects/objects/backgrounds/protos/OmniSimSky.proto"
EXTERNPROTO "omnisim://projects/objects/lights/protos/OmniSimSun.proto"
EXTERNPROTO "omnisim://projects/objects/lights/protos/OmniSimSunMarker.proto"

WorldInfo {
  newtonSolver "mujoco"
  basicTimeStep 16
  title "G1 Shadowing headless numerical evaluation"
  contactProperties [
    ContactProperties {
      material1 "default"
      material2 "default"
      coulombFriction [ 1.5 ]
      bounce 0.0
      bounceVelocity 0.5
    }
  ]
}
Viewpoint {
  orientation -0.25 0.25 0.9354 1.6378
  position -2 -5 1.8
  follow "g1"
  followType "Tracking Shot"
}
OmniSimSky { }
DEF SUN OmniSimSun { }
DEF SUN_MARKER OmniSimSunMarker { }
RectangleArena {
  floorSize 40 20
  wallHeight 0.05
  floorAppearance PBRAppearance {
    baseColor 0.18 0.20 0.22
    roughness 0.95
    metalness 0
  }
}

DEF G1_REAL URDFRobot {
  url "../../robots/unitree/g1/urdf/g1_23dof_omnisim.urdf"
  translation 0 0 0.78
  name "g1"
  supervisor TRUE
  controller "humanoid_stand_deploy"
  physicsBackend "newton"
}
