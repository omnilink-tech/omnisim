#VRML_SIM R2025a utf8

# SIT -> STAND -> SIT mimic demo -- the G1 rises from the chair, stands in front
# of it for 5 s, then sits back down, DYNAMICALLY BALANCING the whole way (RL).
#   - DEF G1_REAL : the real, Newton-simulated G1 (FREE base -- never pinned),
#     driven by g1_sitstand_mimic. An RL policy (G1_SITSTAND_POLICY) drives the
#     13 leg+waist joints to track the shared sit-stand reference + balance; the
#     arms follow it feedforward.
#   - DEF G1_GHOST: a SECOND, physics-free G1 (staticBase, no Newton) rendered as
#     a translucent hologram by g1_sitstand_ghost, DISPLAYING the SAME reference
#     (or the robot's recorded ACHIEVED motion via G1_GHOST_REPLAY). The real
#     robot reproduces what the ghost shows.
#
# Launch: scripts/dev/run_g1_sitstand_mimic.ps1   (GUI, real-time paced).

EXTERNPROTO "omnisim://projects/objects/backgrounds/protos/TexturedBackground.proto"
EXTERNPROTO "omnisim://projects/objects/backgrounds/protos/TexturedBackgroundLight.proto"
EXTERNPROTO "omnisim://projects/objects/floors/protos/RectangleArena.proto"
EXTERNPROTO "omnisim://projects/objects/backgrounds/protos/OmniSimSky.proto"
EXTERNPROTO "omnisim://projects/objects/lights/protos/OmniSimSun.proto"
EXTERNPROTO "omnisim://projects/objects/lights/protos/OmniSimSunMarker.proto"

WorldInfo {
  basicTimeStep 16
  title "Unitree G1 -- sit -> stand -> sit mimic (ghost + real)"
  newtonSolver "mujoco"
  contactProperties [
    ContactProperties {
      material1 "default"
      material2 "default"
      coulombFriction [ 1.5 ]
      bounce 0.0
      bounceVelocity 0.5
    }
  ]
}
Viewpoint {
  orientation -0.2671 0.2730 0.9244 1.6450
  position 3.6 -2.7 1.6
}
OmniSimSky { }
DEF SUN OmniSimSun { }
DEF SUN_MARKER OmniSimSunMarker { }
RectangleArena {
  floorSize 8 6
  wallHeight 0.05
  floorAppearance PBRAppearance {
    baseColor 0.18 0.20 0.22
    roughness 0.95
    metalness 0
  }
}

# ----- Chair under the real robot. Seat top ~0.33 + a REAL collision
# boundingObject on the seat AND backrest (Newton static colliders via
# OMNISIM_NEWTON_STATICS) so the robot rests on / pushes off the chair as it
# rises. Geometry matches the trainer MJCF (g1_sit.mjcf.xml). -----
DEF CHAIR_MIMIC Solid {
  translation 0 -0.55 0
  name "chair_mimic"
  boundingObject Pose {
    translation 0 0 0.40
    children [ Box { size 0.44 0.44 0.06 } ]
  }
  children [
    Pose {
      translation 0 0 0.40
      children [ Shape { castShadows FALSE appearance PBRAppearance { baseColor 0.32 0.26 0.22 roughness 0.7 metalness 0.1 } geometry Box { size 0.44 0.44 0.06 } } ]
    }
    DEF CHAIR_MIMIC_BACK Solid {
      translation -0.085 0 0.66
      name "chair_mimic_back"
      boundingObject Box { size 0.04 0.44 0.52 }
      children [ Shape { castShadows FALSE appearance PBRAppearance { baseColor 0.32 0.26 0.22 roughness 0.7 metalness 0.1 } geometry Box { size 0.04 0.44 0.52 } } ]
    }
    Pose { translation  0.18  0.18 0.15 children [ Shape { castShadows FALSE appearance PBRAppearance { baseColor 0.20 0.16 0.13 roughness 0.6 metalness 0.2 } geometry Box { size 0.05 0.05 0.44 } } ] }
    Pose { translation  0.18 -0.18 0.15 children [ Shape { castShadows FALSE appearance PBRAppearance { baseColor 0.20 0.16 0.13 roughness 0.6 metalness 0.2 } geometry Box { size 0.05 0.05 0.44 } } ] }
    Pose { translation -0.18  0.18 0.15 children [ Shape { castShadows FALSE appearance PBRAppearance { baseColor 0.20 0.16 0.13 roughness 0.6 metalness 0.2 } geometry Box { size 0.05 0.05 0.44 } } ] }
    Pose { translation -0.18 -0.18 0.15 children [ Shape { castShadows FALSE appearance PBRAppearance { baseColor 0.20 0.16 0.13 roughness 0.6 metalness 0.2 } geometry Box { size 0.05 0.05 0.44 } } ] }
  ]
}

# ----- Chair under the ghost (visual-only hologram) -----
DEF CHAIR_GHOST Solid {
  translation 0 0.55 0
  name "chair_ghost"
  children [
    Pose {
      translation 0 0 0.40
      children [ Shape { castShadows FALSE appearance PBRAppearance { baseColor 0.30 0.34 0.40 transparency 0.35 roughness 0.7 metalness 0.1 } geometry Box { size 0.44 0.44 0.06 } } ]
    }
    Pose {
      translation -0.085 0 0.66
      children [ Shape { castShadows FALSE appearance PBRAppearance { baseColor 0.30 0.34 0.40 transparency 0.35 roughness 0.7 metalness 0.1 } geometry Box { size 0.04 0.44 0.52 } } ]
    }
    Pose { translation  0.18  0.18 0.15 children [ Shape { castShadows FALSE appearance PBRAppearance { baseColor 0.22 0.26 0.32 transparency 0.35 roughness 0.6 metalness 0.2 } geometry Box { size 0.05 0.05 0.44 } } ] }
    Pose { translation  0.18 -0.18 0.15 children [ Shape { castShadows FALSE appearance PBRAppearance { baseColor 0.22 0.26 0.32 transparency 0.35 roughness 0.6 metalness 0.2 } geometry Box { size 0.05 0.05 0.44 } } ] }
    Pose { translation -0.18  0.18 0.15 children [ Shape { castShadows FALSE appearance PBRAppearance { baseColor 0.22 0.26 0.32 transparency 0.35 roughness 0.6 metalness 0.2 } geometry Box { size 0.05 0.05 0.44 } } ] }
    Pose { translation -0.18 -0.18 0.15 children [ Shape { castShadows FALSE appearance PBRAppearance { baseColor 0.22 0.26 0.32 transparency 0.35 roughness 0.6 metalness 0.2 } geometry Box { size 0.05 0.05 0.44 } } ] }
  ]
}

# ----- Real robot: the MIMIC (Newton deploy physics), FREE base -- never pinned;
# the RL policy balances it through the whole sit->stand->sit. Uses the PRIM URDF
# (the full-mesh URDF cold-load-CRASHES under Newton); same 23 joints. Spawned
# already seated (OMNISIM_NEWTON_SEED_POSE) so the legs don't fall straight + jam.
DEF G1_REAL URDFRobot {
  url "../../robots/unitree/g1/urdf/g1_23dof_omnisim_prim.urdf"
  translation 0.15 -0.55 0.57
  name "g1"
  supervisor TRUE
  controller "g1_sitstand_mimic"
  physicsBackend "newton"
}

# ----- Ghost: kinematic, translucent, displays the same reference (or replay) -----
DEF G1_GHOST URDFRobot {
  url "../../robots/unitree/g1/urdf/g1_23dof_ghost.urdf"
  translation 0 0.55 0.57
  name "g1_ghost"
  supervisor TRUE
  controller "g1_sitstand_ghost"
  staticBase TRUE
}
