#OMNISIM R2025a utf8

# Deploy world for the CANONICAL G1 walk policy trained by
# projects/policies/research/training/gpu_humanoid_walk_trainer.py (HumanoidWalkEnv, robot=g1).
#
# Pure-RL walk: 47-d obs, 12-d action, lower-body only (waist PD-held). The
# g1_walk_canon_deploy controller assembles the obs to EXACTLY match the trainer.
#
# Uses the legs-only G1 URDF (g1_legs_omnisim.urdf) -- the 12 leg joints the
# policy controls plus the held waist_yaw. Same prim URDF + Newton/mujoco_warp
# solver the trainer's physics derive from.
#
# Required Newton env (set by the launch command -- see the controller docstring
# / the deliverable launch block): OMNISIM_NEWTON_STATICS=1, _SUBSTEPS=4,
# _FORCE_MUJOCO=1, _MJWARP=1, OMNISIM_URDF_USE_INERTIA=1, plus the TRAINED gains
# OMNISIM_NEWTON_TARGET_KE=300 / _KD=15 and OMNISIM_NEWTON_GROUND_MU=1.0.

EXTERNPROTO "omnisim://projects/objects/floors/protos/RectangleArena.proto"
EXTERNPROTO "omnisim://projects/objects/backgrounds/protos/OmniSimSky.proto"
EXTERNPROTO "omnisim://projects/objects/lights/protos/OmniSimSun.proto"
EXTERNPROTO "omnisim://projects/objects/lights/protos/OmniSimSunMarker.proto"

WorldInfo {
  newtonSolver "mujoco"
  basicTimeStep 16
  title "Unitree G1 canonical walk deploy"
  contactProperties [
    ContactProperties {
      material1 "default"
      material2 "default"
      coulombFriction [ 1.0 ]
      bounce 0.0
      bounceVelocity 0.5
    }
  ]
}
Viewpoint {
  orientation -0.278945 0.120681 0.952694 2.359689
  position 2.546 -2.710 3.912
  follow "g1"
  followType "Tracking Shot"
}
OmniSimSky { }
DEF SUN OmniSimSun { }
DEF SUN_MARKER OmniSimSunMarker { }
RectangleArena {
  floorSize 30 6
  wallHeight 0.05
  floorAppearance PBRAppearance {
    baseColor 0.18 0.20 0.22
    roughness 0.95
    metalness 0
  }
}

URDFRobot {
  url "../../../robots/unitree/g1/urdf/g1_legs_omnisim.urdf"
  translation 0 0 0.78
  name "g1"
  supervisor TRUE
  controller "g1_walk_canon_deploy"
  physicsBackend "newton"
}
