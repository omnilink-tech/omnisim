#OMNISIM R2025a utf8

# B2 import + stand smoke-test world (mirrors go2_stand_test.omniworld). Used to
# validate the URDF imports under Newton and to dump the deploy-matched MJCF
# via OMNISIM_NEWTON_SAVE_MJCF for the GPU mujoco_warp trainer.

EXTERNPROTO "omnisim://projects/objects/floors/protos/RectangleArena.proto"
EXTERNPROTO "omnisim://projects/objects/backgrounds/protos/OmniSimSky.proto"
EXTERNPROTO "omnisim://projects/objects/lights/protos/OmniSimSun.proto"
EXTERNPROTO "omnisim://projects/objects/lights/protos/OmniSimSunMarker.proto"

WorldInfo {
  newtonSolver "mujoco"
  basicTimeStep 16
  title "B2 stand test"
  contactProperties [
    ContactProperties {
      material1 "default"
      material2 "default"
      coulombFriction [ 2.0 ]
      bounce 0.0
      bounceVelocity 0.5
    }
  ]
}
Viewpoint {
  orientation -0.278945 0.120681 0.952694 2.359689
  position 4.624 -4.923 5.316
  follow ""
  followType "None"
}
OmniSimSky { }
DEF SUN OmniSimSun { }
DEF SUN_MARKER OmniSimSunMarker { }

RectangleArena {
  floorSize 12 12
  wallHeight 0.05
  floorAppearance PBRAppearance {
    baseColor 0.18 0.20 0.22
    roughness 0.95
    metalness 0
  }
}

URDFRobot {
  url "../../../robots/unitree/b2/urdf/b2.urdf"
  translation 0 0 0.54
  name "b2"
  supervisor TRUE
  controller "<none>"
  physicsBackend "newton"
}
