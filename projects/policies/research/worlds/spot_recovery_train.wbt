#VRML_SIM R2025a utf8

# Spot recovery-policy training world. Body is teleported to a random
# fallen orientation at every episode reset by the spot_recovery_agent
# controller, then the policy learns to right it.
#
# Physics: Newton (migrated from ODE 2026-06-11). Free-body episode-reset
# teleports work under Newton since the WbNewtonBackend resetBodyPose fix.
# NOTE: recovery RL itself is parked (see spot-residual-rl.md); the
# scripted RecoveryFSM is what ships.

EXTERNPROTO "omnisim://projects/objects/floors/protos/RectangleArena.proto"
EXTERNPROTO "omnisim://projects/objects/backgrounds/protos/OmniSimSky.proto"
EXTERNPROTO "omnisim://projects/objects/lights/protos/OmniSimSun.proto"
EXTERNPROTO "omnisim://projects/objects/lights/protos/OmniSimSunMarker.proto"

WorldInfo {
  newtonSolver "mujoco"
  basicTimeStep 16
  title "Spot recovery training"
  contactProperties [
    ContactProperties {
      material1 "default"
      material2 "default"
      coulombFriction [ 2.0 ]
      bounce 0.0
      bounceVelocity 0.5
    }
  ]
}
Viewpoint {
  orientation -0.5773 0.5773 0.5773 2.0944
  position 0 0 4
  follow ""
  followType "None"
}
OmniSimSky { }
DEF SUN OmniSimSun { }
DEF SUN_MARKER OmniSimSunMarker { }

RectangleArena {
  floorSize 20 20
  wallHeight 0.05
  floorAppearance PBRAppearance {
    baseColor 0.18 0.20 0.22
    roughness 0.95
    metalness 0
  }
}

URDFRobot {
  url "../../robots/boston_dynamics/spot/urdf/spot.urdf"
  translation 0 0 0.70
  name "spot"
  supervisor TRUE
  controller "spot_recovery_agent"
  controllerArgs [ "--port" "7100" ]
  physicsBackend "newton"
}
