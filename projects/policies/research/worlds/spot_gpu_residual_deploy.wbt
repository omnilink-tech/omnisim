#VRML_SIM R2025a utf8

# GPU residual deploy world. Same arena as spot_residual_deploy.wbt
# but the controller is spot_gpu_residual_deploy, which loads the
# 49-dim obs / joint-space residual ONNX exported from the GPU
# mjwarp residual trainer.
#
# Physics: Newton (migrated from ODE 2026-06-11). Newton's MuJoCo backend
# is an exact match for the mjwarp trainer since the sim2sim audit.
#
# *** STATUS 2026-06-12: SPOT WALKS HERE. After the sim2sim audit (commit
# f701be55: physics decimation match, honest eval, finite-diff qd, init DR,
# term penalty, settle-pose fix) the v8 policy walks +12.6 m / 30 s with
# ZERO falls, 100% upright through the bridge. Launch recipe:
#   OMNISIM_NEWTON_TARGET_KE=500 KD=60 SUBSTEPS=8 FORCE_MUJOCO=1 MJWARP=1
#   SEED_POSE=1 GROUND_MU=2.0 OMNISIM_URDF_USE_INERTIA=1
#   SPOT_POLICY_ONNX=projects/policies/research/inference/policies/gpu_spot_residual_v8/policy.onnx
# Spawn is 0.64 (trainer-matched settle height). Open: the walk arcs right
# (~69 deg/30 s; the 49-dim obs has no heading error) -- v9 wz-command
# steering trained but did not transfer; next: piecewise-constant
# in-episode wz commands. ***

EXTERNPROTO "omnisim://projects/objects/floors/protos/RectangleArena.proto"
EXTERNPROTO "omnisim://projects/objects/backgrounds/protos/OmniSimSky.proto"
EXTERNPROTO "omnisim://projects/objects/lights/protos/OmniSimSun.proto"
EXTERNPROTO "omnisim://projects/objects/lights/protos/OmniSimSunMarker.proto"

WorldInfo {
  newtonSolver "mujoco"
  basicTimeStep 16
  title "Spot GPU residual deploy"
  contactProperties [
    ContactProperties {
      material1 "default"
      material2 "default"
      coulombFriction [ 2.0 ]
      bounce 0.0
      bounceVelocity 0.5
    }
  ]
}
Viewpoint {
  orientation -0.5773 0.5773 0.5773 2.0944
  position 0 0 7
  follow ""
  followType "None"
}
OmniSimSky { }
DEF SUN OmniSimSun { }
DEF SUN_MARKER OmniSimSunMarker { }

RectangleArena {
  floorSize 60 6
  wallHeight 0.05
  floorAppearance PBRAppearance {
    baseColor 0.18 0.20 0.22
    roughness 0.95
    metalness 0
  }
}

Solid { translation 3 -1.5 0.5 children [ Shape { appearance PBRAppearance { baseColor 1 0 0 } geometry Cylinder { radius 0.08 height 1 } } ] name "m3" }
Solid { translation 6 -1.5 0.5 children [ Shape { appearance PBRAppearance { baseColor 1 0.6 0 } geometry Cylinder { radius 0.08 height 1 } } ] name "m6" }
Solid { translation 9 -1.5 0.5 children [ Shape { appearance PBRAppearance { baseColor 1 1 0 } geometry Cylinder { radius 0.08 height 1 } } ] name "m9" }
Solid { translation 12 -1.5 0.5 children [ Shape { appearance PBRAppearance { baseColor 0 1 0 } geometry Cylinder { radius 0.08 height 1 } } ] name "m12" }
Solid { translation 15 -1.5 0.5 children [ Shape { appearance PBRAppearance { baseColor 0 0.6 1 } geometry Cylinder { radius 0.08 height 1 } } ] name "m15" }
Solid { translation 18 -1.5 0.5 children [ Shape { appearance PBRAppearance { baseColor 0.5 0 1 } geometry Cylinder { radius 0.08 height 1 } } ] name "m18" }
Solid { translation 21 -1.5 0.5 children [ Shape { appearance PBRAppearance { baseColor 1 0 1 } geometry Cylinder { radius 0.08 height 1 } } ] name "m21" }

URDFRobot {
  url "../../robots/boston_dynamics/spot/urdf/spot.urdf"
  translation 0 0 0.64
  name "spot"
  supervisor TRUE
  controller "spot_gpu_residual_deploy"
  physicsBackend "newton"
}
