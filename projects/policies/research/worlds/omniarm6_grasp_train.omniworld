#OMNISIM R2025a utf8

# OMNIARM6 grasp residual-RL TRAINING world.
#
# One OMNIARM6 + real Robotiq 2F-85 over a small bin holding a TARGET cube and a
# ring of CLUTTER cubes. The omniarm6_grasp_agent controller (supervisor) runs the
# TCP protocol the trainer drives: each step it re-randomises the clutter around
# the target, executes ONE hard-coded top-down grasp ADJUSTED by the policy's
# residual action (dx, dy, dz, dyaw), and returns a reward = was the target
# lifted clear. The policy learns the grasp-pose corrections that let the wide
# jaws get a packed cube out -- the action-space expansion the rigid grasp lacks.
#
# Newton + MuJoCo (friction grasp). Driven by the grasp residual-RL trainer; the
# "7100" below is the TCP port placeholder the trainer rewrites.

EXTERNPROTO "omnisim://projects/objects/backgrounds/protos/OmniSimSky.proto"
EXTERNPROTO "omnisim://projects/objects/lights/protos/OmniSimSun.proto"
EXTERNPROTO "omnisim://projects/objects/lights/protos/OmniSimSunMarker.proto"
EXTERNPROTO "omnisim://projects/objects/floors/protos/RectangleArena.proto"

WorldInfo {
  basicTimeStep 16
  title "OMNIARM6 grasp residual-RL training"
  newtonSolver "mujoco"
  contactProperties [
    ContactProperties { material1 "default" material2 "default" coulombFriction [ 5 ] bounce 0 softCFM 0.0003 }
  ]
  # translation_audit: ContactProperties.coulombFriction is an ODE-path field the
  # Newton backend does not read; this declares the same friction where it is read.
  newtonGroundMu 5
}
Viewpoint { orientation -0.278945 0.120681 0.952694 2.359689 position 3.303 -3.516 3.540 }
OmniSimSky { }
DEF SUN OmniSimSun { }
DEF SUN_MARKER OmniSimSunMarker { }
RectangleArena { floorSize 4 4 floorAppearance PBRAppearance { baseColor 0.18 0.20 0.22 roughness 0.95 metalness 0 } }

DEF OMNIARM6 URDFRobot {
  url "../../../robots/omnisim/omniarm6/omniarm6_2f85.urdf"
  translation 0 0 0
  name "omniarm6"
  supervisor TRUE
  staticBase TRUE
  physicsBackend "newton"
  controller "omniarm6_grasp_train"
}

# Small bin (real Newton static colliders) the agent fills with clutter.
DEF BIN_WALL_W Solid { translation 0.345 0.0 0.075 physicsBackend "newton" children [ DEF WW Shape { appearance PBRAppearance { baseColor 0.30 0.33 0.38 roughness 0.8 } geometry Box { size 0.025 0.27 0.15 } } ] name "bin_wall_w" boundingObject USE WW }
DEF BIN_WALL_E Solid { translation 0.575 0.0 0.075 physicsBackend "newton" children [ DEF WE Shape { appearance PBRAppearance { baseColor 0.30 0.33 0.38 roughness 0.8 } geometry Box { size 0.025 0.27 0.15 } } ] name "bin_wall_e" boundingObject USE WE }
DEF BIN_WALL_S Solid { translation 0.46 -0.135 0.075 physicsBackend "newton" children [ DEF WS Shape { appearance PBRAppearance { baseColor 0.30 0.33 0.38 roughness 0.8 } geometry Box { size 0.27 0.025 0.15 } } ] name "bin_wall_s" boundingObject USE WS }
DEF BIN_WALL_N Solid { translation 0.46 0.135 0.075 physicsBackend "newton" children [ DEF WN Shape { appearance PBRAppearance { baseColor 0.30 0.33 0.38 roughness 0.8 } geometry Box { size 0.27 0.025 0.15 } } ] name "bin_wall_n" boundingObject USE WN }

# Target cube (green) + 8 clutter cubes (grey). The agent re-poses all of them
# each episode reset; initial poses here just need to be valid/non-overlapping.
DEF TARGET Solid { translation 0.46 0.0 0.03 physicsBackend "newton" children [ DEF TG Shape { appearance PBRAppearance { baseColor 0.20 0.80 0.30 roughness 1 metalness 0 } geometry Box { size 0.05 0.05 0.05 } } ] name "target" boundingObject USE TG physics Physics { density -1 mass 0.06 } }
DEF CLUT_1 Solid { translation 0.40 -0.06 0.03 physicsBackend "newton" children [ DEF C1 Shape { appearance PBRAppearance { baseColor 0.55 0.57 0.60 roughness 1 } geometry Box { size 0.05 0.05 0.05 } } ] name "clut_1" boundingObject USE C1 physics Physics { density -1 mass 0.06 } }
DEF CLUT_2 Solid { translation 0.52 -0.06 0.03 physicsBackend "newton" children [ DEF C2 Shape { appearance PBRAppearance { baseColor 0.55 0.57 0.60 roughness 1 } geometry Box { size 0.05 0.05 0.05 } } ] name "clut_2" boundingObject USE C2 physics Physics { density -1 mass 0.06 } }
DEF CLUT_3 Solid { translation 0.40 0.06 0.03 physicsBackend "newton" children [ DEF C3 Shape { appearance PBRAppearance { baseColor 0.55 0.57 0.60 roughness 1 } geometry Box { size 0.05 0.05 0.05 } } ] name "clut_3" boundingObject USE C3 physics Physics { density -1 mass 0.06 } }
DEF CLUT_4 Solid { translation 0.52 0.06 0.03 physicsBackend "newton" children [ DEF C4 Shape { appearance PBRAppearance { baseColor 0.55 0.57 0.60 roughness 1 } geometry Box { size 0.05 0.05 0.05 } } ] name "clut_4" boundingObject USE C4 physics Physics { density -1 mass 0.06 } }
DEF CLUT_5 Solid { translation 0.46 -0.07 0.03 physicsBackend "newton" children [ DEF C5 Shape { appearance PBRAppearance { baseColor 0.55 0.57 0.60 roughness 1 } geometry Box { size 0.05 0.05 0.05 } } ] name "clut_5" boundingObject USE C5 physics Physics { density -1 mass 0.06 } }
DEF CLUT_6 Solid { translation 0.46 0.07 0.03 physicsBackend "newton" children [ DEF C6 Shape { appearance PBRAppearance { baseColor 0.55 0.57 0.60 roughness 1 } geometry Box { size 0.05 0.05 0.05 } } ] name "clut_6" boundingObject USE C6 physics Physics { density -1 mass 0.06 } }
DEF CLUT_7 Solid { translation 0.39 0.0 0.03 physicsBackend "newton" children [ DEF C7 Shape { appearance PBRAppearance { baseColor 0.55 0.57 0.60 roughness 1 } geometry Box { size 0.05 0.05 0.05 } } ] name "clut_7" boundingObject USE C7 physics Physics { density -1 mass 0.06 } }
DEF CLUT_8 Solid { translation 0.53 0.0 0.03 physicsBackend "newton" children [ DEF C8 Shape { appearance PBRAppearance { baseColor 0.55 0.57 0.60 roughness 1 } geometry Box { size 0.05 0.05 0.05 } } ] name "clut_8" boundingObject USE C8 physics Physics { density -1 mass 0.06 } }
DEF CLUT_9 Solid { translation 0.43 -0.04 0.09 physicsBackend "newton" children [ DEF C9 Shape { appearance PBRAppearance { baseColor 0.55 0.57 0.60 roughness 1 } geometry Box { size 0.05 0.05 0.05 } } ] name "clut_9" boundingObject USE C9 physics Physics { density -1 mass 0.06 } }
DEF CLUT_10 Solid { translation 0.49 0.04 0.09 physicsBackend "newton" children [ DEF C10 Shape { appearance PBRAppearance { baseColor 0.55 0.57 0.60 roughness 1 } geometry Box { size 0.05 0.05 0.05 } } ] name "clut_10" boundingObject USE C10 physics Physics { density -1 mass 0.06 } }
