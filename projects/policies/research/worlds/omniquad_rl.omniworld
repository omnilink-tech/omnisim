#OMNISIM R2025a utf8

# OmniQuad RL training world.
#
# Flat arena, single OmniQuad, controller "omniquad_rl_agent" (listens on TCP port
# passed via controllerArgs --port). Designed for headless --mode=fast use
# inside OmniQuadEnv (projects/policies/research/envs/omniquad_env.py).
#
# Physics: Newton (MuJoCo CPU). Migrated from ODE 2026-06-11; launch with
# the standard OmniQuad Newton knobs (OMNISIM_NEWTON_TARGET_KE=250 / KD=60 /
# GROUND_MU=2.0 / SEED_POSE=1 / FORCE_MUJOCO=1 / OMNISIM_URDF_USE_INERTIA=1,
# see docs/developer/omniquad-residual-rl.md "Newton port").

EXTERNPROTO "omnisim://projects/objects/backgrounds/protos/TexturedBackground.proto"
EXTERNPROTO "omnisim://projects/objects/backgrounds/protos/TexturedBackgroundLight.proto"
EXTERNPROTO "omnisim://projects/objects/floors/protos/RectangleArena.proto"
EXTERNPROTO "omnisim://projects/objects/backgrounds/protos/OmniSimSky.proto"
EXTERNPROTO "omnisim://projects/objects/lights/protos/OmniSimSun.proto"
EXTERNPROTO "omnisim://projects/objects/lights/protos/OmniSimSunMarker.proto"

WorldInfo {
  newtonSolver "mujoco"
  basicTimeStep 16
  title "OmniQuad RL training"
  info [
    "OmniQuad quadruped, RL training environment."
    "Controller omniquad_rl_agent exchanges obs/action with the OmniQuadEnv via TCP."
  ]
  contactProperties [
    ContactProperties {
      material1 "default"
      material2 "default"
      coulombFriction [ 2.0 ]
      bounce 0.0
      bounceVelocity 0.5
    }
  ]
}
Viewpoint {
  orientation -0.278945 0.120681 0.952694 2.359689
  position 4.624 -4.923 5.476
}
OmniSimSky { }
DEF SUN OmniSimSun { }
DEF SUN_MARKER OmniSimSunMarker { }
RectangleArena {
  floorSize 20 6
  wallHeight 0.05
  floorAppearance PBRAppearance {
    baseColor 0.18 0.20 0.22
    roughness 0.95
    metalness 0
  }
}

URDFRobot {
  url "../../../robots/omnisim/omniquad/urdf/omniquad.urdf"
  translation 0 0 0.70
  name "omniquad"
  supervisor TRUE
  controller "omniquad_rl_agent"
  controllerArgs [ "--port" "7100" ]
  physicsBackend "newton"
}
