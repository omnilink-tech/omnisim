#OMNISIM R2025a utf8

# OmniQuad CROUCH deploy world -- the shadowing pipeline end-to-end on a NON-gait motion.
# The OmniQuad here SHADOWS an MPPI-generated, verifier-certified crouch-recover ghost
# (projects/policies/research/shadowing/ghosts/omniquad_crouch_ghost.npz) under controller
# omniquad_crouch_mimic. Feedforward by default (the ghost is feasible by construction);
# OMNIQUAD_CROUCH_POLICY adds an RL residual.
# Launch: scripts/dev/run_omniquad_crouch_deploy.ps1
# Engine env: OMNISIM_NEWTON_TARGET_KE=500 KD=60 SUBSTEPS=8 FORCE_MUJOCO=1 MJWARP=1
#             SEED_POSE=1 GROUND_MU=2.0 URDF_USE_INERTIA=1  (matches the ghost dynamics).

EXTERNPROTO "omnisim://projects/objects/floors/protos/RectangleArena.proto"
EXTERNPROTO "omnisim://projects/objects/backgrounds/protos/OmniSimSky.proto"
EXTERNPROTO "omnisim://projects/objects/lights/protos/OmniSimSun.proto"
EXTERNPROTO "omnisim://projects/objects/lights/protos/OmniSimSunMarker.proto"

WorldInfo {
  newtonSolver "mujoco"
  basicTimeStep 16
  title "OmniQuad crouch deploy (shadowing)"
  contactProperties [
    ContactProperties {
      material1 "default"
      material2 "default"
      coulombFriction [ 2.0 ]
      bounce 0.0
      bounceVelocity 0.5
    }
  ]
}
Viewpoint {
  orientation -0.278945 0.120681 0.952694 2.359689
  position 4.624 -4.923 5.336
  follow "omniquad"
  followType "Tracking Shot"
  followSmoothness 0.3
}
OmniSimSky { }
DEF SUN OmniSimSun { }
DEF SUN_MARKER OmniSimSunMarker { }

RectangleArena {
  floorSize 8 8
  wallHeight 0.05
  floorAppearance PBRAppearance {
    baseColor 0.18 0.20 0.22
    roughness 0.95
    metalness 0
  }
}

DEF OMNIQUAD_REAL URDFRobot {
  url "../../../robots/omnisim/omniquad/urdf/omniquad.urdf"
  translation 0 0 0.56
  name "omniquad"
  supervisor TRUE
  controller "omniquad_crouch_mimic"
  physicsBackend "newton"
}
