#VRML_SIM R2025a utf8

# Atlas URDF smoke world.
#
# Loads the Atlas URDF with the default <generic> controller so the
# importer + Newton physics get exercised but no Python/RL is wired up.
# Used by `python scripts/dev/headless_runner.py projects/policies/worlds/atlas_smoke.wbt`
# to verify the URDF imports cleanly before building the RL stack on top.

EXTERNPROTO "omnisim://projects/objects/backgrounds/protos/TexturedBackground.proto"
EXTERNPROTO "omnisim://projects/objects/backgrounds/protos/TexturedBackgroundLight.proto"
EXTERNPROTO "omnisim://projects/objects/floors/protos/RectangleArena.proto"
EXTERNPROTO "omnisim://projects/objects/backgrounds/protos/OmniSimSky.proto"
EXTERNPROTO "omnisim://projects/objects/lights/protos/OmniSimSun.proto"
EXTERNPROTO "omnisim://projects/objects/lights/protos/OmniSimSunMarker.proto"

WorldInfo {
  newtonSolver "mujoco"
  basicTimeStep 16
  title "Atlas URDF smoke"
  contactProperties [
    ContactProperties {
      material1 "default"
      material2 "default"
      coulombFriction [ 1.0 ]
      bounce 0.0
      bounceVelocity 0.5
    }
  ]
}
Viewpoint {
  orientation -0.5773 0.5773 0.5773 2.0944
  position 0 0 4
}
OmniSimSky { }
DEF SUN OmniSimSun { }
DEF SUN_MARKER OmniSimSunMarker { }
RectangleArena {
  floorSize 20 6
}

URDFRobot {
  url "../../robots/boston_dynamics/atlas/urdf/atlas_convex_hull.urdf"
  translation 0 0 1.10
  name "atlas"
  supervisor TRUE
  controller "<generic>"
  physicsBackend "newton"
}
