#OMNISIM R2025a utf8

# OmniQuad recovery-policy training world. Body is teleported to a random
# fallen orientation at every episode reset by the omniquad_recovery_agent
# controller, then the policy learns to right it.
#
# Physics: Newton (migrated from ODE 2026-06-11). Free-body episode-reset
# teleports work under Newton since the WbNewtonBackend resetBodyPose fix.
# NOTE: recovery RL itself is parked (see omniquad-residual-rl.md); the
# scripted RecoveryFSM is what ships.

EXTERNPROTO "omnisim://projects/objects/floors/protos/RectangleArena.proto"
EXTERNPROTO "omnisim://projects/objects/backgrounds/protos/OmniSimSky.proto"
EXTERNPROTO "omnisim://projects/objects/lights/protos/OmniSimSun.proto"
EXTERNPROTO "omnisim://projects/objects/lights/protos/OmniSimSunMarker.proto"

WorldInfo {
  newtonSolver "mujoco"
  basicTimeStep 16
  title "OmniQuad recovery training"
  contactProperties [
    ContactProperties {
      material1 "default"
      material2 "default"
      coulombFriction [ 2.0 ]
      bounce 0.0
      bounceVelocity 0.5
    }
  ]
}
Viewpoint {
  orientation -0.278945 0.120681 0.952694 2.359689
  position 4.624 -4.923 5.476
  follow ""
  followType "None"
}
OmniSimSky { }
DEF SUN OmniSimSun { }
DEF SUN_MARKER OmniSimSunMarker { }

RectangleArena {
  floorSize 20 20
  wallHeight 0.05
  floorAppearance PBRAppearance {
    baseColor 0.18 0.20 0.22
    roughness 0.95
    metalness 0
  }
}

URDFRobot {
  url "../../../robots/omnisim/omniquad/urdf/omniquad.urdf"
  translation 0 0 0.70
  name "omniquad"
  supervisor TRUE
  controller "omniquad_recovery_agent"
  controllerArgs [ "--port" "7100" ]
  physicsBackend "newton"
}
