#OMNISIM R2025a utf8

# GHOST PREVIEW -- the stand-and-wave REFERENCE motion ALONE (no physics robot), so we
# design + agree on the ghost BEFORE building the mimic (the ghost-first rule). A single
# kinematic, translucent G1 (staticBase, no Newton) stands, balances, and WAVES its right
# hand on loop, replaying projects/policies/research/shadowing/generate_g1_standwave.py.
#
# Launch: scripts/dev/run_g1_standwave_ghost_preview.ps1

EXTERNPROTO "omnisim://projects/objects/backgrounds/protos/TexturedBackground.proto"
EXTERNPROTO "omnisim://projects/objects/backgrounds/protos/TexturedBackgroundLight.proto"
EXTERNPROTO "omnisim://projects/objects/floors/protos/RectangleArena.proto"
EXTERNPROTO "omnisim://projects/objects/backgrounds/protos/OmniSimSky.proto"
EXTERNPROTO "omnisim://projects/objects/lights/protos/OmniSimSun.proto"
EXTERNPROTO "omnisim://projects/objects/lights/protos/OmniSimSunMarker.proto"

WorldInfo {
  basicTimeStep 16
  title "G1 stand + wave -- GHOST preview (design the motion)"
}
Viewpoint {
  orientation -0.278945 0.120681 0.952694 2.359689
  position 4.294 -4.571 5.557
}
OmniSimSky { }
DEF SUN OmniSimSun { }
DEF SUN_MARKER OmniSimSunMarker { }
RectangleArena {
  floorSize 8 6
  wallHeight 0.05
  floorAppearance PBRAppearance {
    baseColor 0.18 0.20 0.22
    roughness 0.95
    metalness 0
  }
}

# ----- The ghost: kinematic, translucent, stands + waves on loop -----
DEF G1_GHOST URDFRobot {
  url "../../../robots/unitree/g1/urdf/g1_23dof_ghost.urdf"
  translation 0 0 0.79
  name "g1_ghost"
  supervisor TRUE
  controller "g1_standwave_ghost"
  staticBase TRUE
}
