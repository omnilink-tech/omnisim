#OMNISIM R2025a utf8

# GHOST PREVIEW -- the sit->stand->sit REFERENCE motion ALONE (no physics robot),
# so we design + agree on the ghost BEFORE building any mimic. A single kinematic,
# translucent G1 (staticBase, no Newton) plays the shared reference on loop:
# seated -> rise -> stand 5s -> sit back. Adjust projects/policies/control/gait/g1_sitstand.py
# (poses / timeline / heights) until the motion is what we want, then mimic.
#
# Launch: scripts/dev/run_g1_sitstand_ghost_preview.ps1

EXTERNPROTO "omnisim://projects/objects/backgrounds/protos/TexturedBackground.proto"
EXTERNPROTO "omnisim://projects/objects/backgrounds/protos/TexturedBackgroundLight.proto"
EXTERNPROTO "omnisim://projects/objects/floors/protos/RectangleArena.proto"
EXTERNPROTO "omnisim://projects/objects/backgrounds/protos/OmniSimSky.proto"
EXTERNPROTO "omnisim://projects/objects/lights/protos/OmniSimSun.proto"
EXTERNPROTO "omnisim://projects/objects/lights/protos/OmniSimSunMarker.proto"

WorldInfo {
  basicTimeStep 16
  title "G1 sit->stand->sit -- GHOST preview (design the motion)"
}
Viewpoint {
  orientation -0.278945 0.120681 0.952694 2.359689
  position 4.294 -4.571 5.337
}
OmniSimSky { }
DEF SUN OmniSimSun { }
DEF SUN_MARKER OmniSimSunMarker { }
RectangleArena {
  floorSize 8 6
  wallHeight 0.05
  floorAppearance PBRAppearance {
    baseColor 0.18 0.20 0.22
    roughness 0.95
    metalness 0
  }
}

# ----- Chair under the ghost (visual-only). Seat top ~0.43 so the seated pelvis
# (0.55, butt ~0.45) RESTS on it -- reads as sitting, not hovering. -----
DEF CHAIR_GHOST Solid {
  translation 0 0 0
  name "chair_ghost"
  children [
    Pose {
      translation 0 0 0.40
      children [ Shape { castShadows FALSE appearance PBRAppearance { baseColor 0.30 0.34 0.40 transparency 0.35 roughness 0.7 metalness 0.1 } geometry Box { size 0.44 0.44 0.06 } } ]
    }
    Pose {
      translation -0.085 0 0.70
      children [ Shape { castShadows FALSE appearance PBRAppearance { baseColor 0.30 0.34 0.40 transparency 0.35 roughness 0.7 metalness 0.1 } geometry Box { size 0.04 0.44 0.52 } } ]
    }
    Pose { translation  0.18  0.18 0.20 children [ Shape { castShadows FALSE appearance PBRAppearance { baseColor 0.22 0.26 0.32 transparency 0.35 roughness 0.6 metalness 0.2 } geometry Box { size 0.05 0.05 0.40 } } ] }
    Pose { translation  0.18 -0.18 0.20 children [ Shape { castShadows FALSE appearance PBRAppearance { baseColor 0.22 0.26 0.32 transparency 0.35 roughness 0.6 metalness 0.2 } geometry Box { size 0.05 0.05 0.40 } } ] }
    Pose { translation -0.18  0.18 0.20 children [ Shape { castShadows FALSE appearance PBRAppearance { baseColor 0.22 0.26 0.32 transparency 0.35 roughness 0.6 metalness 0.2 } geometry Box { size 0.05 0.05 0.40 } } ] }
    Pose { translation -0.18 -0.18 0.20 children [ Shape { castShadows FALSE appearance PBRAppearance { baseColor 0.22 0.26 0.32 transparency 0.35 roughness 0.6 metalness 0.2 } geometry Box { size 0.05 0.05 0.40 } } ] }
  ]
}

# ----- The ghost: kinematic, translucent, plays the sit->stand->sit reference on loop -----
DEF G1_GHOST URDFRobot {
  url "../../../robots/unitree/g1/urdf/g1_23dof_ghost.urdf"
  translation 0 0 0.57
  name "g1_ghost"
  supervisor TRUE
  controller "g1_sitstand_ghost"
  staticBase TRUE
}
