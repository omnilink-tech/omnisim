#OMNISIM R2025a utf8
EXTERNPROTO "omnisim://projects/objects/backgrounds/protos/OmniSimSky.proto"
EXTERNPROTO "omnisim://projects/objects/lights/protos/OmniSimSun.proto"
EXTERNPROTO "omnisim://projects/objects/lights/protos/OmniSimSunMarker.proto"

WorldInfo {
  basicTimeStep 16
  title "Husky braking assessment"
  newtonSolver "mujoco"
  newtonGroundMu 0.8
  newtonSubsteps 8
}
Viewpoint {
  position 3.964 -4.219 4.158
  orientation -0.278945 0.120681 0.952694 2.359689
}
OmniSimSky { }
DEF SUN OmniSimSun { }
DEF SUN_MARKER OmniSimSunMarker { }
DEF FLOOR Solid {
  translation 2 0 -0.1
  children [ Shape {
    appearance PBRAppearance { baseColor 0.23 0.27 0.30 roughness 0.9 metalness 0 }
    geometry Box { size 12 5 0.2 }
  } ]
  boundingObject Box { size 12 5 0.2 }
}
# Visual lane centerline only: no collider.
Transform {
  translation 2 0 0.002
  children [ Shape {
    appearance PBRAppearance { baseColor 0.8 0.8 0.7 roughness 1 metalness 0 }
    geometry Box { size 10 0.02 0.003 }
  } ]
}
DEF HUSKY URDFRobot {
  url "../../robots/clearpath/husky_description/urdf/husky.urdf"
  translation 0 0 0.2
  name "husky"
  supervisor TRUE
  controller "husky_braking"
}
