<?xml version='1.0' encoding='utf-8'?>
<!--
  OmniArm 6 - OmniSim's generic 6-axis collaborative arm.

  A vendor-neutral reference cobot: 6 revolute joints, 800 mm reach
  (380 mm upper arm + 420 mm forearm), ~25 kg. Gripper variants live beside
  this file (2F-85, 2F-140, suction, gum-grip).

  All geometry is authored in this repository. The visual shells are primitive
  solids emitted by scripts/dev/gen_omnisim_robot_visuals.py; collision
  geometry is primitive cylinders. No mesh, texture or CAD file from any third
  party is used, and nothing here is imported or derived from a vendor product
  model.

  See PROVENANCE.md.
-->
<robot name="omniarm6">

	<link name="link0">
		<inertial>
			<origin rpy="0 0 0" xyz="-0.00090289 -3.524e-05 0.0464554" />
