#OMNISIM R2025a utf8

# OmniArm 6 fleet showcase.
# A 4 x 4 grid of OmniArm 6 cobots, each on its own brushed-aluminium pedestal,
# all running the same omniarm6_wave controller. Each arm picks up a per-instance
# phase offset from the trailing digits of its name (omniarm6_0 .. omniarm6_15) so
# the fleet rolls a wave across the grid instead of moving in lockstep.
#
# Layout (top-down, +X east, +Y north, 1.5 m grid spacing):
#
#   y=+2.25   12  13  14  15
#   y=+0.75    8   9  10  11
#   y=-0.75    4   5   6   7
#   y=-2.25    0   1   2   3
#               x=-2.25 -0.75 +0.75 +2.25

EXTERNPROTO "omnisim://projects/objects/floors/protos/Floor.proto"
EXTERNPROTO "omnisim://projects/appearances/protos/Asphalt.proto"
EXTERNPROTO "omnisim://projects/appearances/protos/BrushedAluminium.proto"
EXTERNPROTO "omnisim://projects/objects/backgrounds/protos/OmniSimSky.proto"
EXTERNPROTO "omnisim://projects/objects/lights/protos/OmniSimSun.proto"
EXTERNPROTO "omnisim://projects/objects/lights/protos/OmniSimSunMarker.proto"

WorldInfo {
  basicTimeStep 16
  title "OmniArm 6 Fleet"
}
Viewpoint {
  orientation -0.278945 0.120681 0.952694 2.359689
  position 13.813 -14.704 13.527
}
OmniSimSky { }
DEF SUN OmniSimSun { }
DEF SUN_MARKER OmniSimSunMarker { }
DirectionalLight {
  direction -0.5 0.4 -0.6
  color 0.85 0.88 1.0
  intensity 1.4
  ambientIntensity 0.0
  castShadows FALSE
}

Floor {
  size 8 8
  tileSize 8 8
  appearance Asphalt {
    colorOverride 0.55 0.57 0.60
  }
}

DEF PEDESTAL_0  Solid { translation -2.25 -2.25 0.075 children [ Shape { appearance BrushedAluminium {} geometry Box { size 0.4 0.4 0.15 } } ] name "pedestal_0"  boundingObject Box { size 0.4 0.4 0.15 } }
DEF PEDESTAL_1  Solid { translation -0.75 -2.25 0.075 children [ Shape { appearance BrushedAluminium {} geometry Box { size 0.4 0.4 0.15 } } ] name "pedestal_1"  boundingObject Box { size 0.4 0.4 0.15 } }
DEF PEDESTAL_2  Solid { translation  0.75 -2.25 0.075 children [ Shape { appearance BrushedAluminium {} geometry Box { size 0.4 0.4 0.15 } } ] name "pedestal_2"  boundingObject Box { size 0.4 0.4 0.15 } }
