			<geometry>
				<cylinder radius="0.05" length="0.165" />
			</geometry>
		</collision>
		<!-- Suction-tool ADAPTER+NECK collider (link6 z 0.1655..0.2105, i.e. the
		     first 45 mm past the flange). It lives HERE and not on the
		     suction_cup link because colliders on fixed-child links are merged
		     visually but never registered by the physics bridges (verified
		     inert under both Newton and ODE, 2026-07-12); link6's own
		     collisions demonstrably work. The rubber LIP (z 0.226..0.2505)
		     stays collision-free on purpose: the vacuum pick welds the part
		     flush against the lip, and a lip collider would fight that weld
		     on every pick. -->
		<collision>
			<origin xyz="0 0 0.188" rpy="0 0 0" />
			<geometry>
				<cylinder radius="0.024" length="0.045" />
			</geometry>
		</collision>
	</link>

	<link name="flange">
	</link>

	<link name="gripper_tcp">
	</link>


	<joint name="joint1" type="revolute">
		<limit lower="-3.14159" upper="3.14159" effort="194" velocity="3.1415" />
		<origin rpy="0 0 0" xyz="0 0 0" />
		<parent link="link0" />
		<child link="link1" />
		<axis xyz="0 0 1" />
	</joint>

