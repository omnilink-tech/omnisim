	<joint name="link6flange" type="fixed">
		<origin rpy="0 0 0" xyz="0 0 0.1655" />
		<parent link="link6" />
		<child link="flange" />
	</joint>

	<joint name="flangegripper_tcp" type="fixed">
		<origin rpy="0 0 0" xyz="0 0 0.0" />
		<parent link="flange" />
		<child link="gripper_tcp" />
	</joint>


	<!-- ===== Suction (vacuum) cup tool: NO fingers =====
	     A flared rubber cup on the flange. Mounted at link6 + 0.1655 (the flange),
	     it extends +z so its LIP sits at local z=0.085 = tool point OZ=0.25 from
	     link6. The metal adapter + neck carry a small collider (local z 0..0.045)
	     so the tool body cannot ghost through bin walls; the rubber LIP
	     (z 0.06..0.085) stays collision-free ON PURPOSE: the pick is a vacuum
	     weld (controller), and a lip collider would fight the part welded flush
	     against it on every pick. -->
	<link name="suction_cup">
		<visual>
			<origin xyz="0 0 0.008" rpy="0 0 0"/>
			<geometry><cylinder radius="0.024" length="0.016"/></geometry>
			<material name="cup_metal"><color rgba="0.55 0.55 0.58 1"/></material>
		</visual>
		<visual>
			<origin xyz="0 0 0.028" rpy="0 0 0"/>
			<geometry><cylinder radius="0.014" length="0.024"/></geometry>
			<material name="cup_neck"><color rgba="0.18 0.18 0.20 1"/></material>
		</visual>
		<visual>
			<origin xyz="0 0 0.050" rpy="0 0 0"/>
			<geometry><cylinder radius="0.019" length="0.020"/></geometry>
			<material name="cup_rubber"><color rgba="0.10 0.10 0.11 1"/></material>
		</visual>
		<visual>
			<origin xyz="0 0 0.0725" rpy="0 0 0"/>
			<geometry><cylinder radius="0.027" length="0.025"/></geometry>
			<material name="cup_lip"><color rgba="0.07 0.07 0.08 1"/></material>
		</visual>
		<inertial>
			<origin xyz="0 0 0.04" rpy="0 0 0"/>
			<mass value="0.05"/>
			<inertia ixx="2e-5" ixy="0" ixz="0" iyy="2e-5" iyz="0" izz="2e-5"/>
		</inertial>
	</link>
	<joint name="link6_suction_cup" type="fixed">
		<origin rpy="0 0 0" xyz="0 0 0.1655"/>
		<parent link="link6"/>
		<child link="suction_cup"/>
	</joint>

</robot>