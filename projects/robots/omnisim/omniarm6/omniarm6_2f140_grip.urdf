		<!-- ⚠ THE GRIPPER BODY LIVES HERE, NOT ON robotiq_2f140_base_link, AND
		     THAT IS AN ENGINE CONSTRAINT, NOT A STYLE CHOICE. The 2F-140 base
		     is attached by a FIXED joint, and OmSolid::flushPendingNewtonRegistrations
		     (OmSolid.cpp:3354-3413) folds a fixed child into its leader body:
		     the mass rolls up, the joint anchors are re-expressed — and the
		     child's boundingObject is DROPPED ("Folding also DROPS its
		     boundingObject entirely", OmSolid.cpp:3380). Measured before this
		     change: OMNISIM_NEWTON_DUMP_MJMODEL listed 16 geoms and NO gripper
		     palm, so the 75x85x90 box authored on the base collided with
		     nothing and a part could enter the gripper body freely.
		     newtonCompoundColliders does NOT recover it — it recurses within
		     ONE Solid's boundingObject, never across the merge.
		     So the same box is declared here, on the leader, shifted by the
		     fixed joint's 0.1655: 0 0 0.045 + 0.1655 = 0 0 0.2105.
		     Measured bound of the ten base STLs in this frame:
		     x[-0.0375,+0.0375] y[-0.0422,+0.0427] z[-0.0036,+0.0898]. -->
		<collision>
			<origin xyz="0 0 0.2105" rpy="0 0 0"/>
			<geometry><box size="0.075 0.085 0.090"/></geometry>
		</collision>
	</link>

