#OMNISIM R2025a utf8

# ============================================================================
# OmniDune -- MINIMAL vehicle verification world.
#
# This is NOT a scenery world. It is the smallest scene that can answer five
# questions about the vehicle, and nothing else lives here:
#
#   1. RIDE HEIGHT   does the chassis settle where the design formula predicts?
#   2. DRIVE         does throttle produce forward displacement?
#   3. STEER         does a commanded steer angle produce measurable yaw?
#   4. SUSPENSION    do the struts stroke over a bump and return, without any
#                    corner pinning against its +/-0.20 m stop?
#   5. HEALTH        0 errors, exit 0, and a .newton.json verdict sidecar.
#
# The ground is one infinite Plane collider. The only other geometry is three
# half-buried cylinder bumps, which exist purely to excite the suspension for
# check 4 -- the real terrain is somebody else's world.
#
# Run:
#   OMNISIM_LOG_PATH=/tmp/omnidune.log \
#     python -m omnisim run-headless \
#       projects/robots/omnisim/omnidune/worlds/omnidune_test.omniworld --duration 14
# ============================================================================

EXTERNPROTO "omnisim://projects/objects/backgrounds/protos/OmniSimSky.proto"
EXTERNPROTO "omnisim://projects/objects/lights/protos/OmniSimSun.proto"
EXTERNPROTO "omnisim://projects/objects/lights/protos/OmniSimSunMarker.proto"
EXTERNPROTO "omnisim://projects/robots/omnisim/omnidune/protos/OmniDune.proto"

WorldInfo {
  title "OmniDune -- suspension and drive verification"
  info [
    "Minimal flat test world for the OmniDune desert buggy."
    "Ground is one infinite Plane collider; three rounded bumps at x = 5.0, 6.5, 8.0 excite the struts."
    "Design ride height: struts at zero deflection when the Robot origin is at z = 0.58."
    "Predicted static sag: front 39.8 mm (f_n 2.50 Hz), rear 45.0 mm (f_n 2.35 Hz)."
  ]
  coordinateSystem "ENU"
  basicTimeStep 8
  # Newton / MuJoCo. Every field below is READ on this path -- WorldInfo.contactProperties
  # is deliberately absent because coulombFriction is an ODE-path declaration and is NOT read.
  newtonSolver "mujoco"
  newtonGroundMu 1.2
  newtonCondim 6          # 3 (the stock value) never consults the rolling/torsional coefficients: a wheel would roll forever
  newtonCone "elliptic"
  newtonImpratio 10
  newtonRobotColliders TRUE   # REQUIRED: without it the chassis body gets a 1 mm placeholder shape and phases through geometry
  newtonNjmax 1024        # a 4-wheel vehicle needs ~32 rows; headroom is cheap and overflow is SILENT
  newtonNconmax 1024
}
Viewpoint {
  orientation -0.278945 0.120681 0.952694 2.359689
  position 5.615 -5.977 6.003
}
OmniSimSky { }
DEF SUN OmniSimSun { }
DEF SUN_MARKER OmniSimSunMarker { }

# ---- ground: one infinite Plane collider (the MuJoCo converter turns an
# ---- authored Plane boundingObject into the solver's ground plane).
DEF GROUND Solid {
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.66 0.55 0.38
        roughness 1
        metalness 0
      }
      geometry Plane {
        size 400 400
      }
    }
  ]
  name "ground"
  boundingObject Plane {
    size 400 400
  }
}

# ---- suspension excitation: three rounded bumps, crossed during the
# ---- controller's 3.4 m/s "bump-run" phase. Half-buried r = 0.30 cylinders
# ---- showing 0.05 m of crown, i.e. a 0.166 m long ramp per side.
DEF BUMP_1 Solid {
  translation 5 0 -0.25
  rotation 1 0 0 1.5708
  children [
    DEF BUMP_SHAPE Shape {
      appearance PBRAppearance {
        baseColor 0.52 0.43 0.30
        roughness 1
        metalness 0
      }
      geometry Cylinder {
        height 10
        radius 0.30
        subdivision 24
      }
    }
  ]
  name "bump_1"
  boundingObject Cylinder {
    height 10
    radius 0.30
  }
}
DEF BUMP_2 Solid {
  translation 6.5 0 -0.25
  rotation 1 0 0 1.5708
  children [
    USE BUMP_SHAPE
  ]
  name "bump_2"
  boundingObject Cylinder {
    height 10
    radius 0.30
  }
}
DEF BUMP_3 Solid {
  translation 8 0 -0.25
  rotation 1 0 0 1.5708
  children [
    USE BUMP_SHAPE
  ]
  name "bump_3"
  boundingObject Cylinder {
    height 10
    radius 0.30
  }
}

# ---- the vehicle. z = 0.58 is the design ride height: struts at exactly zero
# ---- deflection, tyres kissing z = 0. It settles by the predicted sag.
DEF OMNIDUNE OmniDune {
  translation 0 0 0.58
  rotation 0 0 1 0
  name "omnidune"
  controller "omnidune_driver"
}
