#OMNISIM R2025a utf8

# OmniDune -- a 200 m x 200 m dirt/desert racing course, expressed ENTIRELY as
# terrain elevation.  No props, no vehicle: one static Solid, one ElevationGrid.
#
# GENERATED -- do not hand-edit.  Regenerate with
#   python projects/robots/omnisim/omnidune/scripts/gen_dune_course.py --seed 20260826
# The same (seed, span, cells) gives a byte-identical file.
#
# WHY THE COLLIDER IS AN ElevationGrid.  An ElevationGrid boundingObject is the
# ONE collider in this engine that is not silently convexified: OmSolid dispatches
# it to OmNewtonBackend::addShapeHeightfield -> newton.Heightfield -> mjGEOM_HFIELD.
# Every other mesh collider goes through MuJoCo's convex-hull path, which would
# turn this basin into a featureless dome.  Verified PASS to 0.1 mm by OmniBench
# lane 4 (object.elevationgrid_terrain).
#
# GRID: 257 x 257 samples at 0.78125 m cell spacing -> a 200.0 x 200.0 m patch.
#   height[] carries exactly 66049 values (xDimension * yDimension).  ONE VALUE
#   SHORT AND THE RUNTIME REGISTERS NO HEIGHTFIELD AT ALL -- silently, with the
#   world still loading and printing PASS (omnisim_newton_runtime.py,
#   World.add_shape_heightfield).  The engine refuses > 4,000,000 samples; this
#   is 1.7% of that ceiling.
#
# THE RIM IS NOT DECORATION.  A newton heightfield is a finite patch with no skirt
# and no implicit floor beneath it, so a body that leaves the footprint falls for
# ever.  The terrain walls itself instead: beyond a Chebyshev radius of 87 m it
# climbs to +14 m by the patch edge.  Keep vehicles inside |x|, |y| < 87.
#
# THE TERRAIN IS STATIC BY CONSTRUCTION.  newton's add_shape_heightfield takes no
# body -- a heightfield is always world-attached, zero mass, zero inertia.  Do not
# add a Physics node to DUNE_COURSE and do not parent it to anything that moves.
#
# THE COURSE, counter-clockwise from the start/finish line (s = arclength, m):
#   s 0-26       flat start straight -- DEAD FLAT BY CONSTRUCTION.  The racing
#                line here is straight segment 0, whose curvature is exactly zero,
#                so it carries no bank; the grade is pinned and the micro-texture
#                masked out.  This is the world's ANALYTIC DATUM: every emitted
#                sample inside it is exactly 2.660 m, so a body dropped on the
#                start straight must rest at 2.660 + its half-extent.  The flat
#                patch is x in [-51.21, -29.21] at y = -72.00, +/- 5.0 m laterally.
#                Start grid: from (-53.21, -72.00) heading 0 deg.
#   s 40-100     the jump complex -- kicker face to a lip at +4.35 m (s = 65),
#                then the ground falls away to a -0.50 m gap and rises to a landing
#                knuckle at +2.60 m whose far side is the descending landing ramp.
#   corners      5 banked berms, R = 22/22/30/28/20 m.  tan(bank) = 0.36 * kappa * v^2 / g
#                at v = 16 m/s, clamped to 24 deg and tapered to zero at both
#                tangent points, so the straights stay flat.  Measured banking:
#                R22 23.1 deg; R30 17.4 deg; R28 18.5 deg; R20 24.0 deg; R22 23.1 deg.
#   rhythm       whoops 7 m x +/-0.42 m over 47 m; washboard 6 m x +/-0.22 m over 36 m; swells 19 m x +/-0.95 m over 50 m; rollers 14 m x +/-0.62 m over 65 m
#   lap length   498.27 m; racing surface 12 m wide plus a 4.5 m berm each side.
#
# HEIGHT RANGE -0.360 .. 21.712 m.  Terrain-only world -- add a vehicle in a
# sibling world, or spawn one here and RELOAD (a runtime-spawned body is not in
# the solver; see AGENTS.md scene/spawn).
#
# LIGHTING is the canonical recipe (docs/WORLD_RECIPE.md): OmniSimSky +
# DEF SUN OmniSimSun + DEF SUN_MARKER OmniSimSunMarker.  No hand-written
# Background / DirectionalLight, no TexturedBackground, no NightSky.

EXTERNPROTO "omnisim://projects/objects/backgrounds/protos/OmniSimSky.proto"
EXTERNPROTO "omnisim://projects/objects/lights/protos/OmniSimSun.proto"
EXTERNPROTO "omnisim://projects/objects/lights/protos/OmniSimSunMarker.proto"
EXTERNPROTO "omnisim://projects/appearances/protos/SandyGround.proto"
EXTERNPROTO "omnisim://projects/robots/omnisim/omnidune/protos/OmniDune.proto"

WorldInfo {
  title "OmniDune desert racing course"
  gravity 9.81
  basicTimeStep 8
  coordinateSystem "ENU"
  newtonSolver "mujoco"
  newtonStatics TRUE
  # Without this the Robot wrapper's own boundingObject is skipped and the
  # chassis collides with NOTHING -- only the wheels do. On a jump course that
  # means the buggy passes through terrain instead of bellying out. The engine
  # warns ("using sphere r=0.001 (Robot wrapper placeholder)") but still PASSes.
  newtonRobotColliders TRUE
  newtonGroundMu 1.2
  newtonCondim 6
  newtonCone "elliptic"
  newtonImpratio 10
  newtonNjmax 1024
  newtonNconmax 1024
}
Viewpoint {
  # Hero 3/4 rear of the car on the start straight, computed by look-at
  # (local +X forward, local +Z up), never eyeballed.
  orientation -0.093172 0.311441 0.945687 0.612770
  position -59.500 -78.500 6.400
  near 0.5
}
OmniSimSky {
}
DEF SUN OmniSimSun {
}
DEF SUN_MARKER OmniSimSunMarker {
}
