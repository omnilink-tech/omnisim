# ---------------------------------------------------------------------------
# THE VEHICLE.  Placed on the course's analytic datum: the start straight is
# dead flat at exactly 2.660 m, so the design ride height 0.58 puts the tyres
# kissing the surface with the struts at zero deflection -- z = 3.240.  The
# start grid documented in the header is (-53.21, -72.00) heading 0 deg; we sit
# at x = -50 to stay inside the guaranteed-flat patch [-51.21, -29.21] rather
# than in its taper.
#
# VERIFIED SEPARATELY, NOT YET AS AN ASSEMBLY.  The vehicle met all five criteria
# on flat ground (ride height -0.81 mm vs prediction, 57.8 m drive, 2.21 rad yaw,
# struts stroking 65-84 mm and returning to exact sag) and the terrain proved a
# native mjGEOM_HFIELD collider to 0.37 mm.  This file is their first pairing and
# has NOT been run.
# ---------------------------------------------------------------------------
DEF OMNIDUNE OmniDune {
  translation -50.000 -72.000 3.240
  rotation 0 0 1 0
  name "omnidune"
  controller "omnidune_driver"
}
