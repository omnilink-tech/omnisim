#OMNISIM R2025a utf8

# OmniTug 500 - REALISTIC WAREHOUSE mapping demo (physics).
# 24 x 16 m: selective pallet racking, loading dock, staging pallets, 2.8 m
# forklift aisles. Walls/racks/pallets are static Newton colliders; the rover
# is a dynamic Newton body (newtonRobotColliders). Run:
#   python scripts/dev/headless_runner.py \
#     projects/robots/omnisim/omnitug500/worlds/omnitug500_warehouse.omniworld --gui --realtime --duration 420

EXTERNPROTO "omnisim://projects/objects/backgrounds/protos/OmniSimSky.proto"
EXTERNPROTO "omnisim://projects/objects/lights/protos/OmniSimSun.proto"
EXTERNPROTO "omnisim://projects/objects/lights/protos/OmniSimSunMarker.proto"
EXTERNPROTO "omnisim://projects/appearances/protos/RoughConcrete.proto"
EXTERNPROTO "omnisim://projects/appearances/protos/Roughcast.proto"
EXTERNPROTO "omnisim://projects/appearances/protos/Cardboard.proto"
EXTERNPROTO "omnisim://projects/appearances/protos/RoughPine.proto"
EXTERNPROTO "omnisim://projects/appearances/protos/OldSteel.proto"

WorldInfo {
  basicTimeStep 16
  title "OmniTug 500 - Realistic Warehouse Mapping"
  newtonSolver "mujoco"
  newtonStatics TRUE          # walls + racks + pallets collide
  newtonRobotColliders TRUE   # rover chassis is a real collider
  newtonSubsteps 4
}

Viewpoint {
  orientation -0.278945 0.120681 0.952694 2.359689
  position 3.964 -11.069 3.958
  exposure 1.05
}

OmniSimSky { }
DEF SUN OmniSimSun { }
DEF SUN_MARKER OmniSimSunMarker { }

DEF FLOOR Solid {
  translation 0 0 -0.02
  physicsBackend "newton"
  children [ DEF FLOOR_SH Shape { appearance RoughConcrete { colorOverride 0.75 0.75 0.75 textureTransform TextureTransform { scale 14 9 } } geometry Box { size 26.4 17.4 0.04 } } ]
  name "floor"
  boundingObject USE FLOOR_SH
}

DEF LINE_P0 Solid {
  translation 0 -6.85 0.012
  children [ Shape { appearance PBRAppearance { baseColor 0.85 0.72 0.10 roughness 0.7 metalness 0.0 } geometry Box { size 24.0 0.1 0.006 } } ]
  name "line_p0"
}
