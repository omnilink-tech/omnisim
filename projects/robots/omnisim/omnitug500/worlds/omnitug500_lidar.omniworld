#OMNISIM R2025a utf8

# OmniTug 500 - LIVE LASER SCANNERS demo.
#
# The OMNITUG500's CAD (../urdf/omnitug500.urdf) carries two black safety-laser-scanner
# housings on DIAGONALLY OPPOSITE corners (the classic AMR layout: two ~270 deg
# scanners cover the full 360 deg). Measured from the mesh (part6 "black_trim_2",
# z 0.072..0.152 band) the two housings sit at, in the rover's local frame
# (forward = +Y, Z-up, origin at body centre):
#     front-right corner  (+0.290, +0.537, 0.131)
#     rear-left  corner   (-0.290, -0.536, 0.131)
#
# The URDF itself is VISUAL-ONLY and OmniSim's URDFRobot does not host device
# children cleanly, so the two real Lidar devices live on a co-located sidecar
# Robot (DEF SCANNERS) placed at the same spot, with each Lidar at the measured
# corner and aimed diagonally OUTWARD. An OmniSim Lidar looks along its
# local +X and sweeps the local X-Y plane, so we yaw each one to point away from
# the body: front-right -> +45 deg, rear-left -> +225 deg.
#
# Run it (rendering MUST be on - a Lidar is a render-based sensor):
#     python scripts/dev/headless_runner.py \
#        projects/robots/omnisim/omnitug500/worlds/omnitug500_lidar.omniworld --gui --duration 20
# The omnitug500_lidar controller writes the live scan to
# _scratch/omnitug500_lidar/scan.json every ~0.5 s.

EXTERNPROTO "omnisim://projects/objects/backgrounds/protos/OmniSimSky.proto"
EXTERNPROTO "omnisim://projects/objects/lights/protos/OmniSimSun.proto"
EXTERNPROTO "omnisim://projects/objects/lights/protos/OmniSimSunMarker.proto"

WorldInfo {
  basicTimeStep 16
  title "OmniTug 500 - Live Laser Scanners"
  info [
    "OMNITUG500 rover with its two corner safety laser scanners wired as real"
    "Lidar devices. The sidecar 'omnitug500_lidar' controller reads both scans"
    "and writes a fused top-down point cloud to _scratch/omnitug500_lidar/scan.json."
  ]
}

Viewpoint {
  orientation -0.278945 0.120681 0.952694 2.359689
  position 3.964 -4.219 3.958
  exposure 1.0
}

OmniSimSky { }
DEF SUN OmniSimSun { }
DEF SUN_MARKER OmniSimSunMarker { }

# --- Floor (10 x 8 m room) -------------------------------------------------
DEF FLOOR Solid {
  translation 0 0 -0.02
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.22 0.23 0.25
        roughness 0.9
        metalness 0
      }
      geometry Box {
        size 12 10 0.04
      }
    }
  ]
  name "floor"
  boundingObject Box {
    size 12 10 0.04
  }
}

# --- Room walls (asymmetric features so the scan is instantly readable) -----
# North wall (+Y), behind a couple of crates
DEF WALL_N Solid {
  translation 0 4 0.5
  children [
    Shape {
      appearance PBRAppearance { baseColor 0.78 0.76 0.72 roughness 0.95 }
      geometry Box { size 10 0.2 1.0 }
    }
  ]
  name "wall_north"
}
DEF WALL_S Solid {
  translation 0 -4 0.5
  children [
    Shape {
      appearance PBRAppearance { baseColor 0.78 0.76 0.72 roughness 0.95 }
      geometry Box { size 10 0.2 1.0 }
    }
  ]
  name "wall_south"
}
DEF WALL_E Solid {
  translation 5 0 0.5
  children [
    Shape {
      appearance PBRAppearance { baseColor 0.74 0.72 0.69 roughness 0.95 }
      geometry Box { size 0.2 8.2 1.0 }
    }
  ]
  name "wall_east"
}
DEF WALL_W Solid {
  translation -5 0 0.5
  children [
    Shape {
      appearance PBRAppearance { baseColor 0.74 0.72 0.69 roughness 0.95 }
      geometry Box { size 0.2 8.2 1.0 }
    }
  ]
  name "wall_west"
}

# --- Interior obstacles: distinctive, asymmetric, all tall enough to cross
#     the z=0.131 scan plane (each sits on the floor, height >= 0.6 m) --------
DEF OBST_CYL_FL Solid {            # cylinder, front-left
  translation -2.5 1.6 0.4
  children [
    Shape {
      appearance PBRAppearance { baseColor 0.85 0.3 0.1 roughness 0.7 }
      geometry Cylinder { radius 0.3 height 0.8 }
    }
  ]
  name "cyl_front_left"
}
DEF OBST_BOX_RR Solid {            # box, rear-right
  translation 2.8 -1.2 0.4
  children [
    Shape {
      appearance PBRAppearance { baseColor 0.2 0.4 0.85 roughness 0.7 }
      geometry Box { size 0.7 0.7 0.8 }
    }
  ]
  name "box_rear_right"
}
DEF OBST_CRATE_N Solid {          # long crate near the north wall
  translation 1.6 3.0 0.4
  children [
    Shape {
      appearance PBRAppearance { baseColor 0.55 0.45 0.3 roughness 0.85 }
      geometry Box { size 0.5 1.6 0.8 }
    }
  ]
  name "crate_north"
}
DEF OBST_PILLAR_RL Solid {        # thin pillar, rear-left
  translation -3.2 -2.6 0.45
  children [
    Shape {
      appearance PBRAppearance { baseColor 0.15 0.6 0.35 roughness 0.7 }
      geometry Cylinder { radius 0.18 height 0.9 }
    }
  ]
  name "pillar_rear_left"
}

# --- The OMNITUG500 rover (visual body), wheels on the floor, facing world +Y ----
DEF OMNITUG500 URDFRobot {
  url "../urdf/omnitug500.urdf"
  translation 0 0 0
  rotation 0 0 1 0
  name "OMNITUG500"
  controller "<none>"
}

# --- Sidecar Robot carrying the two REAL corner laser scanners --------------
# Co-located with the rover at the origin (same yaw=0), so the Lidar children
# sit exactly on the measured scanner housings and aim outward.
DEF SCANNERS Robot {
  translation 0 0 0
  rotation 0 0 1 0
  name "OMNITUG500_scanners"
  controller "omnitug500_lidar"
  supervisor TRUE
  children [
    # Top-down camera (forward = +X -> world -Z) for a 3D proof render of the
    # live coverage fans. Used only to save a still; the live view is the GUI.
    DEF TOPCAM Camera {
      translation 0 0 7
      rotation -0.5774 0.5774 0.5774 2.0944
      name "topcam"
      width 1100
      height 900
      fieldOfView 1.5
    }
    DEF SCAN_FR Lidar {
      translation 0.290 0.537 0.131
      rotation 0 0 1 0.7854      # look toward +X+Y (world 45 deg), outward
      name "scanner_front_right"
      horizontalResolution 512
      fieldOfView 3.0            # ~171 deg
      verticalFieldOfView 0.02
      numberOfLayers 1
      near 0.05
      minRange 0.06
      maxRange 12.0
      type "fixed"
    }
    DEF SCAN_RL Lidar {
      translation -0.290 -0.536 0.131
      rotation 0 0 1 3.9270      # look toward -X-Y (world 225 deg), outward
      name "scanner_rear_left"
      horizontalResolution 512
      fieldOfView 3.0
      verticalFieldOfView 0.02
      numberOfLayers 1
      near 0.05
      minRange 0.06
      maxRange 12.0
      type "fixed"
    }
  ]
}
