    <joint name="front_left_hip_y" type="revolute">
        <origin xyz="0.0 0.110945 0.0" rpy="0 0 0" />
        <axis xyz="0 1 0" />
        <parent link="front_left_hip" />
        <child link="front_left_upper_leg" />
        <dynamics damping="0.05"/>
        <!-- Widened hip_y for on-back self-righting; real OmniQuad's ROM is wider than the conservative range used here for stable standing. -->
        <limit effort="80" velocity="20" lower="-0.50" upper="3.20" />
        <!-- OmniSim importer extension: spawn at 0.30 (matches NOMINAL stand pose) regardless of the wider limits. -->
        <rest>0.30</rest>
