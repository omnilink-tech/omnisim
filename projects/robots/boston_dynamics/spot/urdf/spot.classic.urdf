<?xml version="1.0" ?>
<robot name="spot">
    <link name="body">
        <visual>
            <geometry>
                <mesh filename="package://spot/meshes/body.dae" />
            </geometry>
        </visual>
        <collision>
            <geometry>
                <mesh filename="package://spot/meshes/body_collision.stl" />
            </geometry>
        </collision>
    
        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <mass value="32.0"/>
            <!-- box 0.65 x 0.21 x 0.19 m, 32 kg -->
            <inertia ixx="0.20" ixy="0" ixz="0" iyy="1.14" iyz="0" izz="1.17"/>
        </inertial>
    </link>

    <link name="base_link"/>
    <joint name="base_link_joint" type="fixed">
        <origin xyz="0 0 0" rpy="0 0 0" />
        <parent link="base_link" />
        <child link="body" />
    </joint>

    <link name="front_rail"/>
    <joint name="front_rail_joint" type="fixed">
        <origin xyz="0.223 0 0.0805" rpy="0 0 0" />
        <parent link="body" />
        <child link="front_rail" />
    </joint>

    <link name="real_front_rail"/>
    <joint name="real_front_rail_joint" type="fixed">
        <origin xyz="0.2075 0 0.0805" rpy="0 0 0" />
        <parent link="body" />
        <child link="real_front_rail" />
    </joint>

    <link name="rear_rail"/>
    <joint name="rear_rail_joint" type="fixed">
        <origin xyz="-0.223 0 0.0805" rpy="0 0 0" />
        <parent link="body" />
        <child link="rear_rail" />
    </joint>

    <link name="real_rear_rail"/>
    <joint name="real_rear_rail_joint" type="fixed">
        <origin xyz="-0.415 0 0" rpy="0 0 0" />
        <parent link="real_front_rail" />
        <child link="real_rear_rail" />
    </joint>

    <link name="front_left_hip">
        <visual>
            <geometry>
                <mesh filename="package://spot/meshes/front_left_hip.dae" />
            </geometry>
        </visual>
        <collision>
            <geometry>
                <mesh filename="package://spot/meshes/front_left_hip_collision.stl" />
            </geometry>
        </collision>
    
        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <mass value="1.0"/>
            <!-- short cylinder, 1 kg, r=0.05 h=0.10 -->
            <inertia ixx="0.0011" ixy="0" ixz="0" iyy="0.0011" iyz="0" izz="0.00125"/>
        </inertial>
    </link>
    <joint name="front_left_hip_x" type="revolute">
        <origin xyz="0.29785 0.05500 0.00000" rpy="0 0 0" />
        <axis xyz="1 0 0" />
        <parent link="body" />
        <child link="front_left_hip" />
        <dynamics damping="0.05"/>
        <limit effort="80" velocity="20" lower="0.001" upper="0.60" />
    </joint>
    <link name="front_left_upper_leg">
        <visual>
            <geometry>
                <mesh filename="package://spot/meshes/front_left_upper_leg.dae" />
            </geometry>
        </visual>
        <collision>
            <geometry>
                <mesh filename="package://spot/meshes/front_left_upper_leg_collision.stl" />
            </geometry>
        </collision>
    
        <inertial>
            <origin xyz="0 0 -0.16" rpy="0 0 0"/>
            <mass value="1.5"/>
            <!-- slender bar 1.5 kg, 0.32 m long, along Z -->
            <inertia ixx="0.0128" ixy="0" ixz="0" iyy="0.0128" iyz="0" izz="0.00125"/>
        </inertial>
    </link>
    <joint name="front_left_hip_y" type="revolute">
        <origin xyz="0.0 0.110945 0.0" rpy="0 0 0" />
        <axis xyz="0 1 0" />
        <parent link="front_left_hip" />
        <child link="front_left_upper_leg" />
        <dynamics damping="0.05"/>
        <limit effort="80" velocity="20" lower="0.001" upper="0.60" />
    </joint>
    <link name="front_left_lower_leg">
        <visual>
            <geometry>
                <mesh filename="package://spot/meshes/front_left_lower_leg.dae" />
            </geometry>
        </visual>
        <collision>
            <origin xyz="0 0 -0.32" rpy="0 0 0"/>
            <geometry>
                <sphere radius="0.035"/>
            </geometry>
        </collision>
    
        <inertial>
            <origin xyz="0 0 -0.16" rpy="0 0 0"/>
            <mass value="0.8"/>
            <!-- slender bar 0.8 kg, 0.32 m long, along Z -->
            <inertia ixx="0.00682" ixy="0" ixz="0" iyy="0.00682" iyz="0" izz="0.0005"/>
        </inertial>
    </link>
    <joint name="front_left_knee" type="revolute">
        <origin xyz="0.025 0.000 -0.3205" rpy="0 0 0" />
        <axis xyz="0 1 0" />
        <parent link="front_left_upper_leg" />
        <child link="front_left_lower_leg" />
        <dynamics damping="0.05"/>
        <limit effort="80" velocity="20" lower="-1.20" upper="-0.01" />
    </joint>
    <link name="front_right_hip">
        <visual>
            <geometry>
                <mesh filename="package://spot/meshes/front_right_hip.dae" />
            </geometry>
        </visual>
        <collision>
            <geometry>
                <mesh filename="package://spot/meshes/front_right_hip_collision.stl" />
