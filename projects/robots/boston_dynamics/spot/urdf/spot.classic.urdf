            <mass value="1.0"/>
            <!-- short cylinder, 1 kg, r=0.05 h=0.10 -->
            <inertia ixx="0.0011" ixy="0" ixz="0" iyy="0.0011" iyz="0" izz="0.00125"/>
        </inertial>
    </link>
    <joint name="front_right_hip_x" type="revolute">
        <origin xyz="0.29785 -0.05500 0.00000" rpy="0 0 0" />
        <axis xyz="1 0 0" />
        <parent link="body" />
        <child link="front_right_hip" />
        <dynamics damping="0.05"/>
        <limit effort="80" velocity="20" lower="-0.60" upper="-0.001" />
    </joint>
