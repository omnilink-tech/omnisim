#OMNISIM R2025a utf8

# Deep Robotics X30 -- terrain crawl.
#
# X30 crawls 10 m of rolling terrain (2-6 cm hills) on real contact physics: a scripted, statically stable creep gait through leg IK, no supervisor pin, no policy.
# Controller: controllers/deep_robotics_crawl (the Unitree B2 crawl model of
# projects/policies/control/gait/b2_crawl_gait.py re-parameterised for this
# leg geometry; its docstring says exactly what it is and is not).
# The terrain is an ElevationGrid whose hills grow from 2 cm to 6 cm along +x;
# the robot starts on flat floor 1.5 m before it. newtonSubsteps 8 +
# newtonCompoundColliders TRUE + newtonGroundMu 2 is the stance recipe from
# PROVENANCE.md.
# It stops and holds its stance 1.5 m past the strip (--stop-x 11.5).
# Watch the progress lines: [deep_robotics_crawl] t=... x=... m travelled.

EXTERNPROTO "omnisim://projects/objects/backgrounds/protos/OmniSimSky.proto"
EXTERNPROTO "omnisim://projects/objects/lights/protos/OmniSimSun.proto"
EXTERNPROTO "omnisim://projects/objects/lights/protos/OmniSimSunMarker.proto"

WorldInfo {
  basicTimeStep 8
  title "Deep Robotics X30 -- terrain crawl"
  info [
    "X30 crawls 10 m of rolling terrain (2-6 cm hills) on real contact physics: a scripted, statically stable creep gait through leg IK, no supervisor pin, no policy."
    "Package: projects/robots/deep_robotics/ (BSD-3-Clause, DeepRoboticsLab)."
  ]
  contactProperties [
    ContactProperties {
      material1 "default"
      material2 "default"
      coulombFriction [ 2.0 ]
      bounce 0.0
    }
  ]
  newtonGroundMu 2
  newtonSubsteps 8
  newtonCompoundColliders TRUE
}
Viewpoint {
  orientation -0.140674 0.324707 0.935295 0.867559
  position -2.4 -3.2 1.6
  follow "x30"
  followType "Tracking Shot"
  followSmoothness 0.4
}
OmniSimSky { }
DEF SUN OmniSimSun { }
DEF SUN_MARKER OmniSimSunMarker { }

DEF FLOOR Solid {
  translation 10 0 -0.5
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.24 0.25 0.27
        roughness 0.85
        metalness 0
      }
      geometry Box {
        size 40 12 1.0
      }
    }
  ]
  name "floor"
  boundingObject Box {
    size 40 12 1.0
  }
}

