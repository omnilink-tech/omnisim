  "macros": {
    "START_PRINT": {
      "gcode": [
        "G28 IF_NOT_HOMED",
        "QUAD_GANTRY_LEVEL",
        "BED_MESH_CALIBRATE ADAPTIVE=1"
      ],
      "note": "Heats to the targets already set, levels the gantry and probes a mesh. Probing is not modelled: it takes no time in the twin and the bed is assumed flat and level."
