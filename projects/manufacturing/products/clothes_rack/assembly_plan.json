 "captions": [
  [
   5.0,
   13.0,
   "1. Rivet an M8 nut into each base tube, 270 mm each side of its centre, and screw in a levelling foot"
  ],
  [
   13.0,
   18.0,
   "2. Seat each base tube in a connector half, on the outside"
  ],
  [
   18.0,
   25.0,
   "3. Stand an upright in each connector's vertical bore, down onto the base tube"
  ],
  [
   25.0,
   30.0,
   "4. Close each foot connector with a second half: both halves are the same CNC part"
  ],
  [
   30.0,
   37.26,
   "5. Four M6 x 55 bolts per connector, washers both sides, nyloc nuts: finger-tight for now"
  ],
  [
   37.26,
   42.26,
   "6. Hold the back half of a top connector on each upright's top"
  ],
  [
   42.26,
   48.26,
   "7. Lay the top bar in both connectors, its ends 10 mm out of each"
  ],
  [
   48.26,
   60.02,
   "8. Close the top connectors and bolt them like the feet"
  ],
  [
   60.02,
   65.02,
   "9. Check it is square (equal diagonals), then torque all 16 bolts to 5 N m, crosswise"
  ],
  [
   65.02,
   70.02,
   "10. Tap in the six end caps; set the feet so the rack stands level"
  ],
  [
   70.02,
   10070.02,
   "Done: 1200 x 600 x 1500 mm, 6.1 kg, made for 20 kg of clothes on the bar"
  ]
