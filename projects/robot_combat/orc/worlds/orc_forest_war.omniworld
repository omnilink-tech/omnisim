        children [
          Shape { appearance PBRAppearance { baseColor 0.40 0.40 0.42 metalness 0 roughness 1 } geometry Box { size 0.50 0.05 0.05 } }
          Solid { translation 0.22 0 0 name "hammer_head" children [ Shape { appearance PBRAppearance { baseColor 0.18 0.18 0.20 metalness 0 roughness 1 } geometry Box { size 0.10 0.10 0.10 } } ] }
        ]
        boundingObject Box { size 0.50 0.05 0.05 }
        physics Physics { density -1 mass 4.0 }
      }
    }
  ]
  boundingObject Box { size 0.65 0.42 0.16 }
  physics Physics { density -1 mass 28.0 }
}

# ===========================================================================
