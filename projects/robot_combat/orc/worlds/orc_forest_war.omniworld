      ]
      endPoint DEF BLUE_HAMMER_RL_WHEEL Solid {
        translation -0.24 0.24 -0.05
        rotation 1 0 0 1.5708
        name "rear_left_wheel"
        children [ Shape { appearance PBRAppearance { baseColor 0.08 0.08 0.08 metalness 0 roughness 1 } geometry Cylinder { height 0.05 radius 0.09 } } ]
        boundingObject Cylinder { height 0.05 radius 0.09 }
