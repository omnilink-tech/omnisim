# ===========================================================================
# Damage + match director — 6-fighter free-for-all on the forest field.
# Arena half-extent 20 m (40 m square footprint). 360 s timer.
# ===========================================================================
DEF DIRECTOR Robot {
  name "damage_director"
  translation 0 0 14
  controller "battlebot_damage_director"
  customData "{\"fighters\": [\"blue_wedge\", \"blue_disc\", \"blue_hammer\", \"red_bar\", \"red_flipper\", \"red_horizontal\"], \"arena_size\": 40.0, \"fail_wheels\": 3, \"contact_gate_m\": 1.4, \"timer_s\": 360.0, \"output\": \"_scratch/orc_forest_war.json\", \"hp\": {\"chassis\": 120.0, \"wheel\": 10.0, \"weapon\": 25.0}, \"impulse_threshold_J\": {\"chassis\": 6.0, \"wheel\": 0.4, \"weapon\": 3.0}}"
  supervisor TRUE
  children [
    Group {
    }
  ]
}
