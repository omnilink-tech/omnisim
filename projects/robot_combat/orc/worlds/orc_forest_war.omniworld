# ===========================================================================
# BLUE HAMMER — overhead hammer arm, pulse mode. Spawns west-north.
# ===========================================================================
DEF BLUE_HAMMER Robot {
  translation -12.0 4.0 0.25
  rotation 0 0 1 0
  name "blue_hammer"
  controller "battlebot_brain"
  controllerArgs [ "--opponent" "red_horizontal" "--strategy" "opportunist" "--weapon-mode" "pulse" "--pulse-range" "1.3" ]
  supervisor TRUE
  physicsBackend "newton"
