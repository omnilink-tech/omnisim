#OMNISIM R2025a utf8

# ORC Forest War — 3v3 combat across a 40 m forest battlefield.
#
# Open mixed-conifer biome borrowed from the cinematic forest env
# (environments/forest.omniworld) but tuned for combat: bigger central
# clearing, perimeter tree patches as cover, longer match timer
# (6 minutes). All five BattleBot weapon archetypes are represented
# across the six fighters.
#
# Roster (paired by --opponent flag, but free-targeting in practice):
#
#   BLUE team (spawn west)
#     blue_wedge    wedge tank             control      vs  red_bar
#     blue_disc     vertical disc spinner  aggressor    vs  red_flipper
#     blue_hammer   overhead hammer arm    opportunist  vs  red_horizontal
#
#   RED team (spawn east)
#     red_bar         horizontal bar spinner (Tombstone-class)
#     red_flipper     pneumatic front flipper (--weapon-mode pulse)
#     red_horizontal  top-mounted horizontal disc
#
# Win condition: last bot still moving wins. Match cap 360 s.
# Director also calls OOTA on any bot whose |x|>20 or |y|>20.

# The forest environment is composed in via the OmniSim `#include`
# preprocessor — see docs/guide/world-include-directive.md. We splice
# in the full cinematic forest (hero trees, rocks, ferns, mushrooms,
# path, dappled lighting, fog) from the standard environment world,
# then layer the 6 ORC bots and the damage director on top.
#
# v1 limitation: the EXTERNPROTO declarations the included file needs
# have to be lifted up here too because the PROTO manager scans this
# file BEFORE the tokenizer expands the include. Mirror the exact
# EXTERNPROTO list from environments/forest.omniworld verbatim.
EXTERNPROTO "omnisim://projects/objects/floors/protos/UnevenTerrain.proto"
EXTERNPROTO "omnisim://projects/appearances/protos/Grass.proto"
EXTERNPROTO "omnisim://projects/appearances/protos/Soil.proto"
EXTERNPROTO "omnisim://projects/appearances/protos/DryMud.proto"
EXTERNPROTO "omnisim://projects/appearances/protos/RoughOak.proto"
EXTERNPROTO "omnisim://projects/appearances/protos/RoughPine.proto"
EXTERNPROTO "omnisim://projects/appearances/protos/Plaster.proto"
EXTERNPROTO "omnisim://projects/objects/trees/protos/Oak.proto"
EXTERNPROTO "omnisim://projects/objects/trees/protos/Pine.proto"
EXTERNPROTO "omnisim://projects/objects/trees/protos/BigSassafras.proto"
EXTERNPROTO "omnisim://projects/objects/trees/protos/Sassafras.proto"
EXTERNPROTO "omnisim://projects/objects/trees/protos/Cypress.proto"
EXTERNPROTO "omnisim://projects/objects/trees/protos/SimpleTree.proto"
EXTERNPROTO "omnisim://projects/objects/rocks/protos/Rock.proto"
EXTERNPROTO "omnisim://projects/objects/backgrounds/protos/OmniSimSky.proto"
EXTERNPROTO "omnisim://projects/objects/lights/protos/OmniSimSun.proto"
EXTERNPROTO "omnisim://projects/objects/lights/protos/OmniSimSunMarker.proto"

# Splice in the cinematic forest env. Its WorldInfo and Viewpoint are
# stripped by the preprocessor's singleton filter so they don't
# collide with the ones declared just below.
#include "omnisim://projects/samples/demos/worlds/environments/forest.omniworld"

WorldInfo {
  basicTimeStep 4
  title "ORC Forest War — 3v3 Open Combat"
  contactProperties [
    ContactProperties {
      material1 "default"
      material2 "default"
      coulombFriction [ 0.9 ]
      bounce 0.05
      bounceVelocity 0.5
    }
  ]
  # Newton combat config. MuJoCo solver REQUIRED -- the default XPBD solver structurally
  # cannot drive a multi-wheel rover (lateral left/right wheel pairs lock; proven in pure
  # Python via scripts/dev/wheel_model_diff.py). MuJoCo + ODE drive them; MuJoCo also gives
  # the robust frictional contact combat ramming needs.
  newtonSolver "mujoco"
  # Give each bot's chassis Box a real collider so ramming registers chassis contacts
  # (without it a Robot wrapper gets a 1 mm placeholder and bots phase through each other):
  newtonRobotColliders TRUE
  # 4 sub-steps keep high closing-speed ram impacts from diverging XPBD to NaN:
  newtonSubsteps 4
}

# Combat-cinematic viewpoint: oblique overhead from south-east at
# ~32 m altitude so the whole battlefield is visible. Overrides the
# forest env's eye-level viewpoint (stripped by the include splicer).
Viewpoint {
  orientation 0.000000 1.000000 0.000000 1.570796
  position 0.000 0.000 68.918
}

# ===========================================================================
# BLUE WEDGE — defensive tank. Spawns west-south.
# ===========================================================================
DEF BLUE_WEDGE Robot {
  translation -12.0 -4.0 0.25
  rotation 0 0 1 0
  name "blue_wedge"
  controller "battlebot_brain"
  controllerArgs [ "--opponent" "red_bar" "--strategy" "control" ]
  supervisor TRUE
  physicsBackend "newton"
  children [
    Shape {
      appearance PBRAppearance { baseColor 0.10 0.25 0.65 metalness 0 roughness 1 }
      geometry Box { size 0.70 0.50 0.16 }
    }
    DEF BLUE_WEDGE_FL_JOINT HingeJoint {
      jointParameters HingeJointParameters { axis 0 1 0 anchor 0.25 0.27 -0.05 }
      device [
        RotationalMotor { name "front_left_wheel_motor" maxVelocity 28 maxTorque 25 }
        PositionSensor { name "front_left_wheel_sensor" }
      ]
      endPoint DEF BLUE_WEDGE_FL_WHEEL Solid {
        translation 0.25 0.27 -0.05
        rotation 1 0 0 1.5708
        name "front_left_wheel"
        children [ Shape { appearance PBRAppearance { baseColor 0.08 0.08 0.08 metalness 0 roughness 1 } geometry Cylinder { height 0.06 radius 0.10 } } ]
        boundingObject Cylinder { height 0.06 radius 0.10 }
        physics Physics { density -1 mass 2.0 }
      }
    }
    DEF BLUE_WEDGE_FR_JOINT HingeJoint {
      jointParameters HingeJointParameters { axis 0 1 0 anchor 0.25 -0.27 -0.05 }
      device [
        RotationalMotor { name "front_right_wheel_motor" maxVelocity 28 maxTorque 25 }
        PositionSensor { name "front_right_wheel_sensor" }
      ]
      endPoint DEF BLUE_WEDGE_FR_WHEEL Solid {
        translation 0.25 -0.27 -0.05
        rotation 1 0 0 1.5708
        name "front_right_wheel"
        children [ Shape { appearance PBRAppearance { baseColor 0.08 0.08 0.08 metalness 0 roughness 1 } geometry Cylinder { height 0.06 radius 0.10 } } ]
        boundingObject Cylinder { height 0.06 radius 0.10 }
        physics Physics { density -1 mass 2.0 }
      }
    }
    DEF BLUE_WEDGE_RL_JOINT HingeJoint {
      jointParameters HingeJointParameters { axis 0 1 0 anchor -0.25 0.27 -0.05 }
      device [
        RotationalMotor { name "rear_left_wheel_motor" maxVelocity 28 maxTorque 25 }
        PositionSensor { name "rear_left_wheel_sensor" }
      ]
      endPoint DEF BLUE_WEDGE_RL_WHEEL Solid {
        translation -0.25 0.27 -0.05
        rotation 1 0 0 1.5708
        name "rear_left_wheel"
        children [ Shape { appearance PBRAppearance { baseColor 0.08 0.08 0.08 metalness 0 roughness 1 } geometry Cylinder { height 0.06 radius 0.10 } } ]
        boundingObject Cylinder { height 0.06 radius 0.10 }
        physics Physics { density -1 mass 2.0 }
      }
    }
    DEF BLUE_WEDGE_RR_JOINT HingeJoint {
      jointParameters HingeJointParameters { axis 0 1 0 anchor -0.25 -0.27 -0.05 }
      device [
        RotationalMotor { name "rear_right_wheel_motor" maxVelocity 28 maxTorque 25 }
        PositionSensor { name "rear_right_wheel_sensor" }
      ]
      endPoint DEF BLUE_WEDGE_RR_WHEEL Solid {
        translation -0.25 -0.27 -0.05
        rotation 1 0 0 1.5708
        name "rear_right_wheel"
        children [ Shape { appearance PBRAppearance { baseColor 0.08 0.08 0.08 metalness 0 roughness 1 } geometry Cylinder { height 0.06 radius 0.10 } } ]
        boundingObject Cylinder { height 0.06 radius 0.10 }
        physics Physics { density -1 mass 2.0 }
      }
    }
    DEF BLUE_WEDGE_WEAPON Solid {
      translation 0.30 0 -0.06
      name "weapon_wedge"
      children [ Shape { appearance PBRAppearance { baseColor 0.85 0.85 0.88 metalness 0 roughness 1 } geometry Box { size 0.20 0.45 0.04 } } ]
      boundingObject Box { size 0.20 0.45 0.04 }
      physics Physics { density -1 mass 1.5 }
    }
  ]
  boundingObject Box { size 0.70 0.50 0.16 }
  physics Physics { density -1 mass 25.0 }
}

