    Shape {
      appearance PBRAppearance { baseColor 0.55 0.05 0.05 metalness 0 roughness 1 }
      geometry Box { size 0.75 0.45 0.13 }
    }
    DEF RED_BAR_FL_JOINT HingeJoint {
      jointParameters HingeJointParameters { axis 0 1 0 anchor 0.30 0.25 -0.05 }
      device [
        RotationalMotor { name "front_left_wheel_motor" maxVelocity 30 maxTorque 30 }
