        boundingObject Cylinder { height 0.05 radius 0.09 }
        physics Physics { density -1 mass 1.5 }
      }
    }
    # Overhead hammer arm — anchored above the chassis, swings down forward.
    DEF BLUE_HAMMER_WEAPON_JOINT HingeJoint {
      jointParameters HingeJointParameters { axis 0 1 0 anchor 0 0 0.12 minStop -1.6 maxStop 0.2 }
      device [
        RotationalMotor { name "weapon_motor" maxVelocity 25 maxTorque 500 }
        PositionSensor { name "weapon_sensor" }
      ]
      endPoint DEF BLUE_HAMMER_WEAPON Solid {
        translation 0 0 0.12
