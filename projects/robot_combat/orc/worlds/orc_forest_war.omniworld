    DEF BLUE_HAMMER_RL_JOINT HingeJoint {
      jointParameters HingeJointParameters { axis 0 1 0 anchor -0.24 0.24 -0.05 }
      device [
        RotationalMotor { name "rear_left_wheel_motor" maxVelocity 28 maxTorque 25 }
