# ===========================================================================
# BLUE ALPHA — wedge tank, protector. Targets the RED queen.
# ===========================================================================
DEF BLUE_ALPHA Robot {
  translation -5.0 -2.0 0.25
  rotation 0 0 1 0
  name "blue_alpha"
  controller "battlebot_brain"
  controllerArgs [ "--opponent" "red_queen" "--strategy" "control" ]
  supervisor TRUE
  physicsBackend "newton"
  children [
    Shape {
      appearance PBRAppearance { baseColor 0.10 0.20 0.55 metalness 0 roughness 1 }
      geometry Box { size 0.70 0.50 0.16 }
    }
    Transform {
      translation 0 0.255 0.02
      children [ Shape {
        appearance PBRAppearance { baseColor 0.50 0.65 0.95 metalness 0 roughness 1 }
        geometry Box { size 0.65 0.01 0.04 }
      } ]
    }
    Transform {
      translation 0 -0.255 0.02
      children [ Shape {
        appearance PBRAppearance { baseColor 0.50 0.65 0.95 metalness 0 roughness 1 }
        geometry Box { size 0.65 0.01 0.04 }
      } ]
    }
    DEF BLUE_ALPHA_FL_JOINT HingeJoint {
      jointParameters HingeJointParameters { axis 0 1 0 anchor 0.25 0.27 -0.05 }
      device [
        RotationalMotor { name "front_left_wheel_motor" maxVelocity 28 maxTorque 25 }
        PositionSensor { name "front_left_wheel_sensor" }
      ]
      endPoint DEF BLUE_ALPHA_FL_WHEEL Solid {
        translation 0.25 0.27 -0.05
        rotation 1 0 0 1.5708
        name "front_left_wheel"
        children [ Shape { appearance PBRAppearance { baseColor 0.08 0.08 0.08 metalness 0 roughness 1 } geometry Cylinder { height 0.06 radius 0.10 } } ]
