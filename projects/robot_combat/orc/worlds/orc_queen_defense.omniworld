# ===========================================================================
# Damage + match director — queens mode. Team whose queen survives wins.
# ===========================================================================
DEF DIRECTOR Robot {
  name "damage_director"
  translation 0 0 9
  controller "battlebot_damage_director"
  customData "{\"fighters\": [\"blue_queen\", \"blue_alpha\", \"blue_bravo\", \"red_queen\", \"red_alpha\", \"red_bravo\"], \"teams\": {\"blue\": [\"blue_queen\", \"blue_alpha\", \"blue_bravo\"], \"red\": [\"red_queen\", \"red_alpha\", \"red_bravo\"]}, \"queens\": {\"blue\": \"blue_queen\", \"red\": \"red_queen\"}, \"arena_size\": 20.0, \"fail_wheels\": 3, \"contact_gate_m\": 1.4, \"timer_s\": 300.0, \"output\": \"_scratch/orc_queen_defense.json\", \"hp\": {\"chassis\": 120.0, \"wheel\": 10.0, \"weapon\": 25.0}, \"impulse_threshold_J\": {\"chassis\": 6.0, \"wheel\": 0.4, \"weapon\": 3.0}}"
  supervisor TRUE
  children [
    Group {
    }
  ]
}
