        name "rear_right_wheel"
        children [ Shape {
          appearance PBRAppearance { baseColor 0.08 0.08 0.08 metalness 0 roughness 1 }
          geometry Cylinder { height 0.06 radius 0.10 }
        } ]
        boundingObject Cylinder { height 0.06 radius 0.10 }
        physics Physics { density -1 mass 2.0 }
      }
    }
    # Horizontal bar spinner overhead.
    DEF RED_ALPHA_WEAPON_JOINT HingeJoint {
      jointParameters HingeJointParameters { axis 0 0 1 anchor 0 0 0.12 }
      device [
        RotationalMotor { name "weapon_motor" maxVelocity 65 maxTorque 200 }
        PositionSensor { name "weapon_sensor" }
      ]
      endPoint DEF RED_ALPHA_WEAPON Solid {
        translation 0 0 0.12
        name "weapon_bar"
        children [
          Shape {
            appearance PBRAppearance { baseColor 0.78 0.78 0.80 metalness 0 roughness 1 }
            geometry Box { size 1.00 0.05 0.04 }
          }
          Transform {
            translation 0.45 0 0
            children [ Shape {
              appearance PBRAppearance { baseColor 0.95 0.20 0.05 metalness 0 roughness 1 }
              geometry Box { size 0.08 0.07 0.06 }
            } ]
          }
          Transform {
            translation -0.45 0 0
            children [ Shape {
