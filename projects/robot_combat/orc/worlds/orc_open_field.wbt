#VRML_SIM R2025a utf8

# ORC Open Field — 2v2 first demo of Open Robot Combat.
#
# An open 20 m x 20 m arena with scattered cover blocks instead of a
# fenced cage. Two teams of two bots each — paired opponents but free
# to engage anyone they reach. Different weapon archetypes per slot
# to put the asymmetric matchups on display.
#
# Team BLUE (west spawn)
#   blue_alpha  — wedge tank (control strategy, defensive)
#   blue_bravo  — vertical disc spinner (aggressor)
#
# Team RED (east spawn)
#   red_alpha   — horizontal bar spinner (aggressor)
#   red_bravo   — pneumatic flipper (opportunist, pulse mode)
#
# Pairings (each bot's --opponent flag):
#   blue_alpha <-> red_alpha   (wedge tank vs bar spinner)
#   blue_bravo <-> red_bravo   (disc spinner vs flipper)
#
# Same damage director + brain controllers as the BattleBots league.
# DEF labels: <BOTNAME>_FL_WHEEL / ..._WEAPON.

EXTERNPROTO "omnisim://projects/objects/floors/protos/Floor.proto"
EXTERNPROTO "omnisim://projects/objects/solids/protos/SolidBox.proto"
EXTERNPROTO "omnisim://projects/objects/backgrounds/protos/OmniSimSky.proto"
EXTERNPROTO "omnisim://projects/objects/lights/protos/OmniSimSun.proto"
EXTERNPROTO "omnisim://projects/objects/lights/protos/OmniSimSunMarker.proto"

WorldInfo {
  basicTimeStep 4
  title "ORC Open Field — 2v2 Open Combat"
  contactProperties [
    ContactProperties {
      material1 "default"
      material2 "default"
      coulombFriction [ 0.9 ]
      bounce 0.05
      bounceVelocity 0.5
    }
  ]
  # Newton combat config. MuJoCo solver REQUIRED -- the default XPBD solver structurally
  # cannot drive a multi-wheel rover (lateral left/right wheel pairs lock; proven in pure
  # Python via scripts/dev/wheel_model_diff.py). MuJoCo + ODE drive them; MuJoCo also gives
  # the robust frictional contact combat ramming needs.
  newtonSolver "mujoco"
  # Register arena walls as collision surfaces, else bots drive through them:
  newtonStatics TRUE
  # Give each bot's chassis Box a real collider so ramming registers chassis contacts
  # (without it a Robot wrapper gets a 1 mm placeholder and bots phase through each other):
  newtonRobotColliders TRUE
  # 4 sub-steps keep high closing-speed ram impacts from diverging XPBD to NaN:
  newtonSubsteps 4
}
Viewpoint {
  orientation -0.5773 0.5773 0.5773 2.0944
  position 0 0 25
}
OmniSimSky { }
DEF SUN OmniSimSun { }
DEF SUN_MARKER OmniSimSunMarker { }
DirectionalLight {
  direction -0.5 0.4 -0.6
  color 0.85 0.88 1.0
  intensity 1.4
  ambientIntensity 0.0
  castShadows FALSE
}

# ===========================================================================
# Arena — open 20 m square with scattered cover blocks. No perimeter
# wall; bots that drive off the edge OOTA out of bounds (the damage
# director ends the match for any bot whose |x|>10 or |y|>10).
# ===========================================================================
Floor {
  size 20 20
  tileSize 1.0 1.0
  appearance PBRAppearance {
    baseColor 0.22 0.22 0.24
    metalness 0
    roughness 1
  }
}

# Centre pillar — large concrete block that splits the arena and
# forces bots to choose a side.
SolidBox {
  translation 0 0 0.75
  name "cover_center"
  size 2.0 2.0 1.5
  appearance PBRAppearance {
    baseColor 0.50 0.50 0.52
    metalness 0
    roughness 1
  }
}

# Four mid-range cover blocks at NE / NW / SE / SW.
SolidBox {
  translation 4 4 0.5
  name "cover_ne"
  size 1.6 0.6 1.0
  appearance PBRAppearance { baseColor 0.50 0.50 0.52 metalness 0 roughness 1 }
}
SolidBox {
  translation -4 4 0.5
  name "cover_nw"
  size 0.6 1.6 1.0
  appearance PBRAppearance { baseColor 0.50 0.50 0.52 metalness 0 roughness 1 }
}
SolidBox {
  translation 4 -4 0.5
  name "cover_se"
  size 0.6 1.6 1.0
  appearance PBRAppearance { baseColor 0.50 0.50 0.52 metalness 0 roughness 1 }
}
SolidBox {
  translation -4 -4 0.5
  name "cover_sw"
  size 1.6 0.6 1.0
  appearance PBRAppearance { baseColor 0.50 0.50 0.52 metalness 0 roughness 1 }
}

# Two long flanking walls at +-7 m on Y, creating channels.
SolidBox {
  translation 0 7 0.4
  name "wall_north"
  size 3.0 0.4 0.8
  appearance PBRAppearance { baseColor 0.40 0.40 0.42 metalness 0 roughness 1 }
}
SolidBox {
  translation 0 -7 0.4
  name "wall_south"
  size 3.0 0.4 0.8
  appearance PBRAppearance { baseColor 0.40 0.40 0.42 metalness 0 roughness 1 }
}

# ===========================================================================
# BLUE ALPHA — wedge tank, control strategy. Spawns west-south.
# ===========================================================================
DEF BLUE_ALPHA Robot {
  translation -7.0 -3.0 0.25
  rotation 0 0 1 0
  name "blue_alpha"
  controller "battlebot_brain"
  controllerArgs [ "--opponent" "red_alpha" "--strategy" "control" ]
  supervisor TRUE
  physicsBackend "newton"
  children [
    # Chassis — dark blue with light side stripes.
    Shape {
      appearance PBRAppearance { baseColor 0.10 0.20 0.55 metalness 0 roughness 1 }
      geometry Box { size 0.70 0.50 0.16 }
    }
    Transform {
      translation 0 0.255 0.02
      children [ Shape {
        appearance PBRAppearance { baseColor 0.50 0.65 0.95 metalness 0 roughness 1 }
        geometry Box { size 0.65 0.01 0.04 }
      } ]
    }
    Transform {
      translation 0 -0.255 0.02
      children [ Shape {
        appearance PBRAppearance { baseColor 0.50 0.65 0.95 metalness 0 roughness 1 }
        geometry Box { size 0.65 0.01 0.04 }
      } ]
    }
    # 4 wheels.
    DEF BLUE_ALPHA_FL_JOINT HingeJoint {
      jointParameters HingeJointParameters { axis 0 1 0 anchor 0.25 0.27 -0.05 }
      device [
        RotationalMotor { name "front_left_wheel_motor" maxVelocity 28 maxTorque 25 }
        PositionSensor { name "front_left_wheel_sensor" }
      ]
      endPoint DEF BLUE_ALPHA_FL_WHEEL Solid {
        translation 0.25 0.27 -0.05
        rotation 1 0 0 1.5708
        name "front_left_wheel"
        children [ Shape {
          appearance PBRAppearance { baseColor 0.08 0.08 0.08 metalness 0 roughness 1 }
          geometry Cylinder { height 0.06 radius 0.10 }
        } ]
        boundingObject Cylinder { height 0.06 radius 0.10 }
        physics Physics { density -1 mass 2.0 }
      }
    }
    DEF BLUE_ALPHA_FR_JOINT HingeJoint {
      jointParameters HingeJointParameters { axis 0 1 0 anchor 0.25 -0.27 -0.05 }
      device [
        RotationalMotor { name "front_right_wheel_motor" maxVelocity 28 maxTorque 25 }
        PositionSensor { name "front_right_wheel_sensor" }
      ]
      endPoint DEF BLUE_ALPHA_FR_WHEEL Solid {
        translation 0.25 -0.27 -0.05
        rotation 1 0 0 1.5708
        name "front_right_wheel"
        children [ Shape {
          appearance PBRAppearance { baseColor 0.08 0.08 0.08 metalness 0 roughness 1 }
          geometry Cylinder { height 0.06 radius 0.10 }
        } ]
        boundingObject Cylinder { height 0.06 radius 0.10 }
        physics Physics { density -1 mass 2.0 }
      }
    }
    DEF BLUE_ALPHA_RL_JOINT HingeJoint {
      jointParameters HingeJointParameters { axis 0 1 0 anchor -0.25 0.27 -0.05 }
      device [
        RotationalMotor { name "rear_left_wheel_motor" maxVelocity 28 maxTorque 25 }
        PositionSensor { name "rear_left_wheel_sensor" }
      ]
      endPoint DEF BLUE_ALPHA_RL_WHEEL Solid {
        translation -0.25 0.27 -0.05
        rotation 1 0 0 1.5708
        name "rear_left_wheel"
        children [ Shape {
          appearance PBRAppearance { baseColor 0.08 0.08 0.08 metalness 0 roughness 1 }
          geometry Cylinder { height 0.06 radius 0.10 }
        } ]
        boundingObject Cylinder { height 0.06 radius 0.10 }
        physics Physics { density -1 mass 2.0 }
      }
    }
    DEF BLUE_ALPHA_RR_JOINT HingeJoint {
      jointParameters HingeJointParameters { axis 0 1 0 anchor -0.25 -0.27 -0.05 }
      device [
        RotationalMotor { name "rear_right_wheel_motor" maxVelocity 28 maxTorque 25 }
        PositionSensor { name "rear_right_wheel_sensor" }
      ]
      endPoint DEF BLUE_ALPHA_RR_WHEEL Solid {
        translation -0.25 -0.27 -0.05
        rotation 1 0 0 1.5708
        name "rear_right_wheel"
        children [ Shape {
          appearance PBRAppearance { baseColor 0.08 0.08 0.08 metalness 0 roughness 1 }
          geometry Cylinder { height 0.06 radius 0.10 }
        } ]
        boundingObject Cylinder { height 0.06 radius 0.10 }
        physics Physics { density -1 mass 2.0 }
      }
    }
    # Wedge weapon — passive sloped plate at the front.
    DEF BLUE_ALPHA_WEAPON Solid {
      translation 0.30 0 -0.06
      name "weapon_wedge"
      children [ Shape {
        appearance PBRAppearance { baseColor 0.85 0.85 0.88 metalness 0 roughness 1 }
        geometry Box { size 0.20 0.45 0.04 }
      } ]
      boundingObject Box { size 0.20 0.45 0.04 }
      physics Physics { density -1 mass 1.5 }
    }
  ]
  boundingObject Box { size 0.70 0.50 0.16 }
  physics Physics { density -1 mass 25.0 }
}

