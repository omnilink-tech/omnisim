  boundingObject Box { size 0.75 0.45 0.13 }
  physics Physics { density -1 mass 35.0 }
}

# ===========================================================================
# RED BRAVO — pneumatic flipper (Hydra-style, pulse mode), opportunist.
#   Spawns east-south, faces west.
# ===========================================================================
DEF RED_BRAVO Robot {
  translation 7.0 -3.0 0.25
  rotation 0 0 1 3.14159265
  name "red_bravo"
  controller "battlebot_brain"
  controllerArgs [ "--opponent" "blue_bravo" "--strategy" "opportunist" "--weapon-mode" "pulse" "--pulse-range" "1.2" ]
  supervisor TRUE
  physicsBackend "newton"
  children [
    Shape {
      appearance PBRAppearance { baseColor 0.45 0.15 0.05 metalness 0 roughness 1 }
      geometry Box { size 0.65 0.42 0.16 }
    }
    DEF RED_BRAVO_FL_JOINT HingeJoint {
      jointParameters HingeJointParameters { axis 0 1 0 anchor 0.24 0.24 -0.05 }
      device [
