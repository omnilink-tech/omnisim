        translation -0.24 -0.24 -0.05
        rotation 1 0 0 1.5708
        name "rear_right_wheel"
        children [ Shape {
          appearance PBRAppearance { baseColor 0.08 0.08 0.08 metalness 0 roughness 1 }
          geometry Cylinder { height 0.05 radius 0.09 }
        } ]
        boundingObject Cylinder { height 0.05 radius 0.09 }
        physics Physics { density -1 mass 1.5 }
      }
    }
    # Pneumatic flipper arm — front-mounted, sweeps up on fire.
    DEF RED_BRAVO_WEAPON_JOINT HingeJoint {
      jointParameters HingeJointParameters {
        axis 0 1 0
        anchor 0.28 0 -0.06
        minStop -0.1
        maxStop 1.4
      }
      device [
        RotationalMotor { name "weapon_motor" maxVelocity 35 maxTorque 600 }
        PositionSensor { name "weapon_sensor" }
      ]
      endPoint DEF RED_BRAVO_WEAPON Solid {
        translation 0.28 0 -0.06
        name "weapon_flipper_arm"
        children [
          Transform {
            translation 0.18 0 0
            children [ Shape {
              appearance PBRAppearance { baseColor 0.95 0.65 0.10 metalness 0 roughness 1 }
              geometry Box { size 0.36 0.36 0.04 }
            } ]
          }
        ]
        boundingObject Transform {
          translation 0.18 0 0
          children [ Box { size 0.36 0.36 0.04 } ]
        }
        physics Physics { density -1 mass 5.0 }
      }
    }
  ]
  boundingObject Box { size 0.65 0.42 0.16 }
  physics Physics { density -1 mass 28.0 }
}

# ===========================================================================
# Damage + match director. 4-fighter free-for-all. The first 3
# bots to be immobilized lose; the last bot standing wins. Larger
# arena (20 m square -> half=10 m) so the OOTA threshold lets bots
# range freely. Wheel HP a bit higher because the open field gives
# more ramming opportunities.
# ===========================================================================
