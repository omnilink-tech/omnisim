#VRML_SIM R2025a utf8

# Husky head-on collision test — explicit-ODE variant of
# `husky_head_on.wbt`. The sibling world inherits the Phase D
# `physicsBackend "auto"` default which resolves to Newton on
# Newton-capable hosts; this variant pins ODE so the P6 parity
# capture has a deterministic ODE reference even on machines where
# Newton is the auto-selected backend.
#
# Only one husky (named "husky") is tracked by the harness_supervisor's
# damage tracker — the other ("husky_b") is the unmonitored attacker.
#
# See docs/developer/damage-system-plan.md + the P6 row of
# engine-migration-plan.md §13.3.

EXTERNPROTO "omnisim://projects/objects/floors/protos/RectangleArena.proto"
EXTERNPROTO "omnisim://projects/appearances/protos/Asphalt.proto"
EXTERNPROTO "omnisim://projects/objects/backgrounds/protos/OmniSimSky.proto"
EXTERNPROTO "omnisim://projects/objects/lights/protos/OmniSimSun.proto"
EXTERNPROTO "omnisim://projects/objects/lights/protos/OmniSimSunMarker.proto"

WorldInfo {
  basicTimeStep 16
  title "Husky Head-On Collision Test (ODE)"
  info [
    "Two huskies on a long arena drive toward each other and collide"
    "head-on. ODE-pinned variant for P6 quantitative parity diffs."
  ]
  contactProperties [
    ContactProperties {
      material1 "default"
      material2 "default"
      coulombFriction [ 0.8 ]
      bounce 0.3
      bounceVelocity 0.5
    }
  ]
}
Viewpoint {
  orientation -0.5773 0.5773 0.5773 2.0944
  position 0 0 18
}
OmniSimSky { }
DEF SUN OmniSimSun { }
DEF SUN_MARKER OmniSimSunMarker { }
DirectionalLight {
  direction -0.5 0.4 -0.6
  color 0.85 0.88 1.0
  intensity 1.4
  ambientIntensity 0.0
  castShadows FALSE
}

RectangleArena {
  floorSize 40 10
  wallHeight 0.5
  floorAppearance Asphalt {
    colorOverride 0.55 0.57 0.60
  }
}

URDFRobot {
  url "../../../robots/clearpath/husky_description/urdf/husky.urdf"
  translation -18 0 0.1
  name "husky"
  supervisor TRUE
  controller "drive_forward"
  controllerArgs [ "50" ]
  physicsBackend "ode"
}

URDFRobot {
  url "../../../robots/clearpath/husky_description/urdf/husky.urdf"
  translation 18 0 0.1
  rotation 0 0 1 3.14159265
  name "husky_b"
  supervisor TRUE
  controller "drive_forward"
  controllerArgs [ "30" ]
  physicsBackend "ode"
}

Robot {
  name "harness_supervisor"
  translation 0 0 12.5
  controller "harness_supervisor"
  supervisor TRUE
  children [
    Group {
    }
  ]
}
