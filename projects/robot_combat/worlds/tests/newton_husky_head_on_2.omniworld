#OMNISIM R2025a utf8

# Two-husky Newton head-on. Same head-on framing as husky_head_on.omniworld
# but with physicsBackend "newton" so both huskies' rigid-body dynamics
# run on the Newton/XPBD GPU solver, exercising the joint-anchor
# rotation projection (right-side husky is yawed 180 deg) fixed in
# 16dcabe.
#
# Supervisor runs with --light so damage.poll is sub-sampled (4f6771d);
# expect cumulative sim speed ~5x real-time on the head-on demo.

EXTERNPROTO "omnisim://projects/objects/floors/protos/RectangleArena.proto"
EXTERNPROTO "omnisim://projects/appearances/protos/Asphalt.proto"
EXTERNPROTO "omnisim://projects/objects/backgrounds/protos/OmniSimSky.proto"
EXTERNPROTO "omnisim://projects/objects/lights/protos/OmniSimSun.proto"
EXTERNPROTO "omnisim://projects/objects/lights/protos/OmniSimSunMarker.proto"

WorldInfo {
  basicTimeStep 16
  title "Newton Husky Head-On (2)"
  contactProperties [
    ContactProperties {
      material1 "default"
      material2 "default"
      coulombFriction [ 0.8 ]
      bounce 0.0
      bounceVelocity 0.5
    }
  ]
}
Viewpoint {
  orientation -0.5773 0.5773 0.5773 2.0944
  position 0 0 14
}
OmniSimSky { }
DEF SUN OmniSimSun { }
DEF SUN_MARKER OmniSimSunMarker { }
DirectionalLight {
  direction -0.5 0.4 -0.6
  color 0.85 0.88 1.0
  intensity 1.4
  ambientIntensity 0.0
  castShadows FALSE
}

RectangleArena {
  floorSize 30 30
  wallHeight 0.5
  floorAppearance Asphalt {
    colorOverride 0.55 0.57 0.60
  }
}

# Husky 1 (tracked). Newton-backed. Hunts husky_b: actively steers
# toward the other robot's world position every step.
URDFRobot {
  url "../../../robots/clearpath/husky_description/urdf/husky.urdf"
  translation -8 -8 0.3
  name "husky"
  supervisor TRUE
  controller "husky_hunt"
  controllerArgs [ "husky_b" ]
  physicsBackend "newton"
}

# Husky 2 (attacker). Yawed 180 deg, Newton-backed. Hunts husky.
URDFRobot {
  url "../../../robots/clearpath/husky_description/urdf/husky.urdf"
  translation 8 8 0.3
  rotation 0 0 1 3.14159265
  name "husky_b"
  supervisor TRUE
  controller "husky_hunt"
  controllerArgs [ "husky" ]
  physicsBackend "newton"
}

# Harness supervisor with --light: damage tracker runs but sub-sampled.
Robot {
  name "harness_supervisor"
  translation 0 0 12
  controller "harness_supervisor"
  controllerArgs [ "--light" ]
  supervisor TRUE
  children [
    Group {
    }
  ]
}
