#VRML_SIM R2025a utf8

# Newton head-on collision WITH damage tracking (P6 of cuda-newton-
# physics-plan.md). Same 4v4 layout as newton_husky_head_on.wbt, plus:
#   - supervisor TRUE on each URDFRobot so the damage_tracker can see
#     them via the supervisor API
#   - harness_supervisor Robot to drive damage_tracker.py
#   - DAMAGE_ROBOT_NAME defaults to "husky"; we name one tracked
#     husky "husky" so the existing tracker picks it up
#
# Open question P6 is meant to settle: does Webots' getContactPoints()
# fire for Newton-backed Solids? Our backend disables their ODE bodies
# (dBodyDisable) but the merger still calls setEnableForContactPoint
# on the geoms, so collision detection should still happen and the
# damage tracker should see contacts.

EXTERNPROTO "omnisim://projects/objects/floors/protos/RectangleArena.proto"
EXTERNPROTO "omnisim://projects/appearances/protos/Asphalt.proto"
EXTERNPROTO "omnisim://projects/objects/backgrounds/protos/OmniSimSky.proto"
EXTERNPROTO "omnisim://projects/objects/lights/protos/OmniSimSun.proto"
EXTERNPROTO "omnisim://projects/objects/lights/protos/OmniSimSunMarker.proto"

WorldInfo {
  basicTimeStep 16
  title "Newton Husky Head-On + Damage"
  contactProperties [
    ContactProperties {
      material1 "default"
      material2 "default"
      coulombFriction [ 0.8 ]
      bounce 0.0
      bounceVelocity 0.5
    }
  ]
}
Viewpoint {
  orientation -0.5773 0.5773 0.5773 2.0944
  position 0 -45 18.0
}
OmniSimSky { }
DEF SUN OmniSimSun { }
DEF SUN_MARKER OmniSimSunMarker { }

RectangleArena {
  floorSize 80 80
  wallHeight 0.5
  floorAppearance Asphalt {
    colorOverride 0.55 0.57 0.60
  }
}

# LEFT side -- one tracked husky ("husky") + 3 attackers.
URDFRobot {
  url "../../../robots/clearpath/husky_description/urdf/husky.urdf"
  translation -8 -18 0.3
  name "husky"
  supervisor TRUE
  controller "drive_forward"
  physicsBackend "newton"
}
URDFRobot {
  url "../../../robots/clearpath/husky_description/urdf/husky.urdf"
  translation -8 -6 0.3
  name "husky_L1"
  controller "drive_forward"
  physicsBackend "newton"
}
URDFRobot {
  url "../../../robots/clearpath/husky_description/urdf/husky.urdf"
  translation -8 6 0.3
  name "husky_L2"
  controller "drive_forward"
  physicsBackend "newton"
}
URDFRobot {
  url "../../../robots/clearpath/husky_description/urdf/husky.urdf"
  translation -8 18 0.3
  name "husky_L3"
  controller "drive_forward"
  physicsBackend "newton"
}

# RIGHT side -- 4 attackers, rotated 180 deg about z.
URDFRobot {
  url "../../../robots/clearpath/husky_description/urdf/husky.urdf"
  translation 8 -18 0.3
  rotation 0 0 1 3.14159
  name "husky_R0"
  controller "drive_forward"
  physicsBackend "newton"
}
URDFRobot {
  url "../../../robots/clearpath/husky_description/urdf/husky.urdf"
  translation 8 -6 0.3
  rotation 0 0 1 3.14159
  name "husky_R1"
  controller "drive_forward"
  physicsBackend "newton"
}
URDFRobot {
  url "../../../robots/clearpath/husky_description/urdf/husky.urdf"
  translation 8 6 0.3
  rotation 0 0 1 3.14159
  name "husky_R2"
  controller "drive_forward"
  physicsBackend "newton"
}
URDFRobot {
  url "../../../robots/clearpath/husky_description/urdf/husky.urdf"
  translation 8 18 0.3
  rotation 0 0 1 3.14159
  name "husky_R3"
  controller "drive_forward"
  physicsBackend "newton"
}

# Harness supervisor -- tracks "husky" by default.
Robot {
  name "harness_supervisor"
  translation 0 0 18
  controller "harness_supervisor"
  controllerArgs [ "--light" ]
  supervisor TRUE
  children [
    Group {
    }
  ]
}
