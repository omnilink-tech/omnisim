#VRML_SIM R2025a utf8

# Newton 20v20 head-on stress world. Generated from the 4v4
# newton_husky_head_on.wbt template. 20 huskies per side, facing
# each other across the arena, all on physicsBackend "newton".
#
# Purpose: validate the post-16dcabe (joint-anchor projection fix)
# multi-articulation behavior at the previously-blocking 20v20 scale.
# That fix turned the "body-index-30 cliff" from a Newton/Warp
# articulation limit into a local-bug symptom; this world is the
# end-to-end validation that the cliff is gone.
#
# Layout: 2 lines of 20 huskies along y = [-19, +19] in 2 m steps,
# left line at x=-8 (forward), right line at x=+8 (rotated 180 deg,
# also forward = approaching the left line).
#
# Per-husky: chassis + 4 wheels = 5 bodies. 40 huskies = 200 bodies,
# 160 hinge joints. The pure-Python solver bench
# (scripts/xpbd_probes/bench_newton_scaling.py) reached 50 huskies
# at 3.4 ms/step flat, so end-to-end here should comfortably stay
# below 60 Hz tick budget on a Newton-capable box.

EXTERNPROTO "omnisim://projects/objects/floors/protos/RectangleArena.proto"
EXTERNPROTO "omnisim://projects/appearances/protos/Asphalt.proto"
EXTERNPROTO "omnisim://projects/objects/backgrounds/protos/OmniSimSky.proto"
EXTERNPROTO "omnisim://projects/objects/lights/protos/OmniSimSun.proto"
EXTERNPROTO "omnisim://projects/objects/lights/protos/OmniSimSunMarker.proto"

WorldInfo {
  basicTimeStep 16
  title "Newton Husky 20v20 Stress (P5 in-OmniSim post-cliff)"
  contactProperties [
    ContactProperties {
      material1 "default"
      material2 "default"
      coulombFriction [ 0.8 ]
      bounce 0.0
      bounceVelocity 0.5
    }
  ]
}
Viewpoint {
  orientation -0.5773 0.5773 0.5773 2.0944
  position 0 -60 30.0
}
OmniSimSky { }
DEF SUN OmniSimSun { }
DEF SUN_MARKER OmniSimSunMarker { }

RectangleArena {
  floorSize 80 80
  wallHeight 0.5
  floorAppearance Asphalt {
    colorOverride 0.55 0.57 0.60
  }
}

# LEFT side -- 20 huskies at x=-8, y in [-19, +19] in 2 m steps.
URDFRobot {
  url "../../../robots/clearpath/husky_description/urdf/husky.urdf"
  translation -8 -19 0.3
  name "husky_L0"
  controller "drive_forward"
  synchronization FALSE
  physicsBackend "newton"
}
