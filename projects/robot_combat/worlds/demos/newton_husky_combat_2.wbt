#VRML_SIM R2025a utf8

# Husky combat (marketing) — two Newton huskies hunt + ram in a tight
# arena; harness_supervisor damage system deforms parts, leaks, and
# DETACHES wheels until a husky is crippled. Marker raised out of the
# top-down frame; full damage tracking (no --light) for fast carnage.

EXTERNPROTO "omnisim://projects/objects/floors/protos/RectangleArena.proto"
EXTERNPROTO "omnisim://projects/appearances/protos/Asphalt.proto"
EXTERNPROTO "omnisim://projects/objects/backgrounds/protos/OmniSimSky.proto"
EXTERNPROTO "omnisim://projects/objects/lights/protos/OmniSimSun.proto"
EXTERNPROTO "omnisim://projects/objects/lights/protos/OmniSimSunMarker.proto"

WorldInfo {
  basicTimeStep 16
  title "Husky Combat (2)"
  contactProperties [
    ContactProperties { material1 "default" material2 "default" coulombFriction [ 0.8 ] bounce 0.0 bounceVelocity 0.5 }
  ]
  # Newton combat config. MuJoCo solver REQUIRED -- XPBD can't drive a multi-wheel rover
  # (lateral left/right wheel pairs lock; proven via scripts/dev/wheel_model_diff.py).
  # MuJoCo + ODE drive them.
  newtonSolver "mujoco"
  # newtonStatics: make the RectangleArena walls solid so the huskies can't drive out.
  # newtonRobotColliders: give the husky chassis a real collider for body-vs-body ramming.
  #   Safe for husky.urdf -- its chassis box floats clear of the wheels (verified on
  #   warehouse_husky: drives normally, wheels still carry load).
  # newtonSubsteps: 4 keeps high closing-speed ram impacts from diverging XPBD to NaN.
  newtonStatics TRUE
  newtonRobotColliders TRUE
  newtonSubsteps 4
}
Viewpoint { orientation -0.5773 0.5773 0.5773 2.0944 position 0 0 14 }
OmniSimSky { }
DEF SUN OmniSimSun { }
DEF SUN_MARKER OmniSimSunMarker { translation 0 0 80 }
DirectionalLight { direction -0.5 0.4 -0.6 color 0.85 0.88 1.0 intensity 1.4 ambientIntensity 0.0 castShadows FALSE }
RectangleArena { floorSize 11 11 wallHeight 0.5 floorAppearance Asphalt { colorOverride 0.55 0.57 0.60 } }

URDFRobot {
  url "../../../robots/clearpath/husky_description/urdf/husky.urdf"
  translation -3.5 0 0.3
  name "husky"
  supervisor TRUE
  controller "husky_hunt"
  controllerArgs [ "husky_b" ]
  physicsBackend "newton"
}
URDFRobot {
  url "../../../robots/clearpath/husky_description/urdf/husky.urdf"
  translation 3.5 0 0.3
  rotation 0 0 1 3.14159265
  name "husky_b"
  supervisor TRUE
  controller "husky_hunt"
  controllerArgs [ "husky" ]
  physicsBackend "newton"
}
Robot {
  name "harness_supervisor"
  translation 0 0 12
  controller "harness_supervisor"
  supervisor TRUE
  children [ Group { } ]
}
