#OMNISIM R2025a utf8

# Husky combat demo (Brawl). Marker-less arena (no sun-marker disc in
# overhead/3-4 shots). Huskies ram via drive_forward at high wheel speed.

EXTERNPROTO "omnisim://projects/objects/floors/protos/RectangleArena.proto"
EXTERNPROTO "omnisim://projects/appearances/protos/Asphalt.proto"
EXTERNPROTO "omnisim://projects/objects/backgrounds/protos/OmniSimSky.proto"
EXTERNPROTO "omnisim://projects/objects/lights/protos/OmniSimSun.proto"

WorldInfo {
  basicTimeStep 16
  title "Husky Combat - Brawl"
}
Viewpoint {
  orientation 0.000000 1.000000 0.000000 1.570796
  position 0.000 0.000 36.839
}
OmniSimSky { }
DEF SUN OmniSimSun { }
DirectionalLight {
  direction -0.5 0.4 -0.6
  color 0.85 0.88 1.0
  intensity 1.4
  ambientIntensity 0.0
  castShadows FALSE
}

RectangleArena {
  floorSize 16 16
  wallHeight 0.4
  floorAppearance Asphalt {
    colorOverride 0.55 0.57 0.60
  }
}

URDFRobot {
  url "../../../robots/clearpath/husky_description/urdf/husky.urdf"
  translation -6 0 0.1
  name "husky_west"
  controller "drive_forward"
  controllerArgs [ "16" ]
}
URDFRobot {
  url "../../../robots/clearpath/husky_description/urdf/husky.urdf"
  translation 6 0 0.1
  rotation 0 0 1 3.14159265
  name "husky_east"
  controller "drive_forward"
  controllerArgs [ "16" ]
}
URDFRobot {
  url "../../../robots/clearpath/husky_description/urdf/husky.urdf"
  translation 0 -6 0.1
  rotation 0 0 1 1.5707963
  name "husky_south"
  controller "drive_forward"
  controllerArgs [ "16" ]
}
URDFRobot {
  url "../../../robots/clearpath/husky_description/urdf/husky.urdf"
  translation 0 6 0.1
  rotation 0 0 1 -1.5707963
  name "husky_north"
  controller "drive_forward"
  controllerArgs [ "16" ]
}
