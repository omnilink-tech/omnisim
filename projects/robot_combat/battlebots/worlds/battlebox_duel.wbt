#VRML_SIM R2025a utf8

# BattleBox duel — Phase 2 headliner. A vertical-spinner BattleBot
# faces a wedge BattleBot. Both bots run the `battlebot_brain`
# adversarial controller. The damage_director presides over the
# match, tracks per-part HP, physically detaches broken wheels +
# weapons, and declares the winner when one bot can no longer move.
#
# Run from the command line:
#   omnisim projects/robot_combat/worlds/battlebox_duel.wbt
#
# NOTE: The two fighters are INLINED here as direct Robot { } nodes
# rather than instances of BattleBot.proto. OmniSim Supervisor cannot
# remove nodes that are internal to a PROTO body — the runtime warns
# "Node is internal to a PROTO and therefore cannot be deleted from
# a Supervisor" and silently skips the removal. Inlining the bots
# brings the wheel + weapon HingeJoints into world-level scope so
# the damage_director's parent.remove() actually works and broken
# parts physically come off.

EXTERNPROTO "omnisim://projects/robot_combat/battlebots/protos/BattleBox.proto"
EXTERNPROTO "omnisim://projects/objects/backgrounds/protos/OmniSimSky.proto"
EXTERNPROTO "omnisim://projects/objects/lights/protos/OmniSimSun.proto"
EXTERNPROTO "omnisim://projects/objects/lights/protos/OmniSimSunMarker.proto"

WorldInfo {
  basicTimeStep 8
  title "BattleBox Duel — Vertical Spinner vs Wedge"
  contactProperties [
    ContactProperties {
      material1 "default"
      material2 "default"
      coulombFriction [ 0.9 ]
      bounce 0.05
      bounceVelocity 0.5
    }
  ]
  # Newton combat config. MuJoCo solver is REQUIRED: the default XPBD solver structurally
  # cannot drive a multi-wheel rover -- two laterally-paired (left/right) wheels lock under
  # XPBD (proven in pure Python, scripts/dev/wheel_model_diff.py; MuJoCo + ODE drive them).
  # MuJoCo also gives the robust frictional contact combat ramming needs.
  newtonSolver "mujoco"
  # Register the BattleBox arena walls as collision surfaces, else bots drive out of the ring:
  newtonStatics TRUE
  # Give each bot's chassis Box a real collider so ramming registers chassis contacts (without
  # it a Robot wrapper gets a 1 mm placeholder and bots phase through each other):
  newtonRobotColliders TRUE
  # Sub-steps for stable high-closing-speed ram impacts:
  newtonSubsteps 4
}
Viewpoint {
  orientation -0.5773 0.5773 0.5773 2.0944
  position 0 0 12
}
OmniSimSky { }
DEF SUN OmniSimSun { }
DEF SUN_MARKER OmniSimSunMarker { }
DirectionalLight {
  direction -0.5 0.4 -0.6
  color 0.85 0.88 1.0
  intensity 1.4
  ambientIntensity 0.0
  castShadows FALSE
}

BattleBox {
  enableKillsaw TRUE
  enablePushers TRUE
  enableScrews TRUE
}

# ===========================================================================
# RED — vertical spinner, aggressor strategy. Spawns at -x facing east.
# ===========================================================================
DEF RED Robot {
  translation -3.0 0 0.25
  rotation 0 0 1 0
  name "red"
  controller "battlebot_brain"
  controllerArgs [ "--opponent" "blue" "--strategy" "aggressor" ]
  supervisor TRUE
  physicsBackend "newton"
  children [
    # Chassis shell.
    Shape {
      appearance PBRAppearance { baseColor 0.8 0.15 0.15 metalness 0 roughness 1 }
      geometry Box { size 0.6 0.4 0.18 }
    }
    # FRONT LEFT wheel.
    DEF RED_FL_JOINT HingeJoint {
      jointParameters HingeJointParameters { axis 0 1 0 anchor 0.22 0.21 -0.05 }
      device [
        RotationalMotor { name "front_left_wheel_motor" maxVelocity 30 maxTorque 12 }
        PositionSensor { name "front_left_wheel_sensor" }
      ]
      endPoint DEF RED_FL_WHEEL Solid {
        translation 0.22 0.21 -0.05
        rotation 1 0 0 1.5708
        name "front_left_wheel"
        children [ Shape {
          appearance PBRAppearance { baseColor 0.1 0.1 0.1 metalness 0 roughness 1 }
          geometry Cylinder { height 0.05 radius 0.09 }
        } ]
        boundingObject Cylinder { height 0.05 radius 0.09 }
        physics Physics { density -1 mass 0.6 }
      }
    }
    # FRONT RIGHT wheel.
    DEF RED_FR_JOINT HingeJoint {
      jointParameters HingeJointParameters { axis 0 1 0 anchor 0.22 -0.21 -0.05 }
      device [
        RotationalMotor { name "front_right_wheel_motor" maxVelocity 30 maxTorque 12 }
        PositionSensor { name "front_right_wheel_sensor" }
      ]
      endPoint DEF RED_FR_WHEEL Solid {
        translation 0.22 -0.21 -0.05
        rotation 1 0 0 1.5708
        name "front_right_wheel"
        children [ Shape {
          appearance PBRAppearance { baseColor 0.1 0.1 0.1 metalness 0 roughness 1 }
          geometry Cylinder { height 0.05 radius 0.09 }
        } ]
        boundingObject Cylinder { height 0.05 radius 0.09 }
        physics Physics { density -1 mass 0.6 }
      }
    }
    # REAR LEFT wheel.
    DEF RED_RL_JOINT HingeJoint {
      jointParameters HingeJointParameters { axis 0 1 0 anchor -0.22 0.21 -0.05 }
      device [
        RotationalMotor { name "rear_left_wheel_motor" maxVelocity 30 maxTorque 12 }
        PositionSensor { name "rear_left_wheel_sensor" }
      ]
      endPoint DEF RED_RL_WHEEL Solid {
        translation -0.22 0.21 -0.05
        rotation 1 0 0 1.5708
        name "rear_left_wheel"
        children [ Shape {
          appearance PBRAppearance { baseColor 0.1 0.1 0.1 metalness 0 roughness 1 }
          geometry Cylinder { height 0.05 radius 0.09 }
        } ]
        boundingObject Cylinder { height 0.05 radius 0.09 }
        physics Physics { density -1 mass 0.6 }
      }
    }
    # REAR RIGHT wheel.
    DEF RED_RR_JOINT HingeJoint {
      jointParameters HingeJointParameters { axis 0 1 0 anchor -0.22 -0.21 -0.05 }
      device [
        RotationalMotor { name "rear_right_wheel_motor" maxVelocity 30 maxTorque 12 }
        PositionSensor { name "rear_right_wheel_sensor" }
      ]
      endPoint DEF RED_RR_WHEEL Solid {
        translation -0.22 -0.21 -0.05
        rotation 1 0 0 1.5708
        name "rear_right_wheel"
        children [ Shape {
          appearance PBRAppearance { baseColor 0.1 0.1 0.1 metalness 0 roughness 1 }
          geometry Cylinder { height 0.05 radius 0.09 }
        } ]
        boundingObject Cylinder { height 0.05 radius 0.09 }
        physics Physics { density -1 mass 0.6 }
      }
    }
    # VERTICAL SPINNER — disc on a horizontal axle at the front.
    DEF RED_WEAPON_JOINT HingeJoint {
      jointParameters HingeJointParameters { axis 0 1 0 anchor 0.36 0 0.0 }
      device [
        RotationalMotor { name "weapon_motor" maxVelocity 60 maxTorque 25 }
        PositionSensor { name "weapon_sensor" }
      ]
      endPoint DEF RED_WEAPON Solid {
        translation 0.36 0 0.0
        rotation 1 0 0 1.5708
        name "weapon_disc"
        children [
          Shape {
            appearance PBRAppearance { baseColor 0.95 0.85 0.1 metalness 0 roughness 1 }
            geometry Cylinder { height 0.04 radius 0.15 }
          }
          Solid {
            translation 0.13 0 0
            name "tooth_a"
            children [ Shape {
              appearance PBRAppearance { baseColor 0.2 0.2 0.2 metalness 0 roughness 1 }
              geometry Box { size 0.05 0.05 0.03 }
            } ]
          }
          Solid {
            translation -0.13 0 0
            name "tooth_b"
            children [ Shape {
              appearance PBRAppearance { baseColor 0.2 0.2 0.2 metalness 0 roughness 1 }
              geometry Box { size 0.05 0.05 0.03 }
            } ]
          }
        ]
        boundingObject Cylinder { height 0.04 radius 0.15 }
        physics Physics { density -1 mass 2.0 }
      }
    }
  ]
  boundingObject Box { size 0.6 0.4 0.18 }
  physics Physics { density -1 mass 10.0 }
}

# ===========================================================================
# BLUE — passive wedge, control strategy. Spawns at +x facing west.
# ===========================================================================
DEF BLUE Robot {
  translation 3.0 0 0.25
  rotation 0 0 1 3.14159265
  name "blue"
  controller "battlebot_brain"
  controllerArgs [ "--opponent" "red" "--strategy" "control" ]
  supervisor TRUE
  physicsBackend "newton"
  children [
    Shape {
      appearance PBRAppearance { baseColor 0.15 0.3 0.85 metalness 0 roughness 1 }
      geometry Box { size 0.6 0.4 0.18 }
    }
    DEF BLUE_FL_JOINT HingeJoint {
      jointParameters HingeJointParameters { axis 0 1 0 anchor 0.22 0.21 -0.05 }
      device [
        RotationalMotor { name "front_left_wheel_motor" maxVelocity 30 maxTorque 12 }
        PositionSensor { name "front_left_wheel_sensor" }
      ]
      endPoint DEF BLUE_FL_WHEEL Solid {
        translation 0.22 0.21 -0.05
        rotation 1 0 0 1.5708
        name "front_left_wheel"
        children [ Shape {
          appearance PBRAppearance { baseColor 0.1 0.1 0.1 metalness 0 roughness 1 }
          geometry Cylinder { height 0.05 radius 0.09 }
        } ]
        boundingObject Cylinder { height 0.05 radius 0.09 }
        physics Physics { density -1 mass 0.6 }
      }
    }
    DEF BLUE_FR_JOINT HingeJoint {
      jointParameters HingeJointParameters { axis 0 1 0 anchor 0.22 -0.21 -0.05 }
      device [
        RotationalMotor { name "front_right_wheel_motor" maxVelocity 30 maxTorque 12 }
        PositionSensor { name "front_right_wheel_sensor" }
      ]
      endPoint DEF BLUE_FR_WHEEL Solid {
        translation 0.22 -0.21 -0.05
        rotation 1 0 0 1.5708
        name "front_right_wheel"
        children [ Shape {
          appearance PBRAppearance { baseColor 0.1 0.1 0.1 metalness 0 roughness 1 }
          geometry Cylinder { height 0.05 radius 0.09 }
        } ]
        boundingObject Cylinder { height 0.05 radius 0.09 }
        physics Physics { density -1 mass 0.6 }
      }
    }
    DEF BLUE_RL_JOINT HingeJoint {
      jointParameters HingeJointParameters { axis 0 1 0 anchor -0.22 0.21 -0.05 }
      device [
        RotationalMotor { name "rear_left_wheel_motor" maxVelocity 30 maxTorque 12 }
        PositionSensor { name "rear_left_wheel_sensor" }
      ]
      endPoint DEF BLUE_RL_WHEEL Solid {
        translation -0.22 0.21 -0.05
        rotation 1 0 0 1.5708
        name "rear_left_wheel"
        children [ Shape {
          appearance PBRAppearance { baseColor 0.1 0.1 0.1 metalness 0 roughness 1 }
          geometry Cylinder { height 0.05 radius 0.09 }
        } ]
        boundingObject Cylinder { height 0.05 radius 0.09 }
        physics Physics { density -1 mass 0.6 }
      }
    }
    DEF BLUE_RR_JOINT HingeJoint {
      jointParameters HingeJointParameters { axis 0 1 0 anchor -0.22 -0.21 -0.05 }
      device [
        RotationalMotor { name "rear_right_wheel_motor" maxVelocity 30 maxTorque 12 }
        PositionSensor { name "rear_right_wheel_sensor" }
      ]
      endPoint DEF BLUE_RR_WHEEL Solid {
        translation -0.22 -0.21 -0.05
        rotation 1 0 0 1.5708
        name "rear_right_wheel"
        children [ Shape {
          appearance PBRAppearance { baseColor 0.1 0.1 0.1 metalness 0 roughness 1 }
          geometry Cylinder { height 0.05 radius 0.09 }
        } ]
        boundingObject Cylinder { height 0.05 radius 0.09 }
        physics Physics { density -1 mass 0.6 }
      }
    }
    # WEDGE — passive ramp at the front, no motor, no joint. The
    # damage_director still tracks it as the "weapon" part and can
    # detach the whole Solid by removing it from this children list.
    DEF BLUE_WEAPON Solid {
      translation 0.33 0 -0.06
      name "weapon_wedge"
      children [ Shape {
        appearance PBRAppearance { baseColor 0.8 0.8 0.85 metalness 0 roughness 1 }
        geometry Box { size 0.25 0.4 0.06 }
      } ]
      boundingObject Box { size 0.25 0.4 0.06 }
      physics Physics { density -1 mass 0.8 }
    }
  ]
  boundingObject Box { size 0.6 0.4 0.18 }
  physics Physics { density -1 mass 10.0 }
}

# Damage + match director. Tracks per-part HP on every fighter, detaches
# broken wheels/weapons as free Solids, declares match-over when a bot
# can no longer move (immobilization OR OOTA). No judge scoring — first
# to lose mobility loses the match.
DEF DIRECTOR Robot {
  name "damage_director"
  translation 0 0 8
  controller "battlebot_damage_director"
  customData "{\"fighters\": [\"red\", \"blue\"], \"arena_size\": 8.0, \"fail_wheels\": 3, \"contact_gate_m\": 1.3, \"timer_s\": 240.0, \"output\": \"_scratch/battlebox_match.json\", \"hp\": {\"chassis\": 60.0, \"wheel\": 4.0, \"weapon\": 10.0}, \"impulse_threshold_J\": {\"chassis\": 2.0, \"wheel\": 0.1, \"weapon\": 0.5}}"
  supervisor TRUE
  children [
    Group {
    }
  ]
}

DEF TRACKER Robot {
  name "duel_tracker"
  translation 0 0 7
  controller "duel_tracker"
  supervisor TRUE
  children [
    Group {
    }
  ]
}
