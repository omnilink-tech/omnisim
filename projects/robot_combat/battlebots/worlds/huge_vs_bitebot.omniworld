            } ]
          }
        ]
        boundingObject Cylinder { height 0.04 radius 0.20 }
        physics Physics { density -1 mass 10.0 }
      }
    }
  ]
  boundingObject Box { size 0.80 0.55 0.18 }
  physics Physics { density -1 mass 80.0 }
}

DEF DIRECTOR Robot {
  name "damage_director"
  translation 0 0 8
  controller "battlebot_damage_director"
  customData "{\"fighters\": [\"huge\", \"bitebot\"], \"arena_size\": 8.0, \"fail_wheels\": 3, \"contact_gate_m\": 1.8, \"timer_s\": 240.0, \"output\": \"_scratch/huge_vs_bitebot.json\", \"hp\": {\"chassis\": 250.0, \"wheel\": 30.0, \"weapon\": 35.0}, \"impulse_threshold_J\": {\"chassis\": 35.0, \"wheel\": 1.5, \"weapon\": 8.0}}"
  supervisor TRUE
  children [
    Group {
    }
  ]
}

DEF TRACKER Robot {
  name "duel_tracker"
  translation 0 0 7
  controller "duel_tracker"
  customData "{\"fighters\": [\"HUGE\", \"BITEBOT\"]}"
  supervisor TRUE
  children [
    Group {
    }
  ]
}
