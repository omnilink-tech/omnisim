#VRML_SIM R2025a utf8

# BattleBox proving ground — Phase 1 of the BattleBots-style expansion.
# Two Huskies dropped into the new BattleBox arena (with killsaw, corner
# pushers, and side screws enabled). Used to validate the arena PROTO
# in isolation before custom BattleBot platforms are introduced in the
# Phase 2 worlds (battlebox_duel.wbt etc.).
#
# The Huskies use the existing `husky_hunt` controller, so this world
# also doubles as a "Husky in a real cage" smoke test.

EXTERNPROTO "omnisim://projects/robot_combat/battlebots/protos/BattleBox.proto"
EXTERNPROTO "omnisim://projects/objects/backgrounds/protos/OmniSimSky.proto"
EXTERNPROTO "omnisim://projects/objects/lights/protos/OmniSimSun.proto"
EXTERNPROTO "omnisim://projects/objects/lights/protos/OmniSimSunMarker.proto"

WorldInfo {
  basicTimeStep 16
  title "BattleBox — Husky Proving Ground"
  contactProperties [
    ContactProperties {
      material1 "default"
      material2 "default"
      coulombFriction [ 0.9 ]
      bounce 0.05
      bounceVelocity 0.5
    }
  ]
}
Viewpoint {
  orientation -0.5773 0.5773 0.5773 2.0944
  position 0 0 12
}
OmniSimSky { }
DEF SUN OmniSimSun { }
DEF SUN_MARKER OmniSimSunMarker { }
DirectionalLight {
  direction -0.5 0.4 -0.6
  color 0.85 0.88 1.0
  intensity 1.4
  ambientIntensity 0.0
  castShadows FALSE
}

# The arena. Killsaw + pushers + screws on, no OOTA pits.
BattleBox {
  enableKillsaw TRUE
  enablePushers TRUE
  enableScrews TRUE
  enableOotaPits FALSE
}

# Two Huskies as test fighters. Spawn at opposite corners, just inside
# the wall buffer. Hunt AI does the rest.
URDFRobot {
  url "../../../robots/clearpath/husky_description/urdf/husky.urdf"
  translation -2.8 -2.8 0.3
  name "husky"
  supervisor TRUE
  controller "husky_hunt"
  controllerArgs [ "husky_b" ]
  physicsBackend "newton"
}

URDFRobot {
  url "../../../robots/clearpath/husky_description/urdf/husky.urdf"
  translation 2.8 2.8 0.3
  rotation 0 0 1 3.14159265
  name "husky_b"
  supervisor TRUE
  controller "husky_hunt"
  controllerArgs [ "husky" ]
  physicsBackend "newton"
}

# Harness supervisor (--light: sub-sampled damage tracker).
Robot {
  name "harness_supervisor"
  translation 0 0 10
  controller "harness_supervisor"
  controllerArgs [ "--light" ]
  supervisor TRUE
  children [
    Group {
    }
  ]
}
