#OMNISIM R2025a utf8

EXTERNPROTO "omnisim://projects/objects/floors/protos/RectangleArena.proto"
EXTERNPROTO "omnisim://projects/appearances/protos/Pavement.proto"
EXTERNPROTO "omnisim://projects/samples/rendering/protos/SphereGrid.proto"
EXTERNPROTO "omnisim://projects/samples/rendering/protos/PbrMaterialSpecimen.proto"
EXTERNPROTO "omnisim://projects/appearances/protos/HammeredCopper.proto"
EXTERNPROTO "omnisim://projects/appearances/protos/RustyMetal.proto"
EXTERNPROTO "omnisim://projects/objects/backgrounds/protos/OmniSimSky.proto"
EXTERNPROTO "omnisim://projects/objects/lights/protos/OmniSimSun.proto"
EXTERNPROTO "omnisim://projects/objects/lights/protos/OmniSimSunMarker.proto"

WorldInfo {
  info [
    "Demo of a simulation world with objects rendered with a Physically Based Rendering (PBR) appearance."
    "PBR rendering was introduced in Webots R2018b, but it is not yet used by default in all simulations."
    "This world file demonstrates the current possibilities of PBR and prefigures the rendering quality of upcoming versions of OmniSim."
    "The documentation about PBR is provided in the OmniSim Reference Manual under the PBRAppearance node."
    "The sphere grids sweep the scalar metalness/roughness parameters; the two material specimens show a complete texture map set (base colour, roughness, metalness, normal, occlusion) on curved and flat geometry."
  ]
  title "Physically Based Rendering"
}
Viewpoint {
  orientation -0.07180624754969592 -0.24012211194513644 0.9680832785291972 5.6761129418669185
  position -7.23059333577823 5.418938787371356 2.254337006919236
  near 0.049999999999999996
}
OmniSimSky { }
DEF SUN OmniSimSun { }
DEF SUN_MARKER OmniSimSunMarker { }
RectangleArena {
  floorSize 20 20
  floorAppearance Pavement {
    type "grid"
  }
  wallHeight 1
}
DEF GOLD SphereGrid {
  translation 0 -0.85 1.3
  name "gold sphere grid"
  color 0.83 0.69 0.22
  normalMap NULL
  baseColorMap NULL
  roughnessMap NULL
  transparency 0
  widthAndHeight 5
}
DEF SILVER SphereGrid {
  translation 0 0.85 3
  name "silver sphere grid"
  color 0.75 0.75 0.75
  normalMap NULL
  baseColorMap NULL
  roughnessMap NULL
  transparency 0
  widthAndHeight 5
}
DEF BLACK SphereGrid {
  translation 0 -0.85 3
  name "black sphere grid"
  color 0 0 0
  normalMap NULL
  baseColorMap NULL
  roughnessMap NULL
  transparency 0
  widthAndHeight 5
}
DEF COPPER SphereGrid {
  translation 0 0.85 1.3
  name "copper sphere grid"
  color 0.72 0.45 0.2
  normalMap NULL
  baseColorMap NULL
  roughnessMap NULL
  transparency 0
  widthAndHeight 5
}
DEF COPPER_SPECIMEN PbrMaterialSpecimen {
  translation -0.5 0.35 0
  name "hammered copper specimen"
  specimenAppearance HammeredCopper {
  }
}
DEF RUST_SPECIMEN PbrMaterialSpecimen {
  translation -0.5 1 0
  name "rusty metal specimen"
  specimenAppearance RustyMetal {
    rustLevel 2
  }
  specimenGeometry Box {
    size 0.28 0.28 0.28
  }
}
