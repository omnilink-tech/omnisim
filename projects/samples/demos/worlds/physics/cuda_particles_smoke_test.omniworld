#OMNISIM R2025a utf8

# CUDA particle pool smoke test -- Phase 1.5 of the CUDA particle effects
# plan. The cuda_particle_pool supervisor owns a numba.cuda buffer of
# N=200 particles, runs the gravity/drag advance kernel each step, and
# `setSFVec3f`-updates a pre-allocated pool of sphere Solids. External
# clients (or the damage tracker) can spawn particles via the wire
# protocol on 127.0.0.1:6791.
#
# Pre-allocated Solid pool: 200 small dark spheres parked at z=-100
# (off-screen) until the first spawn moves them. DEF names follow the
# pattern `particle_NNNN` (zero-padded) so the controller can resolve
# them by name in a single getFromDef pass at startup.
#
# See docs/developer/cuda-particle-effects-plan.md.

EXTERNPROTO "omnisim://projects/objects/floors/protos/RectangleArena.proto"
EXTERNPROTO "omnisim://projects/appearances/protos/Asphalt.proto"
EXTERNPROTO "omnisim://projects/objects/backgrounds/protos/OmniSimSky.proto"
EXTERNPROTO "omnisim://projects/objects/lights/protos/OmniSimSun.proto"
EXTERNPROTO "omnisim://projects/objects/lights/protos/OmniSimSunMarker.proto"

WorldInfo {
  basicTimeStep 16
  title "CUDA Particle Pool Smoke Test"
  info [
    "Phase 1.5: CUDA particle pool prototype. Spawn particles via TCP on"
    "127.0.0.1:6791. Each spawn picks the next slot in the round-robin pool"
    "and pushes its pose to one of the pre-allocated sphere Solids."
  ]
}
Viewpoint {
  orientation -0.5773 0.5773 0.5773 2.0944
  position 0 0 6
}
OmniSimSky { }
DEF SUN OmniSimSun { }
DEF SUN_MARKER OmniSimSunMarker { }

RectangleArena {
  floorSize 8 8
  wallHeight 0.3
  floorAppearance Asphalt {
    colorOverride 0.40 0.42 0.45
  }
}

# CUDA particle pool supervisor: owns the numba.cuda buffer and runs the
# advance kernel each step. Listens on 127.0.0.1:6791. The 200 sphere
# Solids it drives are below; this Robot is the orchestrator.
Robot {
  name "cuda_particle_pool"
  translation 0 0 4
  controller "cuda_particle_pool"
  supervisor TRUE
  children [
    Group {
    }
  ]
}

# Pre-allocated particle pool: 200 small spheres parked at z=-100
# until the cuda_particle_pool supervisor moves them. DEFs are
# zero-padded so getFromDef finds them deterministically. Fixed
# size (Solid has no scale field; per-particle size would need a
# Pose wrapper which P2 will add).
Group {
  children [
    DEF particle_0000 Solid {
      translation 0 0 -100
      name "particle_0000"
      children [
        Shape {
          appearance PBRAppearance {
            baseColor 0.65 0.65 0.65
            roughness 0.9
            emissiveColor 0.4 0.4 0.4
          }
          geometry Sphere { radius 0.05 subdivision 1 }
        }
      ]
    }
    DEF particle_0001 Solid {
      translation 0 0 -100
      name "particle_0001"
      children [
