#VRML_SIM R2025a utf8

# Newton multi-husky swarm drive (P4 of cuda-newton-physics-plan.md).
#
# 8 Husky URDFRobots, each with `physicsBackend "newton"`, all driving
# forward in straight lines. Spaced 12 m apart in y so they drive
# in parallel without proximity-induced solver issues.
#
# **Why 8 and not 10**: at 10 articulated bodies on Newton 1.1 + XPBD
# we hit a structural scaling limit -- one or more huskies' wheel
# actuator targets stop being satisfied (joint_qd settles at ~0.4
# rad/s instead of the commanded 2.5 rad/s) regardless of spacing,
# iterations, or angular damping. See scripts/xpbd_probes/probe13
# for the sweep that pins this down. 8 huskies at 12 m spacing
# reliably drives all 8 in pure-Python characterization. Inter-husky
# contact resolution (P5) will need a different approach -- likely
# Newton's `replicate()` + grouped articulations in a more recent
# release.
#
# On NEWTON=OFF builds, each URDFRobot falls back to ODE per the
# registry's safety net. ODE will be slow but correct.

EXTERNPROTO "omnisim://projects/objects/floors/protos/RectangleArena.proto"
EXTERNPROTO "omnisim://projects/appearances/protos/Asphalt.proto"
EXTERNPROTO "omnisim://projects/objects/backgrounds/protos/OmniSimSky.proto"
EXTERNPROTO "omnisim://projects/objects/lights/protos/OmniSimSun.proto"
EXTERNPROTO "omnisim://projects/objects/lights/protos/OmniSimSunMarker.proto"

WorldInfo {
  basicTimeStep 16
  title "Newton Husky Swarm (8x)"
  info [
    "P4: 8 huskies driving forward simultaneously on Newton XPBD."
    "Each husky has 5 bodies + 5 joints; 40 bodies + 40 joints total."
    "Spaced 12 m apart in y; clear of the Newton 1.1 multi-husky"
    "proximity bug that causes wheel actuator targets to stop being"
    "satisfied at tighter spacing."
    "Exit criterion: sustained >=30 fps with full visualization."
  ]
}
Viewpoint {
  orientation -0.5773 0.5773 0.5773 2.0944
  position -3 -50 12.0
}
OmniSimSky { }
DEF SUN OmniSimSun { }
DEF SUN_MARKER OmniSimSunMarker { }

RectangleArena {
  floorSize 100 100
  wallHeight 0.5
  floorAppearance Asphalt {
    colorOverride 0.55 0.57 0.60
  }
}

URDFRobot {
  url "../../../../robots/clearpath/husky_description/urdf/husky.urdf"
  translation -7 -42 0.3
  name "husky_0"
  controller "drive_forward"
  physicsBackend "newton"
  customData "{\"wheel_torque\":{\"fl\":1.0,\"fr\":1.0,\"rl\":1.0,\"rr\":1.0},\"game_over\":false}"
}
URDFRobot {
  url "../../../../robots/clearpath/husky_description/urdf/husky.urdf"
  translation -7 -30 0.3
  name "husky_1"
  controller "drive_forward"
  physicsBackend "newton"
  customData "{\"wheel_torque\":{\"fl\":1.0,\"fr\":1.0,\"rl\":1.0,\"rr\":1.0},\"game_over\":false}"
}
