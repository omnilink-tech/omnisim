#VRML_SIM R2025a utf8

# A REAL GARMENT, not a rectangular patch: an actual T-shirt mesh, simulated as
# cloth by newton's SolverVBD, hanging by its shoulders and settling under its
# own weight.
#
# WHY THIS WORLD EXISTS. newton_cloth_drape.omniworld proved the cloth stack on
# a 17x17 GRID -- geometry the engine generates from four numbers. This proves
# the other half: that a `Cloth` can take its geometry from a MESH FILE, so the
# fabric OmniSim simulates can be something an artist made rather than something
# the engine can describe analytically. A shirt has sleeves, a neck hole, a hem,
# and a front and back panel that must stay apart -- none of which a dimX/dimY
# patch can express.
#
# THE ASSET. meshes/tshirt.obj: 616 vertices, 1157 triangles, 0.664 m^2 of
# fabric, 0.648 x 0.272 x 0.635 m. Generated by scripts/dev/usd_to_cloth_obj.py
# from unisex_shirt.usd, which newton vendors in its own examples -- Y-up and in
# CENTIMETRES there, converted to OmniSim's ENU Z-up metres offline. It is
# DECIMATED from the original 6436 vertices, for honest cost rather than
# cosmetics: cloth is a per-particle GPU workload, 6436 particles is ~10x this
# world's budget, and drape is a large-scale behaviour that 616 particles
# capture. The converter reports every count it changed.
#
# ⚠ THE DECIMATION IS CONNECTIVITY-AWARE, AND IT HAS TO BE. A T-shirt is a
# flattened tube whose front and back panels pass within a couple of centimetres
# of each other, so ordinary vertex clustering fuses them and the shirt can never
# open. MEASURED: plain clustering left 16-46 non-manifold edges at every target
# from 620 to 2500 vertices; clustering restricted to mesh-CONNECTED vertices cut
# that to 4-14, and a final repair pass (9 triangles removed) took it to 0.
#
# ⚠ WHY IT HANGS RATHER THAN DRAPING OVER A TABLE, which was the obvious demo and
# does not work. UNPINNED CLOTH RESTING ON A STATIC BODY SINKS THROUGH IT on the
# current solver. MEASURED: this shirt dropped onto a 0.6 m static box passed
# through it and kept falling (z = -0.42 by 5.4 s), and so did a matched
# 196-particle GRID sheet from the same height onto the same box, FASTER
# (z = -1.20 by 8.4 s). So the defect is the existing cloth-vs-statics path and
# has nothing to do with mesh authoring -- the shipped grid drape world only
# looks right because its sheet is PINNED and merely brushes the box. Until that
# is fixed, a garment must be hung, not rested. `pinTopBand` is what makes that
# possible for a mesh, and it is this change's one addition with no upstream
# equivalent.
#
# WHAT TO EXPECT, and the proof is numeric rather than visual -- run with
# OMNISIM_CLOTH_TELEMETRY=<path> for JSONL:
#   * 616 particles register, 47 of them pinned (the 0.06 m shoulder band).
#   * bbox_max_z stays PINNED at 1.9346 and never moves, to the last decimal.
#     That is the sharpest check in the world: a pinned particle has mass 0, so
#     any drift at all means the pin did not take.
#   * the free fabric settles: the centroid drops a few cm and stops, and the
#     hem stays far above the floor for ever. Nothing here can sink, because
#     nothing here is resting on anything.
#
# ⚠ THAT LAST BULLET WAS FALSE FOR AS LONG AS THIS WORLD HAS SHIPPED, and the
# world said so about itself while doing the opposite. MEASURED 2026-08-15 on
# the file as committed: the garment did not settle, it CREPT -- the 0.6346 m
# shirt elongated until its hem reached the floor, roughly 1.3 m of stretch, and
# rendered as a floor-length dress with no sleeves distinguishable. Nothing in
# the log said so, because a slowly stretching membrane is not an error, is not
# a warning, and is not a runaway body. Fixed by declaring triKe / triKd on the
# Cloth and newtonSubsteps on the WorldInfo -- see both, and see
# newton_cloth_material.omniworld, where the same pair was established first and
# where the note that this world creeps was already written down.

EXTERNPROTO "omnisim://projects/objects/backgrounds/protos/OmniSimSky.proto"
EXTERNPROTO "omnisim://projects/objects/lights/protos/OmniSimSun.proto"
EXTERNPROTO "omnisim://projects/objects/lights/protos/OmniSimSunMarker.proto"

WorldInfo {
  gravity 9.81
  basicTimeStep 8
  coordinateSystem "ENU"
  # The coupled path: SolverMuJoCo keeps every rigid body, SolverVBD owns the
  # cloth particles, SolverCoupledProxy exchanges forces between them.
  newtonSolver "mujoco+vbd"
  # ⚠ 4, NOT THE DEFAULT 1, AND IT IS PAIRED WITH THE Cloth's triKe BELOW.
  # A stiff FEM membrane needs a shorter effective step before the solve
  # converges instead of ringing, so raising triKe by 10x without raising this
  # trades one visible failure (creep) for another (jitter).
  #
  # 4 rather than the 10 newton_cloth_material uses, because it was MEASURED
  # here rather than copied: at 4 the settled garment is indistinguishable from
  # the same world at 10 (mean frame RGB 108.19/121.77/142.89 against
  # 108.00/121.70/143.29) and it is 2.3x cheaper -- 300 basic steps in 20.1 s
  # against 45.3 s, load 14.6 s against 28.2 s, on machine 9722d23d12a3.
  # Settling was checked rather than assumed: 300 MORE steps move the frame's
  # mean RGB by 0.1, i.e. the shirt has stopped, so this is a converged rest
  # state and not a ring caught at a lucky phase.
  newtonSubsteps 4
  newtonStatics TRUE
  newtonGroundMu 1
}
Viewpoint {
  position -1.7 -1.8 1.9
  orientation 0.33 -0.27 -0.90 1.26
}
OmniSimSky {
}
DEF SUN OmniSimSun {
}
DEF SUN_MARKER OmniSimSunMarker {
}
DEF FLOOR Solid {
  translation 0 0 0
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.35 0.36 0.40
        roughness 1
        metalness 0
      }
      geometry Box {
        size 6 6 0.1
      }
    }
  ]
  name "floor"
  boundingObject Box {
    size 6 6 0.1
  }
}
# The clothes rail. ⚠ DELIBERATELY HAS NO boundingObject: it is a VISUAL PROP
# and nothing else. What actually holds the shirt up is the pinned shoulder
# band, and giving the rail a collider would put a static body back in the
# fabric's contact path -- the exact path measured above to be unreliable -- for
# no benefit. It is also the house rule for kinematic-only props.
DEF RAIL Solid {
  translation 0 0 1.96
  rotation 0 1 0 1.5708
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.72 0.73 0.75
        roughness 0.4
        metalness 1
      }
      geometry Cylinder {
        height 1.6
        radius 0.012
      }
    }
  ]
  name "rail"
}
# The garment, hung as worn: the OBJ's local +Z is the torso axis and its bbox
# is centred on local X/Y with the hem at local z = 0, so an unrotated shirt at
# translation z = 1.30 occupies z = 1.30 (hem) to 1.9346 (shoulders).
#
# `pinTopBand 0.06` pins every vertex within 6 cm of the mesh's maximum LOCAL Z
# -- 47 of the 616, spanning 0.336 m across, i.e. the shoulder line either side
# of the neck. Those particles get mass 0 and stop integrating, so the shirt
# hangs from them exactly as it would from a hanger.
#
# `density` is kg per SQUARE METRE, not per particle: 0.3 is a light cotton
# jersey and over 0.664 m^2 gives a 0.199 kg shirt, which is what a real one
# weighs. That unit is also why the decimation is physically free -- the garment
# masses the same however finely it is tessellated.
DEF TSHIRT Cloth {
  translation 0 0 1.30
  url [
    "meshes/tshirt.obj"
  ]
  density 0.3
  particleRadius 0.01
  pinTopBand 0.06
  # ⚠ THE SHIRT USED TO CREEP INTO A FLOOR-LENGTH DRESS, AND THIS IS THE FIX.
  # MEASURED on this world before the change (harness, 300 steps at
  # basicTimeStep 8): the 0.6346 m garment elongated until its hem reached the
  # FLOOR, roughly 1.3 m of stretch on a 0.199 kg garment hanging from a pinned
  # shoulder band. That is not drape, it is a membrane with nothing holding its
  # rest length, and it makes the world contradict its own "the centroid drops a
  # few cm and stops" claim above. It is stretch and NOT mesh resolution -- it
  # happens identically on the 2394-vertex asset (see newton_cloth_material,
  # where this pair of values was first established).
  #
  # ⚠ triKe AND newtonSubsteps MOVE TOGETHER. See the WorldInfo above.
  triKe 1000000
  triKd 2000
  # A mesh Cloth is pinned by pinTopBand, never by the grid's edge flags;
  # fixTop defaults TRUE, so clear it or the node (correctly) warns that it is
  # being ignored.
  fixTop FALSE
  diffuseColor 0.30 0.45 0.85
  # ⚠ WITHOUT THIS THE GARMENT IS 14.95% PURE BLACK -- MEASURED on this world,
  # harness, 300 basic steps, the hero framing below, 1900x1080; a wider frame
  # that gives the sky more pixels scores lower for the same shirt, so quote the
  # framing with the number. After: 0.00%. The canonical recipe declares
  # `ambientIntensity 0` (OmniSimSun.proto), so every scrap of fill light in an
  # OmniSim world is IMAGE-BASED, and image-based light reaches a surface ONLY
  # through a PBRAppearance. A Phong Cloth renders hard (0,0,0) on every square
  # millimetre the sun does not strike directly -- and a hanging shirt is a
  # closed tube seen from one side, so that is most of it. This is the single
  # biggest reason a garment looked unlike everything around it, ahead of mesh
  # resolution and well ahead of the material's own parameters.
  #
  # ⚠ textureTransform scale 2 2, AND THE ASSET ALREADY CARRIES A SCALE -- these
  # MULTIPLY, so read them together. The OBJ carries `arap-panel` UVs baked at
  # 6 tiles per metre of surface (stated in the header of meshes/tshirt.obj),
  # i.e. a 16.7 cm tile on its own. That was measurably too coarse: at 16.7 cm
  # the weave reads as knitted wool / bubble wrap rather than cotton. Doubling
  # to 12 tiles/m puts one tile at 8.3 cm, which matches every other cloth world
  # in this directory so the four read as one bolt of fabric.
  #
  # The honest 2 cm design tile was swept and REJECTED ON EVIDENCE -- see the
  # tile table in newton_cloth_drape.omniworld: at 2 cm a thread is 0.42 mm,
  # far under one pixel at demo framing, and the mip chain averages the whole
  # weave to a uniform colour. The map renders nothing. 8.3 cm is a legibility
  # choice that is dishonest by 4x, stated rather than hidden.
  # normalMapFactor 0.5 is what pays for that 4x stretch.
  #
  # ⚠ metalness 0 EXPLICITLY -- the schema default is 1, and a metal shirt under
  # ambientIntensity 0 renders near-black, which looks exactly like the bug this
  # field was added to fix.
  #
  # ⚠ baseColorMap is MULTIPLIED by `baseColor` (pbr.frag:259), never replaced.
  # The woven set is generated near-neutral (0.82 0.815 0.80 linear) precisely so
  # a world can tint it, which is how this shirt keeps the blue identity it had
  # as a Phong `diffuseColor`. Do not also use it on a set that carries its own
  # colour (the sponge set does) -- that double-tints into mud.
  appearance PBRAppearance {
    baseColor 0.26 0.40 0.78
    baseColorMap ImageTexture {
      url [
        "textures/woven_cotton_basecolor.png"
      ]
    }
    normalMap ImageTexture {
      url [
        "textures/woven_cotton_normal.png"
      ]
    }
    roughnessMap ImageTexture {
      url [
        "textures/woven_cotton_roughness.png"
      ]
    }
    occlusionMap ImageTexture {
      url [
        "textures/woven_cotton_occlusion.png"
      ]
    }
    metalness 0
    normalMapFactor 0.5
    IBLStrength 1.3
    textureTransform TextureTransform {
      scale 2 2
    }
  }
}
