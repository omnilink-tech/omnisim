  ]
  name "dish"
  boundingObject Box {
    size 0.17 0.17 0.012
  }
}
# ===========================================================================
# THE SPONGE. A tetrahedral-FEM block: 5 tets per hexahedral cell, Lame
# parameters kMu / kLambda, viscous kDamp.
#
# ⚠ `translation` IS THE BLOCK'S MINIMUM CORNER, not its centre -- the opposite
# convention to every Solid in this file.
#
# ⚠ A SoftBody IS TOP-LEVEL ONLY. It cannot be nested in a Pose or a Group, and
# it cannot be attached, welded or parented to a robot link: the only pinning
# mechanism in the node is the four fix* flags, which zero a particle's mass and
# therefore nail it to the WORLD, not to a gripper. THE SPONGE IS HELD BY
# FRICTION AND NOTHING ELSE. That is why newtonGroundMu is 3 rather than the 1
# the sibling cloth worlds use -- it supplies model.soft_contact_mu.
#
# Geometry: 4 x 3 x 2 cells of 25 x 25 x 20 mm = 100 x 75 x 40 mm, 5*4*3 = 60
# particles. Kept small on purpose; soft bodies are a GPU workload and cost
# scales with particle count.
#
# The pinch axis is local/world Y, across the 75 mm dimension. The pad faces see
# 5 x 3 = 15 particles each, well above the 8 the sibling t-shirt grasp needed
# for a reliable bite.
#
# Material: kMu / kLambda 3000 rather than the 1e4 default, because a kitchen
# sponge is soft and must visibly squash; kDamp 30 because at newton's default
# damping of 1 an elastic solid rings for ever instead of settling. density 300
# gives 60 * (0.025*0.025*0.02*300) = 0.225 kg, about right for a damp sponge.
#
# ⚠ `0` MEANS "RUNTIME DEFAULT" ON EVERY MATERIAL FIELD, so a genuinely zero
# value cannot be authored. Every one below is set explicitly.
#
# Rest height: the block rests on its particle RADIUS, not on its face, so the
# bottom particle layer settles at worktop_top + particleRadius = 0.90 + 0.01 =
# 0.91. It is authored there so it starts at rest rather than dropping.
#
# ⚠ There is NO `appearance` field on this node -- only phong `diffuseColor`.
# See the PointLight above for why that matters.
# ===========================================================================
DEF SPONGE SoftBody {
  translation -0.23 -0.0375 0.91
  dimX 4
  dimY 3
  dimZ 2
  cellX 0.025
  cellY 0.025
  cellZ 0.02
  density 300
  # ⚠ 3000 Pa COLLAPSED THE BLOCK, MEASURED. At kMu/kLambda 3000 the sponge is a
  # 3 kPa jelly. It survived the pick, the 88 mm lift, the 360 mm carry and the
  # press -- and then, part-way through the lateral scrub, every one of its 60
  # particles converged to a single point: the particle-centre bbox went
  # 0.0527 -> 0.0045 -> 0.00000 m and stayed there. That is a total FEM failure,
  # not a soft material looking squashy.
  #
  # The load that does it is SHEAR, not the squeeze. newtonGroundMu 3 also
  # supplies soft_contact_mu, so the plate grips the sponge's underside hard
  # while the pads drag its top sideways. A 3 kPa solid cannot carry that.
  # A real kitchen sponge is 20-50 kPa; 20000 sits at the soft end of real and
  # still squashes visibly (the grip compresses it 75 -> 52 mm at 3 kPa, and a
  # ~7x stiffer block still yields several mm under the same pads).
  kMu 20000
  kLambda 20000
  kDamp 30
  particleRadius 0.01
  diffuseColor 0.93 0.78 0.16
  # ⚠ 0.8 rad (~46 deg) IS WHY THIS READS AS A BLOCK AND NOT AS A BAR OF SOAP.
  # Adjacent surface triangles further apart than this angle do NOT share a
  # smoothed vertex normal -- the vertex is split so each side keeps its own
  # face normal. A block's edges are 90 deg so they always split; a face being
  # squashed by the pads bends far less than 46 deg per triangle and stays
  # smooth. Which is exactly the discrimination this demo needs: the hard edges
  # stay hard and the SQUASH stays visible. It is the node default and is
  # written out because it is load-bearing for how the demo reads, not because
  # it needs setting.
  creaseAngle 0.8
  # ⚠ THIS BLOCK REPLACED TWO LIGHTS. Until 2026-08-15 `SoftBody` had no
  # `appearance` field, so the sponge rendered through the engine-owned PHONG
  # path from `diffuseColor` above -- and Phong takes NO image-based fill, so
  # under the canonical recipe (`ambientIntensity 0`) the sponge was pure black
  # on every face the sun did not strike. This world carried a fill
  # DirectionalLight and a PointLight whose stated job was to paper over exactly
  # that. Both are now GONE (see the lighting section above): the sponge takes
  # the same image-based fill every other PBR surface in the scene takes, so it
  # no longer needs its own private lighting rig.
  #
  # ⚠ baseColor IS LEFT AT ITS 1 1 1 DEFAULT AND MUST STAY THERE. WREN
  # MULTIPLIES baseColorMap by the baseColor field (pbr.frag:259) rather than
  # replacing it, and the sponge set carries its OWN yellow -- it is generated
  # from linear (0.93, 0.78, 0.16), the very numbers on the `diffuseColor` line
  # above. Re-declaring that colour here would square it and the sponge would go
  # muddy brown. (The woven-cotton set beside it is the opposite case: generated
  # near-neutral precisely SO a world can tint it. Same directory, opposite
  # rule.)
  #
  # ⚠ metalness 0 EXPLICITLY -- the schema default is 1, and a metal sponge
  # under ambientIntensity 0 renders near-black, i.e. exactly like the bug this
  # whole block exists to remove.
  #
  # occlusionMap is what sells the POROSITY, and it is the map most likely to be
  # dropped as an afterthought: it modulates AMBIENT only, so a pore that fails
  # to darken as the key light swings away is a painted dot rather than a hole.
  # On a scene whose fill is now entirely image-based, ambient IS most of the
  # light, so this map does more here than it would in a lit-from-everywhere
  # scene.
  #
  # TEXTURE SCALE, worked from the geometry rather than guessed. A SoftBody's
  # surface is BOX-projected in the block's own local frame, one texture per
  # face, so `scale` is in units of "tiles per face" and the physical tile size
  # differs per face because the faces differ in size. The sponge set is drawn
  # at ONE TILE = 4 CM (14 pores across it, ~2.9 mm each, which is a real
  # cellulose sponge). The block is 100 x 75 x 40 mm, so its largest face wants
  # 100/40 x 75/40 = 2.5 x 1.875 tiles -- rounded to 2.5 x 1.9, which puts that
  # face's tile at 40.0 x 39.5 mm, i.e. on design. The 40 mm-deep faces then
  # carry a stretched tile; that is inherent to one box projection over a
  # non-cubic block and is not worth a second material to fix on a body this
  # small. normalMapFactor is left at 1 BECAUSE the tile is on design -- unlike
  # the cloth worlds, which stretch their weave 8x and pay for it with 0.45.
  appearance PBRAppearance {
    baseColorMap ImageTexture {
      url [
        "textures/sponge_cellulose_basecolor.png"
      ]
    }
    normalMap ImageTexture {
      url [
        "textures/sponge_cellulose_normal.png"
      ]
    }
    roughnessMap ImageTexture {
      url [
        "textures/sponge_cellulose_roughness.png"
      ]
    }
    occlusionMap ImageTexture {
      url [
        "textures/sponge_cellulose_occlusion.png"
      ]
    }
    metalness 0
    normalMapFactor 1
    IBLStrength 1.5
    textureTransform TextureTransform {
      scale 2.5 1.9
    }
  }
}
# ===========================================================================
# THE FLYING GRIPPER. Five prismatic DoF: gantry X/Y/Z plus two opposed jaws.
#
# ⚠ THE ROOT Robot DECLARES NO `physics`, MAKING IT A STATIC ANCHOR. That is
# not tidiness: it keeps a 7-q / 6-qd FREE joint out of the articulation. Both
# shipped vbd worlds are rooted this way.
#
# ⚠ EVERY INTERMEDIATE LINK CARRIES A 1 mm SPHERE COLLIDER. A Newton body with
# no resolvable boundingObject is given a 12 CM SPHERE FALLBACK -- an invisible
# ball that would swipe through the sponge and the dish.
#
# The two jaws use OPPOSED axes (0 1 0 and 0 -1 0) so both take the SAME scalar
# command. The pinch is symmetric by construction rather than by two matching
# sign flips that can drift apart.
#
# Gains, via maxForce = load / (10 * sag):
#   gantry axes  maxForce 5000  -> ke = 5e4 N/m. Carrying ~0.3 kg that is
#                                  0.06 mm of sag.
#   jaws         maxForce 2000  -> ke = 2e4 N/m.
#
# ⚠ THE JAWS ARE DELIBERATELY 5x SOFTER THAN THE CLOTH-GRASP TEMPLATES, which
# use maxForce 10000 (ke = 1e5, newton's own finger_drive_ke). That value is
# right for FABRIC, which is one particle thick and cannot be over-compressed --
# the pad is meant to win outright. A sponge is 75 mm of compliant tetrahedra
# and CAN be crushed: the pads stall where the jaw spring balances the particle
# contact springs,
#
#       penetration = commanded_interference * ke_jaw / (ke_jaw + ke_soft_eff)
#
# and with ~15 particles per pad face at soft_contact_ke = 1e3 the sponge only
# resists with ke_soft_eff ~ 1.5e4 N/m. At ke_jaw = 1e5 that ratio is 87%, so
# nearly the whole commanded interference becomes real penetration and the pads
# drive straight through particles whose radius is only 10 mm. At 2e4 it is 57%,
# which squeezes rather than crushes.
#
# ⚠ THIS ARITHMETIC IS A PREDICTION, NOT A MEASUREMENT -- ke_soft_eff is
# estimated from the particle count, not read from the solver. The value that
# matters is the MEASURED jaw gap in SPONGE_LOG, and the controller's
# SPONGE_MIN_GAP gate must be set from that, not from this comment.
# ===========================================================================
DEF GANTRY Robot {
  translation 0 0 1.30
  children [
    DEF GX SliderJoint {
      jointParameters JointParameters {
        axis 1 0 0
      }
      device [
        LinearMotor {
          name "gantry_x"
          maxForce 5000
          maxVelocity 5
          minPosition -0.5
          maxPosition 0.5
        }
      ]
      endPoint DEF BASE_X Solid {
        children [
          DEF GY SliderJoint {
            jointParameters JointParameters {
              axis 0 1 0
            }
            device [
              LinearMotor {
                name "gantry_y"
                maxForce 5000
                maxVelocity 5
                minPosition -0.25
                maxPosition 0.25
              }
            ]
            endPoint DEF BASE_Y Solid {
              children [
                DEF GZ SliderJoint {
                  jointParameters JointParameters {
                    axis 0 0 1
                  }
                  device [
                    LinearMotor {
                      name "gantry_z"
                      maxForce 5000
                      maxVelocity 5
                      minPosition -0.5
                      maxPosition 0.1
                    }
                  ]
                  endPoint DEF CARRIAGE Solid {
                    children [
                      # Jaw joint zero == OPEN, at a 140 mm gap. The command is
                      # "how far closed from open", identical for both jaws.
                      DEF JL SliderJoint {
                        jointParameters JointParameters {
                          axis 0 1 0
                        }
                        device [
                          LinearMotor {
                            name "jaw_left"
                            maxForce 2000
                            maxVelocity 5
                            minPosition -0.15
                            maxPosition 0.06
                          }
                        ]
                        endPoint DEF LEFT_PAD Solid {
                          translation 0 -0.07 0
                          children [
                            Shape {
                              appearance PBRAppearance {
                                baseColor 0.72 0.74 0.78
                                roughness 0.4
                                metalness 0.1
                              }
                              geometry Box {
                                size 0.09 0.01 0.04
                              }
                            }
                          ]
                          name "left_pad"
                          boundingObject Box {
                            size 0.09 0.01 0.04
                          }
                          physics Physics {
                            density -1
                            mass 0.025
                          }
                        }
                      }
                      DEF JR SliderJoint {
                        jointParameters JointParameters {
                          axis 0 -1 0
                        }
                        device [
                          LinearMotor {
                            name "jaw_right"
                            maxForce 2000
                            maxVelocity 5
                            minPosition -0.15
                            maxPosition 0.06
                          }
                        ]
                        endPoint DEF RIGHT_PAD Solid {
                          translation 0 0.07 0
                          children [
                            Shape {
                              appearance PBRAppearance {
                                baseColor 0.72 0.74 0.78
                                roughness 0.4
                                metalness 0.1
                              }
                              geometry Box {
                                size 0.09 0.01 0.04
                              }
                            }
                          ]
                          name "right_pad"
                          boundingObject Box {
                            size 0.09 0.01 0.04
                          }
                          physics Physics {
                            density -1
                            mass 0.025
                          }
                        }
                      }
                    ]
                    name "carriage"
                    boundingObject Sphere {
                      radius 0.001
                    }
                    physics Physics {
                      density -1
                      mass 0.01
                    }
                  }
                }
              ]
              name "base_y"
              boundingObject Sphere {
                radius 0.001
              }
              physics Physics {
                density -1
                mass 0.01
              }
            }
          }
        ]
        name "base_x"
        boundingObject Sphere {
          radius 0.001
        }
        physics Physics {
          density -1
          mass 0.01
        }
      }
    }
  ]
  name "gantry"
  controller "vbd_sponge_dishwash"
  supervisor TRUE
}
