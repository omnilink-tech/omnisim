#VRML_SIM R2025a utf8

# Granular-sand physics demo — built end-to-end through the agent-facing
# validation harness. ~300 small Sphere bodies drop into a square pit
# and pile under gravity. Behaves like coarse granular media at pebble
# scale — settles, has an angle of repose, can be displaced by anything
# that pushes through it.
#
# Conservative tuning for the *current* engine capability:
#   - basicTimeStep 32 ms (default; 8 ms is more accurate but unusable
#     during the active fall phase with this many contact pairs)
#   - WorldInfo physicsDisable thresholds raised to 0.05 so the pile
#     sleeps fast once settled, rather than the 0.01 default that keeps
#     slow-moving bodies "active" forever
#   - physicsDisableTime 0.5 s instead of the 1.0 s default
#
# Future scaling — see docs/developer/granular-physics-plan.md for the
# tier-1-through-4 plan to take this from ~300 spheres to ~50,000.
#
# Real sand grains are ~0.1 mm and ~10^9 per m^3 — out of reach for any
# real-time rigid-body engine. Read the visual as "coarse pebbles", not
# silica sand.

EXTERNPROTO "omnisim://projects/objects/floors/protos/Floor.proto"
EXTERNPROTO "omnisim://projects/appearances/protos/SandyGround.proto"
EXTERNPROTO "omnisim://projects/objects/apartment_structure/protos/Wall.proto"
EXTERNPROTO "omnisim://projects/appearances/protos/RoughConcrete.proto"
EXTERNPROTO "omnisim://projects/objects/backgrounds/protos/OmniSimSky.proto"
EXTERNPROTO "omnisim://projects/objects/lights/protos/OmniSimSun.proto"
EXTERNPROTO "omnisim://projects/objects/lights/protos/OmniSimSunMarker.proto"

WorldInfo {
  basicTimeStep 32
  physicsDisableTime 0.5
  physicsDisableLinearThreshold 0.05
  physicsDisableAngularThreshold 0.05
  contactProperties [
    ContactProperties {
      material1 "sand_grain"
      material2 "sand_grain"
      coulombFriction [ 0.65 ]
      bounce 0.05
      bounceVelocity 0.02
    }
    ContactProperties {
      material1 "sand_grain"
      material2 "default"
      coulombFriction [ 0.7 ]
      bounce 0.0
    }
  ]
  title "Granular Sand Demo"
}

# Slight overhead 3/4 view of the pit so you can see grains piling in.
Viewpoint {
  orientation -0.5773 0.5773 0.5773 2.0944
  position 0 0 50
}
OmniSimSky { }
DEF SUN OmniSimSun { }
DEF SUN_MARKER OmniSimSunMarker { }

DirectionalLight {
  direction -0.4 0.4 -0.4
  color 0.7 0.75 0.85
  intensity 0.9
  castShadows FALSE
}

Floor {
  size 8 8
  tileSize 2 2
  appearance SandyGround { textureTransform TextureTransform { scale 4 4 } }
}
Wall { name "wall_N" translation 0 1.4 0.500 rotation 0 0 1 0 size 3.0999999999999996 0.15 1.0 appearance RoughConcrete {} }
Wall { name "wall_S" translation 0 -1.4 0.500 rotation 0 0 1 0 size 3.0999999999999996 0.15 1.0 appearance RoughConcrete {} }
Wall { name "wall_E" translation 1.4 0 0.500 rotation 0 0 1 1.5708 size 2.8 0.15 1.0 appearance RoughConcrete {} }
Wall { name "wall_W" translation -1.4 0 0.500 rotation 0 0 1 1.5708 size 2.8 0.15 1.0 appearance RoughConcrete {} }
DEF G_0 Solid {
  translation -0.3168 -0.3185 1.6033
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.723 0.593 0.380
        roughness 0.9
        metalness 0.0
      }
      geometry Sphere { radius 0.05 subdivision 1 }
    }
  ]
  name "g0"
  contactMaterial "sand_grain"
  boundingObject Sphere { radius 0.05 subdivision 1 }
  physics Physics { density -1 mass 0.837758 }
}
