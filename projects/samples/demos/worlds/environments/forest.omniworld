#OMNISIM R2025a utf8

# Forest (cinematic morning-light edition) — companion environment to
# environments/desert_ruins.omniworld. Same OmniSim recipe (procedural sky +
# OmniSimSun + draggable SUN_MARKER) and the same level of hand-built
# detail, but tuned for a deep-mist deciduous-conifer mix instead of
# golden-hour desert.
#
# This file is an *environment* — no robots. Demos that want a husky/
# spot/etc. driving through this forest should compose on top of it
# (EXTERNPROTO this file's tree/floor content, or copy + add their
# robots).
#
# Composition strategy
# --------------------
#   - Light: warm side-low sun (~25° elevation, NE quadrant) so it
#     rakes between the trunks and casts long shadow stripes across
#     the floor — the dappled-light reading that says "forest" more
#     than the trees themselves do. castShadows TRUE (single biggest
#     realism win).
#   - Atmosphere: heavier fog than the desert (visibility ~110 m,
#     warm-cool neutral) so the back rows fade into mist. This is
#     what fakes the volumetric god-rays-through-trees look on a
#     forward renderer that has no real volumetrics.
#   - Foreground: 8-10 hero trees within 15 m of the central clearing
#     plus understory (ferns, mushrooms, fallen logs, moss-coloured
#     rocks, stumps). Eye reads them first.
#   - Mid-ground (15-40 m): mixed Oak / Pine / BigSassafras / Cypress
#     at varied density, with broken-light gaps.
#   - Background (40-90 m): dense filler — three Forest PROTO patches
#     (procedural-placed random species) give crowd density without
#     hand-placing 200 more trees.
#   - Floor: terrain uses Grass PBR; on top we lay leaf-litter
#     patches (Soil/DryMud) and a dirt path winding NW through the
#     scene — the path leads the eye toward the sunlit gap.

EXTERNPROTO "omnisim://projects/objects/floors/protos/UnevenTerrain.proto"
EXTERNPROTO "omnisim://projects/appearances/protos/Grass.proto"
EXTERNPROTO "omnisim://projects/appearances/protos/Soil.proto"
EXTERNPROTO "omnisim://projects/appearances/protos/DryMud.proto"
EXTERNPROTO "omnisim://projects/appearances/protos/RoughOak.proto"
EXTERNPROTO "omnisim://projects/appearances/protos/RoughPine.proto"
EXTERNPROTO "omnisim://projects/appearances/protos/Plaster.proto"
EXTERNPROTO "omnisim://projects/objects/trees/protos/Oak.proto"
EXTERNPROTO "omnisim://projects/objects/trees/protos/Pine.proto"
EXTERNPROTO "omnisim://projects/objects/trees/protos/BigSassafras.proto"
EXTERNPROTO "omnisim://projects/objects/trees/protos/Sassafras.proto"
EXTERNPROTO "omnisim://projects/objects/trees/protos/Cypress.proto"
EXTERNPROTO "omnisim://projects/objects/trees/protos/SimpleTree.proto"
EXTERNPROTO "omnisim://projects/objects/rocks/protos/Rock.proto"
EXTERNPROTO "omnisim://projects/objects/backgrounds/protos/OmniSimSky.proto"
EXTERNPROTO "omnisim://projects/objects/lights/protos/OmniSimSun.proto"
EXTERNPROTO "omnisim://projects/objects/lights/protos/OmniSimSunMarker.proto"

WorldInfo {
  basicTimeStep 16
  title "Forest"
}

# Eye-level camera (1.9 m) inside the clearing, looking NW down the
# path between the trunks toward the backlit canopy gap. ~50° FOV
# (0.85 rad) for a natural standing-human-in-forest feel — wider
# than the desert hero shot because the forest needs to read across
# more vertical span (canopy + trunks + floor in one frame).
# Orientation computed via /scene/look_at {position:[14,-14,1.9],
# target:[-12,16,3]} on the harness.
Viewpoint {
  orientation 0.0 -0.05163537 0.99866637 2.36492113
  position 14 -14 1.9
  fieldOfView 0.85
  near 0.1
  ambientOcclusionRadius 2
  bloomThreshold 4
}

# Cool morning sky — neutral upper band, warm pre-dawn near the sun.
# Lower luminosity than the desert so the canopy reads as the brightest
# thing in frame (dappled light hierarchy).
OmniSimSky {
  skyColor [ 0.22 0.28 0.26 ]
  luminosity 0.65
}

# Warm side-low sun in the NE quadrant. Lower intensity than desert
# (3.0 vs 4.2) because the forest is meant to feel cooler and shadier;
# strong contrast between lit canopy and shaded floor sells the
# dappled-light reading. The runtime sun_marker controller overrides
# direction every step using SUN_MARKER's pose.
DEF SUN OmniSimSun {
  color 1.0 0.78 0.50
  direction -0.48 -0.78 -0.40
  intensity 3.6
  ambientIntensity 0
}

# Sun marker low and to the NE, ~24° above the horizon. Its position
# is also chosen so the marker disk falls visible through a tree gap
# in the hero shot's upper-third when the camera is at default pose.
DEF SUN_MARKER OmniSimSunMarker {
  translation 42 70 13
  radius 1.0
  baseColor 1.0 0.78 0.40
  emissiveColor 1.0 0.58 0.20
  emissiveIntensity 150
}

# Cool sky fill from the opposite (SW) quadrant — keeps deep-shade
# trunks from reading pure black.
DirectionalLight {
  direction 0.5 0.6 -0.5
  color 0.45 0.55 0.70
  intensity 0.9
  ambientIntensity 0.0
  castShadows FALSE
}

# Subtle green canopy bounce from above — fakes the wrap-around tint
# of light filtering through leaves. Almost no intensity, but it
# colors shadowed sides of trunks slightly green.
DirectionalLight {
  direction 0 0 -1
  color 0.42 0.62 0.40
  intensity 0.25
  ambientIntensity 0.0
  castShadows FALSE
}

# Forest mist — neutral cool tone, exponential, dense enough that the
# back rows of trees fade legibly into the haze (visibilityRange 110).
# This is the single biggest atmosphere lever — fake-volumetrics for
# a forward renderer that has no real volumetric scattering.
Fog {
  color 0.50 0.55 0.50
  fogType "EXPONENTIAL"
  visibilityRange 55
}

# ============================================================================
# Terrain — 200 m square, rolling perlin hills (size.z 6, octaves 7).
# Grass PBR with normal+occlusion maps, tile scale 35 so close-up
# detail is sub-meter without the obvious-repeat pattern we hit in
# the desert. flatCenter keeps the clearing flat.
# ============================================================================
# translation z is 0 — the flat-center clearing sits at world z=0,
# matching the implicit "ground at z=0" assumption for every tree,
# log, branch, leaf-pile, etc. below. Previously z=-0.3 made every
# centred object hover 0.3 m above the clearing.
UnevenTerrain {
  translation 0 0 0
  name "forest_terrain"
  size 200 200 6
  xDimension 180
  yDimension 180
  appearance Grass {
    textureTransform TextureTransform { scale 35 35 }
  }
  randomSeed 19
  flatCenter TRUE
  perlinNOctaves 7
}

# ============================================================================
# Background ring — hand-placed real-mesh trees in the 25-80 m belt
# around the clearing. We deliberately do NOT use Webots' Forest
# PROTO here: it generates 8-polygon SimpleTree billboards which read
# as flat cardboard cutouts against the high-detail Oak/Pine/Sassafras
# protos in front. Heavier (more polygons), but visually consistent.
#
# Layout is a stochastic ring with three density bands:
#   25-40 m (inner ring, mostly visible):       ~22 trees
#   40-65 m (mid ring, partial fog):            ~22 trees
#   65-90 m (outer ring, silhouettes in fog):   ~14 trees
# Mixed Oak / Pine / BigSassafras / Sassafras + Cypress at varied
# scale for vertical variety.
# ============================================================================

# --- 25-40 m inner ring ---
Oak  { translation -32  16 0  rotation 0 0 1  0.4  name "bg_oak_NW1" }
Oak  { translation -28  30 0  rotation 0 0 1  1.6  name "bg_oak_NW2" }
Oak  { translation -10  35 0  rotation 0 0 1  0.7  name "bg_oak_N1"  }
Oak  { translation  12  36 0  rotation 0 0 1  2.2  name "bg_oak_N2"  }
Oak  { translation  28  28 0  rotation 0 0 1  0.3  name "bg_oak_NE1" }
Pine { translation  35   8 0  rotation 0 0 1  1.4  name "bg_pine_E1" }
Pine { translation  32  -8 0  rotation 0 0 1  0.9  name "bg_pine_E2" }
Pine { translation  18  32 0  rotation 0 0 1  1.0  name "bg_pine_NE3" }
Pine { translation -35  -2 0  rotation 0 0 1  0.5  name "bg_pine_W1" }
Pine { translation -33  -15 0 rotation 0 0 1  1.8  name "bg_pine_W2" }
BigSassafras { translation  -3  32 0 rotation 0 0 1  0.2  name "bg_sass_N1" }
BigSassafras { translation -22  26 0 rotation 0 0 1  1.1  name "bg_sass_NW1" }
BigSassafras { translation  26  18 0 rotation 0 0 1  0.6  name "bg_sass_NE1" }
BigSassafras { translation  34 -22 0 rotation 0 0 1  2.4  name "bg_sass_SE1" }
BigSassafras { translation -16 -28 0 rotation 0 0 1  0.8  name "bg_sass_SW1" }
Sassafras { translation  22  -28 0  rotation 0 0 1  1.5  name "bg_sass_S1"  }
Sassafras { translation  -8  -30 0  rotation 0 0 1  0.2  name "bg_sass_S2"  }
Sassafras { translation  6   -28 0  rotation 0 0 1  2.0  name "bg_sass_S3"  }
Sassafras { translation -30   20 0  rotation 0 0 1  0.9  name "bg_sass_NW2" }
Cypress { translation -28 -22 0 scale 1.1 rotation 0 0 1  1.0  name "bg_cyp_SW1" }
Cypress { translation  28 -16 0 scale 0.9 rotation 0 0 1  0.4  name "bg_cyp_SE1" }
Cypress { translation -38   8 0 scale 1.0 rotation 0 0 1  1.8  name "bg_cyp_W1" }

# --- 40-65 m mid ring (partially in fog) ---
Oak  { translation -52  35 0  rotation 0 0 1  0.5  name "bg_oak_far_NW1" }
Oak  { translation -42  52 0  rotation 0 0 1  1.3  name "bg_oak_far_N1" }
Oak  { translation   2  55 0  rotation 0 0 1  0.7  name "bg_oak_far_N2" }
Oak  { translation  48  38 0  rotation 0 0 1  2.0  name "bg_oak_far_NE1" }
Oak  { translation  55   8 0  rotation 0 0 1  0.4  name "bg_oak_far_E1" }
Oak  { translation -55 -25 0  rotation 0 0 1  1.7  name "bg_oak_far_W1" }
Pine { translation  60  20 0  rotation 0 0 1  0.8  name "bg_pine_far_E1" }
Pine { translation  58 -32 0  rotation 0 0 1  1.6  name "bg_pine_far_SE1" }
Pine { translation -60  -8 0  rotation 0 0 1  0.3  name "bg_pine_far_W1" }
Pine { translation  -8  62 0  rotation 0 0 1  1.0  name "bg_pine_far_N1" }
Pine { translation  22  52 0  rotation 0 0 1  2.1  name "bg_pine_far_NE2" }
BigSassafras { translation -48 -38 0 rotation 0 0 1  0.4  name "bg_sass_far_SW1" }
BigSassafras { translation  44 -45 0 rotation 0 0 1  1.5  name "bg_sass_far_SE1" }
BigSassafras { translation  -2 -55 0 rotation 0 0 1  0.8  name "bg_sass_far_S1" }
BigSassafras { translation  62 -10 0 rotation 0 0 1  2.3  name "bg_sass_far_E1" }
BigSassafras { translation -62  20 0 rotation 0 0 1  0.6  name "bg_sass_far_W2" }
Sassafras { translation -30 -50 0   rotation 0 0 1  1.2  name "bg_sass_far_SW2" }
Sassafras { translation  30 -55 0   rotation 0 0 1  0.5  name "bg_sass_far_SE2" }
Sassafras { translation  16 -42 0   rotation 0 0 1  1.9  name "bg_sass_far_S2" }
Cypress { translation  52 -22 0 scale 1.2 rotation 0 0 1  0.7  name "bg_cyp_far_SE1" }
Cypress { translation -55  14 0 scale 1.1 rotation 0 0 1  1.4  name "bg_cyp_far_W1" }
Cypress { translation  10  60 0 scale 1.0 rotation 0 0 1  2.0  name "bg_cyp_far_N1" }

# --- 65-90 m outer ring (silhouettes in deep fog) ---
Oak  { translation -78  45 0  rotation 0 0 1  0.6  name "bg_oak_xfar_NW1" }
Oak  { translation -82 -15 0  rotation 0 0 1  1.4  name "bg_oak_xfar_W1" }
Oak  { translation  75  35 0  rotation 0 0 1  0.9  name "bg_oak_xfar_NE1" }
Oak  { translation  80 -22 0  rotation 0 0 1  2.0  name "bg_oak_xfar_E1" }
Pine { translation  -8  82 0  rotation 0 0 1  0.5  name "bg_pine_xfar_N1" }
Pine { translation  25  78 0  rotation 0 0 1  1.7  name "bg_pine_xfar_NE1" }
Pine { translation -28  82 0  rotation 0 0 1  0.2  name "bg_pine_xfar_NW1" }
Pine { translation  85 -45 0  rotation 0 0 1  1.1  name "bg_pine_xfar_SE1" }
Pine { translation -85 -50 0  rotation 0 0 1  1.9  name "bg_pine_xfar_SW1" }
BigSassafras { translation -75 -60 0 rotation 0 0 1  0.4  name "bg_sass_xfar_SW1" }
BigSassafras { translation  70 -70 0 rotation 0 0 1  1.5  name "bg_sass_xfar_SE1" }
BigSassafras { translation   5 -85 0 rotation 0 0 1  0.8  name "bg_sass_xfar_S1" }
Sassafras { translation -50 -75 0   rotation 0 0 1  1.0  name "bg_sass_xfar_SW2" }
Sassafras { translation  55 -82 0   rotation 0 0 1  0.6  name "bg_sass_xfar_SE2" }

# ============================================================================
# Hand-placed hero trees — within 15 m of the central clearing where
# the eye reads first. Mixed species so silhouettes vary.
# ============================================================================
# Frame-edge foreground hero trees: ~5-8 m from camera along the
# view direction, just off-axis so they curtain the shot without
# blocking the path. Anchors the lower corners with bark silhouette.
Oak    { translation  13.0  -8.2 0  rotation 0 0 1  0.5  name "oak_frame_R_close" }
Oak    { translation   8.4 -12.2 0  rotation 0 0 1  1.8  name "oak_frame_L_close" }
BigSassafras { translation  11.8  -5.3 0  rotation 0 0 1  0.9  name "sass_frame_R_mid" }
BigSassafras { translation   5.8 -10.6 0  rotation 0 0 1  2.4  name "sass_frame_L_mid" }
# Hero trees in the mid path zone
Oak  { translation  10  -2 0  rotation 0 0 1  0.7  name "oak_hero_L" }
Oak  { translation -11  -3 0  rotation 0 0 1 -0.4  name "oak_hero_R" }
Pine { translation  -6   8 0  rotation 0 0 1  0.2  name "pine_mid_NW" }
Pine { translation   7  10 0  rotation 0 0 1  1.5  name "pine_mid_NE" }
BigSassafras { translation  -3  14 0  rotation 0 0 1  0.6  name "sass_mid_N" }
BigSassafras { translation  12  -8 0  rotation 0 0 1  2.1  name "sass_hero_SE" }
Sassafras    { translation  -9   2 0  rotation 0 0 1  1.1  name "sass_close_W" }
Sassafras    { translation   2  -7 0  rotation 0 0 1 -0.8  name "sass_close_S" }
Cypress      { translation   4   3 0  rotation 0 0 1  0.3  name "cyp_close_NE" }
Cypress      { translation  -5  -8 0  rotation 0 0 1  1.0  name "cyp_close_SW" }
# Canopy-cover trees placed BEHIND and BESIDE the camera so their
# crowns sit overhead in the hero shot, blocking the bright sky band
# at the top of frame — the "you are under trees" feeling.
Oak  { translation  18 -22 0  rotation 0 0 1  1.4  name "canopy_back_R" }
Oak  { translation  10 -24 0  rotation 0 0 1  0.5  name "canopy_back_C" }
Pine { translation  22 -16 0  rotation 0 0 1  2.0  name "canopy_back_R2" }
BigSassafras { translation   5 -20 0  rotation 0 0 1  0.9  name "canopy_back_L" }

# Inner mid-ring (10-20 m) — fills the gap between the path zone
# and the back forest patches.
Pine    { translation  15   0 0  rotation 0 0 1  0.4  name "pine_inner_E" }
Pine    { translation -15   0 0  rotation 0 0 1  1.7  name "pine_inner_W" }
Cypress { translation  18  -6 0  rotation 0 0 1  0.6  name "cyp_inner_SE" }
BigSassafras { translation -18  -4 0  rotation 0 0 1  1.3  name "sass_inner_SW" }
Sassafras { translation  15  12 0  rotation 0 0 1  0.2  name "sass_inner_NE" }
Pine    { translation -15  14 0  rotation 0 0 1  2.0  name "pine_inner_NW" }
Oak     { translation  20   8 0  rotation 0 0 1  0.8  name "oak_inner_E" }
BigSassafras { translation -20  10 0  rotation 0 0 1  1.5  name "sass_inner_W" }

# Mid-ring (15-30 m): tree wall that reads as the start of the deep
# forest. Mixed species, mostly closing in from the sides.
Oak  { translation  22   6 0  rotation 0 0 1  0.4  name "oak_mid_E1" }
Oak  { translation -20   8 0  rotation 0 0 1  1.2  name "oak_mid_W1" }
Oak  { translation  18  18 0  rotation 0 0 1  2.4  name "oak_mid_NE2" }
Oak  { translation -18 -14 0  rotation 0 0 1  0.0  name "oak_mid_SW2" }
Pine { translation  25  -8 0  rotation 0 0 1  1.7  name "pine_mid_E1" }
Pine { translation -25  -2 0  rotation 0 0 1 -0.5  name "pine_mid_W1" }
Pine { translation  14  24 0  rotation 0 0 1  0.8  name "pine_mid_NE1" }
Pine { translation -14  22 0  rotation 0 0 1  0.4  name "pine_mid_NW1" }
Pine { translation   5  28 0  rotation 0 0 1  1.6  name "pine_mid_N1" }
Pine { translation -22 -22 0  rotation 0 0 1  2.0  name "pine_mid_SW" }
BigSassafras { translation  28  16 0  rotation 0 0 1  0.5  name "sass_mid_NE3" }
BigSassafras { translation -28  18 0  rotation 0 0 1  1.4  name "sass_mid_NW3" }
BigSassafras { translation  -8 -20 0  rotation 0 0 1  0.9  name "sass_mid_S" }
BigSassafras { translation  20 -18 0  rotation 0 0 1 -0.6  name "sass_mid_SE" }
Cypress      { translation  17  10 0  rotation 0 0 1  0.7  name "cyp_mid_E" }
Cypress      { translation -16   4 0  rotation 0 0 1  1.3  name "cyp_mid_W" }
Cypress      { translation  10 -22 0  rotation 0 0 1  2.2  name "cyp_mid_S" }
Cypress      { translation -10  26 0  rotation 0 0 1  0.1  name "cyp_mid_N" }
Sassafras    { translation  30   2 0  rotation 0 0 1  0.5  name "sass_mid_E" }
Sassafras    { translation -30   8 0  rotation 0 0 1  1.0  name "sass_mid_W" }

# ============================================================================
# Forest floor — fallen logs, stumps, mossy rocks, mushroom clusters,
# fern patches, leaf-litter zones. This is what sells "lived-in forest"
# vs "just some trees".
# ============================================================================

# --- Dirt path winding NW from camera through the clearing. Soil
# appearance (darker brown) reads as worn earth where feet have
# trodden the grass away.
DEF PATH_1 Solid {
  translation 4 -10 0.06
  rotation 0 0 1 0.7
  children [ Shape { appearance DryMud { textureTransform TextureTransform { scale 6 2 } } geometry Box { size 9 2.2 0.12 } castShadows FALSE } ]
  name "path_1"
}
DEF PATH_2 Solid {
  translation -1 -4 0.06
  rotation 0 0 1 0.85
  children [ Shape { appearance DryMud { textureTransform TextureTransform { scale 6 2 } } geometry Box { size 8 2.0 0.12 } castShadows FALSE } ]
  name "path_2"
}
DEF PATH_3 Solid {
  translation -6 3 0.06
  rotation 0 0 1 0.95
  children [ Shape { appearance DryMud { textureTransform TextureTransform { scale 6 2 } } geometry Box { size 7 2.0 0.12 } castShadows FALSE } ]
  name "path_3"
}
DEF PATH_4 Solid {
  translation -10 10 0.06
  rotation 0 0 1 1.05
  children [ Shape { appearance DryMud { textureTransform TextureTransform { scale 6 2 } } geometry Box { size 6 1.8 0.12 } castShadows FALSE } ]
  name "path_4"
}

# --- Fallen logs — cylinders lying horizontally, RoughOak appearance
# so they catch bark texture. Half-sunk into the ground so they look
# settled and weathered.
DEF LOG_1 Solid {
  translation -6 12 0.5
  rotation 0.95 0.3 0 1.5708
  children [ Shape { appearance RoughOak { textureTransform TextureTransform { scale 1 4 } } geometry Cylinder { height 6 radius 0.55 } } ]
  name "log_1"
}
DEF LOG_2 Solid {
  translation 11 5 0.4
  rotation 0.6 0.8 0 1.5708
  children [ Shape { appearance RoughOak { textureTransform TextureTransform { scale 1 3 } } geometry Cylinder { height 4 radius 0.45 } } ]
  name "log_2"
}
DEF LOG_3 Solid {
  translation -14 -6 0.45
  rotation 1 0 0 1.5708
  children [ Shape { appearance RoughOak { textureTransform TextureTransform { scale 1 5 } } geometry Cylinder { height 7 radius 0.5 } } ]
  name "log_3"
}
DEF LOG_4 Solid {
  translation 8 18 0.3
  rotation 0.4 0.92 0 1.5708
  children [ Shape { appearance RoughPine { textureTransform TextureTransform { scale 1 4 } } geometry Cylinder { height 5 radius 0.4 } } ]
  name "log_4"
}
DEF LOG_5 Solid {
  translation -20 4 0.4
  rotation 0.85 0.5 0 1.5708
  children [ Shape { appearance RoughOak { textureTransform TextureTransform { scale 1 5 } } geometry Cylinder { height 6 radius 0.5 } } ]
  name "log_5"
}
DEF LOG_6 Solid {
  translation 16 -4 0.35
  rotation 0 1 0 1.5708
  children [ Shape { appearance RoughPine { textureTransform TextureTransform { scale 1 3 } } geometry Cylinder { height 4.5 radius 0.42 } } ]
  name "log_6"
}

# --- Tree stumps — short wide cylinders with RoughOak texture,
# scattered as evidence of past clearing.
DEF STUMP_1 Solid {
  translation 4 5 0.35
  children [ Shape { appearance RoughOak { textureTransform TextureTransform { scale 1 1 } } geometry Cylinder { height 0.7 radius 0.6 } } ]
  name "stump_1"
}
DEF STUMP_2 Solid {
  translation -8 -10 0.4
  children [ Shape { appearance RoughOak {} geometry Cylinder { height 0.8 radius 0.7 } } ]
  name "stump_2"
}
DEF STUMP_3 Solid {
  translation 18 14 0.35
  children [ Shape { appearance RoughOak {} geometry Cylinder { height 0.7 radius 0.5 } } ]
  name "stump_3"
}
DEF STUMP_4 Solid {
  translation -14 20 0.3
  children [ Shape { appearance RoughPine {} geometry Cylinder { height 0.6 radius 0.55 } } ]
  name "stump_4"
}

# --- Mossy rocks — Rock proto with mossy-stone appearance hint; use
# default Rock and a few extra DEF mossy-tinted spheres for variation.
# Distributed near the path and the foreground logs.
Rock { translation  3 -5 0 rotation 0 0 1 0.3 name "rock_1" scale 1.1 }
Rock { translation -3 -3 0 rotation 0 0 1 1.2 name "rock_2" scale 0.9 type "flat" }
Rock { translation  6  3 0 rotation 0 0 1 2.0 name "rock_3" scale 0.7 }
Rock { translation -6  5 0 rotation 0 0 1 -0.5 name "rock_4" scale 1.0 }
Rock { translation  9 -7 0 rotation 0 0 1 1.6 name "rock_5" scale 1.3 }
Rock { translation -10  0 0 rotation 0 0 1 0.4 name "rock_6" scale 0.8 type "flat" }
Rock { translation -3 -15 0 rotation 0 0 1 1.0 name "rock_7" scale 1.4 }
Rock { translation 15  8 0 rotation 0 0 1 -0.3 name "rock_8" scale 1.2 }
Rock { translation -16  16 0 rotation 0 0 1 0.8 name "rock_9" scale 1.6 }
Rock { translation 22 -14 0 rotation 0 0 1 1.4 name "rock_10" scale 1.3 type "flat" }
# Moss-coloured boulder cluster — inline PBRAppearance tinted
# green-grey because Webots has no dedicated "mossy stone" appearance
# and a tinted matte material reads well enough at this scale.
# Mossy boulders — raised z by +0.3 to keep them looking half-buried
# now that the clearing is at z=0 instead of z=-0.3. Each sphere
# bottom sits ~0.3 m below ground, exposing the top hemisphere.
DEF MOSSY_BOULDER_1 Solid {
  translation -1 -8 0.5
  rotation 0 0 1 0.5
  children [ Shape { appearance PBRAppearance { baseColor 0.42 0.50 0.36 roughness 1.0 metalness 0.0 } geometry Sphere { radius 0.8 subdivision 4 } } ]
  name "mossy_boulder_1"
}
DEF MOSSY_BOULDER_2 Solid {
  translation -3 -9 0.35
  rotation 0 0 1 1.2
  children [ Shape { appearance PBRAppearance { baseColor 0.38 0.46 0.32 roughness 1.0 metalness 0.0 } geometry Sphere { radius 0.6 subdivision 4 } } ]
  name "mossy_boulder_2"
}
DEF MOSSY_BOULDER_3 Solid {
  translation 1 -10 0.45
  rotation 0 0 1 -0.4
  children [ Shape { appearance PBRAppearance { baseColor 0.44 0.52 0.38 roughness 1.0 metalness 0.0 } geometry Sphere { radius 0.7 subdivision 4 } } ]
  name "mossy_boulder_3"
}

# --- Mushroom clusters — small white-cap mushroom stems, hand-faked
