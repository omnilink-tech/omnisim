# ============================================================================
# Undergrowth — SimpleTree at small height (Webots' efficient 8-polygon
# customisable tree mesh, set to bush dimensions). Real plant geometry,
# not Box clusters. Mixed species via `type` so different bushes show
# different leaf textures.
# ============================================================================
# Small bushes (~0.8-1.2 m tall) scattered through the foreground and
# mid-ring. "hazel tree" and "cherry tree" types read most like
# rounded broadleaf shrubs at small scale.
SimpleTree { translation -7   9 0   rotation 0 0 1  0.3  name "bush_NW1" type "hazel tree"  height 1.1  radius 0.7  subdivision 3 enableBoundingObject FALSE }
SimpleTree { translation  8   6 0   rotation 0 0 1  1.0  name "bush_NE1" type "cherry tree" height 0.9  radius 0.6  subdivision 3 enableBoundingObject FALSE }
SimpleTree { translation -11 -4 0   rotation 0 0 1  0.6  name "bush_W1"  type "hazel tree"  height 1.0  radius 0.65 subdivision 3 enableBoundingObject FALSE }
SimpleTree { translation  12 -10 0  rotation 0 0 1 -0.4  name "bush_SE1" type "hazel tree"  height 1.2  radius 0.8  subdivision 3 enableBoundingObject FALSE }
SimpleTree { translation  -2 -6 0   rotation 0 0 1  1.4  name "bush_S1"  type "cherry tree" height 0.8  radius 0.55 subdivision 3 enableBoundingObject FALSE }
SimpleTree { translation   6  16 0  rotation 0 0 1  0.5  name "bush_N1"  type "hazel tree"  height 1.3  radius 0.75 subdivision 3 enableBoundingObject FALSE }
SimpleTree { translation -10  16 0  rotation 0 0 1  1.8  name "bush_NW2" type "cherry tree" height 1.0  radius 0.65 subdivision 3 enableBoundingObject FALSE }
SimpleTree { translation  18  2 0   rotation 0 0 1  0.9  name "bush_E1"  type "hazel tree"  height 1.1  radius 0.7  subdivision 3 enableBoundingObject FALSE }
SimpleTree { translation -18  -8 0  rotation 0 0 1  2.1  name "bush_SW1" type "hazel tree"  height 0.9  radius 0.6  subdivision 3 enableBoundingObject FALSE }
SimpleTree { translation  3   12 0  rotation 0 0 1 -0.6  name "bush_NN1" type "cherry tree" height 1.0  radius 0.7  subdivision 3 enableBoundingObject FALSE }
SimpleTree { translation  -8 -12 0  rotation 0 0 1  0.2  name "bush_SS1" type "hazel tree"  height 1.2  radius 0.75 subdivision 3 enableBoundingObject FALSE }
SimpleTree { translation  16 -2 0   rotation 0 0 1  1.5  name "bush_E2"  type "cherry tree" height 0.8  radius 0.55 subdivision 3 enableBoundingObject FALSE }

# Saplings — young trees, mid-height SimpleTree (2-3 m). Reads as
# next-generation trees coming up between the canopy, gives vertical
# variety at mid-floor level. "white pine" + "spruce" types for
# conifer saplings.
SimpleTree { translation  9   2 0   rotation 0 0 1  0.6  name "sapling_E"   type "white pine" height 2.4 radius 0.6 subdivision 3 enableBoundingObject FALSE }
SimpleTree { translation -7  -1 0   rotation 0 0 1  1.2  name "sapling_W"   type "spruce"     height 2.6 radius 0.7 subdivision 3 enableBoundingObject FALSE }
SimpleTree { translation  4  -4 0   rotation 0 0 1  0.4  name "sapling_S"   type "white pine" height 2.0 radius 0.5 subdivision 3 enableBoundingObject FALSE }
SimpleTree { translation -12  6 0   rotation 0 0 1  1.7  name "sapling_NW"  type "spruce"     height 2.8 radius 0.75 subdivision 3 enableBoundingObject FALSE }
SimpleTree { translation  14  6 0   rotation 0 0 1  2.0  name "sapling_NE"  type "white pine" height 2.4 radius 0.6 subdivision 3 enableBoundingObject FALSE }
SimpleTree { translation -3  20 0   rotation 0 0 1  0.8  name "sapling_N"   type "spruce"     height 2.8 radius 0.7 subdivision 3 enableBoundingObject FALSE }
SimpleTree { translation  6 -16 0   rotation 0 0 1  1.3  name "sapling_SE"  type "white pine" height 2.2 radius 0.6 subdivision 3 enableBoundingObject FALSE }
SimpleTree { translation -14 -10 0  rotation 0 0 1  0.3  name "sapling_SW"  type "spruce"     height 2.5 radius 0.7 subdivision 3 enableBoundingObject FALSE }

