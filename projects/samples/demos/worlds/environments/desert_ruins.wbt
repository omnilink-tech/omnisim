DEF RIPPLE_GROUP_D_3 Solid { translation 57 -11 0.08 rotation 0 0 1 0.5 children [ Shape { appearance SandyGround { textureTransform TextureTransform { scale 5 1 } } geometry Box { size 6 0.8 0.15 } castShadows FALSE } ] name "ripple_d_3" }

DEF RIPPLE_GROUP_E_1 Solid { translation -60  45 0.08 rotation 0 0 1 0.65 children [ Shape { appearance SandyGround { textureTransform TextureTransform { scale 5 1 } } geometry Box { size 8 0.8 0.15 } castShadows FALSE } ] name "ripple_e_1" }
DEF RIPPLE_GROUP_E_2 Solid { translation -57  42 0.08 rotation 0 0 1 0.65 children [ Shape { appearance SandyGround { textureTransform TextureTransform { scale 5 1 } } geometry Box { size 9 0.9 0.15 } castShadows FALSE } ] name "ripple_e_2" }
DEF RIPPLE_GROUP_E_3 Solid { translation -63  48 0.08 rotation 0 0 1 0.65 children [ Shape { appearance SandyGround { textureTransform TextureTransform { scale 5 1 } } geometry Box { size 7 0.8 0.15 } castShadows FALSE } ] name "ripple_e_3" }

# --- Darker mineral patches: small areas of DryMud reading as exposed
