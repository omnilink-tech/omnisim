#VRML_SIM R2025a utf8

# Desert ruins (cinematic golden-hour edition) — pushed to the
# visualization limits of OmniSim's WREN/OpenGL renderer.
#
# The backdrop is hand-built ancient desert architecture: a 4-tier
# ziggurat, an Egyptian-style pylon gate, a colossal marble colonnade
# (eight columns, three collapsed), an obelisk, and a half-buried
# stone dome — plus haze-faded duplicates on the far horizon. We
# deliberately do NOT use the generic city-stock building protos
# (HollowBuilding, BigGlassTower, BuildingUnderConstruction) — they
# read as textured boxes and look wrong in a desert. All the
# silhouettes here are primitive composites (Box/Cylinder/Sphere)
# with mineral PBRAppearance (Plaster/DryMud/Marble) so the
# Rayleigh-tinted sun catches them as warm sandstone.
#
# What changed vs. the previous pass:
#   - Low warm sun + atmosphericSky=earth: scattering tints the sky to
#     dusk and the sun casts long shadows across every dune.
#   - Eye-level cinematic camera (~2.4 m), 35° FOV, framed across the
#     plaza toward the backlit NW skyline.
#   - Layered composition:
#       * hero foreground: fractured colonnade + rebar-spiked debris
#       * mid plaza: StoneFountain, broken benches, columns, brick stub
#       * far skyline: tilted ruined towers, silhouetted, half-buried
#     The eye reads foreground → midground → silhouettes → sun.
#   - Material variety (not just RoughConcrete): FormedConcrete, Marble,
#     RedBricks, RustyMetal, OldSteel, CorrodedMetal, DryMud, Plaster.
#   - 300 m perlin terrain at 8 octaves with Sand (PBR + normal map).
#   - Dense scatter: ~50 rocks, sand drifts, dead-vegetation specks.
#   - Warm exponential fog: cheap atmospheric perspective.

EXTERNPROTO "omnisim://projects/objects/floors/protos/UnevenTerrain.proto"
EXTERNPROTO "omnisim://projects/appearances/protos/Sand.proto"
EXTERNPROTO "omnisim://projects/appearances/protos/SandyGround.proto"
EXTERNPROTO "omnisim://projects/appearances/protos/RoughConcrete.proto"
EXTERNPROTO "omnisim://projects/appearances/protos/FormedConcrete.proto"
EXTERNPROTO "omnisim://projects/appearances/protos/Marble.proto"
EXTERNPROTO "omnisim://projects/appearances/protos/RedBricks.proto"
EXTERNPROTO "omnisim://projects/appearances/protos/RustyMetal.proto"
EXTERNPROTO "omnisim://projects/appearances/protos/CorrodedMetal.proto"
EXTERNPROTO "omnisim://projects/appearances/protos/OldSteel.proto"
EXTERNPROTO "omnisim://projects/appearances/protos/DryMud.proto"
EXTERNPROTO "omnisim://projects/appearances/protos/Plaster.proto"
EXTERNPROTO "omnisim://projects/objects/street_furniture/protos/StoneFountain.proto"
EXTERNPROTO "omnisim://projects/objects/street_furniture/protos/StoneBench.proto"
EXTERNPROTO "omnisim://projects/objects/rocks/protos/Rock.proto"
EXTERNPROTO "omnisim://projects/objects/trees/protos/PalmTree.proto"
EXTERNPROTO "omnisim://projects/objects/apartment_structure/protos/Wall.proto"
EXTERNPROTO "omnisim://projects/objects/backgrounds/protos/OmniSimSky.proto"
EXTERNPROTO "omnisim://projects/objects/lights/protos/OmniSimSun.proto"
EXTERNPROTO "omnisim://projects/objects/lights/protos/OmniSimSunMarker.proto"

WorldInfo {
  basicTimeStep 16
  title "Desert Ruins"
}

# Cinematic eye-level shot: camera SE of the plaza at 2.4 m, looking NW
# across the broken colonnade past the fountain to the backlit tower
# silhouettes and the low sun beyond. ~35° FOV (0.6 rad) for a cinema
# lens feel — long focal length compresses the dunes and stacks the
# skyline against the foreground ruins. Orientation computed via
# POST /scene/look_at {position:[16,-22,2.4], target:[-18,18,6]} —
# see scripts/harness/README.md §5.
Viewpoint {
  orientation 0.0 -0.03546155 0.99937104 2.32255962
  position 14 -19 2.4
  fieldOfView 0.95
  near 0.1
  ambientOcclusionRadius 2
  bloomThreshold 3
}

# atmosphericSky="earth" renders procedural Rayleigh/Mie scattering
# tuned to the sun direction — when SUN is low (golden hour), the sky
# auto-grades from peach near the horizon to deep blue at zenith.
# skyColor sets the unlit base; we warm it slightly so it blends into
# the fog cleanly. Higher luminosity pushes the upper sky brighter so
# silhouettes read against it.
OmniSimSky {
  skyColor [ 0.55 0.42 0.32 ]
  luminosity 1.7
}

# Golden-hour sun: warm amber, intensity bumped so backlit silhouettes
# stay legible against the bright sky. castShadows TRUE (the OmniSimSun
# default) — this is the most important single change for realism.
# The actual direction is overwritten every step by the sun_marker
# controller using SUN_MARKER's position; the explicit value below
# matches the marker (-32, 28, 22) so the t=0 atmosphericSky bake
# matches the post-step direction.
DEF SUN OmniSimSun {
  color 1.0 0.70 0.40
  direction 0.741 -0.648 -0.510
  intensity 4.2
  ambientIntensity 0
}

# Sun marker parked low in the NW quadrant — ~7° above the horizon, far
# enough that the backlit towers fall between the camera and the sun.
# Drag the glowing sphere live in the viewport to rotate the lighting
# (V hides it for clean stills).
DEF SUN_MARKER OmniSimSunMarker {
  translation -32 28 22
  radius 1.1
  baseColor 1.0 0.85 0.45
  emissiveColor 1.0 0.65 0.18
  emissiveIntensity 220
}

# Cool sky fill from the opposite quadrant of the sun — keeps shaded
# sides of ruins from going pitch black. Higher intensity than usual
# (1.8) because backlit composition is otherwise contrast-extreme.
DirectionalLight {
  direction -0.6 0.5 -0.6
  color 0.55 0.65 0.85
  intensity 1.8
  ambientIntensity 0.0
  castShadows FALSE
}

# Warm ground-bounce fill — simulates light reflected off the sunlit
# sand back up onto the underside of ruins. Faint, warm, no shadows.
# Comes from below + behind the sun so it wraps around the silhouettes.
DirectionalLight {
  direction 0.4 -0.3 0.6
  color 0.95 0.65 0.38
  intensity 0.4
  ambientIntensity 0.0
  castShadows FALSE
}

# Warm exponential haze — atmospheric perspective without textures.
# Tuned so the near towers stay legible, the far towers fade into the
# sky, and the central plaza retains crisp contrast. Slightly warmer
# than the sky so the dune crests in the distance pick up a sunset
# wash that flows into the sky-band.
Fog {
  color 0.85 0.66 0.48
  fogType "EXPONENTIAL"
  visibilityRange 320
}

# ============================================================================
# Terrain — 300 m, deep perlin dunes (size z=14, 9 octaves) so the
# crests around the plaza read as proper sand dunes, not gentle swells.
# Texture scale dropped from 120 -> 45 (tiles 2.5 m -> 6.7 m) so the
# repeating pattern is far less obvious at close range. flatCenter
# keeps the inner ~7 m flat for the plaza ruins. The remaining tile
# repeat is broken visually by the hand-placed dune mounds + wind
# drifts + sand ripples below — each of those has its own
# textureTransform rotation so the grain pattern reads differently
# on every patch.
# ============================================================================
UnevenTerrain {
  translation 0 0 0
  name "desert_terrain"
  size 300 300 14
  xDimension 200
  yDimension 200
  appearance Sand {
    textureTransform TextureTransform { scale 45 45 }
  }
  randomSeed 13
  flatCenter TRUE
  perlinNOctaves 9
}

# ============================================================================
# Ancient desert architecture — hand-built from primitives so the
# silhouettes read as eroded stone rather than the textured-box skyscraper
# protos the previous pass used (those are generic city stock and look
# wrong here). Materials are mineral (Plaster/DryMud/Marble) so the
# Rayleigh-tinted sun catches them as warm sandstone at golden hour.
#
# Inventory:
#   - Ziggurat (4-tier stepped pyramid)         NW background — primary backdrop
#   - Pylon Gate (twin trapezoidal towers)      NE background — Egyptian-style entrance
#   - Colossal colonnade (8 huge columns)       SW mid — temple ruin, some fallen
#   - Obelisk (tall tapered shaft + pyramidion) W   midground — solo vertical
#   - Dome ruin (hemisphere broken open)        SE midground — silhouetted curve
#   - Far ziggurat + far pylons                 horizon haze — depth layer
# ============================================================================

# --- Ziggurat: NW background, 4 tiers of stacked stone. Mud-brick
# appearance reads as sun-baked desert sandstone at distance.
# Footprint 30x30 m, total height ~22 m. Half-buried (z=-1.5) for
# weight and "settled into the dunes" reading.
DEF ZIGGURAT Solid {
  translation -88 72 -1.5
  rotation 0 0 1 0.45
  children [
    Pose { translation 0 0 3    children [ Shape { appearance DryMud  { textureTransform TextureTransform { scale 8 4 } } geometry Box { size 30 30 6   } } ] }
    Pose { translation 0 0 8.75 children [ Shape { appearance DryMud  { textureTransform TextureTransform { scale 6 3 } } geometry Box { size 22 22 5.5 } } ] }
    Pose { translation 0 0 14.0 children [ Shape { appearance DryMud  { textureTransform TextureTransform { scale 4 2.5 } } geometry Box { size 15 15 5   } } ] }
    Pose { translation 0 0 18.75 children [ Shape { appearance Plaster { textureTransform TextureTransform { scale 3 2 } } geometry Box { size  9  9 4.5 } } ] }
    # Stair-block on the south face — a single ramp of stone leading up
    # the first tier; reads as the ceremonial stair.
    Pose { translation 0 -15.5 1.5 rotation 1 0 0 -0.45
           children [ Shape { appearance DryMud {} geometry Box { size 5 6 0.5 } } ] }
  ]
  name "ziggurat"
}

# --- Far ziggurat (smaller, hazy) on the far horizon, NW deep.
# Inside the 300 m terrain (-150..+150) so it stands on sand.
DEF ZIGGURAT_FAR Solid {
  translation -128 108 -3
  rotation 0 0 1 -0.4
  children [
    Pose { translation 0 0 3    children [ Shape { appearance DryMud {} geometry Box { size 22 22 6  } } ] }
    Pose { translation 0 0 8.25 children [ Shape { appearance DryMud {} geometry Box { size 16 16 4.5 } } ] }
    Pose { translation 0 0 12.5 children [ Shape { appearance DryMud {} geometry Box { size 10 10 4 } } ] }
    Pose { translation 0 0 16.0 children [ Shape { appearance Plaster {} geometry Box { size  6  6 3 } } ] }
  ]
  name "ziggurat_far"
}

# --- Pylon Gate: twin trapezoidal towers flanking a ceremonial passage,
# Egyptian-style. Built as tilted boxes (approximating the trapezoidal
# batter — wider at base than top). Limestone (Plaster) so it stays
# pale against the sky.
DEF PYLON_LEFT Solid {
  translation 64 58 -1
  rotation 0 0 1 -0.35
  children [
    Pose { translation -4 0 7 children [ Shape { appearance Plaster { textureTransform TextureTransform { scale 4 4 } } geometry Box { size 5 7 14 } } ] }
    # outer batter — narrower top suggesting trapezoidal profile
    Pose { translation -4 0 14.5 children [ Shape { appearance Plaster {} geometry Box { size 4.2 6.2 1 } } ] }
  ]
  name "pylon_left"
}
DEF PYLON_RIGHT Solid {
  translation 64 58 -1
  rotation 0 0 1 -0.35
  children [
    Pose { translation 4 0 7 children [ Shape { appearance Plaster { textureTransform TextureTransform { scale 4 4 } } geometry Box { size 5 7 14 } } ] }
    Pose { translation 4 0 14.5 children [ Shape { appearance Plaster {} geometry Box { size 4.2 6.2 1 } } ] }
  ]
  name "pylon_right"
}
# Lintel beam across the top of the pylon — broken at the right end.
DEF PYLON_LINTEL Solid {
  translation 64 58 -1
  rotation 0 0 1 -0.35
  children [
    Pose { translation -1.2 0 15.7 children [ Shape { appearance Plaster {} geometry Box { size 8 2 1.2 } } ] }
  ]
  name "pylon_lintel"
}

# --- Far pylons in the SE deep — broken, eroded, just silhouettes.
# Inside terrain bounds so they sit on sand instead of the void.
DEF PYLON_FAR_LEFT Solid {
  translation 132 -62 -3
  rotation 0 0 1 1.4
  children [ Pose { translation 0 0 6 children [ Shape { appearance Plaster {} geometry Box { size 5 6 12 } } ] } ]
  name "pylon_far_left"
}
DEF PYLON_FAR_RIGHT Solid {
  translation 140 -57 -3
  rotation 0 0 1 1.4
  children [ Pose { translation 0 0 4 children [ Shape { appearance Plaster {} geometry Box { size 4 5 8 } } ] } ]
  name "pylon_far_right"
}

# --- Colossal colonnade: ruins of a great temple. Row of 8 huge
# columns running NE-SW in the SW quadrant. Three have fallen, five
# stand at varying heights. Marble so they catch the sun warmly.
# Centerline runs from (-105, -45) to (-55, -15), spaced ~6 m apart.
DEF COLOSSUS_1 Solid {
  translation -102 -44 4.5
  rotation 0 1 0 0.02
  children [ Shape { appearance Marble { textureTransform TextureTransform { scale 1 5 } } geometry Cylinder { height 9   radius 1.2 } } ]
  name "colossus_1"
}
DEF COLOSSUS_1_CAP Solid {
  translation -102 -44 9.2
  children [ Shape { appearance Marble {} geometry Box { size 3 3 0.4 } } ]
  name "colossus_1_cap"
}
DEF COLOSSUS_2 Solid {
  translation -96 -41 5
  children [ Shape { appearance Marble { textureTransform TextureTransform { scale 1 5 } } geometry Cylinder { height 10 radius 1.2 } } ]
  name "colossus_2"
}
DEF COLOSSUS_2_CAP Solid {
  translation -96 -41 10.2
  children [ Shape { appearance Marble {} geometry Box { size 3 3 0.4 } } ]
  name "colossus_2_cap"
}
# Fallen across the line — column 3 lying east-west
DEF COLOSSUS_3 Solid {
  translation -88 -37 1.2
  rotation 0.95 -0.31 0 1.5708
  children [ Shape { appearance Marble {} geometry Cylinder { height 11 radius 1.2 } } ]
  name "colossus_3"
}
DEF COLOSSUS_4 Solid {
  translation -82 -34 3.5
  rotation 1 0 0 0.04
  children [ Shape { appearance Marble { textureTransform TextureTransform { scale 1 5 } } geometry Cylinder { height 7 radius 1.2 } } ]
  name "colossus_4"
}
# Fallen
DEF COLOSSUS_5 Solid {
  translation -75 -30 1.2
  rotation 0.92 -0.39 0 1.5708
  children [ Shape { appearance Marble {} geometry Cylinder { height 10.5 radius 1.15 } } ]
  name "colossus_5"
}
DEF COLOSSUS_6 Solid {
  translation -69 -27 4.5
  rotation 0 1 0 -0.03
  children [ Shape { appearance Marble { textureTransform TextureTransform { scale 1 5 } } geometry Cylinder { height 9 radius 1.15 } } ]
  name "colossus_6"
}
DEF COLOSSUS_6_CAP Solid {
  translation -69 -27 9.2
  children [ Shape { appearance Marble {} geometry Box { size 2.9 2.9 0.4 } } ]
  name "colossus_6_cap"
}
DEF COLOSSUS_7 Solid {
  translation -63 -23 5
  children [ Shape { appearance Marble { textureTransform TextureTransform { scale 1 5 } } geometry Cylinder { height 10 radius 1.15 } } ]
  name "colossus_7"
}
# Last column — stub remnant, broken low
DEF COLOSSUS_8 Solid {
  translation -57 -19 1.6
  children [ Shape { appearance Marble {} geometry Cylinder { height 3.2 radius 1.1 } } ]
  name "colossus_8"
}
# Architrave fragment — a stone beam that once linked two columns,
# now collapsed between #6 and #7.
DEF ARCHITRAVE Solid {
  translation -66 -25 5.0
  rotation 0.4 0.92 0 0.5
  children [ Shape { appearance Marble {} geometry Box { size 7 1.2 1.0 } } ]
  name "architrave"
}

# --- Obelisk: tall tapered shaft + pyramidion. West midground,
# isolated against the sky. Marble — reads as polished granite.
DEF OBELISK Solid {
  translation -55 18 0
  children [
    # base plinth
    Pose { translation 0 0 1.5 children [ Shape { appearance Marble {} geometry Box { size 4 4 3 } } ] }
    # shaft — slightly tapered top (we cheat: two stacked tapering boxes)
    Pose { translation 0 0 8.5 children [ Shape { appearance Marble { textureTransform TextureTransform { scale 1 6 } } geometry Box { size 2.4 2.4 11 } } ] }
    Pose { translation 0 0 15.3 children [ Shape { appearance Marble {} geometry Box { size 2.0 2.0 2.6 } } ] }
    # pyramidion (capstone) — small cone-like topper via small box
    Pose { translation 0 0 17.2 children [ Shape { appearance Marble {} geometry Box { size 1.4 1.4 1.6 } } ] }
    Pose { translation 0 0 18.4 children [ Shape { appearance Marble {} geometry Box { size 0.7 0.7 0.8 } } ] }
  ]
  name "obelisk"
}

# --- Far obelisk silhouette, broken in half
DEF OBELISK_FAR Solid {
  translation -125 60 -2
  children [
    Pose { translation 0 0 1.5 children [ Shape { appearance Marble {} geometry Box { size 3 3 3 } } ] }
    Pose { translation 0 0 7   children [ Shape { appearance Marble {} geometry Box { size 1.8 1.8 8 } } ] }
  ]
  name "obelisk_far"
}

# --- Dome ruin: hemisphere half-collapsed into the dunes. The sphere's
# lower half is buried under the terrain, so we read the upper hemisphere
# as a dome. A vertical box cuts a "crack" out of the top so it doesn't
# look pristine.
DEF DOME Solid {
  translation 78 -38 -3
  rotation 0 0 1 0.6
  children [
    Shape {
      appearance Plaster { textureTransform TextureTransform { scale 6 6 } }
      geometry Sphere { radius 9 subdivision 3 }
    }
    # ring base — a low ring of stone around the dome's footprint
    Pose { translation 0 0 0.3 children [ Shape { appearance DryMud {} geometry Cylinder { height 0.6 radius 9.5 } } ] }
  ]
  name "dome"
}

# --- Far broken arch silhouette on the eastern horizon (inside bounds)
DEF ARCH_FAR_LEFT Solid {
  translation 130 82 -1
  rotation 0 0 1 -0.8
  children [ Pose { translation 0 0 5 children [ Shape { appearance Plaster {} geometry Box { size 1.5 1.5 10 } } ] } ]
  name "arch_far_left"
}
DEF ARCH_FAR_RIGHT Solid {
  translation 137 82 -1
  rotation 0 0 1 -0.8
  children [ Pose { translation 0 0 4 children [ Shape { appearance Plaster {} geometry Box { size 1.5 1.5 8 } } ] } ]
  name "arch_far_right"
}
DEF ARCH_FAR_TOP Solid {
  translation 133.5 82 -1
  rotation 0 0 1 -0.8
  children [ Pose { translation 0 0 9.5 children [ Shape { appearance Plaster {} geometry Box { size 8 1.5 1 } } ] } ]
  name "arch_far_top"
}

# ============================================================================
# Extended ruins — same architectural vocabulary, distributed across the
# map so wherever the user pans they find more to look at.
# ============================================================================

# --- Avenue of Sphinxes: a processional way running NW from the plaza
# toward the ziggurat, flanked by six recumbent stone statues in pairs.
# Each statue: low rectangular base + horizontal body + small head block.
# Visible from the hero shot as a line of forms across the dunes.
DEF SPHINX_1L Solid {
  translation -8 18 0
  rotation 0 0 1 0.7
  children [
    Pose { translation 0 0 0.25 children [ Shape { appearance DryMud { textureTransform TextureTransform { scale 3 2 } } geometry Box { size 3.4 1.6 0.5 } } ] }
    Pose { translation -0.3 0 1.1 children [ Shape { appearance DryMud {} geometry Box { size 2.8 1.2 1.2 } } ] }
    Pose { translation -1.6 0 2.0 children [ Shape { appearance DryMud {} geometry Box { size 0.9 0.9 0.9 } } ] }
  ]
  name "sphinx_1l"
}
DEF SPHINX_1R Solid {
  translation -4 14 0
  rotation 0 0 1 0.7
  children [
    Pose { translation 0 0 0.25 children [ Shape { appearance DryMud { textureTransform TextureTransform { scale 3 2 } } geometry Box { size 3.4 1.6 0.5 } } ] }
    Pose { translation -0.3 0 1.1 children [ Shape { appearance DryMud {} geometry Box { size 2.8 1.2 1.2 } } ] }
    Pose { translation -1.6 0 2.0 children [ Shape { appearance DryMud {} geometry Box { size 0.9 0.9 0.9 } } ] }
  ]
  name "sphinx_1r"
}
DEF SPHINX_2L Solid {
  translation -22 30 0
  rotation 0 0 1 0.7
  children [
    Pose { translation 0 0 0.25 children [ Shape { appearance DryMud {} geometry Box { size 3.4 1.6 0.5 } } ] }
    Pose { translation -0.3 0 1.1 children [ Shape { appearance DryMud {} geometry Box { size 2.8 1.2 1.2 } } ] }
    Pose { translation -1.6 0 2.0 children [ Shape { appearance DryMud {} geometry Box { size 0.9 0.9 0.9 } } ] }
  ]
  name "sphinx_2l"
}
DEF SPHINX_2R Solid {
  translation -18 26 0
  rotation 0 0 1 0.7
  children [
    Pose { translation 0 0 0.25 children [ Shape { appearance DryMud {} geometry Box { size 3.4 1.6 0.5 } } ] }
    Pose { translation -0.3 0 1.1 children [ Shape { appearance DryMud {} geometry Box { size 2.8 1.2 1.2 } } ] }
    Pose { translation -1.6 0 2.0 children [ Shape { appearance DryMud {} geometry Box { size 0.9 0.9 0.9 } } ] }
  ]
  name "sphinx_2r"
}
# Third pair partially collapsed — one fallen on its side.
DEF SPHINX_3L Solid {
  translation -36 42 0
  rotation 0 0 1 0.7
  children [
    Pose { translation 0 0 0.25 children [ Shape { appearance DryMud {} geometry Box { size 3.4 1.6 0.5 } } ] }
    Pose { translation -0.3 0 1.1 children [ Shape { appearance DryMud {} geometry Box { size 2.8 1.2 1.2 } } ] }
  ]
  name "sphinx_3l_broken"
}
DEF SPHINX_3R Solid {
  translation -32 38 0.7
  rotation 0.5 0.5 0.7 1.6
  children [
    Pose { translation 0 0 0 children [ Shape { appearance DryMud {} geometry Box { size 3.4 1.6 1.6 } } ] }
  ]
  name "sphinx_3r_toppled"
}

# --- Stone Circle (henge): ring of 8 standing stones, ~14 m diameter,
# at the east edge of the visible scene. A ceremonial ring half-eaten
# by the desert.
# Stones are tall (5-6 m) so they clear the perlin dune crests at this
# distance from origin — at 90 m out, terrain noise can lift the
# ground by 2-3 m, which was burying the previous 3 m stones.
DEF HENGE_1 Solid { translation  97  -5 3.0 children [ Shape { appearance DryMud { textureTransform TextureTransform { scale 1 4 } } geometry Box { size 1.8 0.9 6.0 } } ] name "henge_1" }
DEF HENGE_2 Solid { translation  95   0 2.7 rotation 0 0 1 0.79 children [ Shape { appearance DryMud { textureTransform TextureTransform { scale 1 4 } } geometry Box { size 1.8 0.9 5.4 } } ] name "henge_2" }
DEF HENGE_3 Solid { translation  90   2 3.2 rotation 0 0 1 1.57 children [ Shape { appearance DryMud { textureTransform TextureTransform { scale 1 4 } } geometry Box { size 1.8 0.9 6.4 } } ] name "henge_3" }
DEF HENGE_4 Solid { translation  85   0 2.4 rotation 0 0 1 2.36 children [ Shape { appearance DryMud {} geometry Box { size 1.8 0.9 4.8 } } ] name "henge_4" }
# Fallen stone — toppled onto its side, half-buried.
DEF HENGE_5 Solid { translation  83  -5 0.55 rotation 0 1 0 1.5708 children [ Shape { appearance DryMud {} geometry Box { size 0.9 1.8 5.0 } } ] name "henge_5_fallen" }
DEF HENGE_6 Solid { translation  85 -10 2.5 rotation 0 0 1 -2.36 children [ Shape { appearance DryMud {} geometry Box { size 1.8 0.9 5.0 } } ] name "henge_6" }
DEF HENGE_7 Solid { translation  90 -12 2.9 rotation 0 0 1 -1.57 children [ Shape { appearance DryMud { textureTransform TextureTransform { scale 1 4 } } geometry Box { size 1.8 0.9 5.8 } } ] name "henge_7" }
DEF HENGE_8 Solid { translation  95 -10 2.5 rotation 0 0 1 -0.79 children [ Shape { appearance DryMud {} geometry Box { size 1.8 0.9 5.0 } } ] name "henge_8" }
# Lintel slab balanced across HENGE_3 and HENGE_2 (a la Stonehenge trilithon)
DEF HENGE_LINTEL Solid {
  translation 92.5 1 6.6
  rotation 0 0 1 0.4
  children [ Shape { appearance DryMud {} geometry Box { size 4.5 0.9 0.7 } } ]
  name "henge_lintel"
}
# Central altar stone in the middle of the ring
DEF HENGE_ALTAR Solid {
  translation 90 -5 1.2
  children [ Shape { appearance Marble { textureTransform TextureTransform { scale 2 1 } } geometry Box { size 3.0 1.4 1.6 } } ]
  name "henge_altar"
}

# --- Petra-style cliff facade: a tall flat front of stone with
# columns and a deep arched doorway. Approximated with a back wall,
# four standing columns, a horizontal entablature, and a pediment.
# Placed N of the plaza so it backs the avenue of sphinxes.
DEF FACADE_WALL Solid {
  translation -55 105 -1
  rotation 0 0 1 -0.15
  children [
    # Tall back wall
    Pose { translation 0 0 8 children [ Shape { appearance Plaster { textureTransform TextureTransform { scale 8 6 } } geometry Box { size 22 2 18 } } ] }
    # Pediment (triangular topper) — approximated as a smaller box on top
    Pose { translation 0 0 18.5 children [ Shape { appearance Plaster {} geometry Box { size 18 2.2 2 } } ] }
    Pose { translation 0 0 20.0 children [ Shape { appearance Plaster {} geometry Box { size 12 2.2 1.5 } } ] }
  ]
  name "facade_wall"
}
# Standing columns in front of the facade
DEF FACADE_COL_1 Solid {
  translation -64 104 4
  rotation 0 0 1 -0.15
  children [ Shape { appearance Marble { textureTransform TextureTransform { scale 1 4 } } geometry Cylinder { height 8 radius 0.8 } } ]
  name "facade_col_1"
}
DEF FACADE_COL_2 Solid {
  translation -59 103 4
  rotation 0 0 1 -0.15
  children [ Shape { appearance Marble { textureTransform TextureTransform { scale 1 4 } } geometry Cylinder { height 8 radius 0.8 } } ]
  name "facade_col_2"
}
DEF FACADE_COL_3 Solid {
  translation -51 102 4
  rotation 0 0 1 -0.15
