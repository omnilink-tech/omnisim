# ============================================================================
# Palm tree silhouettes — organic shapes break up the geometric ruin
# skyline. Placed in the mid-distance (25-45 m) so they read as
# silhouettes against the bright sky, framing the central plaza.
# enableBoundingObject FALSE keeps them visual-only (kinematic_props
# guidance — they're decor, no need to snag bridges).
# ============================================================================
PalmTree { translation -25  18 0 rotation 0 0 1  0.4 name "palm_1" enableBoundingObject FALSE }
PalmTree { translation -32  -8 0 rotation 0 0 1 -1.1 name "palm_2" enableBoundingObject FALSE }
PalmTree { translation  28  20 0 rotation 0 0 1  0.7 name "palm_3" enableBoundingObject FALSE }
PalmTree { translation  42 -12 0 rotation 0 0 1  1.4 name "palm_4" enableBoundingObject FALSE }
PalmTree { translation -45  30 0 rotation 0 0 1  0.2 name "palm_5" enableBoundingObject FALSE }
PalmTree { translation  18 -30 0 rotation 0 0 1 -0.6 name "palm_6" enableBoundingObject FALSE }
