}
DEF DUNE_RIDGE_8 Solid {
  translation -85 90 0.8
  rotation 0 0 1 0.4
  children [ Shape { appearance Sand { textureTransform TextureTransform { scale 11 4 rotation 0 } } geometry Box { size 34 7 1.6 } } ]
  name "dune_ridge_8"
}

# --- Sand piles: small flat circular mounds, 4-7 m radius. Cylinder
# geometry so the silhouette is rounded — reads better than a square
# patch up close. Heavy mid-ground coverage.
DEF SAND_PILE_01 Solid { translation  18  -8 0.25 children [ Shape { appearance Sand { textureTransform TextureTransform { scale 3 3 rotation 0.4 } } geometry Cylinder { height 0.5 radius 4 subdivision 12 } } ] name "sand_pile_01" }
DEF SAND_PILE_02 Solid { translation -25  18 0.30 children [ Shape { appearance Sand { textureTransform TextureTransform { scale 3 3 rotation 1.1 } } geometry Cylinder { height 0.6 radius 5 subdivision 12 } } ] name "sand_pile_02" }
DEF SAND_PILE_03 Solid { translation  40   8 0.20 children [ Shape { appearance Sand { textureTransform TextureTransform { scale 2 2 rotation 1.7 } } geometry Cylinder { height 0.4 radius 3 subdivision 12 } } ] name "sand_pile_03" }
DEF SAND_PILE_04 Solid { translation  -8  35 0.30 children [ Shape { appearance Sand { textureTransform TextureTransform { scale 3 3 rotation 0.8 } } geometry Cylinder { height 0.6 radius 4.5 subdivision 12 } } ] name "sand_pile_04" }
DEF SAND_PILE_05 Solid { translation  22  42 0.25 children [ Shape { appearance Sand { textureTransform TextureTransform { scale 2 2 rotation 2.4 } } geometry Cylinder { height 0.5 radius 3.5 subdivision 12 } } ] name "sand_pile_05" }
DEF SAND_PILE_06 Solid { translation  60 -25 0.35 children [ Shape { appearance Sand { textureTransform TextureTransform { scale 3 3 rotation 0.3 } } geometry Cylinder { height 0.7 radius 5 subdivision 12 } } ] name "sand_pile_06" }
DEF SAND_PILE_07 Solid { translation -40  10 0.30 children [ Shape { appearance Sand { textureTransform TextureTransform { scale 3 3 rotation 1.5 } } geometry Cylinder { height 0.6 radius 4 subdivision 12 } } ] name "sand_pile_07" }
DEF SAND_PILE_08 Solid { translation -25 -30 0.40 children [ Shape { appearance Sand { textureTransform TextureTransform { scale 4 4 rotation 0.6 } } geometry Cylinder { height 0.8 radius 6 subdivision 12 } } ] name "sand_pile_08" }
DEF SAND_PILE_09 Solid { translation  80  10 0.30 children [ Shape { appearance Sand { textureTransform TextureTransform { scale 3 3 rotation 2.0 } } geometry Cylinder { height 0.6 radius 4.5 subdivision 12 } } ] name "sand_pile_09" }
DEF SAND_PILE_10 Solid { translation -70  60 0.35 children [ Shape { appearance Sand { textureTransform TextureTransform { scale 3 3 rotation 1.3 } } geometry Cylinder { height 0.7 radius 5 subdivision 12 } } ] name "sand_pile_10" }
DEF SAND_PILE_11 Solid { translation  -5 -60 0.30 children [ Shape { appearance Sand { textureTransform TextureTransform { scale 3 3 rotation 0.5 } } geometry Cylinder { height 0.6 radius 4.5 subdivision 12 } } ] name "sand_pile_11" }
DEF SAND_PILE_12 Solid { translation  25 -28 0.25 children [ Shape { appearance Sand { textureTransform TextureTransform { scale 2 2 rotation 2.6 } } geometry Cylinder { height 0.5 radius 3.5 subdivision 12 } } ] name "sand_pile_12" }

# --- Wind ripples: thin elongated strips of SandyGround (slightly
# different tone than Sand) in groups of 3-5, oriented along wind
# direction. Sub-meter relief — mostly visual texture variation that
# disrupts the regular tile pattern.
DEF RIPPLE_GROUP_A_1 Solid { translation -10 -18 0.08 rotation 0 0 1 0.6 children [ Shape { appearance SandyGround { textureTransform TextureTransform { scale 5 1 } } geometry Box { size 8 0.8 0.15 } castShadows FALSE } ] name "ripple_a_1" }
DEF RIPPLE_GROUP_A_2 Solid { translation -8  -20 0.08 rotation 0 0 1 0.6 children [ Shape { appearance SandyGround { textureTransform TextureTransform { scale 5 1 } } geometry Box { size 7 0.7 0.15 } castShadows FALSE } ] name "ripple_a_2" }
DEF RIPPLE_GROUP_A_3 Solid { translation -12 -22 0.08 rotation 0 0 1 0.6 children [ Shape { appearance SandyGround { textureTransform TextureTransform { scale 5 1 } } geometry Box { size 9 0.9 0.15 } castShadows FALSE } ] name "ripple_a_3" }
DEF RIPPLE_GROUP_A_4 Solid { translation -6 -24 0.08 rotation 0 0 1 0.6 children [ Shape { appearance SandyGround { textureTransform TextureTransform { scale 5 1 } } geometry Box { size 6 0.7 0.15 } castShadows FALSE } ] name "ripple_a_4" }

DEF RIPPLE_GROUP_B_1 Solid { translation 28  20 0.08 rotation 0 0 1 0.4 children [ Shape { appearance SandyGround { textureTransform TextureTransform { scale 5 1 } } geometry Box { size 7 0.8 0.15 } castShadows FALSE } ] name "ripple_b_1" }
DEF RIPPLE_GROUP_B_2 Solid { translation 30  22 0.08 rotation 0 0 1 0.4 children [ Shape { appearance SandyGround { textureTransform TextureTransform { scale 5 1 } } geometry Box { size 8 0.7 0.15 } castShadows FALSE } ] name "ripple_b_2" }
