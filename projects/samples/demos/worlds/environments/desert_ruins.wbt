# --- Stepped Altar Platform: small terraced platform with stairs,
# between the plaza and the pylon gate. Marble base + DryMud upper
# tiers so the materials read as a layered build.
DEF ALTAR_PLATFORM Solid {
  translation 38 25 0
  rotation 0 0 1 0.5
  children [
    Pose { translation 0 0 0.4 children [ Shape { appearance Marble  { textureTransform TextureTransform { scale 5 3 } } geometry Box { size 9 9 0.8 } } ] }
    Pose { translation 0 0 1.4 children [ Shape { appearance DryMud { textureTransform TextureTransform { scale 4 2 } } geometry Box { size 7 7 1.2 } } ] }
    Pose { translation 0 0 2.6 children [ Shape { appearance DryMud {} geometry Box { size 5 5 1.2 } } ] }
    Pose { translation 0 0 3.7 children [ Shape { appearance Marble {} geometry Box { size 3 3 1.0 } } ] }
    # Stair ramp on the south face
    Pose { translation 0 -5 0.7 rotation 1 0 0 -0.4
           children [ Shape { appearance Marble {} geometry Box { size 3.5 4 0.4 } } ] }
  ]
  name "altar_platform"
}

# --- Watchtower ruin: tall narrow stone tower, partially collapsed
