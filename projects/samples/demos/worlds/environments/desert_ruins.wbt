DEF RIPPLE_GROUP_C_1 Solid { translation -35 -15 0.08 rotation 0 0 1 0.55 children [ Shape { appearance SandyGround { textureTransform TextureTransform { scale 5 1 } } geometry Box { size 8 0.9 0.15 } castShadows FALSE } ] name "ripple_c_1" }
