  children [ Shape { appearance SandyGround { textureTransform TextureTransform { scale 4 4 } } geometry Box { size 4.5 2 0.1 } castShadows FALSE } ]
  name "drift_4"
}
DEF DRIFT_5 Solid {
  translation -20 8 0.05
  rotation 0 0 1 0.6
  children [ Shape { appearance SandyGround { textureTransform TextureTransform { scale 4 4 } } geometry Box { size 7 3 0.1 } castShadows FALSE } ]
  name "drift_5"
}

# ============================================================================
# Dune system — hand-placed sand mounds, ridges, and wind ripples that
# overlay the perlin terrain. Their purpose is twofold:
#   1. Add real geometric variation at the mid scale (2-20 m) — the
#      perlin terrain handles macro form and the textures handle micro;
#      this fills the gap and is what the eye reads as "this is desert."
#   2. Break up the unavoidable repeat of the Sand PBR tiling. Each mound
#      has its own textureTransform rotation/scale, so the grain
#      pattern reads differently on every patch — the underlying terrain
#      tile is no longer the dominant visual.
#
# Positioned away from the ruin structures so nothing visually clips. The
# crescent dunes use stacked flat Boxes (cheap dune-profile silhouettes);
# ridge dunes are elongated rotated Boxes aligned with a notional NW-SE
# prevailing wind; sand piles are flat Cylinders; ripples are thin Box
# clusters in groups.
# ============================================================================

# --- Crescent dunes: large rounded mounds, 15-25 m across, ~3 m tall.
# Two-tier stacked box silhouette so they catch light on the sunward
# face and shadow on the lee side.
DEF DUNE_CRESCENT_1 Solid {
  translation -20 -45 0
  rotation 0 0 1 0.3
  children [
    Pose { translation 0 0 0.6 children [ Shape { appearance Sand { textureTransform TextureTransform { scale 6 6 rotation 0.7 } } geometry Box { size 22 13 1.2 } } ] }
    Pose { translation 1 0 1.7 children [ Shape { appearance Sand { textureTransform TextureTransform { scale 5 5 rotation 1.1 } } geometry Box { size 16 9 0.9 } } ] }
  ]
  name "dune_crescent_1"
}
DEF DUNE_CRESCENT_2 Solid {
  translation 32 -55 0
  rotation 0 0 1 -0.4
  children [
    Pose { translation 0 0 0.7 children [ Shape { appearance Sand { textureTransform TextureTransform { scale 6 6 rotation 0.3 } } geometry Box { size 24 14 1.4 } } ] }
    Pose { translation -1 0 1.9 children [ Shape { appearance Sand { textureTransform TextureTransform { scale 5 5 rotation 1.7 } } geometry Box { size 17 10 1.0 } } ] }
  ]
  name "dune_crescent_2"
}
DEF DUNE_CRESCENT_3 Solid {
  translation 65 12 0
  rotation 0 0 1 1.1
  children [
    Pose { translation 0 0 0.6 children [ Shape { appearance Sand { textureTransform TextureTransform { scale 6 6 rotation 2.1 } } geometry Box { size 20 12 1.3 } } ] }
    Pose { translation 0.8 0 1.8 children [ Shape { appearance Sand { textureTransform TextureTransform { scale 5 5 rotation 0.5 } } geometry Box { size 14 8 0.9 } } ] }
  ]
  name "dune_crescent_3"
}
DEF DUNE_CRESCENT_4 Solid {
  translation -38 -80 0
  rotation 0 0 1 0.8
  children [
    Pose { translation 0 0 0.8 children [ Shape { appearance Sand { textureTransform TextureTransform { scale 7 7 rotation 1.3 } } geometry Box { size 26 16 1.6 } } ] }
    Pose { translation 1.5 0 2.2 children [ Shape { appearance Sand { textureTransform TextureTransform { scale 6 6 rotation 2.8 } } geometry Box { size 18 11 1.2 } } ] }
  ]
  name "dune_crescent_4"
}
DEF DUNE_CRESCENT_5 Solid {
  translation 95 60 0
  rotation 0 0 1 -0.6
  children [
    Pose { translation 0 0 1.0 children [ Shape { appearance Sand { textureTransform TextureTransform { scale 8 8 rotation 0.9 } } geometry Box { size 28 18 2.0 } } ] }
    Pose { translation -1 0 2.7 children [ Shape { appearance Sand { textureTransform TextureTransform { scale 6 6 rotation 2.2 } } geometry Box { size 20 12 1.4 } } ] }
  ]
  name "dune_crescent_5"
}
DEF DUNE_CRESCENT_6 Solid {
  translation -75 -10 0
  rotation 0 0 1 1.7
  children [
    Pose { translation 0 0 0.7 children [ Shape { appearance Sand { textureTransform TextureTransform { scale 6 6 rotation 1.9 } } geometry Box { size 22 13 1.4 } } ] }
    Pose { translation 1 0 1.9 children [ Shape { appearance Sand { textureTransform TextureTransform { scale 5 5 rotation 0.4 } } geometry Box { size 15 9 0.9 } } ] }
  ]
  name "dune_crescent_6"
}

# --- Ridge dunes: long elongated mounds aligned with a notional
# prevailing wind (NW-SE), 30-45 m long, 6-10 m wide. They draw the
# eye to the horizon and add directional structure across the open
# dune fields.
DEF DUNE_RIDGE_1 Solid {
  translation 45 65 0.6
  rotation 0 0 1 0.6
  children [ Shape { appearance Sand { textureTransform TextureTransform { scale 12 5 rotation 0 } } geometry Box { size 36 7 1.2 } } ]
  name "dune_ridge_1"
}
DEF DUNE_RIDGE_2 Solid {
  translation -55 -35 0.7
  rotation 0 0 1 0.55
  children [ Shape { appearance Sand { textureTransform TextureTransform { scale 10 4 rotation 0 } } geometry Box { size 32 8 1.4 } } ]
  name "dune_ridge_2"
}
DEF DUNE_RIDGE_3 Solid {
  translation 70 -80 0.8
  rotation 0 0 1 0.7
  children [ Shape { appearance Sand { textureTransform TextureTransform { scale 14 5 rotation 0 } } geometry Box { size 40 9 1.6 } } ]
  name "dune_ridge_3"
}
DEF DUNE_RIDGE_4 Solid {
  translation 105 -25 0.9
  rotation 0 0 1 0.5
  children [ Shape { appearance Sand { textureTransform TextureTransform { scale 14 5 rotation 0 } } geometry Box { size 42 8 1.8 } } ]
  name "dune_ridge_4"
}
DEF DUNE_RIDGE_5 Solid {
  translation -110 30 0.8
  rotation 0 0 1 0.7
  children [ Shape { appearance Sand { textureTransform TextureTransform { scale 12 4 rotation 0 } } geometry Box { size 36 7 1.6 } } ]
  name "dune_ridge_5"
}
DEF DUNE_RIDGE_6 Solid {
  translation -10 95 0.6
  rotation 0 0 1 0.65
  children [ Shape { appearance Sand { textureTransform TextureTransform { scale 10 4 rotation 0 } } geometry Box { size 32 7 1.2 } } ]
