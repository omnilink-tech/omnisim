# ============================================================================
# Central plaza — ancient ruins on the flat zone. Mixed materials so
# nothing reads as repeating concrete: Marble for the fountain ring,
# RedBricks for the eastern wall, FormedConcrete for foundations, etc.
# ============================================================================
StoneFountain {
  translation 0 0 0
  name "central_fountain"
}
StoneBench { translation -3.5  3.0 0 rotation 0 0 1  0.5 name "bench_NW" }
StoneBench { translation  3.5  3.0 0 rotation 0 0 1 -0.5 name "bench_NE" }
StoneBench { translation -3.5 -3.0 0 rotation 0 0 1  2.6 name "bench_SW" }
StoneBench { translation  3.5 -3.0 0 rotation 0 0 1 -2.6 name "bench_SE" }

# ----------------------------------------------------------------------------
# Plaza foundation slabs — large flat marble pavers, half-buried, drift
# of sand reading across. These catch the long sun shadows from the
# columns and read as the "floor" of the lost city.
