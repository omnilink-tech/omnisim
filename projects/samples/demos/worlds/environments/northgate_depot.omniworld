#OMNISIM R2025a utf8

# NORTHGATE DEPOT - a bare distribution-centre interior.
#
# A 25.8 x 16.8 m warehouse hall (interior, wall face to wall face): concrete
# slab, 4 m rendered walls with a dado course, three double rows of pallet
# racking (2.6 m tall, stocked with cardboard), and three dock-door panels down
# the east wall. Robot-free and prop-free by design - drop a ground robot in and
# drive it, or stage your own payload.
#
# The floor is a clean 3 m aisle grid: 3.2 m between facing rack rows, a 3.2 m
# central cross-aisle splitting the left and right rack banks, and ~3.1 m of
# clear perimeter on all four sides. A 1.26 x 0.72 m AGV footprint (the size
# this room was originally cut for) turns anywhere on it.
#
# This file is HAND-MAINTAINED - no generator produces it, so edit it directly.

EXTERNPROTO "omnisim://projects/objects/backgrounds/protos/OmniSimSky.proto"
EXTERNPROTO "omnisim://projects/objects/lights/protos/OmniSimSun.proto"
EXTERNPROTO "omnisim://projects/objects/lights/protos/OmniSimSunMarker.proto"
EXTERNPROTO "omnisim://projects/appearances/protos/RoughConcrete.proto"
EXTERNPROTO "omnisim://projects/appearances/protos/Roughcast.proto"
EXTERNPROTO "omnisim://projects/appearances/protos/Cardboard.proto"
EXTERNPROTO "omnisim://projects/appearances/protos/RoughPine.proto"

WorldInfo {
  basicTimeStep 16
  title "Northgate Depot"
  newtonSolver "mujoco"
  newtonStatics TRUE
  newtonRobotColliders TRUE
  newtonSubsteps 4
}

Viewpoint {
  orientation 0.27 0.30 0.92 1.66
  position 19 -19 15
  exposure 1.05
}

OmniSimSky { }
DEF SUN OmniSimSun { }
DEF SUN_MARKER OmniSimSunMarker { }

