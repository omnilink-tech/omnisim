#OMNISIM R2025a utf8

# Standalone, fully editable construction-site world. Mirrors the content
# of ConstructionSiteEnvironment.proto, but laid out as INDIVIDUAL,
# selectable nodes: PROTO instances for towers/cranes/vehicles/containers,
# and self-contained named Solids (appearances inlined per object) for the
# custom assemblies — so any object can be picked, moved, or deleted in the
# Webots scene tree without affecting the others.
#
# The site_screenshot supervisor sweeps the Viewpoint and exports PNGs to
# projects/_scratch/site_shots for review.

EXTERNPROTO "omnisim://projects/objects/backgrounds/protos/OmniSimSky.proto"
EXTERNPROTO "omnisim://projects/objects/lights/protos/OmniSimSun.proto"
EXTERNPROTO "omnisim://projects/objects/buildings/protos/Warehouse.proto"
EXTERNPROTO "omnisim://projects/objects/traffic/protos/TrafficCone.proto"
EXTERNPROTO "omnisim://projects/objects/traffic/protos/WorkBarrier.proto"
EXTERNPROTO "omnisim://projects/objects/freight/protos/IntermodalContainer.proto"
EXTERNPROTO "omnisim://projects/objects/freight/protos/IntermodalOfficeContainer.proto"
EXTERNPROTO "omnisim://projects/objects/factory/pallet/protos/WoodenPalletStack.proto"
EXTERNPROTO "omnisim://projects/objects/obstacles/protos/OilBarrel.proto"
EXTERNPROTO "omnisim://projects/objects/factory/forklift/protos/Forklift.proto"
EXTERNPROTO "omnisim://projects/objects/lights/protos/ConstructionLamp.proto"
EXTERNPROTO "omnisim://projects/objects/street_furniture/protos/WorkTrashContainer.proto"
EXTERNPROTO "omnisim://projects/objects/street_furniture/protos/PublicToilet.proto"
EXTERNPROTO "omnisim://projects/samples/demos/protos/TowerCrane.proto"
EXTERNPROTO "omnisim://projects/samples/demos/protos/ConstructionFrameBuilding.proto"
EXTERNPROTO "omnisim://projects/samples/demos/protos/DumpTruck.proto"
EXTERNPROTO "omnisim://projects/samples/demos/protos/Excavator.proto"
EXTERNPROTO "omnisim://projects/samples/demos/protos/ConcreteMixer.proto"
EXTERNPROTO "omnisim://projects/appearances/protos/SandyGround.proto"
EXTERNPROTO "omnisim://projects/appearances/protos/DryMud.proto"
EXTERNPROTO "omnisim://projects/appearances/protos/Sand.proto"
EXTERNPROTO "omnisim://projects/appearances/protos/RustyMetal.proto"
EXTERNPROTO "omnisim://projects/appearances/protos/GalvanizedMetal.proto"
EXTERNPROTO "omnisim://projects/appearances/protos/OldPlywood.proto"
EXTERNPROTO "omnisim://projects/appearances/protos/RoughConcrete.proto"

WorldInfo {
  basicTimeStep 16
  gravity 9.81
  title "Construction Site (dev, editable)"
}
Viewpoint {
  orientation -0.305 0.305 0.902 1.66
  position 30 -26 16
}
OmniSimSky { }
DEF SUN OmniSimSun { }
DirectionalLight {
  direction -0.72 0.30 -0.42
  color 1.0 0.90 0.72
  intensity 2.6
  ambientIntensity 0.0
  castShadows TRUE
}
DirectionalLight {
  direction 0.5 -0.25 -0.5
  color 0.45 0.52 0.62
  intensity 0.5
  ambientIntensity 0.2
  castShadows FALSE
}
Fog {
  color 0.80 0.80 0.82
  fogType "EXPONENTIAL"
  visibilityRange 190
}

# ── Ground (dirt + mud patches), with collision plane ──
DEF SITE_GROUND Solid {
  children [
    Pose { translation 0 0 -0.22 children [ Shape { appearance SandyGround { colorOverride 0.78 0.72 0.60 textureTransform TextureTransform { scale 150 150 } } geometry Box { size 400 400 0.4 } } ] }
    Pose { translation -6 -2 -0.019 children [ Shape { appearance DryMud { textureTransform TextureTransform { scale 6 6 } } geometry Box { size 7 5 0.004 } } ] }
    Pose { translation 9 6 -0.019 children [ Shape { appearance DryMud { textureTransform TextureTransform { scale 5 5 } } geometry Box { size 6 5 0.004 } } ] }
  ]
  name "site_ground"
  boundingObject Plane { }
}

