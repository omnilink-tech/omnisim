ConstructionFrameBuilding { translation -4 26 0 rotation 0 0 1 1.5708 floors 11 wrapFloors 5 wrapColor 0.74 0.74 0.70 name "hero_tower" }
ConstructionFrameBuilding { translation 14 40 0 rotation 0 0 1 0.2 floors 14 baysX 3 baysY 3 bay 4.0 wrapFloors 9 wrapColor 0.70 0.70 0.66 name "tower_north" }
