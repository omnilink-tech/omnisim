#VRML_SIM R2025a utf8
# Dev preview of the full ConstructionSiteEnvironment (as used by the
# omnilink_construction_site demo) — renders via the site_screenshot
# supervisor to projects/_scratch/site_shots. No functional robots.

EXTERNPROTO "omnisim://projects/objects/backgrounds/protos/OmniSimSky.proto"
EXTERNPROTO "omnisim://projects/objects/lights/protos/OmniSimSun.proto"
EXTERNPROTO "omnisim://projects/samples/demos/protos/ConstructionSiteEnvironment.proto"

WorldInfo {
  basicTimeStep 16
  title "Construction site env preview"
}
Viewpoint {
  orientation -0.305 0.305 0.902 1.66
  position 30 -26 16
}
OmniSimSky { }
DEF SUN OmniSimSun { }
DirectionalLight {
  direction -0.72 0.30 -0.42
  color 1.0 0.90 0.72
  intensity 2.6
  castShadows TRUE
}
DirectionalLight {
  direction 0.5 -0.25 -0.5
  color 0.45 0.52 0.62
  intensity 0.5
  ambientIntensity 0.2
  castShadows FALSE
}
Fog {
  color 0.80 0.80 0.82
  fogType "EXPONENTIAL"
  visibilityRange 190
}

ConstructionSiteEnvironment {
}

Robot {
  name "site_screenshot"
  supervisor TRUE
  controller "site_screenshot"
  children []
}
