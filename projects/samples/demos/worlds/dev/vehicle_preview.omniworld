#OMNISIM R2025a utf8
# Dev preview of the procedural construction vehicles (DumpTruck,
# Excavator, ConcreteMixer) with a worker for scale. Renders via the
# vehicle_preview supervisor to projects/_scratch/vehicle_shots.

EXTERNPROTO "omnisim://projects/objects/backgrounds/protos/OmniSimSky.proto"
EXTERNPROTO "omnisim://projects/objects/lights/protos/OmniSimSun.proto"
EXTERNPROTO "omnisim://projects/objects/floors/protos/Floor.proto"
EXTERNPROTO "omnisim://projects/appearances/protos/SandyGround.proto"
EXTERNPROTO "omnisim://projects/samples/demos/protos/DumpTruck.proto"
EXTERNPROTO "omnisim://projects/samples/demos/protos/Excavator.proto"
EXTERNPROTO "omnisim://projects/samples/demos/protos/ConcreteMixer.proto"

WorldInfo {
  basicTimeStep 16
  title "Vehicle preview"
}
Viewpoint {
  orientation -0.305 0.305 0.902 1.66
  position 13 -1 6
}
OmniSimSky { }
DEF SUN OmniSimSun { }
DirectionalLight {
  direction -0.6 0.3 -0.5
  color 1.0 0.95 0.85
  intensity 2.4
  castShadows TRUE
}
Floor {
  size 40 40
  tileSize 4 4
  appearance SandyGround { colorOverride 0.8 0.74 0.62 textureTransform TextureTransform { scale 12 12 } }
}

DumpTruck { translation 0 -7 0 rotation 0 0 1 0.3 name "preview_dumptruck" }
Excavator { translation 0 0 0 rotation 0 0 1 0.4 name "preview_excavator" }
ConcreteMixer { translation 0 7 0 rotation 0 0 1 0.2 name "preview_mixer" }

# worker for scale (1.75 m)
DEF SCALE_WORKER Pose {
  translation 3 0 0
  children [
    Pose { translation 0 0 0.45 children [ Shape { appearance PBRAppearance { baseColor 0.12 0.15 0.3 } geometry Box { size 0.32 0.26 0.9 } } ] }
    Pose { translation 0 0 1.16 children [ Shape { appearance PBRAppearance { baseColor 0.96 0.55 0.05 } geometry Capsule { height 0.5 radius 0.22 } } ] }
    Pose { translation 0 0 1.62 children [ Shape { appearance PBRAppearance { baseColor 0.78 0.6 0.46 } geometry Sphere { radius 0.11 } } ] }
    Pose { translation 0 0 1.72 children [ Shape { appearance PBRAppearance { baseColor 0.95 0.85 0.1 } geometry Cylinder { radius 0.13 height 0.12 } } ] }
  ]
}

Robot {
  name "vehicle_preview"
  supervisor TRUE
  controller "vehicle_preview"
  children []
}
