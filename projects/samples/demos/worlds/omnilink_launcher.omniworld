# v4 content pass: real garden assets + near-camera grass clumps (alpha-cutout cards).
# v4.2: the fence line fronts the lot at y=-8.6 with a gate on the path. It was at -8.0,
# but its own shadow band (1 m pickets, 31-deg sun -> ~0.8 m NW) covered the patrol
# rover's front lane at y=-7.15, so the rover crossed the front with its shadow merged
# into the fence's; at -8.6 the lane rides a sunlit strip and the moving shadow reads.
# PicketFence segments extend along LOCAL -Y; rotation z=+90 deg turns that into +X,
# so each run's origin is its west end. West run x -7.4..-2.3, east run x -0.5..6.3.
DEF FENCE_W PicketFence {
  translation -7.4 -8.6 0.02
  rotation 0 0 1 1.5708
  numberOfSegments 3
  enableBoundingObject FALSE
}
DEF FENCE_E PicketFence {
  translation -0.5 -8.6 0.02
  rotation 0 0 1 1.5708
  name "picket fence east"
  numberOfSegments 4
  enableBoundingObject FALSE
}
DEF TREE_SASSAFRAS Sassafras {
  translation 8.0 7.5 0
  rotation 0 0 1 1.2
  enableBoundingObject FALSE
}
DEF WHEELBARROW Wheelbarrow {
  translation -4.6 -6.1 0.02
  rotation 0 0 1 0.5
}
DEF WATERING_CAN WateringCan {
  translation 1.5 -3.1 0.055
  rotation 0 0 1 -0.7
}
