#OMNISIM R2025a utf8

# OmniSim Launcher — the "hello world" scene: a small sunlit house on a lawn.
#
# Right-click the floating orb robot → "Show Robot Window" → a gallery of
# every demo in the repo appears. Click "Launch" to open that demo's world.
# Categories: starter, chat (arms/mobile/quadruped), flagship, physics,
# games, kinematics, URDF showcase, generated worlds.
#
# The scene is the Beauty Bench house lot (see
# projects/samples/demos/worlds/rendering/beauty_bench.omniworld — that copy
# stays FROZEN as the render-quality benchmark; this one is the living
# first-open experience). Differences from the benchmark, both deliberate:
#   - the Viewpoint authors renderBackend "wgpu" (the per-world opt-in), so
#     the first thing a new user sees is the HDR + AgX + GTAO look;
#   - SUN_MARKER is present, so the day-night cycle runs — at night the
#     door strip, the lamp and the orb glow against the dark house.
#
# To return here: relaunch from launch.bat (no args), or File → Open World.

EXTERNPROTO "omnisim://projects/objects/backgrounds/protos/OmniSimSky.proto"
EXTERNPROTO "omnisim://projects/objects/lights/protos/OmniSimSun.proto"
EXTERNPROTO "omnisim://projects/objects/lights/protos/OmniSimSunMarker.proto"
EXTERNPROTO "omnisim://projects/appearances/protos/Grass.proto"
EXTERNPROTO "omnisim://projects/appearances/protos/RedBricks.proto"
EXTERNPROTO "omnisim://projects/appearances/protos/Plaster.proto"
EXTERNPROTO "omnisim://projects/appearances/protos/FormedConcrete.proto"
EXTERNPROTO "omnisim://projects/appearances/protos/Parquetry.proto"
EXTERNPROTO "omnisim://projects/appearances/protos/PaintedWood.proto"
EXTERNPROTO "omnisim://projects/appearances/protos/BrushedSteel.proto"
EXTERNPROTO "omnisim://projects/appearances/protos/Copper.proto"
EXTERNPROTO "omnisim://projects/appearances/protos/Marble.proto"
EXTERNPROTO "omnisim://projects/appearances/protos/CorrodedMetal.proto"
EXTERNPROTO "omnisim://projects/appearances/protos/BrushedAluminium.proto"
EXTERNPROTO "omnisim://projects/appearances/protos/OsbWood.proto"
EXTERNPROTO "omnisim://projects/appearances/protos/Pavement.proto"
EXTERNPROTO "omnisim://projects/objects/trees/protos/Oak.proto"
EXTERNPROTO "omnisim://projects/objects/trees/protos/Pine.proto"
EXTERNPROTO "omnisim://projects/objects/trees/protos/Sassafras.proto"
EXTERNPROTO "omnisim://projects/objects/garden/protos/PicketFence.proto"
EXTERNPROTO "omnisim://projects/objects/garden/protos/Wheelbarrow.proto"
EXTERNPROTO "omnisim://projects/objects/garden/protos/WateringCan.proto"

WorldInfo {
  newtonCompoundColliders TRUE
  basicTimeStep 32
  title "OmniSim — Launcher"
  info [
    "OmniSim — demo launcher. Right-click the orb → Show Robot Window."
    "Pick a demo from the side panel and click Launch."
  ]
}
Viewpoint {
  orientation 0 0.329 0.945 0.735
  position -10.5 -9.5 4.4
  exposure 1.0
  renderBackend "wgpu"
}
OmniSimSky { }
DEF SUN OmniSimSun {
  # Initial sun = the Beauty Bench hero light (front-right sky, shadows raking
  # toward the camera); the SUN_MARKER supervisor then runs the day-night cycle.
  direction -0.6 0.35 -0.42
}
# The marker drives SUN.direction = -normalize(marker translation) from its
# first step, OVERRIDING the authored direction above. Its PROTO default (0 0 8)
# is a straight-down noon sun that flattens the whole scene, so author the
# translation to reproduce the hero sun exactly: -(-0.6 0.35 -0.42) * 14.
DEF SUN_MARKER OmniSimSunMarker { translation 10.3 -6.0 7.2 }

DEF LAUNCHER Robot {
  translation -3.2 -5.0 1.3
  name "omnisim_launcher"
  supervisor TRUE
  controller "omnilink_launcher"
  window "omnilink_launcher"
  children [
    DEF ORB_SHAPE Shape {
      appearance PBRAppearance {
        baseColor 0.97 0.90 0.40
        emissiveColor 0.40 0.36 0.16
        roughness 0.35
        metalness 0.25
      }
      geometry Sphere {
        radius 0.28
        subdivision 3
      }
    }
    PointLight {
      color 0.97 0.90 0.40
      intensity 0.6
      location 0 0 0
      # Quadratic attenuation (0 0 1). The field defaults to "1 0 0" (constant),
      # which makes WbPointLight emit a parsing warning on every load -- the very
      # first thing a new user sees in the console. Its own advice: "Only the third
      # component of the 'attenuation' field should be greater than 0."
      attenuation 0 0 1
      radius 4.0
      castShadows FALSE
    }
  ]
}

