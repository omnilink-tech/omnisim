# Patrol rover: kinematic (no Physics -- the lot has no colliders), driven by the
# omni_patrol supervisor on a rounded-rect loop around the house. It exists so a
# viewer can watch the lighting stack play over a MOVING body: it reads the
# OmniLight probe field as it goes, its PCSS shadow tracks the sun, and at night
# the light bar and orb are the moving light sources.
DEF PATROL_ROVER Robot {
  translation 5.6 -1.0 0.02
  rotation 0 0 1 1.5708
  name "patrol_rover"
  supervisor TRUE
  controller "omni_patrol"
  children [
    Pose { translation 0 0 0.20 children [ Shape { appearance PBRAppearance { baseColor 0.10 0.10 0.12 roughness 0.45 metalness 0.35 } geometry Box { size 0.62 0.40 0.16 } } ] }
    Pose { translation -0.02 0 0.315 children [ Shape { appearance PBRAppearance { baseColor 0.93 0.90 0.80 roughness 0.35 metalness 0.05 } geometry Box { size 0.50 0.34 0.07 } } ] }
    Pose { translation 0.10 0 0.356 children [ Shape { appearance PBRAppearance { baseColor 0.97 0.80 0.20 roughness 0.4 metalness 0.1 } geometry Box { size 0.22 0.30 0.012 } } ] }
    Pose { translation 0.312 0 0.24 children [ Shape { appearance PBRAppearance { baseColor 0 0 0 roughness 1 metalness 0 emissiveColor 0.97 0.88 0.55 emissiveIntensity 5 } geometry Box { size 0.015 0.30 0.05 } } ] }
    Pose { translation -0.16 0 0.42 children [ Shape { appearance BrushedSteel { } geometry Cylinder { radius 0.012 height 0.14 } } ] }
    Pose { translation -0.16 0 0.52 children [ Shape { appearance PBRAppearance { baseColor 0.97 0.90 0.40 emissiveColor 0.40 0.36 0.16 roughness 0.35 metalness 0.25 } geometry Sphere { radius 0.055 subdivision 3 } } ] }
    Pose { translation 0.21 0.225 0.12 rotation 1 0 0 1.5708 children [ DEF WHEEL_SPIN_FL Pose { children [
      DEF TIRE Shape { appearance PBRAppearance { baseColor 0.06 0.06 0.07 roughness 0.9 metalness 0 } geometry Cylinder { radius 0.12 height 0.075 } }
      DEF HUB Shape { appearance PBRAppearance { baseColor 0.70 0.70 0.72 roughness 0.3 metalness 0.8 } geometry Cylinder { radius 0.045 height 0.078 } }
      DEF SPOKE_A Shape { appearance PBRAppearance { baseColor 0.93 0.90 0.80 roughness 0.5 metalness 0.2 } geometry Box { size 0.21 0.028 0.08 } }
      DEF SPOKE_B Pose { rotation 0 0 1 1.5708 children [ USE SPOKE_A ] }
    ] } ] }
    Pose { translation 0.21 -0.225 0.12 rotation 1 0 0 1.5708 children [ DEF WHEEL_SPIN_FR Pose { children [ USE TIRE USE HUB USE SPOKE_A USE SPOKE_B ] } ] }
    Pose { translation -0.21 0.225 0.12 rotation 1 0 0 1.5708 children [ DEF WHEEL_SPIN_RL Pose { children [ USE TIRE USE HUB USE SPOKE_A USE SPOKE_B ] } ] }
    Pose { translation -0.21 -0.225 0.12 rotation 1 0 0 1.5708 children [ DEF WHEEL_SPIN_RR Pose { children [ USE TIRE USE HUB USE SPOKE_A USE SPOKE_B ] } ] }
  ]
}
