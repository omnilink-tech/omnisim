#OMNISIM R2025a utf8

# Closed-loop agent demo, corrected plan: the same four independent Huskies
# receive separated ring targets after the shared-target run reports contacts.

EXTERNPROTO "omnisim://projects/objects/floors/protos/RectangleArena.proto"
EXTERNPROTO "omnisim://projects/appearances/protos/Asphalt.proto"
EXTERNPROTO "omnisim://projects/objects/backgrounds/protos/OmniSimSky.proto"
EXTERNPROTO "omnisim://projects/objects/lights/protos/OmniSimSun.proto"

WorldInfo {
  basicTimeStep 16
  title "Agent Fleet - Contact-Aware Replan"
}
Viewpoint {
  orientation 0 1 0 1.570796
  position 0 0 30
}
OmniSimSky { }
OmniSimSun { }
DirectionalLight {
  direction -0.4 0.3 -0.8
  color 0.9 0.94 1
  intensity 1.3
  castShadows FALSE
}
RectangleArena {
  floorSize 16 16
  wallHeight 0.35
  floorAppearance Asphalt { colorOverride 0.12 0.14 0.17 }
}

DEF TARGET_A Solid { translation -1.8 0 0.012 children [ Shape { appearance PBRAppearance { baseColor 0.96 0.91 0.02 emissiveColor 0.25 0.22 0 roughness 0.65 metalness 0 } geometry Box { size 0.8 0.8 0.024 } } ] name "target a" }
DEF TARGET_B Solid { translation 1.8 0 0.012 children [ Shape { appearance PBRAppearance { baseColor 0.05 0.75 0.95 emissiveColor 0.0 0.18 0.25 roughness 0.65 metalness 0 } geometry Box { size 0.8 0.8 0.024 } } ] name "target b" }
DEF TARGET_C Solid { translation 0 -1.8 0.012 children [ Shape { appearance PBRAppearance { baseColor 0.92 0.1 0.68 emissiveColor 0.24 0.01 0.14 roughness 0.65 metalness 0 } geometry Box { size 0.8 0.8 0.024 } } ] name "target c" }
DEF TARGET_D Solid { translation 0 1.8 0.012 children [ Shape { appearance PBRAppearance { baseColor 0.12 0.9 0.35 emissiveColor 0.02 0.23 0.07 roughness 0.65 metalness 0 } geometry Box { size 0.8 0.8 0.024 } } ] name "target d" }

DEF FLEET_A URDFRobot {
  url "../../../../robots/clearpath/husky_description/urdf/husky.urdf"
  translation -6.2 0 0.1
  rotation 0 0 1 0
  name "fleet_a"
  controller "fleet_goal"
  supervisor TRUE
  customData "{\"target\":[-1.8,0.0],\"plan\":\"separated_ring\"}"
}
DEF FLEET_B URDFRobot {
  url "../../../../robots/clearpath/husky_description/urdf/husky.urdf"
  translation 6.2 0 0.1
  rotation 0 0 1 3.141593
  name "fleet_b"
  controller "fleet_goal"
  supervisor TRUE
  customData "{\"target\":[1.8,0.0],\"plan\":\"separated_ring\"}"
}
DEF FLEET_C URDFRobot {
  url "../../../../robots/clearpath/husky_description/urdf/husky.urdf"
  translation 0 -6.2 0.1
  rotation 0 0 1 1.570796
  name "fleet_c"
  controller "fleet_goal"
  supervisor TRUE
  customData "{\"target\":[0.0,-1.8],\"plan\":\"separated_ring\"}"
}
DEF FLEET_D URDFRobot {
  url "../../../../robots/clearpath/husky_description/urdf/husky.urdf"
  translation 0 6.2 0.1
  rotation 0 0 1 -1.570796
  name "fleet_d"
  controller "fleet_goal"
  supervisor TRUE
  customData "{\"target\":[0.0,1.8],\"plan\":\"separated_ring\"}"
}
