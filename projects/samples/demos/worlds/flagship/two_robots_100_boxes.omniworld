      device [ LinearMotor { name "finger_l" maxForce 200 maxVelocity 2 } PositionSensor { name "finger_l_sensor" } ]
      endPoint DEF A_FINGER_L Solid { name "A_finger_l" translation 0 0.09 0
      children [Pose { translation 0 0 0 children [ Shape { appearance PBRAppearance { baseColor .075 .07 .055 metalness 0.1 roughness .48 } geometry Box { size 0.11 0.006 0.065 } } ] }Pose { translation 0 0 0.068 children [ Shape { appearance PBRAppearance { baseColor .78 .75 .42 metalness 0.1 roughness .48 } geometry Box { size 0.065 0.009000000000000001 0.08 } } ] }] boundingObject Box { size .11 0.006 .065 }
