#OMNISIM R2025a utf8
# Part Two: one hundred free boxes. Warm-neutral continuation of the original film.
EXTERNPROTO "omnisim://projects/objects/floors/protos/Floor.proto"
EXTERNPROTO "omnisim://projects/objects/backgrounds/protos/OmniSimSky.proto"
EXTERNPROTO "omnisim://projects/objects/lights/protos/OmniSimSun.proto"
EXTERNPROTO "omnisim://projects/objects/lights/protos/OmniSimSunMarker.proto"
WorldInfo { basicTimeStep 8 title "Two robots. One hundred boxes."
 newtonSolver "mujoco" newtonStatics TRUE newtonRobotColliders TRUE newtonCompoundColliders TRUE
 newtonGroundMu 1.5 newtonCone "elliptic" newtonImpratio 10 newtonCondim 4
 newtonContactKe 2500 newtonContactKd 100 newtonIterations 100 newtonLsIterations 30
 newtonNjmax 8192 newtonNconmax 2048 }
Viewpoint { position 5.2 -8.4 5.2 orientation -0.1921913568670045 0.10706136743966453 0.9755000491786604 2.14605608322842 fieldOfView .75
 exposure .9 near .05 far 80 ambientOcclusionRadius .5 bloomThreshold 10 }
OmniSimSky { luminosity 1.1 }
DEF SUN OmniSimSun { color 1 .95 .84 intensity 2.6 ambientIntensity .09 castShadows TRUE }
DEF SUN_MARKER OmniSimSunMarker { translation -12 -18 25 }
Floor { size 100 100 tileSize 16 12 appearance PBRAppearance { baseColor .73 .71 .65 metalness 0 roughness .9
 baseColorMap ImageTexture { url ["omnisim://projects/samples/demos/worlds/textures/one_passage/concrete.png"] }
 normalMap ImageTexture { url ["omnisim://projects/appearances/protos/textures/rough_concrete/rough_concrete_normal.jpg"] } normalMapFactor .06 } }
DEF STAGE Solid { name "STAGE" translation 0 0 0.025 children [Pose { translation 0 0 0 children [ Shape { appearance PBRAppearance { baseColor .11 .105 .084 metalness 0.1 roughness .48 } geometry Box { size 5.1 3.3 0.05 } } ] }] boundingObject Box {size 5.1 3.3 0.05} }
DEF TOWER_PLINTH Solid { name "TOWER_PLINTH" translation 0 0 0.2 children [Pose { translation 0 0 0 children [ Shape { appearance PBRAppearance { baseColor .25 .24 .195 metalness 0.1 roughness .48 } geometry Box { size 0.58 0.58 0.3 } } ] }] boundingObject Box {size 0.58 0.58 0.3} }
DEF SUPPLY_A Solid { name "SUPPLY_A" translation -1.15 0 0.2 children [Pose { translation 0 0 0 children [ Shape { appearance PBRAppearance { baseColor .29 .28 .235 metalness 0.1 roughness .48 } geometry Box { size 1.24 2.64 0.3 } } ] }] boundingObject Box {size 1.24 2.64 0.3} }
DEF ROBOT_A Robot { translation -2.1 0 0 name "A" supervisor TRUE controller "tower100_builder"
    children [Pose { translation 0 0 0.09 children [ Shape { appearance PBRAppearance { baseColor .09 .087 .073 metalness 0.1 roughness .48 } geometry Box { size 0.44 3.0 0.18 } } ] }
    Pose { translation 0 0 0.21 children [ Shape { appearance PBRAppearance { baseColor .45 .44 .39 metalness 0.7 roughness .48 } geometry Box { size 0.28 2.8 0.06 } } ] } SliderJoint { jointParameters JointParameters { axis 0 1 0 }
      device [ LinearMotor { name "y" maxForce 1500 maxVelocity 2 } PositionSensor { name "y_sensor" } ]
      endPoint DEF A_Y Solid { name "A_y" translation 0 0 0
      children [SliderJoint { jointParameters JointParameters { axis 0 0 1 }
