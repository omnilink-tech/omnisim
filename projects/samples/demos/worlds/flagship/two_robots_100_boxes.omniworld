      physics Physics { density -1 mass 0.04 } } }Pose { translation -1.05 0 0.18 children [ Shape { appearance PBRAppearance { baseColor .53 .52 .48 metalness 0.65 roughness .48 } geometry Box { size 2.2 0.095 0.085 } } ] }] boundingObject Pose {translation 0 0 .115 children [Box {size .19 .31 .055}]}
      physics Physics { density -1 mass 0.7 } } }] boundingObject Pose {translation 0 0 .1 children [Box {size .22 .23 .28}]}
