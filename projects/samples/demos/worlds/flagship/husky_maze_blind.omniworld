# Visual marker 'blue_cylinder' at cell (8,8).
Solid {
  translation 6.0 6.0 0.30
  name "blue_cylinder"
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.10 0.30 0.95
        roughness 0.4
