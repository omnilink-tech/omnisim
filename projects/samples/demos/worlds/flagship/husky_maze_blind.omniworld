# Husky robot, spawned at the NW start cell facing east.
DEF HUSKY URDFRobot {
  url "../../../../robots/clearpath/husky_description/urdf/husky.urdf"
  translation -10 10 0.1
  name "husky"
  supervisor TRUE
  controller "husky_omnilink_bridge"
}

# Vision sidecar — see controllers/husky_eye/.
Robot {
  name "husky_eye"
  translation -10 10 1
  supervisor TRUE
  controller "husky_eye"
  children [
    # Four cardinal cameras at 160x120 — agent gets a 360 deg view per chat,
    # never has to pivot to look. Lower resolution (~17 K input tokens per
    # frame) keeps the four-image multi-modal payload roughly equal to the
    # old single-camera 320x240 cost while quadrupling situational awareness.
    Camera {
      name "front_camera"
      width 160
      height 120
      fieldOfView 1.4
      rotation 0 1 0 0.35
    }
    Camera {
      name "right_camera"
      width 160
      height 120
      fieldOfView 1.4
      rotation 0 0 1 -1.5707963267948966
    }
    Camera {
      name "back_camera"
      width 160
      height 120
      fieldOfView 1.4
      rotation 0 0 1 3.141592653589793
    }
    Camera {
      name "left_camera"
      width 160
      height 120
      fieldOfView 1.4
      rotation 0 0 1 1.5707963267948966
    }
    Shape {
      appearance PBRAppearance {
        baseColor 0.2 0.6 1.0
        emissiveColor 0.05 0.15 0.3
        roughness 0.4
      }
      geometry Sphere { radius 0.05 }
    }
  ]
}
