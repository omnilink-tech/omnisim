#OMNISIM R2025a utf8

# Husky maze - Husky Maze (Blind)
# Recursive-backtracker maze, seed=100, identical layout to
# husky_maze_visual.omniworld. The title contains "Blind", which
# makes the bridge gate BOTH /maze and /lidar to {available: false}.
# The agent must navigate from camera frames + pose only —
# no wall list, no ray ranges. Vision becomes load-bearing for
# *navigation itself*, not just marker identification.

EXTERNPROTO "omnisim://projects/objects/floors/protos/Floor.proto"
EXTERNPROTO "omnisim://projects/objects/apartment_structure/protos/Wall.proto"
EXTERNPROTO "omnisim://projects/appearances/protos/Roughcast.proto"
EXTERNPROTO "omnisim://projects/appearances/protos/Asphalt.proto"
EXTERNPROTO "omnisim://projects/objects/backgrounds/protos/OmniSimSky.proto"
EXTERNPROTO "omnisim://projects/objects/lights/protos/OmniSimSun.proto"
EXTERNPROTO "omnisim://projects/objects/lights/protos/OmniSimSunMarker.proto"

WorldInfo {
  basicTimeStep 16
  title "Husky Maze (Blind)"
  info [
    "drive the husky to the cell that holds the RED cylinder.",
    "the bridge will not give you the maze layout (try_get_known_map -> available:false)",
    "and will not give you lidar ranges (read_lidar -> available:false).",
    "you have only read_camera, get_state (pose), and motion primitives.",
    "decide which cell to drive to AND whether the path ahead is clear from pixels alone."
  ]
}
Viewpoint {
  orientation -0.5773 0.5773 0.5773 2.0944
  position 0 0 50
}
OmniSimSky { }
DEF SUN OmniSimSun { }
DEF SUN_MARKER OmniSimSunMarker { }
DirectionalLight {
  direction -0.4 0.3 -0.6
  color 0.85 0.88 1.0
  intensity 1.4
  ambientIntensity 0.0
  castShadows FALSE
}

Floor {
  size 26 26
  tileSize 26 26
  appearance Asphalt {
    colorOverride 0.55 0.57 0.60
  }
}

# Outer perimeter walls (22 m x 22 m enclosure, centred on origin).
Wall { name "wall_perim_N" translation 0 11 0 size 22.2 0.2 1 }
Wall { name "wall_perim_S" translation 0 -11 0 size 22.2 0.2 1 }
Wall { name "wall_perim_E" translation 11 0 0 size 0.2 22.2 1 }
Wall { name "wall_perim_W" translation -11 0 0 size 0.2 22.2 1 }

