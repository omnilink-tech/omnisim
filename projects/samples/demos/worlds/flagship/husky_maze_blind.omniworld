# Goal marker - red post + yellow finial at the SE goal cell.
Solid {
  translation 10 -10 0.25
  name "goal_marker"
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.95 0.1 0.1
        roughness 0.4
        metalness 0.0
        emissiveColor 0.4 0.0 0.0
      }
      geometry Cylinder {
        height 0.5
        radius 0.15
      }
    }
    Pose {
      translation 0 0 0.42
      children [
        Shape {
          appearance PBRAppearance {
            baseColor 1.0 0.85 0.0
            roughness 0.4
            metalness 0.0
            emissiveColor 0.5 0.4 0.0
          }
          geometry Sphere {
            radius 0.22
            subdivision 2
          }
        }
      ]
    }
  ]
}

# Visual marker 'red_cylinder' at cell (5,3).
Solid {
  translation 0.0 -4.0 0.30
  name "red_cylinder"
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.95 0.10 0.10
        roughness 0.4
        metalness 0.0
        emissiveColor 0.38 0.04 0.04
      }
      geometry Cylinder {
        height 0.60
        radius 0.18
      }
    }
  ]
}

# Visual marker 'green_cylinder' at cell (3,7).
Solid {
  translation -4.0 4.0 0.30
  name "green_cylinder"
  children [
