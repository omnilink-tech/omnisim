# ============================================================================
# Two huskies parked at the west end, one in each sector. Each runs the
# husky_omnilink_bridge controller on a different port (configurable via
# controllerArgs in iter 1; iter 0 ships with the bridges hard-coded so
# only ONE husky's bridge will respond — the other is visual-only until
# the multiplexing change lands).
# ============================================================================
DEF HUSKY_NORTH URDFRobot {
  url "../../../../robots/clearpath/husky_description/urdf/husky.urdf"
  translation -12 +5 0.1
  rotation 0 0 1 0
  name "husky_north"
  controller "husky_omnilink_bridge"
  controllerArgs ["--port" "6070" "--eye-port" "6071"]
  supervisor TRUE
}

DEF HUSKY_SOUTH URDFRobot {
  url "../../../../robots/clearpath/husky_description/urdf/husky.urdf"
  translation -12 -5 0.1
  rotation 0 0 1 0
  name "husky_south"
  controller "husky_omnilink_bridge"
  controllerArgs ["--port" "6080" "--eye-port" "6081"]
  supervisor TRUE
}

# Eye sidecars — one per husky. Each gets a different listening port +
# tracks its own husky DEF via the new --track-def controllerArg landed
# in iter 1. The blue-tinted sphere is the north eye, orange-tinted is
# south, so an operator scrolling around in OmniSim can tell them apart.
Robot {
  name "husky_eye_north"
  translation -12 +5 1
  supervisor TRUE
  controller "husky_eye"
  controllerArgs ["--port" "6071" "--track-def" "HUSKY_NORTH"]
  children [
    Camera {
      name "front_camera"
      width 320
      height 240
      fieldOfView 1.4
      rotation 0 1 0 0.35
    }
    Shape {
      appearance PBRAppearance {
        baseColor 0.2 0.6 1.0
        emissiveColor 0.05 0.15 0.3
        roughness 0.4
      }
      geometry Sphere { radius 0.05 }
    }
  ]
}

Robot {
  name "husky_eye_south"
  translation -12 -5 1
  supervisor TRUE
  controller "husky_eye"
  controllerArgs ["--port" "6081" "--track-def" "HUSKY_SOUTH"]
  children [
    Camera {
      name "front_camera"
      width 320
      height 240
      fieldOfView 1.4
      rotation 0 1 0 0.35
    }
    Shape {
      appearance PBRAppearance {
        baseColor 1.0 0.6 0.2
        emissiveColor 0.3 0.15 0.05
        roughness 0.4
      }
      geometry Sphere { radius 0.05 }
    }
  ]
}
