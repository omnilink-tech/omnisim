#OMNISIM R2025a utf8

# Agent Build Film challenge: unseen 17x17 maze.
# Planner-visible at runtime: pose, goal, dimensions, 360-degree ray ranges.
# Planner-hidden at runtime: seed, wall list, adjacency graph, optimal path.
# layout_sha256: b1aa122b974b3fd5f5080a0cca2743c7c6897b6c9f1cdbc9508aae8480f32e77

EXTERNPROTO "omnisim://projects/objects/floors/protos/Floor.proto"
