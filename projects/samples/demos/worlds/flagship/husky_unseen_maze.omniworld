WorldInfo {
  basicTimeStep 16
  title "Husky Unseen Maze — b1aa122b97"
  info [
    "A frozen sensor-only planner must reach the southeast beacon."
    "The planner receives robot pose, maze dimensions, goal coordinates, and 360-degree ray ranges."
    "It does not receive this world's wall nodes, seed, adjacency graph, or optimal path."
  ]
  newtonSolver "mujoco"
  newtonStatics TRUE
  newtonRobotColliders TRUE
  newtonCompoundColliders TRUE
  newtonSubsteps 4
  # Skid-steer tires need controlled lateral scrub during a turn; 0.72 keeps
  # forward traction while avoiding the unrealistically locked 1.15 surface.
  newtonGroundMu 0.42
}

