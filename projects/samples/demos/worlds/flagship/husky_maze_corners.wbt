#VRML_SIM R2025a utf8

# Husky maze - Husky Maze (Corners Tour)
# Recursive-backtracker maze, seed=31. Same coordinate
# convention as husky_maze.wbt: 11x11 cells, 2 m each,
# cell (col, row) center at (-10 + 2*col, -10 + 2*row).
# Start cell (0, 10) at (-10, +10).

EXTERNPROTO "omnisim://projects/objects/floors/protos/Floor.proto"
EXTERNPROTO "omnisim://projects/objects/apartment_structure/protos/Wall.proto"
EXTERNPROTO "omnisim://projects/appearances/protos/Roughcast.proto"
EXTERNPROTO "omnisim://projects/appearances/protos/Asphalt.proto"
EXTERNPROTO "omnisim://projects/objects/backgrounds/protos/OmniSimSky.proto"
EXTERNPROTO "omnisim://projects/objects/lights/protos/OmniSimSun.proto"
EXTERNPROTO "omnisim://projects/objects/lights/protos/OmniSimSunMarker.proto"

WorldInfo {
  basicTimeStep 16
  title "Husky Maze (Corners Tour)"
  info [
    "Mission: visit each of the four corner cells of the maze and then return to your start."
    ""
    "The four corners are:"
    "  * NW = (col=0, row=10) at world (-10, +10)  (this is also your start)"
    "  * NE = (col=10, row=10) at world (+10, +10)"
    "  * SE = (col=10, row=0) at world (+10, -10)"
    "  * SW = (col=0, row=0) at world (-10, -10)"
    ""
    "After your first cell move you have visited NW. Then visit the other three corners in any order, then drive back to NW."
    "Call complete_mission with rationale='visited NW + NE + SE + SW + returned to NW' once you finish."
  ]
}
Viewpoint {
  orientation -0.5773 0.5773 0.5773 2.0944
  position 0 0 50
}
OmniSimSky { }
DEF SUN OmniSimSun { }
DEF SUN_MARKER OmniSimSunMarker { }
DirectionalLight {
  direction -0.4 0.3 -0.6
  color 0.85 0.88 1.0
  intensity 1.4
  ambientIntensity 0.0
  castShadows FALSE
}

Floor {
  size 26 26
  tileSize 26 26
  appearance Asphalt {
    colorOverride 0.55 0.57 0.60
  }
}

# Outer perimeter walls (22 m x 22 m enclosure, centred on origin).
Wall { name "wall_perim_N" translation 0 11 0 size 22.2 0.2 1 }
Wall { name "wall_perim_S" translation 0 -11 0 size 22.2 0.2 1 }
Wall { name "wall_perim_E" translation 11 0 0 size 0.2 22.2 1 }
Wall { name "wall_perim_W" translation -11 0 0 size 0.2 22.2 1 }

# Internal maze walls.
