# Goal marker - red post + yellow finial at the SE goal cell.
Solid {
  translation 10 -10 0.25
  name "goal_marker"
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.95 0.1 0.1
        roughness 0.4
        metalness 0.0
        emissiveColor 0.4 0.0 0.0
      }
      geometry Cylinder {
        height 0.5
        radius 0.15
      }
    }
    Pose {
      translation 0 0 0.42
      children [
        Shape {
          appearance PBRAppearance {
            baseColor 1.0 0.85 0.0
            roughness 0.4
            metalness 0.0
            emissiveColor 0.5 0.4 0.0
          }
          geometry Sphere {
            radius 0.22
            subdivision 2
          }
        }
      ]
    }
  ]
}

# Husky robot, spawned at the NW start cell facing east.
URDFRobot {
  url "../../../../robots/clearpath/husky_description/urdf/husky.urdf"
  translation -10 10 0.1
  name "husky"
  supervisor TRUE
  controller "husky_omnilink_bridge"
}
