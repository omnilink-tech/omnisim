WorldInfo { basicTimeStep 16 }
Viewpoint { orientation -0.5773 0.5773 0.5773 2.0944 position 0 -1 14 }
OmniSimSky { }
DEF SUN OmniSimSun { }
DEF SUN_MARKER OmniSimSunMarker { }
OmniLinkStage { floorSize 14 14 wallHeight 0.1 }
