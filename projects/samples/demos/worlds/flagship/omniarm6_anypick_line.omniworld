#OMNISIM R2025a utf8

# OmniLink — OmniArm 6 ANYPICK LINE (L-conveyor feeds bins of mixed parts)
# An L-shaped conveyor brings BINS of mixed parts (cubes, capsule tubes,
# L-shaped tubes) to a pick station in front of the OmniArm 6: in along -y on the
# north leg, corner at the station (0.46, 0), out along +x on the east leg.
# Three bins arrive ONE AFTER THE OTHER, each in a DIFFERENT yaw; the robot
# empties each with the contact-honest AnyPick (per-shape suction anchors,
# vacuum only at measured touch, near-wall tilt computed in the yawed bin's
# own frame), sorting parts by shape into three trays; the emptied bin then
# departs along the east leg. Transport is kinematic (bin + contents as a
# rigid ensemble, per-tick pose + zero velocity); picking is live physics.
#
# Newton + MuJoCo solver. Belts + tray walls are Newton static colliders and
# bins + L-tubes are compound multi-box bodies -- both baked into WorldInfo
# (newtonStatics / newtonCompoundColliders) so any launch path works; the env
# vars OMNISIM_NEWTON_STATICS / OMNISIM_NEWTON_COMPOUND_COLLIDERS are no
# longer required.
#
# Headless verify:
#   ANYPICK_AUTOQUIT=1 python scripts/dev/headless_runner.py \
#     projects/samples/demos/worlds/flagship/omniarm6_anypick_line.omniworld --duration 1500

EXTERNPROTO "omnisim://projects/samples/demos/protos/OmniLinkStage.proto"
EXTERNPROTO "omnisim://projects/objects/backgrounds/protos/OmniSimSky.proto"
EXTERNPROTO "omnisim://projects/objects/lights/protos/OmniSimSun.proto"
EXTERNPROTO "omnisim://projects/objects/lights/protos/OmniSimSunMarker.proto"

WorldInfo {
  basicTimeStep 16
  title "OmniLink — OmniArm 6 AnyPick line (L-conveyor, mixed shapes)"
  newtonSolver "mujoco"
  newtonStatics TRUE             # belts/tray walls collide (folds OMNISIM_NEWTON_STATICS into the world)
  newtonCompoundColliders TRUE   # bins + L-tubes are multi-box bodies (folds OMNISIM_NEWTON_COMPOUND_COLLIDERS)
  contactProperties [
    ContactProperties { material1 "default" material2 "default" coulombFriction [ 3 ] bounce 0 softCFM 0.0003 }
  ]
  # translation_audit: ContactProperties.coulombFriction is an ODE-path field the
  # Newton backend does not read; this declares the same friction where it is read.
  #
  # mu 5 is past the contact solver's stable range at basicTimeStep 16 and sank
  # this world's dynamic bodies through the floor -- measured over a 12 s settle
  # with the robots removed: 8 of 24 bodies below z=0. mu 3 keeps every part on its
  # surface and is the value docs/guide/friction-grasp.md measured for a
  # two-finger pinch, so it is the highest friction this world can actually hold.
  newtonGroundMu 3
}
Viewpoint { orientation -0.278945 0.120681 0.952694 2.359689 position 3.303 -3.516 3.540 }
OmniSimSky { }
DEF SUN OmniSimSun { }
DEF SUN_MARKER OmniSimSunMarker { }
OmniLinkStage { floorSize 4.6 4.6 }

DEF OMNIARM6 URDFRobot {
  url "../../../../robots/omnisim/omniarm6/omniarm6_gumgrip.urdf"
  translation 0 0 0
  name "omniarm6"
  supervisor TRUE
  staticBase TRUE
  physicsBackend "newton"
  controller "omniarm6_anypick_line"
}

# ── Top-down recognition camera over the pick station ───────────────
DEF BIN_CAM Robot {
  translation 0.46 0 1.15
  children [
    Camera {
      name "bin_camera"
      rotation 0 1 0 1.5708
      width 320
      height 320
      fieldOfView 0.6
      recognition Recognition { maxRange 3 occlusion 1 frameColor 0 1 0 frameThickness 2 }
    }
    RangeFinder {
      name "bin_depth"
      rotation 0 1 0 1.5708
      width 160
      height 160
      fieldOfView 0.6
      minRange 0.05
      maxRange 2.5
    }
  ]
  name "bin_cam"
  controller "anypick_cam"
}

# ── The L-SHAPED CONVEYOR: north in-feed leg + east out-feed leg meeting at
# the pick station (0.46, 0). Static Newton colliders (belt top z = 0.08);
# the bins ride them kinematically (driven by the controller).
DEF BELT_IN Solid {
  translation 0.46 1.20 0.04
  physicsBackend "newton"
  children [
    DEF BELT_IN_SH Shape { appearance PBRAppearance { baseColor 0.15 0.16 0.19 roughness 0.9 metalness 0.4 } geometry Box { size 0.50 2.00 0.08 } }
  ]
  name "belt_in"
  boundingObject USE BELT_IN_SH
}
DEF BELT_OUT Solid {
  translation 1.13 0 0.04
  physicsBackend "newton"
  children [
    DEF BELT_OUT_SH Shape { appearance PBRAppearance { baseColor 0.15 0.16 0.19 roughness 0.9 metalness 0.4 } geometry Box { size 1.85 0.50 0.08 } }
  ]
  name "belt_out"
  boundingObject USE BELT_OUT_SH
}

