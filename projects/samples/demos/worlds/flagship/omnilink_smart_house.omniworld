# ── A real dynamic body: the book on the bed ──────────────────────────
# The one Newton dynamic body in the house — it settles on the bed's
# collider, which keeps the world honest under --fail-on-runaway.
DEF BOOK Solid {
  translation 3.2 -2.9 0.75
  name "book"
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.7 0.2 0.15
        roughness 0.8
        metalness 0
      }
      geometry Box {
        size 0.19 0.13 0.035
      }
    }
  ]
  boundingObject Box {
    size 0.19 0.13 0.035
  }
  physics Physics {
    density -1
    mass 0.4
  }
}

