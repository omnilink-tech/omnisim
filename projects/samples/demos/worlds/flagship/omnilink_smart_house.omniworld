      translation 0 0 2.23
      children [
        Shape {
          appearance DEF MAT_LIVING_CEILING PBRAppearance {
            baseColor 0.95 0.93 0.85
            emissiveColor 0 0 0
            roughness 0.5
            metalness 0
          }
          geometry Cylinder {
            height 0.06
            radius 0.16
          }
        }
