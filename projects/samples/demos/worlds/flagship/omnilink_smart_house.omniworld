# ── The hub: wall tablet + the bridge controller ──────────────────────
DEF SMART_HOUSE Robot {
  translation -0.09 -3.2 0
  name "smart_house"
  supervisor TRUE
  controller "smart_house_bridge"
  controllerArgs [ "--robot" "smart_house" "--port" "8766" ]
  children [
    Pose {
      translation -0.015 0 1.4
      children [
        Shape {
          appearance PBRAppearance {
            baseColor 0.12 0.12 0.13
            roughness 0.4
            metalness 0.3
          }
          geometry Box {
            size 0.03 0.3 0.22
          }
        }
      ]
    }
    Pose {
      translation -0.033 0 1.4
      children [
        Shape {
          appearance DEF MAT_HUB_SCREEN PBRAppearance {
            baseColor 0.05 0.08 0.09
            emissiveColor 0 0.06 0.08
            roughness 0.2
            metalness 0
          }
          geometry Box {
            size 0.008 0.24 0.16
          }
        }
      ]
    }
  ]
}
