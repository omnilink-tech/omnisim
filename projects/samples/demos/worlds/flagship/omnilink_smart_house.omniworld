# ── Front door: kinematic hinged leaf, hinge at the west jamb ─────────
# The bridge writes rotation [0 0 1 theta]: 0 = closed, 1.45 = open
# (swings north into the hallway). Kinematic on purpose — nothing
# dynamic drives through it, and the aperture is measured by reading
# this rotation back.
DEF FRONT_DOOR Solid {
  translation -2.98 -4 0
  rotation 0 0 1 0
  name "front door leaf"
  children [
    Pose {
      translation 0.48 0 1
      children [
        Shape {
          appearance PBRAppearance {
            baseColor 0.42 0.26 0.14
            roughness 0.65
            metalness 0
          }
          geometry Box {
            size 0.94 0.06 1.94
          }
        }
      ]
    }
    Pose {
      translation 0.84 -0.06 1
      children [
        Shape {
          appearance PBRAppearance {
            baseColor 0.75 0.72 0.65
            roughness 0.3
            metalness 1
          }
          geometry Sphere {
            radius 0.035
          }
        }
      ]
    }
  ]
}

# ── Living-room blinds panel ──────────────────────────────────────────
# Closed: parent z = 0 (panel covers the window reveal, z 0.67..2.17).
# Open: parent z = -4 (panel parked below the lawn, invisible).
# Authored OPEN — the default house state.
