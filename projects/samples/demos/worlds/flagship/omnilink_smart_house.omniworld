#OMNISIM R2025a utf8

# OmniLink — Smart House
# A single-floor 10 x 8 m house (living_room / kitchen / bedroom / hallway)
# wired as a smart-home HUB: the `smart_house` Robot runs the
# `smart_house_bridge` supervisor controller, which serves the Haven hub
# HTTP contract on 127.0.0.1:8766 (lights, appliances, thermostat, lock,
# blinds, security, sensors, energy, scenarios).
#
# Everything the bridge actuates is DEF-addressed:
#   PL_* PointLights + MAT_* fixture materials   (6 light devices)
#   MAT_OVEN_IND / MAT_TV_SCREEN / MAT_COFFEE_IND / MAT_HEATER_IND
#   FRONT_DOOR (kinematic hinged leaf, rotation = aperture)
#   BLINDS_LIVING (panel teleported into / out of the window reveal)
#   RESIDENT (kinematic capsule, teleported by the scenario engine)
#   MAT_HUB_SCREEN (wall tablet status colour)
# Decorative props follow the kinematic-props rule: no boundingObject.

EXTERNPROTO "omnisim://projects/objects/backgrounds/protos/OmniSimSky.proto"
EXTERNPROTO "omnisim://projects/objects/lights/protos/OmniSimSun.proto"
EXTERNPROTO "omnisim://projects/objects/lights/protos/OmniSimSunMarker.proto"
EXTERNPROTO "omnisim://projects/objects/apartment_structure/protos/Wall.proto"
EXTERNPROTO "omnisim://projects/objects/apartment_structure/protos/Window.proto"
EXTERNPROTO "omnisim://projects/objects/floors/protos/Floor.proto"
EXTERNPROTO "omnisim://projects/appearances/protos/Grass.proto"
EXTERNPROTO "omnisim://projects/objects/tables/protos/Table.proto"
EXTERNPROTO "omnisim://projects/objects/chairs/protos/Chair.proto"
EXTERNPROTO "omnisim://projects/objects/bedroom/protos/Bed.proto"

WorldInfo {
  basicTimeStep 16
  title "OmniLink — Smart House"
  newtonCompoundColliders TRUE
}
Viewpoint {
  orientation -0.278945 0.120681 0.952694 2.359689
  position 23.121 -24.613 22.430
}
OmniSimSky { }
DEF SUN OmniSimSun { }
DEF SUN_MARKER OmniSimSunMarker { }

