#OMNISIM R2025a utf8

# OmniLink — OmniArm 6 BIN PICKING + COLOR SORT (camera-driven, random full bin)
# An OmniArm 6 + a real SUCTION (vacuum) cup empties a box that has been FILLED with
# 36 cubes dumped in randomly (jittered positions, random orientations, stacked
# into a pile) and SORTS them by colour into two trays. The vacuum cup grips each
# cube's TOP face from directly above, so dense packing / rolling / jaw geometry
# stop mattering -- the pile empties top-down with no shaking. A top-down camera
# (Recognition node) detects the cubes; its controller publishes the visible
# cube ids+colours to customData, and the arm picks the cubes the camera sees
# (occlusion => the top of the pile), reading each cube's pose from the scene.
#
# Newton + MuJoCo solver (friction grasp). Bin + tray walls are real Newton
# static colliders (launch with OMNISIM_NEWTON_STATICS=1) so the gripper can't
# pass through them. Static colliders are MuJoCo-compatible after the 2026-06-05
# WbNewtonBackend fix (fixed-joint weld at spawn pose).
#
# Generated by _genworld.py (seed 7). Headless verify:
#   OMNISIM_NEWTON_STATICS=1 BINPICK_AUTOQUIT=1 python scripts/dev/headless_runner.py \
#     projects/samples/demos/worlds/flagship/omniarm6_bin_picking.omniworld --duration 1200

EXTERNPROTO "omnisim://projects/samples/demos/protos/OmniLinkStage.proto"
EXTERNPROTO "omnisim://projects/objects/backgrounds/protos/OmniSimSky.proto"
EXTERNPROTO "omnisim://projects/objects/lights/protos/OmniSimSun.proto"
EXTERNPROTO "omnisim://projects/objects/lights/protos/OmniSimSunMarker.proto"

WorldInfo {
  basicTimeStep 16
  title "OmniLink — OmniArm 6 bin picking + colour sort (camera, random fill)"
  newtonSolver "mujoco"
  contactProperties [
    ContactProperties { material1 "default" material2 "default" coulombFriction [ 3 ] bounce 0 softCFM 0.0003 }
  ]
  # translation_audit: ContactProperties.coulombFriction is an ODE-path field the
  # Newton backend does not read; this declares the same friction where it is read.
  #
  # mu 5 is past the contact solver's stable range at basicTimeStep 16 and sank
  # this world's dynamic bodies through the floor -- measured over a 12 s settle
  # with the robots removed: 37 of 37 bodies below z=0. mu 3 keeps every part on its
  # surface and is the value docs/guide/friction-grasp.md measured for a
  # two-finger pinch, so it is the highest friction this world can actually hold.
  newtonGroundMu 3
}
Viewpoint { orientation -0.278945 0.120681 0.952694 2.359689 position 3.303 -3.516 3.540 }
OmniSimSky { }
DEF SUN OmniSimSun { }
DEF SUN_MARKER OmniSimSunMarker { }
OmniLinkStage { floorSize 4 4 }

DEF OMNIARM6 URDFRobot {
  url "../../../../robots/omnisim/omniarm6/omniarm6_suction.urdf"
  translation 0 0 0
  name "omniarm6"
  supervisor TRUE
  staticBase TRUE
  physicsBackend "newton"
  controller "omniarm6_bin_picking"
}
# The suction (vacuum) cup is a real tool link in omniarm6_suction.urdf (flared
# rubber cup on the flange, NO fingers), so it rides the wrist rigidly -- no
# separate visual node to pin. The pick is a vacuum weld in the controller.

# ── Top-down recognition camera over the bin ────────────────────────
DEF BIN_CAM Robot {
  translation 0.46 0 1.15
  children [
    Camera {
      name "bin_camera"
      rotation 0 1 0 1.5708
      width 320
      height 320
      fieldOfView 0.6
      recognition Recognition { maxRange 3 occlusion 1 frameColor 0 1 0 frameThickness 2 }
    }
  ]
  name "bin_cam"
  controller "bin_camera"
}

# ── The BOX: a MOVABLE dynamic bin (floor + 4 walls on ONE free Newton body) so
# the robot can GRAB it by a wall and SHAKE/TILT it to tumble stuck cubes into
# reachable spots (singulation) when picking stalls. Heavy + a low CG so reaching
# in to pick doesn't shove it; only a deliberate grab moves it. Launch with
# OMNISIM_NEWTON_COMPOUND_COLLIDERS=1 so every wall + the floor is a real collider.
DEF MOVABLE_BIN Solid {
  translation 0.46 0 0.0
  rotation 0 0 1 0
  physicsBackend "newton"
  children [
    Transform { translation 0 0 0.011 children [ DEF BFLOOR_SH Shape { appearance PBRAppearance { baseColor 0.28 0.31 0.36 roughness 0.85 metalness 0.2 } geometry Box { size 0.42 0.42 0.022 } } ] }
    Transform { translation -0.195 0 0.131 children [ DEF BWW_SH Shape { appearance PBRAppearance { baseColor 0.30 0.33 0.38 roughness 0.8 metalness 0.3 } geometry Box { size 0.03 0.42 0.22 } } ] }
    Transform { translation 0.195 0 0.131 children [ DEF BWE_SH Shape { appearance PBRAppearance { baseColor 0.30 0.33 0.38 roughness 0.8 metalness 0.3 } geometry Box { size 0.03 0.42 0.22 } } ] }
    Transform { translation 0 -0.195 0.131 children [ DEF BWS_SH Shape { appearance PBRAppearance { baseColor 0.30 0.33 0.38 roughness 0.8 metalness 0.3 } geometry Box { size 0.42 0.03 0.22 } } ] }
    Transform { translation 0 0.195 0.131 children [ DEF BWN_SH Shape { appearance PBRAppearance { baseColor 0.30 0.33 0.38 roughness 0.8 metalness 0.3 } geometry Box { size 0.42 0.03 0.22 } } ] }
  ]
  name "movable_bin"
  boundingObject Group { children [
    Transform { translation 0 0 0.011 children [ Box { size 0.42 0.42 0.022 } ] }
    Transform { translation -0.195 0 0.131 children [ Box { size 0.03 0.42 0.22 } ] }
    Transform { translation 0.195 0 0.131 children [ Box { size 0.03 0.42 0.22 } ] }
    Transform { translation 0 -0.195 0.131 children [ Box { size 0.42 0.03 0.22 } ] }
    Transform { translation 0 0.195 0.131 children [ Box { size 0.42 0.03 0.22 } ] }
  ] }
  physics Physics { density -1 mass 6.0 centerOfMass [ 0 0 0.015 ] }
}

# ── Output TRAYS — sorted destinations (low collider walls) ─────────
DEF RED_ZONE Solid { translation 0.30 -0.44 0.001 children [ Shape { appearance PBRAppearance { baseColor 0.85 0.18 0.16 roughness 1 metalness 0 transparency 0.35 } geometry Box { size 0.26 0.24 0.002 } } ] name "red_zone" }
