# Back aisle + west link — the return half of tug_a's one-way loop, marked so
# the circulation reads as designed rather than as a tug wandering.
# The aisle line used to run x[3.700,15.100] -- 0.200 m INTO wall_E (inner
# face 14.900) and out to its outer face, so the paint crossed the building
# line. It now ends at x = 14.800, 0.100 m short of the wall, which is where
# a real aisle line stops: x[3.700,14.800], length 11.100, centre 9.250. The
# west end is unchanged, so the junction with PARK_LINK_LINE (x = 4.5) is too.
DEF PARK_AISLE_LINE Solid { translation 9.25 6.6 0.006 children [ Shape { appearance USE PARK_LINE geometry Box { size 11.1 0.07 0.002 } } ] name "park_aisle_line" }
DEF PARK_LINK_LINE Solid { translation 4.5 3.65 0.006 children [ Shape { appearance USE PARK_LINE geometry Box { size 0.07 5.9 0.002 } } ] name "park_link_line" }
DEF PARK_ROW_LABEL Solid {
  translation 4.35 4.2 0.006
  children [
    Transform { translation 0 0.30 0 children [ Shape { appearance USE PARK_TICK geometry Box { size 0.30 0.07 0.002 } } ] }
    Transform { translation 0 0 0 children [ Shape { appearance USE PARK_TICK geometry Box { size 0.30 0.07 0.002 } } ] }
    Transform { translation 0 -0.30 0 children [ Shape { appearance USE PARK_TICK geometry Box { size 0.30 0.07 0.002 } } ] }
  ]
  name "park_row_label"
}

# ============================================================================
# 5b. DOCK E — the OUTBOUND CART DOOR on the east wall, and the third in-floor
# drag-chain conveyor. When the park row is full, tug_a docks the oldest cart,
# tows it down to CART_OUTBOUND_INFEED and detaches; the conveyor carries it
# east and out through the door. At the door the cart is handed straight back
# to the inbound side (CART_INBOUND_ENTRY, inside dock 2) -- the same cart,
# "round the block on the outbound truck and back as an empty".
#
# THIS IS THE ONE OFF-STAGE MOVE IN THE WORLD, and it is deliberately placed
# where a warehouse actually hides things: inside a doorway, past the wall
# line, at the end of a conveyor that visibly took the cart there. Carts are
# CONSERVED across it (one out, the same one in), which is what makes the
# eight-cart ring endless rather than a spawner.
#
# LOAD-BEARING GEOMETRY:
#   DEF CART_OUTBOUND_INFEED (11.90, -1.00)  where tug_a lets go
#   DEF CART_OUTBOUND_EXIT   (14.55, -1.00)  inside the door; the handoff
# Carts here sit at yaw 0 (hitch east) -- the same yaw the inbound lane
# wants, so the ride out, the handoff and the ride in never rotate a cart.
# ============================================================================
# wall_E is cut here (opening y -2.3 .. 0.3, lintel wall_E_head_e above), so
# this is a real doorway and the dark panel is the backdrop closing its outer
# end at x[15.020,15.100] -- 0.120 m clear of a cart standing at DEF
# CART_OUTBOUND_EXIT, which used to sit 0.000 m off wall_E's inner face and
# 0.080 m inside this panel. Local -x is world +x here (yaw pi).
DEF DOCK_DOOR_E Solid {
  translation 14.86 -1 0
  rotation 0 0 1 3.14159
  children [
    Transform { translation -0.20 0 1.35 children [ Shape { appearance PBRAppearance { baseColor 0.06 0.06 0.07 roughness 0.95 metalness 0 } geometry Box { size 0.08 2.6 2.7 } } ] }
    Transform { translation 0.03 0 2.62 children [ Shape { appearance PBRAppearance { baseColor 0.35 0.37 0.40 roughness 0.7 metalness 0.4 } geometry Box { size 0.10 2.8 0.16 } } ] }
  ]
  name "dock_door_e"
}
DEF OUTBOUND_CONVEYOR Solid {
  translation 13.25 -1 0
  children [
    Transform { translation 0 0 0.005 children [ Shape { appearance USE CONV_DECK geometry Box { size 3.00 1.10 0.010 } } ] }
    Transform { translation 0 0.20 0.012 children [ Shape { appearance USE CONV_SLOT geometry Box { size 3.00 0.11 0.008 } } ] }
    Transform { translation 0 -0.20 0.012 children [ Shape { appearance USE CONV_SLOT geometry Box { size 3.00 0.11 0.008 } } ] }
    Transform { translation 0 0.20 0.014 children [ Shape { appearance USE CONV_CHAIN geometry Box { size 3.00 0.055 0.006 } } ] }
    Transform { translation 0 -0.20 0.014 children [ Shape { appearance USE CONV_CHAIN geometry Box { size 3.00 0.055 0.006 } } ] }
    # GUIDE KERBS AT THE DOOR END ONLY (world x 14.15..14.75). The western
    # 2.4 m of this deck is a TUG WORKING STRETCH, not a cart lane, and a
    # kerb there is exactly the trap the fill conveyor's south leg already
    # avoids ("that leg crosses the transit lane and a 0.10 m kerb there
    # would be a tug trap"). tug_a drives the full length of this deck to set
    # a cart on the infeed -- it finishes _trail = 1.33 m EAST of the cart, at
    # x = 13.23 -- and then has to leave sideways, because the cart is west of
    # it and the dock door is east. Full-length kerbs left 1.05 m between
    # their inner faces (centres y = +-0.56, 0.07 thick) for a tug measuring
    # 0.7160 m across -- its true footprint, taken from the union of the
    # OmniTug 500's own primitive-solid URDF geometry, not the 0.72 m round
    # number. That is
    # 0.167 m a side: less than the 0.28 m drift measured on this lane while
    # towing, and the tug's 1.45 m turning circle crossed them outright
    # (measured at 055d7c82: 36 incursion ticks). Keeping the
    # kerbs where the cart is handed to the door and dropping them where the
    # tug works is the honest resolution; the cart is 0.70 m wide, rides the
    # chain dead on the centreline, and never needed guiding here.
    Transform { translation 1.20 0.56 0.05 children [ Shape { appearance USE CONV_KERB geometry Box { size 0.60 0.07 0.10 } } ] }
    Transform { translation 1.20 -0.56 0.05 children [ Shape { appearance USE CONV_KERB geometry Box { size 0.60 0.07 0.10 } } ] }
    Transform { translation 0 0.72 0.003 children [ Shape { appearance USE CONV_HATCH geometry Box { size 3.00 0.09 0.002 } } ] }
    Transform { translation 0 -0.72 0.003 children [ Shape { appearance USE CONV_HATCH geometry Box { size 3.00 0.09 0.002 } } ] }
    # Drive head SOUTH of the lane and clear of it. It used to sit at world
    # (11.63, -0.20) -- 0.90 m north of the lane, directly under PARK_SPOT_5's
    # approach, where the tug that pushes a cart into that spot stood with its
    # tail 0.07 m off a 0.34 m steel cabinet and swept it while pivoting. At
    # y = -2.05 it is 0.49 m clear of a tug running the lane dead centre and
    # still 0.21 m clear of one that has drifted a quarter-metre while towing
    # (measured drift: 0.28 m). The little kerb-to-drive-head connector that
    # used to bridge them is gone with the west kerbs it connected to -- a
    # 0.015 m overlap. It was NOT the last one in the world when that was
    # written: OUTFEED_SPUR's south-east leg stood fully inside the
    # FILL_CONVEYOR deck plate. THAT ONE IS NOW FIXED TOO (the leg stepped in
    # to local x = 0.14, into the channel between the deck edge and the
    # hatching -- see its own note), so the world has no remaining
    # prop-in-prop overlap on either conveyor.
    #
    # WHY THIS CABINET IS NOT MOVING AGAIN. An audit re-derived the old bug
    # here and concluded the cabinet still sits "entirely inside PARK_SPOT_5's
    # approach column". The x-overlap is real -- x[11.460,11.800] is inside
    # the 0.7162 m-wide tug column x[11.142,11.858] centred on the spot -- but
    # the CONSEQUENCE does not follow, because that column is only ever
    # entered from the NORTH end. MavIdleLoop._park_in_spot runs the tow east
    # along Y_LANE = +0.70 (mobile bridge, class constant), turns north THERE,
    # and drives up to y = 4.20; the pivot at (11.50, +0.70) reaches y =
    # -0.024 at worst, 1.826 m north of this cabinet's north face. The only
    # traffic that ever gets south of that is the dock E run itself, which is
    # the y = -1.00 lane this cabinet is already dimensioned against, and the
    # tug's turn-and-leave pivot at its hand-off pose (13.23, -1.00) clears
    # the cabinet by 0.939 m. Moving it east to "clear the column" would eat
    # straight into that 0.939 m, i.e. trade a clearance that is real for one
    # that is not. Same for the other half of the finding: a cart standing at
    # DEF CART_OUTBOUND_INFEED spans x[11.550,12.250] and does overlap
    # PARK_SPOT_5's cart column by 0.300 m, but it sits at y[-1.350,-0.650],
    # 5.55 m south of the spot and 0.627 m clear of the spot-5 pivot circle,
    # so no park approach and no collect run can ever meet it.
    Transform { translation -1.62 -1.05 0.17 children [ Shape { appearance USE CONV_DRIVE geometry Box { size 0.34 0.40 0.34 } } ] }
  ]
  name "outbound_conveyor"
}
DEF OUTBOUND_DOG Solid {
  translation 11.9 -1 0
  children [
    Transform { translation 0 0 0.048 children [ Shape { appearance USE CONV_DOG geometry Box { size 0.10 0.62 0.085 } } ] }
    Transform { translation 0 0.20 0.020 children [ Shape { appearance USE CONV_CHAIN geometry Box { size 0.16 0.09 0.03 } } ] }
    Transform { translation 0 -0.20 0.020 children [ Shape { appearance USE CONV_CHAIN geometry Box { size 0.16 0.09 0.03 } } ] }
  ]
  name "outbound_dog"
}
