# ============================================================================
# 5. THE CART PARK — the open back of the site, where tug_a parks every cart
# it dispatches. This REPLACES the three green storage bays (deleted): the
# demo no longer has a single privileged "dispatch bay" that one cart shuttles
# in and out of. It has a row, and carts accumulate in it.
#
# ONE ROW, SIX SPOTS, ALL DIRECTLY REACHABLE. The row is deliberately a
# single line rather than a grid: in a grid, parking in the back row means
# towing a cart through the front row's spots, so the front row can only be
# filled last and collecting a back-row cart deadlocks the moment the front
# row is full. One row has no such ordering constraint -- every spot is
# entered straight off the transit lane and left straight into the back
# aisle, so tug_a can take ANY spot and collect ANY cart at any time.
#
# CIRCULATION (why parked carts face north). tug_a tows a cart north up the
# column into its spot, detaches, and keeps going north to the BACK AISLE
# (y=6.6), west along it, and back down the WEST LINK (x=4.5) to the transit
# lane -- a one-way loop, no reversing, no three-point turns behind a row of
# parked carts. Because the tug leaves northward, the cart it drops is left
# hitch-NORTH, which is exactly the side tug_a must come back to when it
# collects that cart later.
#
# LOAD-BEARING GEOMETRY: DEF PARK_SPOT_1..6 are read live by MavIdleLoop,
# which scans them in order for the first one no cart is standing on. Moving
# a marker moves the parking. Spacing is 1.40 m for 0.70 m carts, so there is
# a 0.70 m walkway between neighbours and a tug can always see daylight.
# All visual-only floor line markings.
# ============================================================================
# Six painted drive-through spots. Side lines only (the tug enters from the
# south and leaves to the north, so a closed box would just be paint the
# cart drives over); the blue tick on the aisle side is the spot ID mark.
DEF PARK_SPOT_1 Solid {
  translation 5.9 4.2 0.005
  children [
    Transform { translation -0.55 0 0 children [ Shape { appearance DEF PARK_LINE PBRAppearance { baseColor 0.90 0.90 0.90 roughness 1 metalness 0 } geometry Box { size 0.07 1.10 0.002 } } ] }
    Transform { translation 0.55 0 0 children [ Shape { appearance USE PARK_LINE geometry Box { size 0.07 1.10 0.002 } } ] }
    Transform { translation 0 -0.60 0 children [ Shape { appearance DEF PARK_TICK PBRAppearance { baseColor 0.30 0.72 0.95 roughness 1 metalness 0 } geometry Box { size 0.62 0.07 0.002 } } ] }
  ]
  name "park_spot_1"
}
DEF PARK_SPOT_2 Solid {
  translation 7.3 4.2 0.005
  children [
    Transform { translation -0.55 0 0 children [ Shape { appearance USE PARK_LINE geometry Box { size 0.07 1.10 0.002 } } ] }
    Transform { translation 0.55 0 0 children [ Shape { appearance USE PARK_LINE geometry Box { size 0.07 1.10 0.002 } } ] }
    Transform { translation 0 -0.60 0 children [ Shape { appearance USE PARK_TICK geometry Box { size 0.62 0.07 0.002 } } ] }
  ]
  name "park_spot_2"
}
DEF PARK_SPOT_3 Solid {
  translation 8.7 4.2 0.005
  children [
    Transform { translation -0.55 0 0 children [ Shape { appearance USE PARK_LINE geometry Box { size 0.07 1.10 0.002 } } ] }
    Transform { translation 0.55 0 0 children [ Shape { appearance USE PARK_LINE geometry Box { size 0.07 1.10 0.002 } } ] }
    Transform { translation 0 -0.60 0 children [ Shape { appearance USE PARK_TICK geometry Box { size 0.62 0.07 0.002 } } ] }
  ]
  name "park_spot_3"
}
DEF PARK_SPOT_4 Solid {
  translation 10.1 4.2 0.005
  children [
    Transform { translation -0.55 0 0 children [ Shape { appearance USE PARK_LINE geometry Box { size 0.07 1.10 0.002 } } ] }
    Transform { translation 0.55 0 0 children [ Shape { appearance USE PARK_LINE geometry Box { size 0.07 1.10 0.002 } } ] }
    Transform { translation 0 -0.60 0 children [ Shape { appearance USE PARK_TICK geometry Box { size 0.62 0.07 0.002 } } ] }
  ]
  name "park_spot_4"
}
DEF PARK_SPOT_5 Solid {
  translation 11.5 4.2 0.005
  children [
    Transform { translation -0.55 0 0 children [ Shape { appearance USE PARK_LINE geometry Box { size 0.07 1.10 0.002 } } ] }
    Transform { translation 0.55 0 0 children [ Shape { appearance USE PARK_LINE geometry Box { size 0.07 1.10 0.002 } } ] }
    Transform { translation 0 -0.60 0 children [ Shape { appearance USE PARK_TICK geometry Box { size 0.62 0.07 0.002 } } ] }
