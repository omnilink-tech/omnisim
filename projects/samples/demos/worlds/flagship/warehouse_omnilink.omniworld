  children [
    Transform { translation 0 0.46 0 children [ Shape { appearance USE MARK_LINE geometry Box { size 0.94 0.06 0.002 } } ] }
    Transform { translation 0 -0.46 0 children [ Shape { appearance USE MARK_LINE geometry Box { size 0.94 0.06 0.002 } } ] }
    Transform { translation -0.44 0 0 children [ Shape { appearance USE MARK_LINE geometry Box { size 0.06 0.92 0.002 } } ] }
