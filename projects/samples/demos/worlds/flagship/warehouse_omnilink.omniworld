# ============================================================================
DEF KIOSK_ZONE Solid {
  translation -11 -7.5 0.005
  children [
    Transform { translation 0 1 0 children [ Shape { appearance DEF KIOSK_LINE PBRAppearance { baseColor 0.95 0.78 0.10 roughness 1 metalness 0 } geometry Box { size 2.07 0.07 0.002 } } ] }
    Transform { translation 0 -1 0 children [ Shape { appearance USE KIOSK_LINE geometry Box { size 2.07 0.07 0.002 } } ] }
    Transform { translation -1 0 0 children [ Shape { appearance USE KIOSK_LINE geometry Box { size 0.07 2.07 0.002 } } ] }
    Transform { translation 1 0 0 children [ Shape { appearance USE KIOSK_LINE geometry Box { size 0.07 2.07 0.002 } } ] }
