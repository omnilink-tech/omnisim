DEF AISLE_LINE_S Solid { translation 2.6 -8.6 0.006 children [ Shape { appearance PBRAppearance { baseColor 0.90 0.90 0.90 roughness 1 metalness 0 } geometry Box { size 22 0.07 0.002 } } ] name "aisle_line_s" }

