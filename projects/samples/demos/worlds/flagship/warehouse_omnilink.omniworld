  poleRadius 0.03
  poleShape "square"
  poleAppearance PBRAppearance { baseColor 0.95 0.73 0.08 roughness 0.7 metalness 0 emissiveColor 0.38 0.28 0.03 }
  horizontalBarAppearance PBRAppearance { baseColor 0.95 0.73 0.08 roughness 0.7 metalness 0 emissiveColor 0.38 0.28 0.03 }
  path [ -6.2 2.6 0, -6.2 6.2 0 ]
}

# ============================================================================
# THE TROLLEYS — EIGHT identical flat-deck tug trolleys (AMR tugger carts)
# circulating on a closed ring. Every spawn pose below is a LEGITIMATE
# resting place in that ring, so the world is already mid-shift at t=0
# rather than staged:
#   TROLLEY_PAYLOAD  fill station, under the arm      (being filled)
#   TROLLEY_B        CART_STAGE                       (next empty, pre-fetched)
#   TROLLEY_C        CART_LANE_PICKUP                 (empty, off the truck)
#   TROLLEY_D..G     PARK_SPOT_1..4                   (parked at the back)
#   TROLLEY_H        CART_INBOUND_ENTRY               (just off the truck)
# That leaves PARK_SPOT_5 and _6 free. Two, not one, and not zero: tug_a
# keeps PARK_RESERVE (1) spot free by collecting the oldest cart during its
# DEAD time, so the row wants a spare to work with. Starting one below the
# reserve means the recycle path fires within the first few minutes of any
# run -- it is exercised, not dead code -- but it fires in the window where
# the arm is busy rather than while a loaded cart blocks the station.
#
# Filled line boxes ride the outfeed spur onto the flat deck; the OmniTug 500 tugs
# magnetically dock to the hitch (mobile bridge attach_trolley) and tow with
# one-trailer kinematics. Parked carts sit hitch-SOUTH so tug_a can always
# dock one from the open lane side without reversing into a neighbour; lane
# carts sit hitch-EAST for the same reason.
#
# TROLLEY_PAYLOAD is written out in full because it carries the DEF
# appearances (TROLLEY_STEEL / _DARK / _CLEAT / _WHEEL / _HITCH) the other
# seven USE; B..H are generated from one template so a cart cannot drift.
#
# Kinematic-ensemble body (the anypick-line bin pattern): a physics body
# with a compound collider, towed by the mobile bridge with per-tick pose +
# resetPhysics (zero velocity). The deck collider MOVES WITH IT, so the
# box (and the parts inside the box) rest on the deck at the fill station
# AND at the dispatch bay after the tow — no static catch solids, no
# steady-state pinning. Collider = deck column only (tunnel-proof; corner
# cleats are visual so nothing can wedge the OmniArm 6's sweep); the hitch
# stays collider-free so the docking tug's tail never fights it. Local
# frame: hitch bar along +x; hitch POINT at local (0.70, 0, 0.25). The
# drawbar was lengthened from 0.60 to 0.70 m so the tow's articulation clamp
# (mobile bridge _ARTIC_MAX_RAD, the jackknife guard) has a workable ~50deg
# swing before the deck would reach the tug body; keep this in step with the
# controller constant _HITCH_LOCAL.
# Spawned yaw -90 deg -> hitch faces the south gate.
# ============================================================================
DEF TROLLEY_PAYLOAD Solid {
  translation -8 3.6 0
  rotation 0 0 1 -1.5708
  physicsBackend "newton"
  children [
    # — steel deck (top 0.325) —
    Transform { translation 0 0 0.30 children [ Shape { appearance DEF TROLLEY_STEEL PBRAppearance { baseColor 0.30 0.34 0.40 roughness 0.55 metalness 0.7 } geometry Box { size 0.70 0.70 0.05 } } ] }
    Transform { translation 0 0 0.265 children [ Shape { appearance DEF TROLLEY_DARK PBRAppearance { baseColor 0.16 0.17 0.20 roughness 0.7 metalness 0.5 } geometry Box { size 0.66 0.66 0.02 } } ] }
    # — corner cleats that cradle the line box (visual-only) —
    Transform { translation 0.245 0.245 0.34 children [ Shape { appearance DEF TROLLEY_CLEAT PBRAppearance { baseColor 0.85 0.55 0.10 roughness 0.7 metalness 0.3 } geometry Box { size 0.06 0.06 0.03 } } ] }
    Transform { translation 0.245 -0.245 0.34 children [ Shape { appearance USE TROLLEY_CLEAT geometry Box { size 0.06 0.06 0.03 } } ] }
    Transform { translation -0.245 0.245 0.34 children [ Shape { appearance USE TROLLEY_CLEAT geometry Box { size 0.06 0.06 0.03 } } ] }
    Transform { translation -0.245 -0.245 0.34 children [ Shape { appearance USE TROLLEY_CLEAT geometry Box { size 0.06 0.06 0.03 } } ] }
    # — four caster assemblies (fork + wheel), visual-only —
    Transform { translation 0.27 0.27 0.185 children [ Shape { appearance USE TROLLEY_DARK geometry Box { size 0.04 0.07 0.13 } } ] }
    Transform { translation 0.27 -0.27 0.185 children [ Shape { appearance USE TROLLEY_DARK geometry Box { size 0.04 0.07 0.13 } } ] }
    Transform { translation -0.27 0.27 0.185 children [ Shape { appearance USE TROLLEY_DARK geometry Box { size 0.04 0.07 0.13 } } ] }
    Transform { translation -0.27 -0.27 0.185 children [ Shape { appearance USE TROLLEY_DARK geometry Box { size 0.04 0.07 0.13 } } ] }
    Transform { translation 0.27 0.27 0.06 rotation 1 0 0 1.5708 children [ Shape { appearance DEF TROLLEY_WHEEL PBRAppearance { baseColor 0.09 0.09 0.10 roughness 0.9 metalness 0.1 } geometry Cylinder { radius 0.06 height 0.05 } } ] }
    Transform { translation 0.27 -0.27 0.06 rotation 1 0 0 1.5708 children [ Shape { appearance USE TROLLEY_WHEEL geometry Cylinder { radius 0.06 height 0.05 } } ] }
    Transform { translation -0.27 0.27 0.06 rotation 1 0 0 1.5708 children [ Shape { appearance USE TROLLEY_WHEEL geometry Cylinder { radius 0.06 height 0.05 } } ] }
    Transform { translation -0.27 -0.27 0.06 rotation 1 0 0 1.5708 children [ Shape { appearance USE TROLLEY_WHEEL geometry Cylinder { radius 0.06 height 0.05 } } ] }
    # — hitch drawbar + plate (hitch point local (0.70, 0, 0.25)) —
    Transform { translation 0.525 0 0.25 children [ Shape { appearance USE TROLLEY_STEEL geometry Box { size 0.35 0.05 0.04 } } ] }
    Transform { translation 0.70 0 0.21 children [ Shape { appearance DEF TROLLEY_HITCH PBRAppearance { baseColor 0.85 0.55 0.10 roughness 0.6 metalness 0.4 } geometry Box { size 0.035 0.14 0.12 } } ] }
    Transform { translation 0.70 0 0.27 rotation 1 0 0 1.5708 children [ Shape { appearance USE TROLLEY_HITCH geometry Cylinder { radius 0.028 height 0.03 } } ] }
  ]
  name "trolley_payload"
  boundingObject Transform { translation 0 0 0.1625 children [ Box { size 0.70 0.70 0.325 } ] }
  physics Physics { density -1 mass 22.0 centerOfMass [ 0 0 0.12 ] }
}
