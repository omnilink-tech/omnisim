# ============================================================================
# THE FILL CONVEYOR — the in-floor drag-chain conveyor that runs the whole
# north-south cart column of the pick cell: empties IN to the fill spot in
# front of OmniArm 6, loaded carts back OUT and clear of the cell.
#
# THIS NODE EXISTS TO KILL THE MAGIC GLIDE. Before it, tug_b dropped the
# returning cart on the lane and the cart slid into position on its own --
# the single worst read in the demo, because a 22 kg steel cart moved with no
# cause on screen. Now the tug tows the cart only as far as CONVEYOR_STATION
# (the middle of this deck), detaches, and the conveyor takes it from
# there: chain dog engaged, constant 0.26 m/s, straight up the slot. Every
# metre a cart travels in this world is now either towed or conveyed.
#
# IT RUNS PAST THE STATION, and that is the fix for the demo's dead air.
# The deck used to STOP at the station, so a loaded cart had to sit there
# until tug_a came and dragged it away -- and because the station is also the
# only way an empty can reach the arm, the arm stalled for the whole of that
# dock-and-drag (measured 20 s of a 34 s wait). The deck now continues 2.55 m
# further south to DEF CART_PICKUP, so the loaded cart clears the station in
# one continuous move and the next empty follows straight in behind it. See
# the CART_PICKUP note below for the before/after numbers.
#
# LOAD-BEARING GEOMETRY (a contract with MavIdleLoop + WarehouseLine):
#   centreline x = -8.00  == TROLLEY_PAYLOAD.x, so the carry is a straight
#                            line and the cart needs no turn at any stop.
#   pickup  y = -1.00     == DEF CART_PICKUP, the loaded-cart outfeed.
#   station y =  1.55     == DEF CONVEYOR_STATION, the empty-cart infeed.
#   discharge y = 3.60    == TROLLEY_PAYLOAD.y, the fill spot the arm bridge
#                            derives from that trolley's spawn pose.
# The deck runs y -1.45..3.75; the guide kerbs cover the NORTH leg only
# (y 1.425..3.175): they clear the OUTFEED_SPUR's south legs at y=3.40 -- the
# box conveyor above and the cart conveyor below share this footprint and must
# not intersect -- and the SOUTH leg deliberately has none, because that leg
# crosses the transit lane at y=0.70 and a 0.10 m kerb there would be a tug
# trap. Visual-only (no boundingObject): the cart is carried kinematically,
# and a collider here would fight both the cart and any tug driving over it.
# ============================================================================
DEF FILL_CONVEYOR Solid {
  translation -8 1.15 0
  children [
    Transform { translation 0 0 0.005 children [ Shape { appearance USE CONV_DECK geometry Box { size 1.10 5.20 0.010 } } ] }
    Transform { translation 0.20 0 0.012 children [ Shape { appearance USE CONV_SLOT geometry Box { size 0.11 5.20 0.008 } } ] }
    Transform { translation -0.20 0 0.012 children [ Shape { appearance USE CONV_SLOT geometry Box { size 0.11 5.20 0.008 } } ] }
    Transform { translation 0.20 0 0.014 children [ Shape { appearance USE CONV_CHAIN geometry Box { size 0.055 5.20 0.006 } } ] }
    Transform { translation -0.20 0 0.014 children [ Shape { appearance USE CONV_CHAIN geometry Box { size 0.055 5.20 0.006 } } ] }
    # kerbs guard the NORTH leg only, and stop short of the outfeed spur's
    # legs (see the header note). World y 1.425..3.175, unchanged.
    Transform { translation 0.56 1.15 0.05 children [ Shape { appearance USE CONV_KERB geometry Box { size 0.07 1.75 0.10 } } ] }
    Transform { translation -0.56 1.15 0.05 children [ Shape { appearance USE CONV_KERB geometry Box { size 0.07 1.75 0.10 } } ] }
    Transform { translation 0.72 0 0.003 children [ Shape { appearance USE CONV_HATCH geometry Box { size 0.09 5.20 0.002 } } ] }
    Transform { translation -0.72 0 0.003 children [ Shape { appearance USE CONV_HATCH geometry Box { size 0.09 5.20 0.002 } } ] }
    # drive head beside the STATION, east side — the mid-span drive between
    # the two legs of the shuttle. Left exactly where it was in WORLD
    # coordinates (-7.20, 1.555) when the deck grew south, because it is the
    # one raised part of this conveyor and both tugs' approaches are built
    # around it standing there.
    Transform { translation 0.80 0.405 0.17 children [ Shape { appearance USE CONV_DRIVE geometry Box { size 0.40 0.34 0.34 } } ] }
    Transform { translation 0.56 0.405 0.30 children [ Shape { appearance USE CONV_KERB geometry Box { size 0.10 0.16 0.10 } } ] }
  ]
  name "fill_conveyor"
}
DEF FILL_CONVEYOR_DOG Solid {
  translation -8 1.55 0
  children [
    Transform { translation 0 0 0.048 children [ Shape { appearance USE CONV_DOG geometry Box { size 0.62 0.10 0.085 } } ] }
    Transform { translation 0.20 0 0.020 children [ Shape { appearance USE CONV_CHAIN geometry Box { size 0.09 0.16 0.03 } } ] }
    Transform { translation -0.20 0 0.020 children [ Shape { appearance USE CONV_CHAIN geometry Box { size 0.09 0.16 0.03 } } ] }
  ]
  name "fill_conveyor_dog"
}
# CONVEYOR STATION — the painted hand-off spot at the south end of the fill
# conveyor, and the single busiest square metre in the demo. It is BOTH ends
# of the shuttle: tug_b delivers an empty cart here and the conveyor takes it
# north to the arm; when that cart comes back loaded, the conveyor sets it
# down here again and tug_a tows it away.
#
# WHY THE CONVEYOR SHUTTLES BOTH WAYS. The fill spot sits between the belt
# and the arm, so the only way in or out is straight up this column -- which
# means a tug docking a loaded cart AT the fill spot would have to stand
# exactly where the next empty cart is staged, and the two jobs would fight
# over the same 2 m of floor forever. Running the conveyor in reverse for the
# loaded cart removes the conflict outright: no tug ever enters the pick cell,
# tug_a collects from open floor south of the gate, and the cart's whole trip
# to and from the arm is conveyed rather than towed.
#
# THE SHUTTLE INVARIANT — at most ONE cart may be inside {station, fill spot}
# at any moment. The conveyor is a single lane and this marker is both its
# ends, so a cart parked here while another stands at the fill spot is a hard
# deadlock: the loaded one has nowhere to come out to and the empty has
# nowhere to go in. That is why TROLLEY_B spawns at CART_STAGE rather than
# here, and why tug_b will not move a staged cart onto this spot until the
# fill spot is clear. Do not "helpfully" park a cart here in the world file.
#
# tug_a and tug_b both read this DEF's position, so the decal is load-bearing
# config, not decor. Painted OUTLINE only (the floor stays one colour).
DEF CONVEYOR_STATION Solid {
  translation -8 1.55 0.014
  children [
    Transform { translation 0 -0.46 0 children [ Shape { appearance DEF BUFFER_LINE PBRAppearance { baseColor 0.90 0.90 0.90 roughness 1 metalness 0 } geometry Box { size 0.94 0.06 0.002 } } ] }
    Transform { translation -0.44 0 0 children [ Shape { appearance USE BUFFER_LINE geometry Box { size 0.06 0.92 0.002 } } ] }
    Transform { translation 0.44 0 0 children [ Shape { appearance USE BUFFER_LINE geometry Box { size 0.06 0.92 0.002 } } ] }
  ]
  name "conveyor_station"
}

# ============================================================================
# CART PICKUP — the LOADED-cart outfeed spot, 2.55 m south of the station at
# the far end of the same in-floor fill conveyor. This marker is the whole of
# the throughput fix.
#
# WHY IT EXISTS. The station used to be where a loaded cart WAITED for tug_a,
# and because the station is also the only way an empty cart can reach the
# arm, that wait blocked the empty, which blocked the fill spot, which stalled
# OmniArm 6 for the whole of tug_a's dock-and-drag. Measured on one baseline
# cycle: cart down at the station t=60.5, tug_a attached t=76.0, station
# actually clear t~80 -- 20 s of the arm's 34 s wait spent watching a tug
# reverse onto a hitch.
#
# So the loaded cart no longer stops at the station. The conveyor runs it
# straight through, 4.60 m in one continuous move, and sets it down HERE. The
# station is clear the moment the cart passes it, the next empty comes in
# behind, and tug_a collects from this spot on its own schedule instead of
# being on the arm's critical path at all.
#
# LOAD-BEARING GEOMETRY:
#   x = -8.00   the fill conveyor centreline; the run is one straight line.
#   y = -1.00   far enough south that a cart standing here is clear of the
#               tug that stages the NEXT empty on the station. That tug ends
#               its push at y=+0.32 (it pushes the cart north from behind),
#               so its tail sits at about y=-0.03; a cart here spans
#               y -1.35..-0.65, leaving 0.62 m. y=-0.50 -- the obvious
#               "same pitch as station->fill" choice -- leaves 0.12 m and
#               would eventually clip.
#
# The cart arrives hitch-SOUTH (the conveyor sets final yaw from the fill
# spot's), so tug_a pre-docks at (-8.00, -3.15), reverses north onto the
# hitch and tows north onto the transit lane -- it never pulls a cart back
# through the station. Painted OUTLINE only, open on the south side where
# the tug backs on. A cart standing here is ON A CONVEYOR, so the "a cart
# only ever moves because a tug tows it or a machine runs it" invariant is
# intact.
# ============================================================================
DEF CART_PICKUP Solid {
  translation -8 -1.00 0.014
  children [
    Transform { translation 0 0.46 0 children [ Shape { appearance USE BUFFER_LINE geometry Box { size 0.94 0.06 0.002 } } ] }
    Transform { translation -0.44 0 0 children [ Shape { appearance USE BUFFER_LINE geometry Box { size 0.06 0.92 0.002 } } ] }
    Transform { translation 0.44 0 0 children [ Shape { appearance USE BUFFER_LINE geometry Box { size 0.06 0.92 0.002 } } ] }
  ]
  name "cart_pickup"
}


# CART STAGE — a painted holding spot west of the conveyor column where tug_b
# parks the NEXT empty cart while the station is still busy. This is the whole
# of the overlap fix: the long fetch from the cart lane happens WHILE tug_a is
# out hauling, so when the station finally clears, the empty is two metres
# away instead of fifteen. Deliberately OFF the conveyor column (x=-9.7, not
# -8.0) so a staged cart never stands in tug_a's collection approach.
# tug_b's loop reads this DEF's position. Painted OUTLINE only.
#
# WHY y = 0.55 AND NOT 1.30. A one-trailer dock is a straight-line manoeuvre
# along the cart's hitch axis, so this marker's y IS the y of the tug that
# services it: tug_b finishes the drop at (-8.37, y) and pre-docks the staged
# cart at (-7.45, y), both facing east, both 0.36 m half-beam. At y=1.30 those
# two poses put the tug's north flank at y=1.66 -- INSIDE the fill conveyor's
# east guide kerb (y>=1.425) and its drive-head cabinet (y>=1.385, 0.34 m
# tall). That was not a near miss: it was 111 of 780 sampled ticks with the
# tug's footprint inside a solid machine, and it was invisible because the
# tug's obstacle list did not contain the conveyor. Moving the stage 0.75 m
# south clears both by more than 0.22 m and clears the tug's pivot circle too,
# and costs the choreography nothing -- the stage is still west of the column,
# still two metres from the station, still out of tug_a's approach (which runs
# north up x=-8 and never comes west of it).
DEF CART_STAGE Solid {
  translation -9.7 0.55 0.006
  children [
    Transform { translation 0 0.46 0 children [ Shape { appearance USE BUFFER_LINE geometry Box { size 0.94 0.06 0.002 } } ] }
    Transform { translation 0 -0.46 0 children [ Shape { appearance USE BUFFER_LINE geometry Box { size 0.94 0.06 0.002 } } ] }
    Transform { translation -0.44 0 0 children [ Shape { appearance USE BUFFER_LINE geometry Box { size 0.06 0.92 0.002 } } ] }
  ]
  name "cart_stage"
}

# ============================================================================
# 4. STAGING — two painted zones on the transit floor between the pick cell
# and the cart park. The OmniTug 500 tugs park in them facing the main aisle
# (south) whenever they have nothing to do. Both run the mobile bridge
# trolley tow over the WHOLE eight-cart fleet (--pallets ...), because
# either tug may end up handling any cart in the ring.
#
# ROLES ARE PARTITIONED BY PLACE, NOT BY NEGOTIATION -- this is what keeps
# two supervisors out of each other's way without a scheduler:
#   tug_a ("dispatch")       collects loaded carts FROM the conveyor station,
#                            and owns the transit lane eastbound, the CART
#                            PARK and DOCK E.
#   tug_b ("trolley_return") owns the CART LANE, CART_STAGE, CONVEYOR_STATION
#                            and the fill conveyor (both directions).
# The two sets are disjoint, so the tugs cannot select the same cart. The
# only shared resource left is the east-west transit lane, and that -- and
# only that -- gets an explicit lock (on_lane in each bridge's /state).
# ============================================================================
# Painted OUTLINE only (no filled tile): the floor is one constant colour
# site-wide, so each staging bay is marked by a thin painted border the way a
# real warehouse paints a parking box.
DEF STAGING_ZONE_A Solid {
  translation -4.6 -4.6 0.005
  children [
    Transform { translation 0 1.3 0 children [ Shape { appearance DEF STAGE_LINE PBRAppearance { baseColor 0.90 0.90 0.90 roughness 1 metalness 0 } geometry Box { size 2.67 0.07 0.002 } } ] }
    Transform { translation 0 -1.3 0 children [ Shape { appearance USE STAGE_LINE geometry Box { size 2.67 0.07 0.002 } } ] }
    Transform { translation -1.3 0 0 children [ Shape { appearance USE STAGE_LINE geometry Box { size 0.07 2.67 0.002 } } ] }
    Transform { translation 1.3 0 0 children [ Shape { appearance USE STAGE_LINE geometry Box { size 0.07 2.67 0.002 } } ] }
  ]
  name "staging_zone_a"
}
DEF STAGING_ZONE_B Solid {
  translation -1.4 -4.6 0.005
  children [
    Transform { translation 0 1.3 0 children [ Shape { appearance USE STAGE_LINE geometry Box { size 2.67 0.07 0.002 } } ] }
    Transform { translation 0 -1.3 0 children [ Shape { appearance USE STAGE_LINE geometry Box { size 2.67 0.07 0.002 } } ] }
    Transform { translation -1.3 0 0 children [ Shape { appearance USE STAGE_LINE geometry Box { size 0.07 2.67 0.002 } } ] }
    Transform { translation 1.3 0 0 children [ Shape { appearance USE STAGE_LINE geometry Box { size 0.07 2.67 0.002 } } ] }
  ]
  name "staging_zone_b"
}

# OmniTug 500 tugs. The OmniTug 500 URDF is a single visual link (no wheel
# joints, no physics) driven kinematically by its controllers via
# supervisor pose writes -- the mobile bridge's "kinematic" layout does the
# same. Local +Y is forward and the wheels touch the floor at z=0, so the
# spawn rotation -pi points the nose (heading) south. See
# projects/robots/omnisim/omnitug500/.
DEF TUG_A URDFRobot {
  url "../../../../robots/omnisim/omnitug500/urdf/omnitug500.urdf"
  translation -4.6 -4.6 0
  rotation 0 0 1 3.14159
  name "tug_a"
  supervisor TRUE
  controller "omnilink_mobile_bridge"
  # --idle-resume-s 12: see the note on the OmniArm 6's controllerArgs. All
  # three robots take the SAME quiet window, so a chat turn with the site
  # never leaves one robot parked long after its neighbours went back to
  # work.
  controllerArgs [ "--robot" "omnitug500" "--port" "8766" "--name" "tug_a" "--pallets" "TROLLEY_PAYLOAD,TROLLEY_B,TROLLEY_C,TROLLEY_D,TROLLEY_E,TROLLEY_F,TROLLEY_G,TROLLEY_H" "--idle-loop" "dispatch" "--idle-resume-s" "12" "--idle-arm-port" "8765" "--idle-peer-port" "8767" ]
  window "omnilink_chat"
}
DEF TUG_B URDFRobot {
  url "../../../../robots/omnisim/omnitug500/urdf/omnitug500.urdf"
  translation -1.4 -4.6 0
  rotation 0 0 1 3.14159
  name "tug_b"
  supervisor TRUE
  controller "omnilink_mobile_bridge"
  # --idle-resume-s 12: see the note on the OmniArm 6's controllerArgs.
  controllerArgs [ "--robot" "omnitug500" "--port" "8767" "--name" "tug_b" "--pallets" "TROLLEY_PAYLOAD,TROLLEY_B,TROLLEY_C,TROLLEY_D,TROLLEY_E,TROLLEY_F,TROLLEY_G,TROLLEY_H" "--idle-loop" "trolley_return" "--idle-resume-s" "12" "--idle-arm-port" "8765" "--idle-peer-port" "8766" ]
  window "omnilink_chat"
}

