#OMNISIM R2025a utf8

# OmniLink — TWO-ARM THROW & CATCH (Shadowing)
# Arm A (left) picks a cube and THROWS it (the certified toss ghost); Arm B (right, facing A)
# CATCHES it mid-flight with its suction cup. The catch is a genuine feedback problem: B watches
# the flying cube, predicts its trajectory, positions the cup at the interception point, and
# engages on proximity (killing the cube's momentum -- the new free-body setVelocity engine fix).
#
# Headless verify:
#   OMNISIM_NEWTON_STATICS=1 OMNIARM6_TC_AUTOQUIT=1 python scripts/dev/headless_runner.py \
#     projects/samples/demos/worlds/flagship/omniarm6_throw_catch.omniworld --duration 600

EXTERNPROTO "omnisim://projects/samples/demos/protos/OmniLinkStage.proto"
EXTERNPROTO "omnisim://projects/objects/backgrounds/protos/OmniSimSky.proto"
EXTERNPROTO "omnisim://projects/objects/lights/protos/OmniSimSun.proto"
EXTERNPROTO "omnisim://projects/objects/lights/protos/OmniSimSunMarker.proto"

WorldInfo {
  basicTimeStep 16
  title "OmniLink — OmniArm 6 two-arm throw & catch (Shadowing)"
  newtonSolver "mujoco"
  contactProperties [
    ContactProperties { material1 "default" material2 "default" coulombFriction [ 3 ] bounce 0 softCFM 0.0003 }
  ]
  # translation_audit: ContactProperties.coulombFriction is an ODE-path field the
  # Newton backend does not read; this declares the same friction where it is read.
  #
  # mu 5 is past the contact solver's stable range at basicTimeStep 16 and sank
  # this world's dynamic bodies through the floor -- measured over a 12 s settle
  # with the robots removed: the part below z=0. mu 3 keeps every part on its
  # surface and is the value docs/guide/friction-grasp.md measured for a
  # two-finger pinch, so it is the highest friction this world can actually hold.
  newtonGroundMu 3
}
Viewpoint { orientation -0.278945 0.120681 0.952694 2.359689 position 6.208 -5.890 5.626 }
OmniSimSky { }
DEF SUN OmniSimSun { }
DEF SUN_MARKER OmniSimSunMarker { }
OmniLinkStage { floorSize 6 6 }

# Arm A: the THROWER (default orientation, faces +x toward B)
DEF OMNIARM6_A URDFRobot {
  url "../../../../robots/omnisim/omniarm6/omniarm6_suction.urdf"
  translation 0 0 0
  name "omniarm6_a"
  supervisor TRUE
  staticBase TRUE
  physicsBackend "newton"
  controller "omniarm6_throw_arm"
}

# Arm B: the CATCHER, at x=1.35 rotated 180deg about z so it FACES arm A (-x).
DEF OMNIARM6_B URDFRobot {
  url "../../../../robots/omnisim/omniarm6/omniarm6_suction.urdf"
  translation 1.35 0 0
  rotation 0 0 1 3.14159
  name "omniarm6_b"
  supervisor TRUE
  staticBase TRUE
  physicsBackend "newton"
  controller "omniarm6_catch_arm"
}

# Pick pedestal + the cube to throw (arm A picks it off this).
DEF PEDESTAL Solid {
  translation 0.45 0 0.05
  children [
    DEF PED_SH Shape {
      appearance PBRAppearance { baseColor 0.35 0.37 0.40 roughness 0.9 metalness 0.1 }
      geometry Box { size 0.12 0.12 0.10 }
    }
  ]
  name "pedestal"
  boundingObject USE PED_SH
}
DEF PART Solid {
  translation 0.45 0 0.125
  physicsBackend "newton"
  children [
    DEF PART_SH Shape {
      appearance PBRAppearance { baseColor 0.90 0.30 0.12 roughness 0.6 metalness 0.1 }
      geometry Box { size 0.05 0.05 0.05 }
    }
  ]
  name "part"
  boundingObject USE PART_SH
  physics Physics { density -1 mass 0.2 }
}
