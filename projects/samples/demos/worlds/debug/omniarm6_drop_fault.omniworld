#OMNISIM R2025a utf8

# OmniSim DEBUGGING DEMO — "the arm drops the box two times in five"
#
# THIS WORLD IS DELIBERATELY BROKEN. It is the bug, not the fixture.
#
# It is a byte-for-byte copy of the flagship friction-grasp cell
# projects/samples/demos/worlds/flagship/omniarm6_real_pick_place.omniworld
# with exactly TWO fields changed:
#
#   1. WorldInfo.newtonGroundMu   6  ->  1.5     <- THE FAULT
#   2. DEF BLOCK ... mass      0.15  ->  0.30    <- the payload that exposes it
#
# The fix is the sibling world omniarm6_drop_fault_fixed.omniworld, which is
# this file with newtonGroundMu back at 6. Diff them: it is one number.
#
# WHY THIS IS A GOOD BUG. Nothing here is welded. The block is held by contact
# friction between two Robotiq 2F-85 pads and nothing else -- it is not named
# DEF GRASP_*, so ArmBridge._attach_nearest is structurally unable to weld it.
# So when friction is wrong, the block falls, the way it would on a real cell.
# And it falls INTERMITTENTLY: at newtonGroundMu 1.5 the 0.15 / 0.20 / 0.25 kg
# payloads are carried and placed, and the 0.30 / 0.35 kg payloads are dropped
# in mid-air. Two in five. A screenshot of the end state cannot tell you which
# happened -- a dropped block often lands close enough to the place target to
# score placed=True.
#
# WHAT THE DEMO PROVES. The whole diagnosis comes off ONE endpoint,
# GET /sim/events, in full-tracking mode ({"light": false}): the grip is lost
# with the block airborne, the block re-contacts a table ~64 ms later, and the
# engine's own startup line on the same stream reports mu=1.5. No screenshot,
# no file read, no world source.
#
# Run it:
#   python -m omnisim run-headless projects/samples/demos/worlds/debug/omniarm6_drop_fault.omniworld --duration 90
#   (PICK_AUTOQUIT=1 cuts that to ~11 s; PICK_OUT=<path> keeps the result JSON
#    out of the flagship controller's directory)
#
# Diagnose it the way an agent would:
#   python scripts/dev/diagnose_drop.py projects/samples/demos/worlds/debug/omniarm6_drop_fault.omniworld
#
# Full write-up, with the measured numbers and the honest caveats:
#   projects/samples/demos/worlds/debug/README.md
#
# ⚠ The three physics fields below are NOT the fault and must not be "fixed":
# basicTimeStep 8, condim 4 and the elliptic cone + impratio are the flagship
# recipe (docs/guide/friction-grasp.md). Changing them changes the demo.

EXTERNPROTO "omnisim://projects/samples/demos/protos/OmniLinkStage.proto"
EXTERNPROTO "omnisim://projects/objects/backgrounds/protos/OmniSimSky.proto"
EXTERNPROTO "omnisim://projects/objects/lights/protos/OmniSimSun.proto"
EXTERNPROTO "omnisim://projects/objects/lights/protos/OmniSimSunMarker.proto"

WorldInfo {
  basicTimeStep 8
  title "OmniSim debugging demo — the arm drops the box (FAULTY: newtonGroundMu 1.5)"
  newtonSolver "mujoco"
  newtonStatics TRUE
  newtonCompoundColliders TRUE
  # ⚠ THE FAULT. The flagship cell ships 6. At 1.5 the pads still hold the
  # lighter payloads and lose the 0.30 / 0.35 kg ones in mid-carry. Friction is
  # global here: one ShapeConfig serves the whole world, so this single number
  # sets how grippy the pads are.
  newtonGroundMu 1.5
  newtonContactKe 8000
  newtonContactKd 200
  newtonCone "elliptic"
  newtonImpratio 100
  newtonCondim 4
  newtonIterations 150
  newtonLsIterations 50
}
Viewpoint { orientation -0.30 0.13 0.945 2.33 position 1.85 -1.75 1.25 }
OmniSimSky { }
DEF SUN OmniSimSun { }
DEF SUN_MARKER OmniSimSunMarker { }
OmniLinkStage { floorSize 4 4 }

DEF OMNIARM6 URDFRobot {
  url "../../../../robots/omnisim/omniarm6/omniarm6_2f85_grip.urdf"
  translation 0 0 0
  name "omniarm6"
  supervisor TRUE
  staticBase TRUE
  physicsBackend "newton"
  controller "omniarm6_real_pick_place"
}

# Pick pedestal, top face at z=0.20
DEF PICK_TABLE Solid {
  translation 0.46 0 0.10
  children [
    DEF PT_SH Shape {
      appearance PBRAppearance { baseColor 0.40 0.43 0.48 roughness 1 metalness 0 }
      geometry Box { size 0.26 0.26 0.20 }
    }
  ]
  name "pick_table"
  boundingObject USE PT_SH
}

# Place pedestal. The carry between the two is where the grip is lost, and
# `contact.began BLOCK <-> PLACE_TABLE` is the event that says the carry
# SUCCEEDED -- on a dropped run it is never emitted at all.
DEF PLACE_TABLE Solid {
  translation 0.24 -0.42 0.10
  children [
    DEF PL_SH Shape {
      appearance PBRAppearance { baseColor 0.82 0.68 0.15 roughness 1 metalness 0 }
      geometry Box { size 0.24 0.24 0.20 }
    }
  ]
  name "place_table"
  boundingObject USE PL_SH
}

# ⚠ NOT named DEF GRASP_* on purpose: ArmBridge._attach_nearest only ever
# yields DEF GRASP_* nodes, so this block is STRUCTURALLY ineligible for the
# kinematic weld. The hold cannot be faked by accident.
#
# 0.30 kg is the payload the fault drops. scripts/dev/drop_payload_sweep.py
# rewrites this one number to walk the 0.15 / 0.20 / 0.25 / 0.30 / 0.35 kg set.
# ⚠ The behaviour is NOT monotonic in mass outside that band -- 0.45 kg holds
# here and drops on the fixed world. Stay inside 0.15-0.35 kg.
DEF BLOCK Solid {
  translation 0.46 0 0.245
  children [
    DEF BLK_SH Shape {
      appearance PBRAppearance { baseColor 0.85 0.25 0.20 roughness 1 metalness 0 }
      geometry Box { size 0.05 0.05 0.09 }
    }
  ]
  name "block"
  boundingObject USE BLK_SH
  physics Physics { density -1 mass 0.30 }
}
