#OMNISIM R2025a utf8

# OmniLink — TurtleBot3 Waffle Pi
# 2-wheel diff-drive bot (Pi variant). Same prompts as Waffle.

EXTERNPROTO "omnisim://projects/samples/demos/protos/OmniLinkStage.proto"
EXTERNPROTO "omnisim://projects/objects/backgrounds/protos/OmniSimSky.proto"
EXTERNPROTO "omnisim://projects/objects/lights/protos/OmniSimSun.proto"
EXTERNPROTO "omnisim://projects/objects/lights/protos/OmniSimSunMarker.proto"

WorldInfo {
  basicTimeStep 16
  title "OmniLink — TurtleBot3 Waffle Pi"
}
Viewpoint {
  orientation -0.278945 0.120681 0.952694 2.359689
  position 2.312 -2.461 2.413
  follow "tb3_waffle_pi"
  followType "Tracking Shot"
  followSmoothness 0.3
}
OmniSimSky { }
DEF SUN OmniSimSun { }
DEF SUN_MARKER OmniSimSunMarker { }
OmniLinkStage {
  floorSize 6 6
}

DEF TB3_WAFFLE_PI URDFRobot {
  url "../../../../robots/robotis/turtlebot3_description/urdf/turtlebot3_waffle_pi.urdf"
  translation 0 0 0
  name "tb3_waffle_pi"
  supervisor TRUE
  controller "omnilink_mobile_bridge"
  controllerArgs [ "--robot" "tb3_waffle_pi" "--port" "8765" ]
  window "omnilink_chat"
}
