#VRML_SIM R2025a utf8

# OmniLink — Boston Dynamics Spot
# Spot quadruped. The bridge exposes "stand", "sit", "wave hello",
# "walk forward", and "stop". The walk uses a wave-gait leg cycle plus
# supervisor-driven body translation -- see spot_simple_pose.py for the
# physics rationale behind the supervisor cheat.

EXTERNPROTO "omnisim://projects/samples/demos/protos/OmniLinkStage.proto"
EXTERNPROTO "omnisim://projects/objects/backgrounds/protos/OmniSimSky.proto"
EXTERNPROTO "omnisim://projects/objects/lights/protos/OmniSimSun.proto"
EXTERNPROTO "omnisim://projects/objects/lights/protos/OmniSimSunMarker.proto"

WorldInfo {
  basicTimeStep 16
  title "OmniLink — Spot"
  info [
    "Spot quadruped. Bridge accepts stand / sit / wave / walk / stop"
    "via the omnilink_chat window."
  ]
  contactProperties [
    ContactProperties {
      material1 "default"
      material2 "default"
      coulombFriction [ 2.0 ]
      bounce 0.0
    }
  ]
}
Viewpoint {
  orientation -0.278945 0.120681 0.952694 2.359689
  position 2.742 -2.919 3.865
}
OmniSimSky { }
DEF SUN OmniSimSun { }
DEF SUN_MARKER OmniSimSunMarker { }
OmniLinkStage {
  floorSize 6 6
}

DEF SPOT URDFRobot {
  url "../../../../robots/boston_dynamics/spot/urdf/spot.urdf"
  translation 0 0 0.85
  name "spot"
  supervisor TRUE
  controller "omnilink_quadruped_bridge"
  controllerArgs [ "--robot" "spot" "--port" "8765" ]
  window "omnilink_chat"
}
