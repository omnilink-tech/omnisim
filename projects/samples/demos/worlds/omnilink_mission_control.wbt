# ── Husky fleet ──────────────────────────────────────────────────
# 6 Huskies parked in a row at the south edge. Each on its own
# omnilink_mobile_bridge port + --name.

DEF HUSKY_1 URDFRobot {
  url "../../../robots/clearpath/husky_description/urdf/husky.urdf"
  translation -5 -13 0.2
  rotation 0 0 1 1.5707963
  name "husky_1"
  supervisor TRUE
  controller "omnilink_mobile_bridge"
  controllerArgs [ "--robot" "husky" "--port" "8765" "--name" "husky_1" ]
  window "omnilink_chat"
}
