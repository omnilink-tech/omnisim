<?xml version="1.0"?>
<!-- Hokuyo UTM-30LX — 270 deg planar lidar, 0.1-30 m range. -->
<robot xmlns:xacro="http://ros.org/wiki/xacro">
  <xacro:macro name="hokuyo_utm30lx" params="parent_link prefix:=hokuyo_utm30lx *origin">
    <link name="${prefix}_link">
      <visual>
        <origin xyz="0 0 0.044" rpy="0 0 0"/>
        <geometry><cylinder length="0.087" radius="0.030"/></geometry>
        <material name="${prefix}_grey"><color rgba="0.20 0.20 0.20 1.0"/></material>
      </visual>
      <collision>
        <origin xyz="0 0 0.044" rpy="0 0 0"/>
        <geometry><cylinder length="0.087" radius="0.030"/></geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 0.044" rpy="0 0 0"/>
        <mass value="0.21"/>
        <inertia ixx="1.6e-4" ixy="0" ixz="0" iyy="1.6e-4" iyz="0" izz="9.5e-5"/>
      </inertial>
    </link>
    <joint name="${prefix}_joint" type="fixed">
      <parent link="${parent_link}"/>
      <child link="${prefix}_link"/>
      <xacro:insert_block name="origin"/>
    </joint>
    <gazebo reference="${prefix}_link">
      <sensor name="${prefix}" type="lidar">
        <update_rate>40</update_rate>
        <ray>
          <scan><horizontal><samples>1080</samples><min_angle>-2.35619</min_angle><max_angle>2.35619</max_angle></horizontal></scan>
          <range><min>0.1</min><max>30.0</max></range>
        </ray>
      </sensor>
    </gazebo>
  </xacro:macro>
</robot>
