<?xml version="1.0"?>
<!-- Hokuyo URG-04LX — 240 deg planar lidar, 0.06-4.096 m range. -->
<robot xmlns:xacro="http://ros.org/wiki/xacro">
  <xacro:macro name="hokuyo_urg04lx" params="parent_link prefix:=hokuyo_urg04lx *origin">
    <link name="${prefix}_link">
      <visual>
        <origin xyz="0 0 0.025" rpy="0 0 0"/>
        <geometry><box size="0.050 0.050 0.070"/></geometry>
        <material name="${prefix}_grey"><color rgba="0.20 0.20 0.20 1.0"/></material>
      </visual>
      <collision>
        <origin xyz="0 0 0.025" rpy="0 0 0"/>
        <geometry><box size="0.050 0.050 0.070"/></geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 0.025" rpy="0 0 0"/>
        <mass value="0.16"/>
        <inertia ixx="9e-5" ixy="0" ixz="0" iyy="9e-5" iyz="0" izz="6e-5"/>
      </inertial>
    </link>
    <joint name="${prefix}_joint" type="fixed">
      <parent link="${parent_link}"/>
      <child link="${prefix}_link"/>
      <xacro:insert_block name="origin"/>
    </joint>
    <gazebo reference="${prefix}_link">
      <sensor name="${prefix}" type="lidar">
        <update_rate>10</update_rate>
        <ray>
          <scan><horizontal><samples>667</samples><min_angle>-2.09439</min_angle><max_angle>2.09439</max_angle></horizontal></scan>
          <range><min>0.06</min><max>4.096</max></range>
        </ray>
      </sensor>
    </gazebo>
  </xacro:macro>
</robot>
