<?xml version="1.0"?>
<!--
smartmicro UMRR-0A31 — long-range automotive radar. ±18 deg HFoV,
1.0-160 m range.
-->
<robot xmlns:xacro="http://ros.org/wiki/xacro">
  <xacro:macro name="umrr_0a31" params="parent_link prefix:=umrr_0a31 *origin">
    <link name="${prefix}_link">
      <visual>
        <origin xyz="0 0 0.025" rpy="0 0 0"/>
        <geometry><box size="0.085 0.085 0.030"/></geometry>
        <material name="${prefix}_dark"><color rgba="0.16 0.16 0.16 1.0"/></material>
      </visual>
      <collision>
        <origin xyz="0 0 0.025" rpy="0 0 0"/>
        <geometry><box size="0.085 0.085 0.030"/></geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 0.025" rpy="0 0 0"/>
        <mass value="0.16"/>
        <inertia ixx="1.0e-4" ixy="0" ixz="0" iyy="1.0e-4" iyz="0" izz="1.9e-4"/>
      </inertial>
    </link>
    <joint name="${prefix}_joint" type="fixed">
      <parent link="${parent_link}"/>
      <child link="${prefix}_link"/>
      <xacro:insert_block name="origin"/>
    </joint>
    <gazebo reference="${prefix}_link">
      <sensor name="${prefix}" type="lidar">
        <update_rate>20</update_rate>
        <ray>
          <scan><horizontal><samples>72</samples><min_angle>-0.3142</min_angle><max_angle>0.3142</max_angle></horizontal></scan>
          <range><min>1.0</min><max>160.0</max></range>
        </ray>
      </sensor>
    </gazebo>
  </xacro:macro>
</robot>
