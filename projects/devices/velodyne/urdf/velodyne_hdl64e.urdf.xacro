<?xml version="1.0"?>
<!--
Velodyne HDL-64E — 64-layer rotational lidar.
Spec: 360 deg horizontal x 26.8 deg vertical, 64 layers, 120 m range.
-->
<robot xmlns:xacro="http://ros.org/wiki/xacro">
  <xacro:macro name="velodyne_hdl64e" params="parent_link prefix:=velodyne_hdl64e *origin">
    <link name="${prefix}_link">
      <visual>
        <origin xyz="0 0 0.143" rpy="0 0 0"/>
        <geometry>
          <cylinder length="0.286" radius="0.103"/>
        </geometry>
        <material name="${prefix}_grey">
          <color rgba="0.15 0.15 0.16 1.0"/>
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0.143" rpy="0 0 0"/>
        <geometry>
          <cylinder length="0.286" radius="0.103"/>
        </geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 0.143" rpy="0 0 0"/>
        <mass value="13.0"/>
        <inertia ixx="1.0e-1" ixy="0" ixz="0" iyy="1.0e-1" iyz="0" izz="6.9e-2"/>
      </inertial>
    </link>
    <joint name="${prefix}_joint" type="fixed">
      <parent link="${parent_link}"/>
      <child link="${prefix}_link"/>
      <xacro:insert_block name="origin"/>
    </joint>
    <gazebo reference="${prefix}_link">
      <sensor name="${prefix}" type="lidar">
        <update_rate>10</update_rate>
        <ray>
          <scan>
            <horizontal>
              <samples>4500</samples>
              <min_angle>-3.14159</min_angle>
              <max_angle>3.14159</max_angle>
            </horizontal>
            <vertical>
              <samples>64</samples>
              <min_angle>-0.4014</min_angle>
              <max_angle>0.0666</max_angle>
            </vertical>
          </scan>
          <range>
            <min>0.8</min>
            <max>120.0</max>
          </range>
        </ray>
      </sensor>
    </gazebo>
  </xacro:macro>
</robot>
