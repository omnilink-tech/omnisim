<?xml version="1.0"?>
<!--
Velodyne VLP-16 / Puck — 16-layer rotational lidar.

Spec: 360 deg horizontal x 30 deg vertical, 16 layers, 100 m range.
Sensor emitted via <gazebo><sensor type="lidar">; the OmniSim URDF
importer materialises it as a Webots Lidar device with the
appropriate numberOfLayers + verticalFieldOfView when
OMNISIM_URDF_USE_SENSORS=1.

Usage in a parent URDF or xacro:

    <xacro:include filename="$(find omnisim_devices)/velodyne/urdf/velodyne_vlp16.urdf.xacro"/>
    <xacro:velodyne_vlp16 parent_link="base_link" prefix="velo">
      <origin xyz="0 0 0.5" rpy="0 0 0"/>
    </xacro:velodyne_vlp16>
-->
<robot xmlns:xacro="http://ros.org/wiki/xacro">
  <xacro:macro name="velodyne_vlp16" params="parent_link prefix:=velodyne *origin">
    <link name="${prefix}_link">
      <visual>
        <origin xyz="0 0 0.0363" rpy="0 0 0"/>
        <geometry>
          <cylinder length="0.0727" radius="0.0516"/>
        </geometry>
        <material name="${prefix}_grey">
          <color rgba="0.15 0.15 0.16 1.0"/>
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0.0363" rpy="0 0 0"/>
        <geometry>
          <cylinder length="0.0727" radius="0.052"/>
        </geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 0.0363" rpy="0 0 0"/>
        <mass value="0.83"/>
        <inertia ixx="6.6e-4" ixy="0" ixz="0" iyy="6.6e-4" iyz="0" izz="1.1e-3"/>
      </inertial>
    </link>
    <joint name="${prefix}_joint" type="fixed">
      <parent link="${parent_link}"/>
      <child link="${prefix}_link"/>
      <xacro:insert_block name="origin"/>
    </joint>
    <gazebo reference="${prefix}_link">
      <sensor name="${prefix}" type="lidar">
        <update_rate>10</update_rate>
        <ray>
          <scan>
            <horizontal>
              <samples>3600</samples>
              <min_angle>-3.14159</min_angle>
              <max_angle>3.14159</max_angle>
            </horizontal>
            <vertical>
              <samples>16</samples>
              <min_angle>-0.2618</min_angle>
              <max_angle>0.2618</max_angle>
            </vertical>
          </scan>
          <range>
            <min>1.0</min>
            <max>100.0</max>
          </range>
        </ray>
      </sensor>
    </gazebo>
  </xacro:macro>
</robot>
