<?xml version="1.0"?>
<!--
Velodyne HDL-32E — 32-layer rotational lidar.
Spec: 360 deg horizontal x 41.34 deg vertical, 32 layers, 70 m range.
-->
<robot xmlns:xacro="http://ros.org/wiki/xacro">
  <xacro:macro name="velodyne_hdl32e" params="parent_link prefix:=velodyne_hdl32e *origin">
    <link name="${prefix}_link">
      <visual>
        <origin xyz="0 0 0.072" rpy="0 0 0"/>
        <geometry>
          <cylinder length="0.144" radius="0.043"/>
        </geometry>
        <material name="${prefix}_grey">
          <color rgba="0.15 0.15 0.16 1.0"/>
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0.072" rpy="0 0 0"/>
        <geometry>
          <cylinder length="0.144" radius="0.043"/>
        </geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 0.072" rpy="0 0 0"/>
        <mass value="1.0"/>
        <inertia ixx="2.1e-3" ixy="0" ixz="0" iyy="2.1e-3" iyz="0" izz="9.2e-4"/>
      </inertial>
    </link>
    <joint name="${prefix}_joint" type="fixed">
      <parent link="${parent_link}"/>
      <child link="${prefix}_link"/>
      <xacro:insert_block name="origin"/>
    </joint>
    <gazebo reference="${prefix}_link">
      <sensor name="${prefix}" type="lidar">
        <update_rate>10</update_rate>
        <ray>
          <scan>
            <horizontal>
              <samples>4500</samples>
              <min_angle>-3.14159</min_angle>
              <max_angle>3.14159</max_angle>
            </horizontal>
            <vertical>
              <samples>32</samples>
              <min_angle>-0.5358</min_angle>
              <max_angle>0.1857</max_angle>
            </vertical>
          </scan>
          <range>
            <min>1.0</min>
            <max>70.0</max>
          </range>
        </ray>
      </sensor>
    </gazebo>
  </xacro:macro>
</robot>
