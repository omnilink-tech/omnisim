<?xml version="1.0"?>
<!--
Generic servo — a single revolute joint with a small bracket-shaped
visual. Useful as a building block when authoring custom mechanisms
that need a parameterised servo joint without committing to a vendor.
-->
<robot xmlns:xacro="http://ros.org/wiki/xacro">
  <xacro:macro name="servo" params="parent_link prefix:=servo lower:=-3.14 upper:=3.14 effort:=2.0 velocity:=6.28 axis_xyz:='0 0 1' *origin">
    <link name="${prefix}_body_link">
      <visual>
        <origin xyz="0 0 0.020" rpy="0 0 0"/>
        <geometry><box size="0.040 0.020 0.040"/></geometry>
        <material name="${prefix}_dark"><color rgba="0.16 0.16 0.16 1.0"/></material>
      </visual>
      <collision>
        <origin xyz="0 0 0.020" rpy="0 0 0"/>
        <geometry><box size="0.040 0.020 0.040"/></geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 0.020" rpy="0 0 0"/>
        <mass value="0.060"/>
        <inertia ixx="1.1e-5" ixy="0" ixz="0" iyy="1.6e-5" iyz="0" izz="6.0e-6"/>
      </inertial>
    </link>
    <joint name="${prefix}_mount" type="fixed">
      <parent link="${parent_link}"/>
      <child link="${prefix}_body_link"/>
      <xacro:insert_block name="origin"/>
    </joint>
    <link name="${prefix}_horn_link">
      <visual>
        <origin xyz="0 0 0.005" rpy="0 0 0"/>
        <geometry><cylinder length="0.010" radius="0.010"/></geometry>
        <material name="${prefix}_white"><color rgba="0.85 0.85 0.85 1.0"/></material>
      </visual>
      <inertial>
        <origin xyz="0 0 0.005" rpy="0 0 0"/>
        <mass value="0.003"/>
        <inertia ixx="1e-7" ixy="0" ixz="0" iyy="1e-7" iyz="0" izz="1e-7"/>
      </inertial>
    </link>
    <joint name="${prefix}_joint" type="revolute">
      <parent link="${prefix}_body_link"/>
      <child link="${prefix}_horn_link"/>
      <origin xyz="0 0 0.040" rpy="0 0 0"/>
      <axis xyz="${axis_xyz}"/>
      <limit lower="${lower}" upper="${upper}" effort="${effort}" velocity="${velocity}"/>
    </joint>
  </xacro:macro>
</robot>
