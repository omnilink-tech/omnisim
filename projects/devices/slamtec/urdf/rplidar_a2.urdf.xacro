<?xml version="1.0"?>
<!-- SLAMTEC RPLidar A2 — 360 deg planar lidar, 0.2-12 m range. -->
<robot xmlns:xacro="http://ros.org/wiki/xacro">
  <xacro:macro name="rplidar_a2" params="parent_link prefix:=rplidar_a2 *origin">
    <link name="${prefix}_link">
      <visual>
        <origin xyz="0 0 0.020" rpy="0 0 0"/>
        <geometry><cylinder length="0.040" radius="0.038"/></geometry>
        <material name="${prefix}_dark"><color rgba="0.12 0.12 0.13 1.0"/></material>
      </visual>
      <collision>
        <origin xyz="0 0 0.020" rpy="0 0 0"/>
        <geometry><cylinder length="0.040" radius="0.038"/></geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 0.020" rpy="0 0 0"/>
        <mass value="0.190"/>
        <inertia ixx="6e-5" ixy="0" ixz="0" iyy="6e-5" iyz="0" izz="1.4e-4"/>
      </inertial>
    </link>
    <joint name="${prefix}_joint" type="fixed">
      <parent link="${parent_link}"/>
      <child link="${prefix}_link"/>
      <xacro:insert_block name="origin"/>
    </joint>
    <gazebo reference="${prefix}_link">
      <sensor name="${prefix}" type="lidar">
        <update_rate>10</update_rate>
        <ray>
          <scan><horizontal><samples>400</samples><min_angle>-3.14159</min_angle><max_angle>3.14159</max_angle></horizontal></scan>
          <range><min>0.2</min><max>12.0</max></range>
        </ray>
      </sensor>
    </gazebo>
  </xacro:macro>
</robot>
