<?xml version="1.0"?>
<!-- Robotis LDS-01 — TurtleBot3 lidar. 360 deg, 0.12-3.5 m range. -->
<robot xmlns:xacro="http://ros.org/wiki/xacro">
  <xacro:macro name="lds01" params="parent_link prefix:=lds01 *origin">
    <link name="${prefix}_link">
      <visual>
        <origin xyz="0 0 0.015" rpy="0 0 0"/>
        <geometry><cylinder length="0.030" radius="0.038"/></geometry>
        <material name="${prefix}_dark"><color rgba="0.12 0.12 0.13 1.0"/></material>
      </visual>
      <collision>
        <origin xyz="0 0 0.015" rpy="0 0 0"/>
        <geometry><cylinder length="0.030" radius="0.038"/></geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 0.015" rpy="0 0 0"/>
        <mass value="0.125"/>
        <inertia ixx="3e-5" ixy="0" ixz="0" iyy="3e-5" iyz="0" izz="9e-5"/>
      </inertial>
    </link>
    <joint name="${prefix}_joint" type="fixed">
      <parent link="${parent_link}"/>
      <child link="${prefix}_link"/>
      <xacro:insert_block name="origin"/>
    </joint>
    <gazebo reference="${prefix}_link">
      <sensor name="${prefix}" type="lidar">
        <update_rate>5</update_rate>
        <ray>
          <scan><horizontal><samples>360</samples><min_angle>-3.14159</min_angle><max_angle>3.14159</max_angle></horizontal></scan>
          <range><min>0.12</min><max>3.5</max></range>
        </ray>
      </sensor>
    </gazebo>
  </xacro:macro>
</robot>
