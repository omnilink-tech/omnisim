<?xml version="1.0"?>
<!--
Carnegie Robotics MultiSense S21 — stereo + depth camera. 2048x1088
mono channels at up to 30 Hz, ~80 deg HFoV. Modelled here as two
separate cameras (left + right) plus a depth camera, all colocated.
-->
<robot xmlns:xacro="http://ros.org/wiki/xacro">
  <xacro:macro name="multisense_s21" params="parent_link prefix:=multisense_s21 *origin">
    <link name="${prefix}_link">
      <visual>
        <origin xyz="0 0 0.030" rpy="0 0 0"/>
        <geometry><box size="0.215 0.085 0.060"/></geometry>
        <material name="${prefix}_dark"><color rgba="0.14 0.14 0.14 1.0"/></material>
      </visual>
      <collision>
        <origin xyz="0 0 0.030" rpy="0 0 0"/>
        <geometry><box size="0.215 0.085 0.060"/></geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 0.030" rpy="0 0 0"/>
        <mass value="0.66"/>
        <inertia ixx="6.0e-4" ixy="0" ixz="0" iyy="2.7e-3" iyz="0" izz="3.1e-3"/>
      </inertial>
    </link>
    <joint name="${prefix}_joint" type="fixed">
      <parent link="${parent_link}"/>
      <child link="${prefix}_link"/>
      <xacro:insert_block name="origin"/>
    </joint>
    <gazebo reference="${prefix}_link">
      <sensor name="${prefix}_left" type="camera">
        <update_rate>30</update_rate>
        <camera>
          <horizontal_fov>1.40</horizontal_fov>
          <image><width>1024</width><height>544</height></image>
        </camera>
      </sensor>
      <sensor name="${prefix}_right" type="camera">
        <update_rate>30</update_rate>
        <camera>
          <horizontal_fov>1.40</horizontal_fov>
          <image><width>1024</width><height>544</height></image>
        </camera>
      </sensor>
      <sensor name="${prefix}_depth" type="depth">
        <update_rate>30</update_rate>
        <camera>
          <horizontal_fov>1.40</horizontal_fov>
          <image><width>1024</width><height>544</height></image>
        </camera>
      </sensor>
    </gazebo>
  </xacro:macro>
</robot>
