<?xml version="1.0"?>
<!-- Sick LMS291 — 180 deg planar lidar, max 80 m range. -->
<robot xmlns:xacro="http://ros.org/wiki/xacro">
  <xacro:macro name="sick_lms291" params="parent_link prefix:=sick_lms291 *origin">
    <link name="${prefix}_link">
      <visual>
        <origin xyz="0 0 0.084" rpy="0 0 0"/>
        <geometry><box size="0.155 0.155 0.168"/></geometry>
        <material name="${prefix}_yellow"><color rgba="0.85 0.71 0.10 1.0"/></material>
      </visual>
      <collision>
        <origin xyz="0 0 0.084" rpy="0 0 0"/>
        <geometry><box size="0.155 0.155 0.168"/></geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 0.084" rpy="0 0 0"/>
        <mass value="4.5"/>
        <inertia ixx="2.0e-2" ixy="0" ixz="0" iyy="2.0e-2" iyz="0" izz="1.8e-2"/>
      </inertial>
    </link>
    <joint name="${prefix}_joint" type="fixed">
      <parent link="${parent_link}"/>
      <child link="${prefix}_link"/>
      <xacro:insert_block name="origin"/>
    </joint>
    <gazebo reference="${prefix}_link">
      <sensor name="${prefix}" type="lidar">
        <update_rate>75</update_rate>
        <ray>
          <scan><horizontal><samples>180</samples><min_angle>-1.5708</min_angle><max_angle>1.5708</max_angle></horizontal></scan>
          <range><min>0.1</min><max>80.0</max></range>
        </ray>
      </sensor>
    </gazebo>
  </xacro:macro>
</robot>
