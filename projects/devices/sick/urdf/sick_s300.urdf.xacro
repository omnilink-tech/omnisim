<?xml version="1.0"?>
<!-- Sick S300 — 270 deg safety lidar, 0.5 deg resolution, 0.1-30 m range. -->
<robot xmlns:xacro="http://ros.org/wiki/xacro">
  <xacro:macro name="sick_s300" params="parent_link prefix:=sick_s300 *origin">
    <link name="${prefix}_link">
      <visual>
        <origin xyz="0 0 0.077" rpy="0 0 0"/>
        <geometry><cylinder length="0.155" radius="0.054"/></geometry>
        <material name="${prefix}_yellow"><color rgba="0.85 0.71 0.10 1.0"/></material>
      </visual>
      <collision>
        <origin xyz="0 0 0.077" rpy="0 0 0"/>
        <geometry><cylinder length="0.155" radius="0.054"/></geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 0.077" rpy="0 0 0"/>
        <mass value="1.2"/>
        <inertia ixx="3.0e-3" ixy="0" ixz="0" iyy="3.0e-3" iyz="0" izz="1.8e-3"/>
      </inertial>
    </link>
    <joint name="${prefix}_joint" type="fixed">
      <parent link="${parent_link}"/>
      <child link="${prefix}_link"/>
      <xacro:insert_block name="origin"/>
    </joint>
    <gazebo reference="${prefix}_link">
      <sensor name="${prefix}" type="lidar">
        <update_rate>16</update_rate>
        <ray>
          <scan><horizontal><samples>540</samples><min_angle>-2.35619</min_angle><max_angle>2.35619</max_angle></horizontal></scan>
          <range><min>0.1</min><max>30.0</max></range>
        </ray>
      </sensor>
    </gazebo>
  </xacro:macro>
</robot>
