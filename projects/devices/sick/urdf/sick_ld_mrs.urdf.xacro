<?xml version="1.0"?>
<!--
Sick LD-MRS — 4-layer rotational automotive lidar.
85 deg horizontal x ~3.2 deg vertical (4 layers), 0.5-300 m range.
-->
<robot xmlns:xacro="http://ros.org/wiki/xacro">
  <xacro:macro name="sick_ld_mrs" params="parent_link prefix:=sick_ld_mrs *origin">
    <link name="${prefix}_link">
      <visual>
        <origin xyz="0 0 0.044" rpy="0 0 0"/>
        <geometry><box size="0.164 0.093 0.088"/></geometry>
        <material name="${prefix}_dark"><color rgba="0.20 0.20 0.20 1.0"/></material>
      </visual>
      <collision>
        <origin xyz="0 0 0.044" rpy="0 0 0"/>
        <geometry><box size="0.164 0.093 0.088"/></geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 0.044" rpy="0 0 0"/>
        <mass value="1.0"/>
        <inertia ixx="2.0e-3" ixy="0" ixz="0" iyy="3.0e-3" iyz="0" izz="3.0e-3"/>
      </inertial>
    </link>
    <joint name="${prefix}_joint" type="fixed">
      <parent link="${parent_link}"/>
      <child link="${prefix}_link"/>
      <xacro:insert_block name="origin"/>
    </joint>
    <gazebo reference="${prefix}_link">
      <sensor name="${prefix}" type="lidar">
        <update_rate>50</update_rate>
        <ray>
          <scan>
            <horizontal>
              <samples>340</samples>
              <min_angle>-0.7418</min_angle>
              <max_angle>0.7418</max_angle>
            </horizontal>
            <vertical>
              <samples>4</samples>
              <min_angle>-0.02793</min_angle>
              <max_angle>0.02793</max_angle>
            </vertical>
          </scan>
          <range><min>0.5</min><max>300.0</max></range>
        </ray>
      </sensor>
    </gazebo>
  </xacro:macro>
</robot>
