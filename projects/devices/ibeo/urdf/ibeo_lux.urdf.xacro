<?xml version="1.0"?>
<!--
Ibeo LUX — 4-layer automotive lidar. 110 deg HFoV, ±1.6 deg vertical
(4 layers), 0.3-200 m range.
-->
<robot xmlns:xacro="http://ros.org/wiki/xacro">
  <xacro:macro name="ibeo_lux" params="parent_link prefix:=ibeo_lux *origin">
    <link name="${prefix}_link">
      <visual>
        <origin xyz="0 0 0.043" rpy="0 0 0"/>
        <geometry><box size="0.164 0.093 0.088"/></geometry>
        <material name="${prefix}_dark"><color rgba="0.16 0.16 0.16 1.0"/></material>
      </visual>
      <collision>
        <origin xyz="0 0 0.043" rpy="0 0 0"/>
        <geometry><box size="0.164 0.093 0.088"/></geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 0.043" rpy="0 0 0"/>
        <mass value="1.0"/>
        <inertia ixx="2.0e-3" ixy="0" ixz="0" iyy="3.0e-3" iyz="0" izz="3.0e-3"/>
      </inertial>
    </link>
    <joint name="${prefix}_joint" type="fixed">
      <parent link="${parent_link}"/>
      <child link="${prefix}_link"/>
      <xacro:insert_block name="origin"/>
    </joint>
    <gazebo reference="${prefix}_link">
      <sensor name="${prefix}" type="lidar">
        <update_rate>25</update_rate>
        <ray>
          <scan>
            <horizontal>
              <samples>440</samples>
              <min_angle>-0.9599</min_angle>
              <max_angle>0.9599</max_angle>
            </horizontal>
            <vertical>
              <samples>4</samples>
              <min_angle>-0.0279</min_angle>
              <max_angle>0.0279</max_angle>
            </vertical>
          </scan>
          <range><min>0.3</min><max>200.0</max></range>
        </ray>
      </sensor>
    </gazebo>
  </xacro:macro>
</robot>
