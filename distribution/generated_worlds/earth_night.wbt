#OMNISIM R2025a utf8

EXTERNPROTO "omnisim://projects/objects/rocks/protos/Rock.proto"
EXTERNPROTO "omnisim://projects/objects/floors/protos/UnevenTerrain.proto"
EXTERNPROTO "omnisim://projects/appearances/protos/SandyGround.proto"
EXTERNPROTO "omnisim://projects/objects/backgrounds/protos/OmniSimSky.proto"
EXTERNPROTO "omnisim://projects/objects/lights/protos/OmniSimSun.proto"
EXTERNPROTO "omnisim://projects/objects/lights/protos/OmniSimSunMarker.proto"

# Interactive time-of-day playground for the Earth atmospheric sky,
# with the same cinematic scene as mars_night.wbt — sand-toned
# ground, scatter of rocks, three reference spheres (chrome / matte
# white / matte slate).  The `sun_control` supervisor drives sun
# direction, exposure, and Earth/Mars preset live via keyboard.
#
# Keys (also printed on-screen, toggle with H):
#   arrows : sun azimuth / elevation  (shift = coarse)
#   [ ]    : exposure
#   E / M  : Earth / Mars atmosphere
#   1..4   : midnight / sunrise / noon / sunset presets
#   R      : reset to starting sun position
#
# Compare against docs/developer/atmospheric-sky-preview.html.

WorldInfo {
  basicTimeStep 16
  title "atmospheric sky playground — Earth"
}
OmniSimSky { }
DEF SUN OmniSimSun { }
DEF SUN_MARKER OmniSimSunMarker { }
DEF VIEW Viewpoint {
  orientation -0.06 0.06 0.996 1.5708
  position 0 -3 1.7
  bloomThreshold 10.0
  ambientOcclusionRadius 2.0
  exposure 1.5
  far 800
}

# Earth-tone exponential haze — gentle atmospheric depth.  Pushed
# out far enough that 60-80m foreground reads cleanly and only the
# horizon (~150m+) blends into the sky colour.
Fog {
  color 0.78 0.72 0.58
  visibilityRange 250
  fogType "EXPONENTIAL"
}

# Cinematic Perlin-noise terrain.  300×300m footprint with 5m of
# relief; gentler than Mars to feel more Earth-like (desert plateau
# instead of dune field).  flatCenter keeps the inner area level
# so the placed spheres + rocks sit on flat ground.
UnevenTerrain {
  name "earth_terrain"
  size 300 300 5
  xDimension 200
  yDimension 200
  flatCenter TRUE
  perlinNOctaves 4
  randomSeed 11
  appearance PBRAppearance {
    baseColor 0.55 0.48 0.35
    roughness 0.92
    metalness 0.0
  }
}

# Three reference spheres at y=4m.  Chrome catches sky reflection
# (IBL specular).  Matte white catches sky irradiance colour (IBL
# diffuse).  Matte slate shows sun direction via shading.
DEF CHROME Solid {
  translation 1.5 4 0.35
  name "chrome_ball"
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.85 0.85 0.85
        metalness 1.0
        roughness 0.05
      }
      geometry Sphere {
        radius 0.35
        subdivision 3
      }
    }
  ]
}
DEF WHITE Solid {
  translation 0 4 0.35
  name "white_ball"
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.95 0.95 0.92
        metalness 0.0
        roughness 0.85
      }
      geometry Sphere {
        radius 0.35
        subdivision 3
      }
    }
  ]
}
DEF SLATE Solid {
  translation -1.5 4 0.35
  name "slate_ball"
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.20 0.22 0.25
        metalness 0.0
        roughness 0.7
      }
      geometry Sphere {
        radius 0.35
        subdivision 3
      }
    }
  ]
}

# Scattered rocks — Earth tones (granite / sandstone).
Rock {
  translation 3.2 5.5 0
  scale 4
  color 0.55 0.5 0.42
}
Rock {
  translation -2.8 6.5 0
  rotation 0 0 1 1.3
  scale 6
  type "flat"
  color 0.50 0.45 0.38
}
Rock {
  translation 0.5 9 0
  rotation 0 0 1 2.1
  scale 9
  color 0.45 0.42 0.38
}
Rock {
  translation -4.3 4.2 0
  rotation 0 0 1 0.5
  scale 3
  color 0.55 0.5 0.42
}
Rock {
  translation 5.0 3.2 0
  rotation 0 0 1 -0.8
  scale 5
  type "flat"
  color 0.50 0.45 0.38
}
Rock {
  translation -1.2 13 0
  scale 12
  color 0.40 0.38 0.35
}
Rock {
  translation 6.5 11 0
  rotation 0 0 1 1.9
  scale 10
  type "flat"
  color 0.42 0.40 0.35
}

Robot {
  name "sun_controller"
  controller "sun_control"
  supervisor TRUE
  children [
  ]
}
