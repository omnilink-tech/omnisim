{
  "mcpServers": {
    "omnisim": {
      "command": "python",
      "args": [
        "-m",
        "omnisim_mcp"
      ],
      "cwd": ".",
      "enabled": true,
      "env": {
        "OMNISIM_HARNESS_URL": "http://127.0.0.1:6789",
        "PYTHONPATH": "packages/omnisim-mcp/src"
      },
      "startup_timeout_sec": 10,
      "tool_timeout_sec": 120
    }
  }
}
