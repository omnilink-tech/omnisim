#VRML_SIM R2025a utf8

EXTERNPROTO "omnisim://tests/parser/protos/ParserTestSupervisor.proto"
EXTERNPROTO "omnisim://tests/parser/protos/DerivedProtoUsingSameParameterName.proto"

WorldInfo {
  info [
    "Test procedure:"
    "- add Appearance node in unusedSlot > GPS > Shape > appearance field"
    " "
    "Regression test for issue 875"
  ]
}
Viewpoint {
  orientation -0.9993459205108881 0.03475439723559569 0.009993149205133538 0.560353
  position 0.163095 0.754028 0.969325
  near 0.001
}
Background {
  atmosphericSky "earth"
}
ParserTestSupervisor {
}
DEF SUN DirectionalLight {
  direction 0.2 -1 0.55
}
DEF SUN_MARKER Solid {
  translation 0 0 8
  name "sun_marker"
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 1.0 0.9 0.55
        emissiveColor 1.0 0.85 0.45
        emissiveIntensity 35
        roughness 1.0
        metalness 0.0
      }
      geometry Sphere {
        radius 0.9
        subdivision 3
      }
      castShadows FALSE
    }
  ]
}
Robot {
  name "sun_marker_driver"
  controller "sun_marker"
  supervisor TRUE
  children [
  ]
}
DerivedProtoUsingSameParameterName {
}
