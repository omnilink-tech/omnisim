#OMNISIM R2025a utf8

EXTERNPROTO "omnisim://tests/protos/protos/TemplateSlotContainer.proto"
EXTERNPROTO "omnisim://tests/protos/protos/NestedBoxShape.proto"
EXTERNPROTO "omnisim://tests/default/protos/TestSuiteEmitter.proto"
EXTERNPROTO "omnisim://tests/default/protos/TestSuiteSupervisor.proto"

WorldInfo {
  coordinateSystem "NUE"
}
Viewpoint {
  orientation 0.8475460211639829 -0.5290250132102281 0.04240610105891831 0.18862
  position -0.77536 -0.704351 3.16576
  near 0.001
}
Background {
  skyColor [
    1 1 1
  ]
  atmosphericSky "earth"
}
DEF SUN DirectionalLight {
  direction 0.2 -1 0.55
}
DEF SUN_MARKER Solid {
  translation 0 0 8
  name "sun_marker"
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 1.0 0.9 0.55
        emissiveColor 1.0 0.85 0.45
        emissiveIntensity 35
        roughness 1.0
        metalness 0.0
      }
      geometry Sphere {
        radius 0.9
        subdivision 3
      }
      castShadows FALSE
    }
  ]
}
Robot {
  name "sun_marker_driver"
  controller "sun_marker"
  supervisor TRUE
  children [
  ]
}
DEF TEST_PROTO TemplateSlotContainer {
  translation -1 -1 -1
  children [
    DEF TEST_PARAMETER NestedBoxShape {
    }
  ]
}
Robot {
  translation 0.45 0.45 0.6
  children [
    Camera {
      rotation -0.577353047596502 0.5773496460042129 0.577348113957118 2.0943983352517446
      fieldOfView 0.01
      width 1
      height 1
    }
    TestSuiteEmitter {
    }
  ]
  controller "proto_nested_parameter"
  controllerArgs [
    "proto_nested_parameter"
  ]
  supervisor TRUE
}
TestSuiteSupervisor {
}
