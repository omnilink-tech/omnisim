#VRML_SIM R2021b utf8

EXTERNPROTO "omnisim://projects/objects/floors/protos/Floor.proto"
EXTERNPROTO "omnisim://tests/default/protos/TestSuiteEmitter.proto"
EXTERNPROTO "omnisim://projects/objects/factory/containers/protos/WoodenBox.proto"
EXTERNPROTO "omnisim://tests/protos/protos/Bc21bCameraProto.proto"
EXTERNPROTO "omnisim://tests/default/protos/TestSuiteSupervisor.proto"

WorldInfo {
  title "Verifies the ENU/FLU backwards compatibility (introduced after R2021b)"
}
Viewpoint {
  orientation 0.3418802238517728 -0.5383484923353598 -0.7702589261665891 2.2317232844182784
  position -2.3127808353193133 1.0804206354552899 1.2165637916476852
}
Background {
  skyColor [ 0.15 0.20 0.30 ]
  atmosphericSky "earth"
}
DEF SUN DirectionalLight {
  color 1.0 0.95 0.85
  direction -0.5 -0.5 -0.3
  intensity 2.5
  castShadows TRUE
}
DEF SUN_MARKER Solid {
  translation 0 0 8
  name "sun_marker"
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 1.0 0.9 0.55
        emissiveColor 1.0 0.85 0.45
        emissiveIntensity 35
        roughness 1.0
        metalness 0.0
      }
      geometry Sphere {
        radius 0.9
        subdivision 3
      }
      castShadows FALSE
    }
  ]
}
Robot {
  name "sun_marker_driver"
  controller "sun_marker"
  supervisor TRUE
  children [
  ]
}
Floor {
  rotation 1 0 0 1.5707996938995747
}
Robot {
  children [
    TestSuiteEmitter {
    }
  ]
  controller "backward_compatibility_enu_flu"
  supervisor TRUE
}
WoodenBox {
  translation 0.58 0 0.1
  size 0.2 0.2 0.2
}
DEF ROBOT_NODE Robot {
  translation 0 0 0.13
  children [
    DEF OLD_PROTO Bc21bCameraProto {
    }
  ]
  name "user_robot"
}
TestSuiteSupervisor {
}
