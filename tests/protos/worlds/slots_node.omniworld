#OMNISIM R2025a utf8

EXTERNPROTO "omnisim://projects/objects/floors/protos/Floor.proto"
EXTERNPROTO "omnisim://tests/protos/protos/SlotNode.proto"
EXTERNPROTO "omnisim://tests/protos/protos/SlotNodeGendered.proto"
EXTERNPROTO "omnisim://tests/default/protos/TestSuiteEmitter.proto"
EXTERNPROTO "omnisim://tests/default/protos/TestSuiteSupervisor.proto"

WorldInfo {
  basicTimeStep 16
  coordinateSystem "NUE"
}
Viewpoint {
  orientation -0.05705428043499259 -0.9854906620563442 -0.15985294518335813 2.76296
  position -0.436058 0.533884 -1.0595
}
Background {
  skyColor [
    0.4 0.7 1
  ]
  atmosphericSky "earth"
}
DEF SUN DirectionalLight {
  ambientIntensity 1
  direction 0.2 -1 0.5
}
DEF SUN_MARKER Solid {
  translation 0 0 8
  name "sun_marker"
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 1.0 0.9 0.55
        emissiveColor 1.0 0.85 0.45
        emissiveIntensity 35
        roughness 1.0
        metalness 0.0
      }
      geometry Sphere {
        radius 0.9
        subdivision 3
      }
      castShadows FALSE
    }
  ]
}
Robot {
  name "sun_marker_driver"
  controller "sun_marker"
  supervisor TRUE
  children [
  ]
}
Floor {
  rotation 1 0 0 -1.5708
}
Robot {
  children [
    DEF ACC1 Slot {
      type "slot"
      endPoint SlotNode {
      }
    }
    DEF ACC2 Slot {
      type "slot-"
      endPoint SlotNodeGendered {
      }
    }
    DEF ACC3&4 Slot {
      endPoint Slot {
        type "any"
        endPoint Accelerometer {
          children [
            Accelerometer {
              name "acc4"
            }
          ]
          name "acc3"
        }
      }
    }
    DEF ACC5 Slot {
      endPoint Slot {
        endPoint Accelerometer {
          name "acc5"
        }
      }
    }
    DEF ACC6 Slot {
      type "type with spaces"
      endPoint Slot {
        type "type with spaces"
        endPoint Accelerometer {
          name "acc6"
        }
      }
    }
    DEF ACC7 Slot {
      type "slot+"
      endPoint Slot {
        type "slot+"
        endPoint Accelerometer {
          name "acc7"
        }
      }
    }
    DEF ACC8 Slot {
      type "slot"
      endPoint Slot {
        type "default"
        endPoint Accelerometer {
          name "acc8"
        }
      }
    }
    TestSuiteEmitter {
    }
  ]
  controller "slot_node"
}
TestSuiteSupervisor {
}
