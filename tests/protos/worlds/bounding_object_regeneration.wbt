#VRML_SIM R2025a utf8

EXTERNPROTO "omnisim://tests/default/protos/TestSuiteEmitter.proto"
EXTERNPROTO "omnisim://tests/protos/protos/RegenerableBoundingObjectBox.proto"
EXTERNPROTO "omnisim://tests/protos/protos/ProtoSolidWithBoundingObject.proto"
EXTERNPROTO "omnisim://tests/default/protos/TestSuiteSupervisor.proto"

WorldInfo {
  info [
    "Validates correct regeneration of a boundingObject."
  ]
  title "Test boundingObject regeneration"
  coordinateSystem "NUE"
  lineScale 1
}
Viewpoint {
  orientation -0.8576898584843424 0.46519382454732994 0.21900413753200396 1.003987095929511
  position 2.3196532359282633 4.968074565711988 4.556630326655434
}
Background {
  skyColor [
    0 0.811765 0.992157
  ]
  atmosphericSky "earth"
}
DEF SUN DirectionalLight {
  direction 0 0.5 -1
}
DEF SUN_MARKER Solid {
  translation 0 0 8
  name "sun_marker"
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 1.0 0.9 0.55
        emissiveColor 1.0 0.85 0.45
        emissiveIntensity 35
        roughness 1.0
        metalness 0.0
      }
      geometry Sphere {
        radius 0.9
        subdivision 3
      }
      castShadows FALSE
    }
  ]
}
Robot {
  name "sun_marker_driver"
  controller "sun_marker"
  supervisor TRUE
  children [
  ]
}
DEF ROBOT Robot {
  translation 0 0 2
  children [
    TestSuiteEmitter {
    }
  ]
  boundingObject DEF REGENERABLE_BOX_IN_ROBOT RegenerableBoundingObjectBox {
  }
  controller "bounding_object_regeneration"
  supervisor TRUE
}
ProtoSolidWithBoundingObject {
  boundingObject DEF REGENERABLE_BOX_IN_PROTO RegenerableBoundingObjectBox {
  }
}
DEF PROBE_ROBOT Solid {
  translation 1 0 2
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.180392 0.203922 0.211765
      }
      geometry DEF BOX Box {
        size 0.1 0.1 0.1
      }
    }
  ]
  boundingObject USE BOX
  physics Physics {
  }
}
DEF PROBE_PROTO Solid {
  translation 1 0 0
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.180392 0.203922 0.211765
      }
      geometry DEF BOX Box {
        size 0.1 0.1 0.1
      }
    }
  ]
  boundingObject USE BOX
  physics Physics {
  }
}
TestSuiteSupervisor {
}
