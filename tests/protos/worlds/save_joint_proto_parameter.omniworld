#OMNISIM R2025a utf8

EXTERNPROTO "omnisim://projects/objects/floors/protos/Floor.proto"
EXTERNPROTO "omnisim://tests/protos/protos/SlotifiedRobot.proto"
EXTERNPROTO "omnisim://tests/default/protos/TestSuiteEmitter.proto"
EXTERNPROTO "omnisim://tests/default/protos/TestSuiteSupervisor.proto"

WorldInfo {
  basicTimeStep 16
  coordinateSystem "NUE"
}
Viewpoint {
  orientation -0.08334733598826562 -0.9668174197677529 -0.24148974805834703 2.696656465490489
  position -0.9432232632081097 1.3717031825484522 -1.8631266884352105
}
Background {
  skyColor [
    0.4 0.7 1
  ]
  atmosphericSky "earth"
}
DEF SUN DirectionalLight {
  ambientIntensity 1
  direction 0.2 -1 0.5
}
DEF SUN_MARKER Solid {
  translation 0 0 8
  name "sun_marker"
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 1.0 0.9 0.55
        emissiveColor 1.0 0.85 0.45
        emissiveIntensity 35
        roughness 1.0
        metalness 0.0
      }
      geometry Sphere {
        radius 0.9
        subdivision 3
      }
      castShadows FALSE
    }
  ]
}
Robot {
  name "sun_marker_driver"
  controller "sun_marker"
  supervisor TRUE
  children [
  ]
}
Floor {
  rotation 1 0 0 -1.5708
}
SlotifiedRobot {
  controller "<generic>"
  slot [
    HingeJoint {
      jointParameters HingeJointParameters {
        position 1
      }
      endPoint DEF TARGET Solid {
        translation 0 0.270151 0.420735
        rotation 1 0 0 1
        children [
          Shape {
            geometry Sphere {
              radius 0.1
            }
          }
        ]
      }
    }
  ]
}
Robot {
  children [
    TestSuiteEmitter {
    }
  ]
  controller "save_joint_proto_parameter"
  customData "init"
  supervisor TRUE
}
TestSuiteSupervisor {
}
