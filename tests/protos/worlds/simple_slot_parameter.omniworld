#OMNISIM R2025a utf8

EXTERNPROTO "omnisim://tests/protos/protos/SimpleSlotParent.proto"
EXTERNPROTO "omnisim://tests/default/protos/TestSuiteEmitter.proto"
EXTERNPROTO "omnisim://tests/default/protos/TestSuiteSupervisor.proto"

WorldInfo {
  basicTimeStep 16
  lineScale 0.9
  coordinateSystem "NUE"
}
Viewpoint {
  orientation 0.013209806508037086 -0.9747254802151771 -0.22301510987220777 3.4817
  position 0.269593 0.23807 -0.613166
}
Background {
  skyColor [
    0.4 0.7 1
  ]
  atmosphericSky "earth"
}
DEF SUN DirectionalLight {
  ambientIntensity 1
  direction 0.2 -1 0.5
}
DEF SUN_MARKER Solid {
  translation 0 0 8
  name "sun_marker"
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 1.0 0.9 0.55
        emissiveColor 1.0 0.85 0.45
        emissiveIntensity 35
        roughness 1.0
        metalness 0.0
      }
      geometry Sphere {
        radius 0.9
        subdivision 3
      }
      castShadows FALSE
    }
  ]
}
Robot {
  name "sun_marker_driver"
  controller "sun_marker"
  supervisor TRUE
  children [
  ]
}
SimpleSlotParent {
  endPoint Slot {
    endPoint Shape {
      geometry Box {
        size 0.1 0.1 0.1
      }
    }
  }
}
DEF TEST Robot {
  translation 0.1 0 0
  children [
    DistanceSensor {
      rotation 0 1 0 3.14159
      type "infra-red"
    }
    TestSuiteEmitter {
    }
  ]
  controller "single_distance_sensor_detection"
  controllerArgs [
    "simple_slot_parameter"
  ]
}
TestSuiteSupervisor {
}
