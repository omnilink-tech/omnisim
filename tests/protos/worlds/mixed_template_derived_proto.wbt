#VRML_SIM R2025a utf8

EXTERNPROTO "omnisim://tests/protos/protos/DerivedTemplateBoxShape.proto"
EXTERNPROTO "omnisim://tests/default/protos/TestSuiteEmitter.proto"
EXTERNPROTO "omnisim://tests/default/protos/TestSuiteSupervisor.proto"

WorldInfo {
  coordinateSystem "NUE"
}
Viewpoint {
  orientation -0.9992718787813574 -0.03682169553327173 -0.009993748787688626 0.530375
  position 0.24064 0.93072 1.35507
  near 0.001
}
Background {
  skyColor [
    1 1 1
  ]
  atmosphericSky "earth"
}
DEF SUN DirectionalLight {
  direction 0.2 -1 0.55
}
DEF SUN_MARKER Solid {
  translation 0 0 8
  name "sun_marker"
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 1.0 0.9 0.55
        emissiveColor 1.0 0.85 0.45
        emissiveIntensity 35
        roughness 1.0
        metalness 0.0
      }
      geometry Sphere {
        radius 0.9
        subdivision 3
      }
      castShadows FALSE
    }
  ]
}
Robot {
  name "sun_marker_driver"
  controller "sun_marker"
  supervisor TRUE
  children [
  ]
}
DEF TEST_PROTO DerivedTemplateBoxShape {
}
Robot {
  children [
    Camera {
      translation 0.2 0 0.15
      rotation -0.577353047596502 0.5773496460042129 0.577348113957118 2.0943983352517446
      name "cameraX"
      fieldOfView 0.01
      width 1
      height 1
    }
    Camera {
      translation 0 0.2 0.15
      rotation -0.577353047596502 0.5773496460042129 0.577348113957118 2.0943983352517446
      name "cameraY"
      fieldOfView 0.01
      width 1
      height 1
    }
    TestSuiteEmitter {
    }
  ]
  controller "mixed_template_derived_proto"
  controllerArgs [
    "mixed_template_derived_proto"
  ]
  supervisor TRUE
}
TestSuiteSupervisor {
}
