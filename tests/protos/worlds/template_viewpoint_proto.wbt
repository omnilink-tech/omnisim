#VRML_SIM R2025a utf8

EXTERNPROTO "omnisim://tests/protos/protos/TemplateViewpoint.proto"
EXTERNPROTO "omnisim://tests/default/protos/TestSuiteEmitter.proto"
EXTERNPROTO "omnisim://tests/default/protos/TestSuiteSupervisor.proto"

WorldInfo {
  coordinateSystem "NUE"
}
DEF VIEWPOINT TemplateViewpoint {
  position 0 0 3
  follow "solid"
  followSmoothness 0
}
Background {
  skyColor [
    0.12549 0.619608 1
  ]
  atmosphericSky "earth"
}
DEF SUN DirectionalLight {
  direction 0.2 -1 0.55
}
DEF SUN_MARKER Solid {
  translation 0 0 8
  name "sun_marker"
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 1.0 0.9 0.55
        emissiveColor 1.0 0.85 0.45
        emissiveIntensity 35
        roughness 1.0
        metalness 0.0
      }
      geometry Sphere {
        radius 0.9
        subdivision 3
      }
      castShadows FALSE
    }
  ]
}
Robot {
  name "sun_marker_driver"
  controller "sun_marker"
  supervisor TRUE
  children [
  ]
}
DEF SOLID Solid {
  children [
    DEF SHAPE Shape {
      appearance Appearance {
        material Material {
          diffuseColor 1 0 0
        }
      }
      geometry Sphere {
        radius 0.1
      }
    }
  ]
  boundingObject USE SHAPE
  physics Physics {
  }
}
Robot {
  children [
    TestSuiteEmitter {
    }
  ]
  controller "template_viewpoint_proto"
  controllerArgs [
    "template_viewpoint_proto"
  ]
  supervisor TRUE
}
TestSuiteSupervisor {
}
