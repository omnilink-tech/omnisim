#OMNISIM R2025a utf8

EXTERNPROTO "omnisim://tests/default/protos/TestSuiteEmitter.proto"
EXTERNPROTO "omnisim://tests/default/protos/TestSuiteSupervisor.proto"

WorldInfo {
  lineScale 0.4
  coordinateSystem "NUE"
}
Viewpoint {
  orientation -0.1653220498832909 0.9517682871808957 0.25846807798861876 1.84265
  position 2.0274 1.30972 -0.445536
}
Background {
  skyColor [
    0.4 0.7 1
  ]
  atmosphericSky "earth"
}
DEF SUN DirectionalLight {
  ambientIntensity 1
  direction -0.33 -1 -0.5
  castShadows TRUE
}
DEF SUN_MARKER Solid {
  translation 0 0 8
  name "sun_marker"
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 1.0 0.9 0.55
        emissiveColor 1.0 0.85 0.45
        emissiveIntensity 35
        roughness 1.0
        metalness 0.0
      }
      geometry Sphere {
        radius 0.9
        subdivision 3
      }
      castShadows FALSE
    }
  ]
}
Robot {
  name "sun_marker_driver"
  controller "sun_marker"
  supervisor TRUE
  children [
  ]
}
Robot {
  children [
    DEF BASE_BOX Shape {
      geometry Box {
        size 0.2 0.5 0.2
      }
    }
    HingeJoint {
      jointParameters HingeJointParameters {
        axis -1 0 0
        anchor 0 0.25 -0.1
      }
      device [
        PositionSensor {
          name "position sensor 1"
        }
      ]
      endPoint Solid {
        translation 0 0.25 -0.3
        rotation -1 0 0 0
        children [
          DEF BOX_SHAPE Shape {
            geometry Box {
              size 0.1 0.1 0.5
            }
          }
        ]
        boundingObject USE BOX_SHAPE
        physics Physics {
        }
      }
    }
    HingeJoint {
      jointParameters HingeJointParameters {
        axis 0 0 1
        anchor -0.1 0.25 0
      }
      device [
        PositionSensor {
          name "position sensor 2"
        }
        Brake {
          name "brake 1"
        }
      ]
      endPoint Solid {
        translation -0.3 0.25 0
        rotation 0 1 0 1.5708
        children [
          USE BOX_SHAPE
        ]
        name "solid(1)"
        boundingObject USE BOX_SHAPE
        physics Physics {
        }
      }
    }
    HingeJoint {
      jointParameters HingeJointParameters {
        anchor 0 0.25 0.1
      }
      device [
        Brake {
          name "brake 2"
        }
        PositionSensor {
          name "position sensor 3"
        }
      ]
      endPoint Solid {
        translation 0 0.25 0.3
        rotation 1 0 0 0
        children [
          USE BOX_SHAPE
        ]
        name "solid(2)"
        boundingObject USE BOX_SHAPE
        physics Physics {
        }
      }
    }
    HingeJoint {
      jointParameters HingeJointParameters {
        axis 0 0 -1
        anchor 0.1 0.25 0
      }
      device [
        Brake {
          name "brake 3"
        }
        PositionSensor {
          name "position sensor 4"
        }
      ]
      endPoint Solid {
        translation 0.3 0.25 0
        rotation 0 1 0 1.5708
        children [
          USE BOX_SHAPE
        ]
        name "solid(3)"
        boundingObject USE BOX_SHAPE
        physics Physics {
        }
      }
    }
    TestSuiteEmitter {
    }
  ]
  boundingObject USE BASE_BOX
  controller "brake"
}
TestSuiteSupervisor {
}
