#OMNISIM R2025a utf8

EXTERNPROTO "omnisim://tests/default/protos/TestSuiteEmitter.proto"
EXTERNPROTO "omnisim://tests/default/protos/TestSuiteSupervisor.proto"

WorldInfo {
  info [
    "Description: example of fully asymetric friction contact"
  ]
  contactProperties [
    ContactProperties {
      coulombFriction [
        0.01 0.23
      ]
      frictionRotation 0.1 0
    }
  ]
  coordinateSystem "NUE"
  # translation_audit: ContactProperties.coulombFriction is an ODE-path field the
  # Newton backend does not read; this declares the same friction where it is read.
  newtonGroundMu 0.01
}
Viewpoint {
  orientation 0.14769592763935188 -0.9311375438078949 -0.33341983664765945 4.07756
  position 4.15362 2.76824 -3.60275
}
Background {
  skyColor [
    0.4 0.7 1
  ]
  atmosphericSky "earth"
}
DEF SUN DirectionalLight {
  ambientIntensity 1
  direction -0.33 -1 -0.5
  castShadows TRUE
}
DEF SUN_MARKER Solid {
  translation 0 0 8
  name "sun_marker"
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 1.0 0.9 0.55
        emissiveColor 1.0 0.85 0.45
        emissiveIntensity 35
        roughness 1.0
        metalness 0.0
      }
      geometry Sphere {
        radius 0.9
        subdivision 3
      }
      castShadows FALSE
    }
  ]
}
Robot {
  name "sun_marker_driver"
  controller "sun_marker"
  supervisor TRUE
  children [
  ]
}
DEF BOX1 Solid {
  translation 0.121931 -0.9 1.17269
  rotation -0.8570712869942254 0.38584912920333886 0.3413931143170397 1.86553
  children [
    Shape {
      geometry DEF BOX Box {
        size 0.3 0.3 0.3
      }
    }
  ]
  boundingObject USE BOX
  physics Physics {
  }
}
DEF BOX2 Solid {
  translation -0.8 -0.9 0.7
  rotation -0.27484395543776663 0.7249438824601457 0.6315988975947736 2.68309
  children [
    Shape {
      geometry DEF BOX Box {
        size 0.3 0.3 0.3
      }
    }
  ]
  name "solid(2)"
  boundingObject USE BOX
  physics Physics {
  }
}
DEF PLANE Solid {
  translation 0 -1.16 0
  rotation -0.7931261333066688 0.45791307696489164 0.40158006749657943 1.92612
  children [
    DEF PLANE Pose {
      children [
        Shape {
          geometry Plane {
            size 4 4
          }
        }
      ]
    }
  ]
  name "solid(3)"
  boundingObject USE PLANE
}
Robot {
  children [
    TestSuiteEmitter {
    }
  ]
  controller "asymmetric_friction"
  supervisor TRUE
}
TestSuiteSupervisor {
}
