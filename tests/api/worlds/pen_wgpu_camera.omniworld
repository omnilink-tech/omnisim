#OMNISIM R2025a utf8

# W3/P3 (WREN retirement): the Pen paint layer must be READABLE FROM A wgpu CAMERA IMAGE.
#
# WHY THIS IS A SEPARATE WORLD FROM pen.omniworld. `pen` pins ABSOLUTE colours at +-2 against
# WREN's shading of a Material{ambientIntensity 1} board lit by a PointLight{intensity 0}; the
# wgpu sensor path has no equivalent ambient model, so that world reads (85,141,187) where WREN
# reads (207,207,207) with NO pen involved at all. Pinning absolute colours here would therefore
# test the ambient model, not the pen. This world asserts the DIFFERENCE the ink makes -- which is
# exactly the P3 gate, and is renderer-shading-independent.
#
# The Camera pins renderBackend "wgpu" so the assertion holds whichever way Camera.wrl's default
# points. A build or host without wgpu-native falls back to WREN, where the pen also paints, so
# the test still PASSES there -- it simply stops being evidence about wgpu.

EXTERNPROTO "omnisim://tests/default/protos/TestSuiteEmitter.proto"
EXTERNPROTO "omnisim://tests/default/protos/TestSuiteSupervisor.proto"

WorldInfo {
  coordinateSystem "NUE"
}
Viewpoint {
  orientation -0.0337312933381785 -0.9992628026488236 -0.018331696379549164 1.52813
  position -0.480663 0.147115 0.0135119
}
Background {
  skyColor [
    0.4 0.7 1
  ]
  atmosphericSky "earth"
}
DEF FLOOR Solid {
  children [
    Pose {
      rotation 1 0 0 -1.57079632679
      children [
        Shape {
          geometry Plane {
          }
        }
      ]
    }
  ]
  locked TRUE
}
DEF BOARD Solid {
  translation 0 0.005 0
  rotation 1 0 0 0
  children [
    Pose {
      rotation 1 0 0 -1.57079632679
      children [
        Shape {
          appearance Appearance {
            material Material {
              ambientIntensity 1
              diffuseColor 1 1 1
              specularColor 0.74902 0.74902 0.74902
            }
            texture ImageTexture {
              url [
                "textures/white256.png"
              ]
            }
          }
          geometry Plane {
            size 0.15 0.3
          }
        }
      ]
    }
  ]
  locked TRUE
}
DEF ROBOT Robot {
  translation 0 0.09 0
  children [
    DEF BODY Shape {
      geometry Box {
        size 0.1 0.02 0.2
      }
    }
    DEF PEN0 Pen {
      translation 0 -0.02 0.08
      rotation 1 0 0 -1.57
      name "pen0"
      inkColor 1 0 0
      inkDensity 1
      leadSize 0.04
    }
    DEF CAM0 Camera {
      translation 0 -0.008 0.08
      rotation 0.7071057811840316 -0.7071077811834126 0 3.14159
      children [
        Pose {
          rotation 1 0 0 -1.57079632679
          children [
            Shape {
              geometry Cylinder {
                height 0.01
                radius 0.01
              }
            }
          ]
        }
      ]
      name "camera0"
      fieldOfView 0.35
      renderBackend "wgpu"
    }
    TestSuiteEmitter {
    }
  ]
  controller "pen_wgpu_camera"
}
TestSuiteSupervisor {
}
