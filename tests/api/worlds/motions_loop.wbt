#VRML_SIM R2025a utf8

EXTERNPROTO "omnisim://projects/objects/floors/protos/Floor.proto"
EXTERNPROTO "omnisim://tests/api/protos/Hexapod.proto"
EXTERNPROTO "omnisim://tests/default/protos/TestSuiteSupervisor.proto"

WorldInfo {
  basicTimeStep 40
  coordinateSystem "NUE"
}
Viewpoint {
  orientation 0.09381280484314058 0.9772880504530638 0.19001900980984185 3.79301
  position -0.688942 0.522118 -0.823828
}
Background {
  skyColor [
    0.4 0.7 1
  ]
  atmosphericSky "earth"
}
DEF SUN DirectionalLight {
  ambientIntensity 1
  direction 0.2 -1 0.55
}
DEF SUN_MARKER Solid {
  translation 0 0 8
  name "sun_marker"
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 1.0 0.9 0.55
        emissiveColor 1.0 0.85 0.45
        emissiveIntensity 35
        roughness 1.0
        metalness 0.0
      }
      geometry Sphere {
        radius 0.9
        subdivision 3
      }
      castShadows FALSE
    }
  ]
}
Robot {
  name "sun_marker_driver"
  controller "sun_marker"
  supervisor TRUE
  children [
  ]
}
Floor {
  rotation 1 0 0 -1.57079632679
  size 20 20
  tileSize 2 2
}
DEF HEXAPOD Hexapod {
  controller "motion"
  controllerArgs [
    "loop"
  ]
}
TestSuiteSupervisor {
}
