#OMNISIM R2025a utf8

EXTERNPROTO "omnisim://tests/default/protos/TestSuiteSupervisor.proto"
EXTERNPROTO "omnisim://projects/objects/mirror/protos/Mirror.proto"
EXTERNPROTO "omnisim://tests/default/protos/TestSuiteEmitter.proto"

WorldInfo {
  coordinateSystem "NUE"
}
Viewpoint {
  orientation 0 0 1 0
  position -0.06790763702491784 -1.463755315382977 1.0217679711005074
}
Background {
  skyColor [
    0.788235294117647 0.788235294117647 0.788235294117647
  ]
  atmosphericSky "earth"
}
DEF SUN DirectionalLight {
  ambientIntensity 1
  direction 0 -0.5 -1
}
DEF SUN_MARKER Solid {
  translation 0 0 8
  name "sun_marker"
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 1.0 0.9 0.55
        emissiveColor 1.0 0.85 0.45
        emissiveIntensity 35
        roughness 1.0
        metalness 0.0
      }
      geometry Sphere {
        radius 0.9
        subdivision 3
      }
      castShadows FALSE
    }
  ]
}
Robot {
  name "sun_marker_driver"
  controller "sun_marker"
  supervisor TRUE
  children [
  ]
}
DirectionalLight {
  ambientIntensity 1
  direction 0 -0.5 1
}
TestSuiteSupervisor {
}
Transform {
  translation 0 -4 -4.51
  children [
    Shape {
      appearance Appearance {
        material Material {
          diffuseColor 0 1 0
        }
        texture ImageTexture {
        }
      }
      geometry Plane {
        size 20 20
      }
    }
  ]
}
Mirror {
  translation 0 -2.01 -0.79
}
Robot {
  translation 0 -2.17 1.43
  children [
    DEF ROBOT_CAMERA Camera {
      translation 0 0.47 -1.61
      rotation -0.577353047596502 0.5773496460042129 0.577348113957118 2.0943983352517446
    }
    Pose {
      rotation 1 0 0 -1.57
      children [
        Shape {
          appearance Appearance {
            material Material {
            }
            texture ImageTexture {
              url [
                "textures/transparent.png"
              ]
            }
          }
          geometry Box {
            size 8 0.1 8
          }
        }
      ]
    }
    TestSuiteEmitter {
    }
  ]
  name "mirror supervisor"
  controller "mirror_supervisor"
  supervisor TRUE
}
