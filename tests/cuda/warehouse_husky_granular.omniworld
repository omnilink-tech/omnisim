#OMNISIM R2025a utf8

# Husky + granular sphere field combined demo.

#

# Reuses the warehouse Husky's husky_random controller (random-walk fallback

# mode — no customData payload, so the controller drives a stuck-detect

# random walk inside whatever bounds exist). Drops 1000 GPU-managed spheres

# into the arena and exercises full two-way coupling between the robot's

# rigid body and the granular field via dBodyAddForceAtPos.

#

# What you SHOULD see: 1000 spheres fall and pile, Husky drives, particles

# get pushed by each link's bounding sphere as the Husky rolls over them,

# and the Husky in turn slows / drifts / stalls when ploughing into the

# pile (reaction force scales with the GranularGroup's mass field).



EXTERNPROTO "omnisim://projects/objects/floors/protos/RectangleArena.proto"

EXTERNPROTO "omnisim://projects/appearances/protos/Asphalt.proto"



WorldInfo {

  basicTimeStep 16

  title "Husky + GranularGroup (two-way coupling)"

}

Viewpoint {

  # Top-down camera matching warehouse_husky.omniworld and husky_maze.omniworld's

  # orientation; height scaled for our 8 m × 8 m arena (those use 30+ m

  # arenas at z=50, so ~50 × 8/32 ≈ 12.5 to keep the floor framed

  # similarly).

  orientation -0.5773 0.5773 0.5773 2.0944

  position 0 0 13

}

Background {

  skyColor [ 0.02 0.03 0.06 ]

  atmosphericSky "earth"

}

DEF SUN DirectionalLight {

  ambientIntensity 0.5

  direction 0.4 -0.6 1.1

  intensity 2.0

  color 0.95 0.96 1.0

  castShadows TRUE

}

DEF SUN_MARKER Solid {
  translation 0 0 8
  name "sun_marker"
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 1.0 0.9 0.55
        emissiveColor 1.0 0.85 0.45
        emissiveIntensity 35
        roughness 1.0
        metalness 0.0
      }
      geometry Sphere {
        radius 0.9
        subdivision 3
      }
      castShadows FALSE
    }
  ]
}
Robot {
  name "sun_marker_driver"
  controller "sun_marker"
  supervisor TRUE
  children [
  ]
}
RectangleArena {

  floorSize 8 8

  wallHeight 0.4

  floorAppearance Asphalt {

    colorOverride 0.55 0.57 0.60

  }

}

URDFRobot {

  url "../../projects/robots/clearpath/husky_description/urdf/husky.urdf"

  translation -3 -3 0.1

  name "husky"

  controller "husky_random"

  supervisor TRUE

  # The husky_random controller reads customData as JSON and uses

  # world_centre + world_size + boundary_margin for its boundary-repulsion

  # steering. Without this it falls back to defaults (80m world at

  # (40,40)) and happily drives off the floor, so we have to tell it

  # explicitly that this arena is 8m wide centred at the origin.

  customData "{\"world_centre\":[0,0],\"world_size\":8.0,\"boundary_margin\":1.0}"

}

GranularGroup {

  radius 0.05

  count 1000

  boundsHalfWidth 4.0

  mass 0.5

  # 500 g per ball, 1000 balls = 500 kg total. With two-way coupling on,

  # the Husky's wheels + chassis push particles AND the particles push

  # back via dBodyAddForceAtPos. Bigger mass = more reverse impulse =

  # robot slows down or stalls when ploughing into the pile.

}

