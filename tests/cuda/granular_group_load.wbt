#VRML_SIM R2025a utf8
# M2 skeleton load test for the GranularGroup PROTO.
#
# Goal: prove the node parses, instantiates, and lives in the scene tree on
# both CUDA-on and CUDA-off builds. No physics or rendering is wired in this
# slice, so the world is intentionally barebones — a floor, a viewpoint, and
# the GranularGroup itself sitting near the origin. Loaded by
# tests/cuda/test_granular_group_load.py via the existing headless runner.
#
# Background uses NightSky + DirectionalLight per the project default.

EXTERNPROTO "omnisim://projects/objects/floors/protos/RectangleArena.proto"

WorldInfo {
  basicTimeStep 16
  title "GranularGroup M2 load test"
}
Viewpoint {
  orientation -0.3 -0.05 0.95 0.5
  position -1.5 -2.0 1.2
}
Background {
  skyColor [ 0.02 0.03 0.06 ]
  atmosphericSky "earth"
}
DEF SUN DirectionalLight {
  ambientIntensity 0.4
  direction 0.5 -1 0.6
  intensity 1.5
  castShadows TRUE
}
DEF SUN_MARKER Solid {
  translation 0 0 8
  name "sun_marker"
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 1.0 0.9 0.55
        emissiveColor 1.0 0.85 0.45
        emissiveIntensity 35
        roughness 1.0
        metalness 0.0
      }
      geometry Sphere {
        radius 0.9
        subdivision 3
      }
      castShadows FALSE
    }
  ]
}
Robot {
  name "sun_marker_driver"
  controller "sun_marker"
  supervisor TRUE
  children [
  ]
}
RectangleArena {
  floorSize 2 2
  wallHeight 0.05
}
GranularGroup {
  radius 0.02
  count 250
}
