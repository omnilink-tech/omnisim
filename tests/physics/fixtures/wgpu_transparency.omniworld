#OMNISIM R2025a utf8

# Test fixture for wgpu transparency (pre-flip worklist gap: "no transparency").
# A red box and a green sphere sit BEHIND two panes: a PBRAppearance glass pane
# (transparency 0.65) and a plain-Appearance/Material pane (transparency 0.5, the
# URDF-robot material path). Correct output: both occluded objects visibly show
# THROUGH their pane, tinted by it; the panes cast no shadow; an opaque control
# box confirms opaque rendering is untouched. Static (no physics) so a self-check
# or a MAINVIEW_DUMP frame samples it directly.

WorldInfo {
  basicTimeStep 16
  FPS 30
}
Viewpoint {
  orientation 0 0.39 0.921 1.5708
  position 0 -2.6 1.3
}
Background {
  skyColor [ 0.15 0.20 0.30 ]
  atmosphericSky "earth"
}
DEF SUN DirectionalLight {
  color 1.0 0.97 0.92
  direction -0.55 -0.5 -0.65
  intensity 3.5
  castShadows TRUE
}
DEF FLOOR Solid {
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.45 0.45 0.48
        roughness 1.0
        metalness 0.0
      }
      geometry Box { size 4 4 0.02 }
    }
  ]
  name "floor"
}
# ---- pair 1: PBR glass pane in front of a red box ----
DEF RED_BOX Solid {
  translation 0 0.35 0.15
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.85 0.1 0.1
        roughness 0.8
        metalness 0.0
      }
      geometry Box { size 0.2 0.2 0.28 }
    }
  ]
  name "red box"
}
DEF GLASS_PBR Solid {
  translation 0 -0.1 0.25
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.55 0.75 0.9
        transparency 0.65
        roughness 0.15
        metalness 0.0
      }
      geometry Box { size 0.7 0.02 0.5 }
    }
  ]
  name "pbr glass pane"
}
# ---- pair 2: plain-Appearance Material pane in front of a green sphere ----
DEF GREEN_SPHERE Solid {
  translation 1.0 0.35 0.18
  children [
    Shape {
      appearance Appearance {
        material Material { diffuseColor 0.1 0.75 0.15 }
      }
      geometry Sphere { radius 0.14 subdivision 3 }
    }
  ]
  name "green sphere"
}
DEF PANE_MATERIAL Solid {
  translation 1.0 -0.1 0.25
  children [
    Shape {
      appearance Appearance {
        material Material {
          diffuseColor 0.9 0.85 0.4
          transparency 0.5
        }
      }
      geometry Box { size 0.7 0.02 0.5 }
    }
  ]
  name "material pane"
}
# ---- opaque control: must render exactly as before transparency support ----
DEF OPAQUE_CONTROL Solid {
  translation -1.0 0.1 0.15
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.2 0.3 0.8
        roughness 0.5
        metalness 0.0
      }
      geometry Box { size 0.25 0.25 0.28 }
    }
  ]
  name "opaque control"
}
