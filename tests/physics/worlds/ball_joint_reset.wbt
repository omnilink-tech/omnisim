#VRML_SIM R2025a utf8

EXTERNPROTO "omnisim://tests/default/protos/TestSuiteEmitter.proto"
EXTERNPROTO "omnisim://tests/default/protos/TestSuiteSupervisor.proto"

WorldInfo {
  coordinateSystem "NUE"
  lineScale 0.4
}
Viewpoint {
  orientation -0.17893748710767574 -0.9740180887954226 -0.1388169240651244 1.5294095694295469
  position -0.7633347051256945 0.24038376817935225 0.1030482734348383
}
Background {
  skyColor [ 0.15 0.20 0.30 ]
  atmosphericSky "earth"
}
DEF SUN DirectionalLight {
  color 1.0 0.95 0.85
  direction -0.5 -0.5 -0.3
  intensity 2.5
  castShadows TRUE
}
DEF SUN_MARKER Solid {
  translation 0 0 8
  name "sun_marker"
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 1.0 0.9 0.55
        emissiveColor 1.0 0.85 0.45
        emissiveIntensity 35
        roughness 1.0
        metalness 0.0
      }
      geometry Sphere {
        radius 0.9
        subdivision 3
      }
      castShadows FALSE
    }
  ]
}
Robot {
  name "sun_marker_driver"
  controller "sun_marker"
  supervisor TRUE
  children [
  ]
}
DEF BALL_JOINT_ROBOT Robot {
  children [
    BallJoint {
      jointParameters BallJointParameters {
        position 1
      }
      jointParameters2 JointParameters {
        position 2
      }
      jointParameters3 JointParameters {
        position 1
        axis 1 0 0
      }
      endPoint DEF SOLID_ENDPOINT Solid {
        rotation 0.06288823946284747 0.9406150471981956 -0.333599164150032 2.611508937346137
        children [
          Shape {
            appearance PBRAppearance {
            }
            geometry Box {
              size 0.1 0.1 0.1
            }
          }
        ]
      }
    }
  ]
  name "robot"
}
DEF SUPERVISOR Robot {
  children [
    TestSuiteEmitter {
    }
  ]
  controller "ball_joint_reset"
  name "supervisor"
  supervisor TRUE
}
TestSuiteSupervisor {
}
