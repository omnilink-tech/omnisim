#OMNISIM R2025a utf8

# Newton ball-joint (3-DoF spherical) verification fixture (newton-ode-replacement-plan.md W2.2).
#
# A light bob (PENDULUM) hangs off a heavy, floor-resting post (BASE) through a PASSIVE BallJoint and
# swings down under gravity. BASE + PENDULUM are both dynamic, so both get Newton bodies and the ball
# joint registers (no static-base subtlety). The point of the test:
#
#   Run ONE Newton run with OMNISIM_PROBE_TRAJ_ALL (so the nested PENDULUM is dumped, not just the
#   BASE root) and check the PENDULUM's path: a CONSTRAINED bob SWINGS -- it stays at the joint
#   radius from the anchor and gains horizontal displacement -- while a bob whose ball joint failed
#   to register is a free body and free-falls STRAIGHT DOWN, |dx|,|dy| ~ 0. The two outcomes differ
#   by the pendulum length, so this is a large, unmistakable verdict.
#   (Newton run uses STATICS=1 + SUBSTEPS=4, the floor-contact config.)
#
# ⚠️ THE SECOND ARM IS GONE, AND THE FIXTURE SURVIVES IT (2026-08-08). This used to say "run the
# SAME world twice -- forced-ODE (OMNISIM_FORCE_ODE=1) and Newton default -- and diff PENDULUM",
# using ODE's known-good ball joint as the oracle. src/ode was DELETED (commit bdc02139), so that
# arm cannot exist. Do not try to revive it: the engine now IGNORES OMNISIM_FORCE_ODE (verified
# 2026-08-08 -- the run comes up on Newton and writes a normal .newton.json sidecar), so the
# "reference" arm would just be a second Newton run and the diff would read ~0, i.e. a silent
# false "the ball joint matches the oracle". The fixture is KEPT rather than deleted because its
# discriminator was never actually comparative: swing-vs-free-fall is an ABSOLUTE property of one
# trajectory. What is lost is only the convenience of an exact reference curve to diff against;
# what remains is the pass/fail this test was built for.

WorldInfo {
  basicTimeStep 4
  FPS 30
}
Viewpoint {
  orientation 0 0 -1 3.141592653589793
  position -3 -3 1.5
}
Background {
  skyColor [ 0.15 0.20 0.30 ]
}
DEF SUN DirectionalLight {
  color 1.0 0.95 0.85
  direction -0.5 -0.5 -0.6
  intensity 2.5
}
DEF FLOOR Solid {
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.5 0.5 0.5
        roughness 1.0
        metalness 0.0
      }
      geometry Box {
        size 4 4 0.1
      }
    }
  ]
  name "floor"
  boundingObject Box {
    size 4 4 0.1
  }
}
DEF BASE Solid {
  translation 0 0 0.55
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.35 0.35 0.40
      }
      geometry Box {
        size 0.3 0.3 1.0
      }
    }
    DEF BALL BallJoint {
      jointParameters BallJointParameters {
        anchor 0 0 0.45
      }
      endPoint DEF PENDULUM Solid {
        translation 0.5 0 0.45
        children [
          Shape {
            appearance PBRAppearance {
              baseColor 0.85 0.30 0.25
            }
            geometry Box {
              size 0.15 0.15 0.15
            }
          }
        ]
        name "pendulum"
        boundingObject Box {
          size 0.15 0.15 0.15
        }
        physics Physics {
          density -1
          mass 1.0
        }
      }
    }
  ]
  name "base"
  boundingObject Box {
    size 0.3 0.3 1.0
  }
  physics Physics {
    density -1
    mass 50.0
  }
}
DEF ORACLE_DUMPER Robot {
  name "oracle_dumper"
  controller "oracle_dumper"
  supervisor TRUE
  children [
  ]
}
