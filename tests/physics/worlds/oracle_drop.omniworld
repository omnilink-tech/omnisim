#OMNISIM R2025a utf8

# Physics oracle world (default-flip-plan.md §3.3). Three staggered free boxes fall onto a floor.
#
# ⚠️ THIS WORLD LOST ITS ORACLE (2026-08-08). It used to be run twice by
# scripts/dev/physics_oracle.py -- OMNISIM_LEGACY=1 for the ODE reference vs the migration default
# for Newton -- and the two contact-resolution trajectories diffed, since contact is exactly where
# the two backends differed. src/ode was DELETED (commit bdc02139), so the reference arm cannot
# exist and physics_oracle.py refuses rather than pretending -- deliberately, because the engine now
# IGNORES OMNISIM_LEGACY (verified 2026-08-08: the run comes up on Newton and writes a normal
# .newton.json sidecar). A revived "reference" arm would be a second Newton run, diff to ~0, and
# report a false agreement.
#
# What the world is still good for is the ABSOLUTE part: three boxes in free fall have an analytic
# answer (z = z0 - g t^2/2 until contact) and must come to rest ON the floor rather than through it.
# That needs no second backend. All shapes are boxes (a Newton-supported primitive), so the bodies
# genuinely run on Newton.

WorldInfo {
  basicTimeStep 4
  FPS 30
}
Viewpoint {
  orientation 0 0 -1 3.141592653589793
  position -3.5 -3.5 1.2
}
Background {
  skyColor [ 0.15 0.20 0.30 ]
  atmosphericSky "earth"
}
DEF SUN DirectionalLight {
  color 1.0 0.95 0.85
  direction -0.5 -0.5 -0.6
  intensity 2.5
  castShadows TRUE
}
DEF FLOOR Solid {
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.5 0.5 0.5
        roughness 1.0
        metalness 0.0
      }
      geometry Box {
        size 4 4 0.1
      }
    }
  ]
  name "floor"
  boundingObject Box {
    size 4 4 0.1
  }
}
DEF FALLER1 Solid {
  translation -0.4 0 0.9
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.85 0.30 0.25
      }
      geometry Box {
        size 0.2 0.2 0.2
      }
    }
  ]
  name "faller1"
  boundingObject Box {
    size 0.2 0.2 0.2
  }
  physics Physics {
    density -1
    mass 1.0
  }
}
DEF FALLER2 Solid {
  translation 0 0 1.2
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.30 0.65 0.85
      }
      geometry Box {
        size 0.2 0.2 0.2
      }
    }
  ]
  name "faller2"
  boundingObject Box {
    size 0.2 0.2 0.2
  }
  physics Physics {
    density -1
    mass 1.0
  }
}
DEF FALLER3 Solid {
  translation 0.4 0 1.5
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.40 0.80 0.40
      }
      geometry Box {
        size 0.2 0.2 0.2
      }
    }
  ]
  name "faller3"
  boundingObject Box {
    size 0.2 0.2 0.2
  }
  physics Physics {
    density -1
    mass 1.0
  }
}
DEF ORACLE_DUMPER Robot {
  name "oracle_dumper"
  controller "oracle_dumper"
  supervisor TRUE
  children [
  ]
}
