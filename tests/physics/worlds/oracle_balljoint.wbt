#VRML_SIM R2025a utf8

# Newton ball-joint (3-DoF spherical) verification fixture (newton-ode-replacement-plan.md W2.2).
#
# A light bob (PENDULUM) hangs off a heavy, floor-resting post (BASE) through a PASSIVE BallJoint and
# swings down under gravity. BASE + PENDULUM are both dynamic, so both get Newton bodies and the ball
# joint registers (no static-base subtlety). The point of the test:
#
#   Run the SAME world twice -- forced-ODE (OMNISIM_FORCE_ODE=1) and Newton default -- with
#   OMNISIM_PROBE_TRAJ_ALL (so the nested PENDULUM is dumped, not just the BASE root) and diff PENDULUM.
#   ODE always has a ball joint, so ODE's bob SWINGS (constrained to the joint radius). If Newton's ball
#   joint registers + constrains, Newton's bob tracks that swing; if it had fallen back to a free body it
#   would free-fall STRAIGHT DOWN -- a large, unmistakable divergence. So the diff is a clean pass/fail
#   independent of the exact geometry. (Newton run uses STATICS=1 + SUBSTEPS=4, the floor-contact config.)

WorldInfo {
  basicTimeStep 4
  FPS 30
}
Viewpoint {
  orientation 0 0 -1 3.141592653589793
  position -3 -3 1.5
}
Background {
  skyColor [ 0.15 0.20 0.30 ]
}
DEF SUN DirectionalLight {
  color 1.0 0.95 0.85
  direction -0.5 -0.5 -0.6
  intensity 2.5
}
DEF FLOOR Solid {
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.5 0.5 0.5
        roughness 1.0
        metalness 0.0
      }
      geometry Box {
        size 4 4 0.1
      }
    }
  ]
  name "floor"
  boundingObject Box {
    size 4 4 0.1
  }
}
DEF BASE Solid {
  translation 0 0 0.55
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.35 0.35 0.40
      }
      geometry Box {
        size 0.3 0.3 1.0
      }
    }
    DEF BALL BallJoint {
      jointParameters BallJointParameters {
        anchor 0 0 0.45
      }
      endPoint DEF PENDULUM Solid {
        translation 0.5 0 0.45
        children [
          Shape {
            appearance PBRAppearance {
              baseColor 0.85 0.30 0.25
            }
            geometry Box {
              size 0.15 0.15 0.15
            }
          }
        ]
        name "pendulum"
        boundingObject Box {
          size 0.15 0.15 0.15
        }
        physics Physics {
          density -1
          mass 1.0
        }
      }
    }
  ]
  name "base"
  boundingObject Box {
    size 0.3 0.3 1.0
  }
  physics Physics {
    density -1
    mass 50.0
  }
}
DEF ORACLE_DUMPER Robot {
  name "oracle_dumper"
  controller "oracle_dumper"
  supervisor TRUE
  children [
  ]
}
