#OMNISIM R2025a utf8

EXTERNPROTO "omnisim://tests/parser/protos/RobotSlot.proto"
EXTERNPROTO "omnisim://tests/physics/protos/RobotWithHingeJoint.proto"
EXTERNPROTO "omnisim://tests/physics/protos/RobotWithSliderJoint.proto"
EXTERNPROTO "omnisim://tests/physics/protos/RobotWithHinge2Joint.proto"
EXTERNPROTO "omnisim://tests/physics/protos/RobotWithBallJoint.proto"
EXTERNPROTO "omnisim://tests/default/protos/TestSuiteEmitter.proto"
EXTERNPROTO "omnisim://tests/default/protos/TestSuiteSupervisor.proto"

WorldInfo {
  info [
    "Tests the loading of hidden parameters."
  ]
  title "Hidden parameter load test"
}
Viewpoint {
  orientation 0.7470290283624516 0.646616024550071 0.15438700586161153 5.42889
  position -1.2077 1.6424 1.96945
}
Background {
  atmosphericSky "earth"
}
DEF SUN DirectionalLight {
  ambientIntensity 1
  castShadows TRUE
}
DEF SUN_MARKER Solid {
  translation 0 0 8
  name "sun_marker"
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 1.0 0.9 0.55
        emissiveColor 1.0 0.85 0.45
        emissiveIntensity 35
        roughness 1.0
        metalness 0.0
      }
      geometry Sphere {
        radius 0.9
        subdivision 3
      }
      castShadows FALSE
    }
  ]
}
Robot {
  name "sun_marker_driver"
  controller "sun_marker"
  supervisor TRUE
  children [
  ]
}
DEF ROBOT RobotSlot {
  hidden translation_0 0.1 0.1 0.23
  hidden rotation_0 1 0 0 0.47
  hidden linearVelocity_0 0 1 0
  slot [
    Shape {
      geometry DEF BOX Box {
        size 0.1 0.1 0.1
      }
    }
  ]
  boundingObject USE BOX
  physics Physics {
  }
}
DEF HINGEJOINT RobotWithHingeJoint {
  hidden position_0_0 0.111
  translation -0.4 0 0.5
}
DEF SLIDERJOINT RobotWithSliderJoint {
  hidden position_0_0 0.222
  translation -0.2 0 0.5
}
DEF HINGEJOINT RobotWithHinge2Joint {
  hidden position_0_0 0.333
  hidden position2_0_0 0.444
  translation 0 0 0.5
}
DEF HINGEJOINT RobotWithBallJoint {
  hidden position_0_0 0.555
  hidden position2_0_0 0.666
  hidden position3_0_0 0.777
  translation 0.2 0 0.5
}
Robot {
  children [
    Receiver {
      name "receiver"
      channel 1
    }
    TestSuiteEmitter {
    }
  ]
  name "supervisor"
  controller "hidden_parameter_single"
  supervisor TRUE
}
TestSuiteSupervisor {
}
