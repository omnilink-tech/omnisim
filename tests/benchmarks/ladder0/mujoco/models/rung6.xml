<!-- GENERATED by tests/benchmarks/ladder0/mujoco/scenes.py.
     Ladder0 rung 6 (drive forward, stop at a sensed threshold) -- MuJoCo arm.
     Every number here is read from the ladder's shared contract; do not
     hand-edit.  MJCF `size` is a HALF-extent where VRML `size` is a full
     extent, and `fromto` states a cylinder's axis explicitly. -->
<mujoco model="ladder0_rung6_mujoco">

  <!-- Only gravity and the timestep are set from the contract.  Everything
       else is MuJoCo's default, on purpose: this arm is the un-tuned
       reference for the solver OmniSim runs underneath. -->
  <option timestep="0.004" gravity="0 0 -9.81"/>

  <default>
    <!-- sliding / torsional / rolling.  condim defaults to 3, so only the
         first component is in force; the rest are declared for the record. -->
    <geom friction="1.0 0.005 0.0001"/>
  </default>

  <worldbody>
    <!-- Floor slab: full extents 20.0 x 20.0 x 0.2 m centred at z=0.4,
         so its top surface is at z=0.5.  Deliberately NOT at z=0. -->
    <geom name="floor" type="box" size="10.0 10.0 0.1" pos="0 0 0.4"
          rgba="0.4 0.42 0.45 1"/>

    <!-- wall: near face at x=3.0, so a ray from x_s reads 3.0-x_s. -->
    <geom name="wall" type="box" size="0.1 2.0 0.8"
          pos="3.1 0 1.3" rgba="0.55 0.55 0.6 1"/>

    <!-- Chassis origin sits at the AXLE height, z = floor_top + wheel_r =
         0.6.  Its half-height is 0.075, so its underside clears the floor by
         0.025 m and never contacts: every ground contact in this scene
         is a wheel contact, which is the invariant the rung tests. -->
    <body name="chassis" pos="0 0.0 0.6">
      <freejoint name="chassis_free"/>
      <geom name="chassis_geom" type="box" size="0.3 0.2 0.075"
            mass="5.0" rgba="0.85 0.72 0.25 1"/>
      <site name="range_site" pos="0.32 0 0.0" zaxis="1 0 0"
            size="0.005" rgba="0.9 0.2 0.2 1"/>

      <body name="fl" pos="0.2 0.225 0">
        <joint name="fl_joint" type="hinge" axis="0 1 0"/>
        <geom name="fl_geom" type="cylinder"
              fromto="0 -0.025 0  0 0.025 0" size="0.1" mass="0.5"
              rgba="0.15 0.15 0.18 1"/>
      </body>

      <body name="fr" pos="0.2 -0.225 0">
        <joint name="fr_joint" type="hinge" axis="0 1 0"/>
        <geom name="fr_geom" type="cylinder"
              fromto="0 -0.025 0  0 0.025 0" size="0.1" mass="0.5"
              rgba="0.15 0.15 0.18 1"/>
      </body>

      <body name="rl" pos="-0.2 0.225 0">
        <joint name="rl_joint" type="hinge" axis="0 1 0"/>
        <geom name="rl_geom" type="cylinder"
              fromto="0 -0.025 0  0 0.025 0" size="0.1" mass="0.5"
              rgba="0.15 0.15 0.18 1"/>
      </body>

      <body name="rr" pos="-0.2 -0.225 0">
        <joint name="rr_joint" type="hinge" axis="0 1 0"/>
        <geom name="rr_geom" type="cylinder"
              fromto="0 -0.025 0  0 0.025 0" size="0.1" mass="0.5"
              rgba="0.15 0.15 0.18 1"/>
      </body>
    </body>
  </worldbody>

  <sensor>
    <rangefinder name="range" site="range_site" cutoff="5.0"/>
  </sensor>

  <actuator>
    <!-- Deadbeat velocity servo: kv = I/dt = 0.625000, half the
         explicit-Euler stability bound 2I/dt, for a wheel's
         own I = m r^2 / 2 = 0.002500 kg m^2. -->
    <velocity name="fl_motor" joint="fl_joint" kv="0.625000"/>
    <velocity name="fr_motor" joint="fr_joint" kv="0.625000"/>
    <velocity name="rl_motor" joint="rl_joint" kv="0.625000"/>
    <velocity name="rr_motor" joint="rr_joint" kv="0.625000"/>
  </actuator>

</mujoco>
