WorldInfo {
  gravity 0
  basicTimeStep 4
  FPS 30
  randomSeed 42
  coordinateSystem "ENU"
  newtonSolver "mujoco"
  newtonStatics TRUE
}
Viewpoint {
  position -6 -6 3
  orientation -0.15 0.05 0.99 1.2
}
Background {
  skyColor [ 0.15 0.17 0.22 ]
}
DEF OMNIBENCH_PROBER Robot {
  translation 0 0 1.5
  name "omnibench_prober"
  controller "omnibench_prober"
  controllerArgs [
    "--label=device.imu_nested_carrier"
    "--duration=2"
    "--measure=sensor:gyro_direct;sensor:acc_direct;sensor:gyro_nested;sensor:acc_nested;quat:SUBJECT;pos:SUBJECT"
    "--act=motor_velocity:m:2:0.0"
  ]
  supervisor TRUE
  children [
    DEF POST Shape {
      appearance PBRAppearance { baseColor 0.3 0.3 0.35 roughness 1 metalness 0 }
      geometry Box { size 0.08 0.08 0.08 }
    }
    HingeJoint {
      jointParameters DEF JP HingeJointParameters {
        axis 0 0 1
        anchor 0 0 0
      }
      device [
        RotationalMotor { name "m" maxTorque 100 maxVelocity 12 }
      ]
      endPoint DEF SUBJECT Solid {
        translation 0.25 0 0
        name "arm"
        children [
          DEF ARM_SHAPE Shape {
            appearance PBRAppearance { baseColor 0.85 0.55 0.2 roughness 0.9 metalness 0 }
            geometry Box { size 0.5 0.05 0.05 }
          }
          Gyro { name "gyro_direct" }
          Accelerometer { name "acc_direct" }
          DEF IMU_CARRIER Solid {
            translation 0 0 0.05
            name "imu_carrier"
            children [
              Gyro { name "gyro_nested" }
              Accelerometer { name "acc_nested" }
            ]
            boundingObject Box { size 0.001 0.001 0.001 }
            physics Physics { density -1 mass 0.001 }
          }
        ]
        boundingObject USE ARM_SHAPE
        physics Physics { density -1 mass 1 }
      }
    }
  ]
  physics NULL
