#
# probe : device.accelerometer
# family: device
# claim : Accelerometer -- proper-acceleration readout, MEASURED under rotation and under gravity
# doc   : AGENTS.md ROS-2 sensor lane: 'Accelerometer never produces a sample at all -- not even gravity', measured on a URDF Husky whose IMU carrier is a folded nested Solid with no Newton body (README rule 11 localises that defect to the CARRIER, not the device). This probe mounts the device DIRECTLY on the driven endPoint Solid -- a real body -- so it measures the DEVICE; the folded-carrier case is device.imu_nested_carrier's arm.

WorldInfo {
  gravity 9.81
  basicTimeStep 4
  FPS 30
  randomSeed 42
  coordinateSystem "ENU"
  newtonSolver "mujoco"
  newtonStatics TRUE
}
Viewpoint {
  position -6 -6 3
  orientation -0.15 0.05 0.99 1.2
}
Background {
  skyColor [ 0.15 0.17 0.22 ]
}
DEF OMNIBENCH_PROBER Robot {
  translation 0 0 1.5
  name "omnibench_prober"
  controller "omnibench_prober"
  controllerArgs [
    "--label=device.accelerometer"
    "--duration=2"
    "--measure=sensor:acc_spin;sensor:acc_static;device_exists:acc_spin;device_exists:acc_static;quat:SUBJECT;pos:SUBJECT;quat:REFERENCE"
    "--act=motor_velocity:m:2:0.0"
  ]
  supervisor TRUE
  children [
    DEF POST Shape {
      appearance PBRAppearance { baseColor 0.3 0.3 0.35 roughness 1 metalness 0 }
      geometry Box { size 0.08 0.08 0.08 }
    }
    HingeJoint {
      jointParameters DEF JP HingeJointParameters {
        axis 0 0 1
        anchor 0 0 0
      }
      device [
        RotationalMotor { name "m" maxTorque 100 maxVelocity 12 }
      ]
      endPoint DEF SUBJECT Solid {
        translation 0.25 0 0
        name "arm"
        children [
          DEF ARM_SHAPE Shape {
            appearance PBRAppearance { baseColor 0.85 0.55 0.2 roughness 0.9 metalness 0 }
            geometry Box { size 0.5 0.05 0.05 }
          }
          Accelerometer { name "acc_spin" }
        ]
        boundingObject USE ARM_SHAPE
        physics Physics { density -1 mass 1 }
      }
    }
    HingeJoint {
      jointParameters DEF JP_REF HingeJointParameters {
        axis 0 0 1
        anchor 0 0 -1
      }
      endPoint DEF REFERENCE Solid {
        translation 0 0 -1
        name "reference"
        children [
          DEF REF_SHAPE Shape {
            appearance PBRAppearance { baseColor 0.4 0.6 0.85 roughness 0.9 metalness 0 }
            geometry Box { size 0.1 0.1 0.1 }
          }
          Accelerometer { name "acc_static" }
        ]
        boundingObject USE REF_SHAPE
        physics Physics { density -1 mass 1 }
      }
    }
  ]
  physics NULL
}
