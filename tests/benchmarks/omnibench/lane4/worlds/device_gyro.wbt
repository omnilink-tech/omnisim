#VRML_SIM R2025a utf8

# GENERATED by tests/benchmarks/omnibench/lane4/gen_worlds.py -- do not hand-edit.
# OmniBench lane 4a (capability coverage), see tests/benchmarks/omnibench/SPEC.md.
#
# probe : device.gyro
# family: device
# claim : Gyro -- angular velocity readout, MEASURED under rotation
# doc   : src/omnisim/nodes/OmGyro.cpp computeValue() reads the angular velocity of upperSolid()->bodyHandle() and, when that is null, writes NO value and warns "this node or its parents requires a 'physics' field to be functional". OmAccelerometer does the same; OmInertialUnit and the GPS position channel are computed from matrix() and need no body. That asymmetry is a complete explanation of the ROS 2 lane's URDF-Husky finding (Gyro constant [0,0,0] and Accelerometer silent while the InertialUnit in the SAME carrier Solid tracked yaw), so this probe mounts BOTH gyros on real Newton bodies -- otherwise it would measure that authoring requirement and misreport it as a device defect.

WorldInfo {
  gravity 0
  basicTimeStep 4
  FPS 30
  randomSeed 42
  coordinateSystem "ENU"
  newtonSolver "mujoco"
  newtonStatics TRUE
}
Viewpoint {
  position -6 -6 3
  orientation -0.15 0.05 0.99 1.2
}
Background {
  skyColor [ 0.15 0.17 0.22 ]
}
DEF OMNIBENCH_PROBER Robot {
  translation 0 0 1.5
  name "omnibench_prober"
  controller "omnibench_prober"
  controllerArgs [
    "--label=device.gyro"
    "--duration=2"
    "--measure=sensor:gyro_spin;sensor:gyro_static;quat:SUBJECT;pos:SUBJECT;quat:REFERENCE;jointpos:JP"
    "--act=motor_velocity:m:2:0.0"
  ]
  supervisor TRUE
  children [
    DEF POST Shape {
      appearance PBRAppearance { baseColor 0.3 0.3 0.35 roughness 1 metalness 0 }
      geometry Box { size 0.08 0.08 0.08 }
    }
    HingeJoint {
      jointParameters DEF JP HingeJointParameters {
        axis 0 0 1
        anchor 0 0 0
      }
      device [
        RotationalMotor { name "m" maxTorque 100 maxVelocity 12 }
      ]
      endPoint DEF SUBJECT Solid {
        translation 0.25 0 0
        name "arm"
        children [
          DEF ARM_SHAPE Shape {
            appearance PBRAppearance { baseColor 0.85 0.55 0.2 roughness 0.9 metalness 0 }
            geometry Box { size 0.5 0.05 0.05 }
          }
          Gyro { name "gyro_spin" }
        ]
        boundingObject USE ARM_SHAPE
        physics Physics { density -1 mass 1 }
      }
    }
    HingeJoint {
      jointParameters DEF JP_REF HingeJointParameters {
        axis 0 0 1
        anchor 0 0 -1
      }
      endPoint DEF REFERENCE Solid {
        translation 0 0 -1
        name "reference"
        children [
          DEF REF_SHAPE Shape {
            appearance PBRAppearance { baseColor 0.4 0.6 0.85 roughness 0.9 metalness 0 }
            geometry Box { size 0.1 0.1 0.1 }
          }
          Gyro { name "gyro_static" }
        ]
        boundingObject USE REF_SHAPE
        physics Physics { density -1 mass 1 }
      }
    }
  ]
  physics NULL
}
