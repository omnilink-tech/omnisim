#OMNISIM R2025a utf8

# OmniBench lane 3a determinism world (SPEC.md — lane 3).
# Five spheres dropped in a tight cluster onto a box pedestal on a floor: they
# collide with the box AND each other, so the trajectory exercises multi-contact
# resolution — the hard case for run-to-run determinism (free flight is trivially
# reproducible; contact ordering is where nondeterminism shows up).
# All shapes are Newton-supported primitives (sphere/box), so the bodies really
# run on the Newton backend rather than silently falling back to ODE.
# Recorded by the lane3_recorder supervisor (positions + velocities per step,
# %.17g), driven by tests/benchmarks/omnibench/lane3/determinism.py.
# Headless-only test world: exempt from the canonical-lighting recipe (tests/).

WorldInfo {
  basicTimeStep 4
  FPS 30
  randomSeed 42
}
Viewpoint {
  orientation 0 0 -1 3.141592653589793
  position -3.5 -3.5 1.5
}
Background {
  skyColor [ 0.15 0.20 0.30 ]
}
DEF SUN DirectionalLight {
  direction -0.5 -0.5 -0.6
  intensity 2.0
}
DEF FLOOR Solid {
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.5 0.5 0.5
        roughness 1.0
        metalness 0.0
      }
      geometry Box {
        size 6 6 0.1
      }
    }
  ]
  name "floor"
  boundingObject Box {
    size 6 6 0.1
  }
}
DEF PEDESTAL Solid {
  translation 0 0 0.15
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.4 0.4 0.6
        roughness 1.0
        metalness 0.0
      }
      geometry Box {
        size 1 1 0.2
      }
    }
  ]
  name "pedestal"
  boundingObject Box {
    size 1 1 0.2
  }
}
DEF S1 Solid {
  translation 0.02 0.01 0.7
  children [
    DEF S1_SHAPE Shape {
      appearance PBRAppearance {
        baseColor 0.85 0.30 0.25
      }
      geometry Sphere {
        radius 0.1
      }
    }
  ]
  name "s1"
  boundingObject Sphere {
    radius 0.1
  }
  physics Physics {
    density -1
    mass 1.0
  }
}
DEF S2 Solid {
  translation -0.03 0.04 0.95
  children [
    DEF S2_SHAPE Shape {
      appearance PBRAppearance {
        baseColor 0.30 0.65 0.85
      }
      geometry Sphere {
        radius 0.1
      }
    }
  ]
  name "s2"
  boundingObject Sphere {
    radius 0.1
  }
  physics Physics {
    density -1
    mass 1.0
  }
}
DEF S3 Solid {
  translation 0.05 -0.03 1.2
  children [
    DEF S3_SHAPE Shape {
      appearance PBRAppearance {
        baseColor 0.40 0.80 0.40
      }
      geometry Sphere {
        radius 0.1
      }
    }
  ]
  name "s3"
  boundingObject Sphere {
    radius 0.1
  }
  physics Physics {
    density -1
    mass 1.0
  }
}
DEF S4 Solid {
  translation -0.04 -0.05 1.45
  children [
    DEF S4_SHAPE Shape {
      appearance PBRAppearance {
        baseColor 0.9 0.8 0.3
      }
      geometry Sphere {
        radius 0.1
      }
    }
  ]
  name "s4"
  boundingObject Sphere {
    radius 0.1
  }
  physics Physics {
    density -1
