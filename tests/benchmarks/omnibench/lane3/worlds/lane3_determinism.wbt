DEF S5 Solid {
  translation 0.01 0.06 1.7
  children [
    DEF S5_SHAPE Shape {
      appearance PBRAppearance {
        baseColor 0.7 0.4 0.8
      }
      geometry Sphere {
        radius 0.1
      }
    }
  ]
  name "s5"
  boundingObject Sphere {
