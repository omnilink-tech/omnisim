#OMNISIM R2025a utf8

# OmniBench lane 3c driveability probe world (SPEC.md — lane 3).
# Deliberately tiny so cold loads are fast and probe latency measures the
# HARNESS surface, not asset streaming:
#   DEF TARGET   static box    -> /scene/frame numeric-verification probe
#   DEF BALL     dynamic sphere -> /sim/step determinism probe (it falls)
#   DEF BOT      1-joint pendulum robot (controller <none>)
#                -> /robot/BOT/joints probe (the joint swings under gravity)
# The driveability runner (driveability.py) COPIES this file to a temp dir and
# edits the copy for the hot-reload probe; the repo copy is never touched.
# Headless-only test world: exempt from the canonical-lighting recipe (tests/).

WorldInfo {
  basicTimeStep 16
  FPS 30
  randomSeed 42
}
Viewpoint {
  orientation 0 0 -1 3.141592653589793
  position -4 -4 2
}
Background {
  skyColor [ 0.15 0.20 0.30 ]
}
DEF SUN DirectionalLight {
  direction -0.5 -0.5 -0.6
  intensity 2.0
}
DEF FLOOR Solid {
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.5 0.5 0.5
        roughness 1.0
        metalness 0.0
      }
      geometry Box {
        size 6 6 0.1
      }
    }
  ]
  name "floor"
  boundingObject Box {
    size 6 6 0.1
  }
}
DEF TARGET Solid {
  translation 0 0 0.3
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.85 0.30 0.25
        roughness 0.8
        metalness 0.0
      }
      geometry Box {
        size 0.4 0.4 0.5
      }
    }
  ]
  name "target"
  boundingObject Box {
    size 0.4 0.4 0.5
  }
}
DEF BALL Solid {
  translation 1 0 1
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.30 0.65 0.85
      }
      geometry Sphere {
        radius 0.1
      }
    }
  ]
  name "ball"
  boundingObject Sphere {
    radius 0.1
  }
  physics Physics {
    density -1
    mass 1.0
  }
}
DEF BOT Robot {
  translation -1 0 0.8
  name "bot"
  controller "<none>"
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.3 0.3 0.3
      }
      geometry Box {
        size 0.1 0.1 0.1
      }
    }
    HingeJoint {
      jointParameters HingeJointParameters {
        axis 0 1 0
      }
      device [
        RotationalMotor {
          name "swing_motor"
        }
        PositionSensor {
          name "swing_sensor"
        }
      ]
      endPoint Solid {
        translation 0.2 0 0
        children [
          Shape {
            appearance PBRAppearance {
              baseColor 0.9 0.8 0.3
            }
            geometry Box {
              size 0.3 0.05 0.05
            }
          }
        ]
        name "pendulum_arm"
        boundingObject Box {
          size 0.3 0.05 0.05
        }
        physics Physics {
          density -1
          mass 0.5
        }
      }
    }
  ]
}
