# The lane-3 recorder, required by determinism.py: it samples every tracked
# body's pose+velocity per step at %.17g and writes run.csv into
# $OMNIBENCH_L3_OUT_DIR. Without it the harness sees "empty CSV", retries, and
# reports nothing -- which is exactly what happened on the first attempt at
# this world.
DEF LANE3_RECORDER Robot {
  name "lane3_recorder"
  controller "lane3_recorder"
  supervisor TRUE
  children [
  ]
}
