#VRML_SIM R2025a utf8

# OmniBench lane 1R (physics validation against MEASURED motion).
# Contract: tests/benchmarks/omnibench/lane1r/README.md
#
# ONE world serves all 550 tosses. The initial condition is injected by the
# controller from the LANE1R_* environment variables rather than baked into a
# .wbt per trajectory -- 550 generated worlds would be 550 files to keep in
# sync with a dataset that already has a single source of truth.
#
# TABLE HEIGHT. The dataset's table is z = 0 and the cube rests at
# z ~ 0.0512. This world puts the table top at z = TABLE_TOP = 0.5 and the
# runner adds the same offset to every measured position, for the reason
# lane 1 lifted its own floor: Newton adds an IMPLICIT ground plane at z = 0,
# so a table whose top is also at z = 0 gives the solver two coincident
# contact manifolds. Measured on lane 1's T6, removing that duplicate moved
# settle creep by 8x. The offset is undone before scoring.
#
# TIMESTEP. 0.5 ms (2000 Hz), and the controller advances 1 ms per iteration.
# Acosta et al. (RA-L 2022) stepped all three engines at 1480 Hz, so 2000 Hz
# does not flatter us; it is finer.
#
# ⚠ It is NOT 1/1480 s, and the reason is a real trap: `Robot.step()` takes an
# INTEGER number of milliseconds, and its default argument is
# `int(basic_time_step)`. A world with basicTimeStep 0.6757 therefore
# produces `step(0)` -- an infinite no-op rather than an error. Any world here
# must keep basicTimeStep integer-divisible into the step argument.
#
# So the simulation rate is deliberately DECOUPLED from the 148 Hz data rate:
# record on a 1 ms grid, and let the scorer resample onto the measurement
# times. Either rate can then change without the other silently drifting.

WorldInfo {
  gravity 9.81
  basicTimeStep 0.5
  FPS 30
  randomSeed 42
  coordinateSystem "ENU"
  newtonSolver "mujoco"
  newtonStatics TRUE
  # Cube-on-wood, mu_static 0.15, from data/contactnets_cube.urdf.
  # There is NO restitution field on the Newton path; the measured e = 0.125
  # has to be identified through the contact spring (ke, kd) instead. See
  # identify.py -- and note that a fitted e is a fitted e, not a declared one.
  newtonGroundMu 0.15
  newtonCone "elliptic"
  newtonImpratio 10
}
Viewpoint {
  position -1.2 -1.4 1.0
  orientation -0.18 0.10 0.98 1.15
}
Background {
  skyColor [ 0.15 0.17 0.22 ]
}
DEF TABLE Solid {
  translation 0 0 0.4
  name "table"
  children [
    DEF TABLE_SHAPE Shape {
      appearance PBRAppearance { baseColor 0.62 0.48 0.32 roughness 1 metalness 0 }
      geometry Box { size 4 4 0.2 }
    }
  ]
  boundingObject USE TABLE_SHAPE
}
DEF CUBE Solid {
  translation 0 0 0.6
  name "cube"
  children [
    DEF CUBE_SHAPE Shape {
      appearance PBRAppearance { baseColor 0.6 0.0 0.0 roughness 0.8 metalness 0 }
      geometry Box { size 0.1048 0.1048 0.1048 }
    }
  ]
  boundingObject USE CUBE_SHAPE
  physics Physics {
    density -1
    mass 0.37
    centerOfMass [ 0 0 0 ]
    # 8.1e-4 isotropic, from the URDF. NOT the shipped MJCF's 6.167e-4:
    # that is exactly m*a^2/6 for a UNIFORM 0.10 m cube, i.e. a convenience
    # model. Uniform at 0.1048 m would be 6.77e-4, and the measured value is
    # above it because the real cube is hollow.
    inertiaMatrix [ 8.1e-4 8.1e-4 8.1e-4, 0 0 0 ]
  }
}
DEF LANE1R_RECORDER Robot {
  name "lane1r_recorder"
  controller "lane1r_replay"
  supervisor TRUE
}
