<?xml version="1.0" ?>
<!-- The object to be moved: a 50 mm cube, 0.2 kg, one link, no meshes.     -->
<!-- Units: metres, kilograms. Its own frame is at its geometric centre.    -->
<robot name="block">
  <link name="block">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry><box size="0.05 0.05 0.05"/></geometry>
      <material name="mimosa"><color rgba="0.95 0.78 0.20 1"/></material>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry><box size="0.05 0.05 0.05"/></geometry>
    </collision>
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <mass value="0.2"/>
      <inertia ixx="8.333e-05" ixy="0" ixz="0" iyy="8.333e-05" iyz="0"
               izz="8.333e-05"/>
    </inertial>
  </link>
</robot>
