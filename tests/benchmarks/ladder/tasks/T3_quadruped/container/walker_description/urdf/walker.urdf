      <origin xyz="0 0 -0.10" rpy="0 0 0"/>
      <mass value="0.60"/>
      <inertia ixx="0.00208" ixy="0" ixz="0" iyy="0.00208" iyz="0"
               izz="0.00016"/>
    </inertial>
    <visual>
      <origin xyz="0 0 -0.10" rpy="0 0 0"/>
      <geometry><box size="0.04 0.04 0.20"/></geometry>
      <material name="limb_light"/>
    </visual>
  </link>
  <joint name="thigh_fr_joint" type="revolute">
    <parent link="hip_fr"/>
    <child link="thigh_fr"/>
    <origin xyz="0 -0.055 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.60" upper="1.60" effort="30.0" velocity="20.0"/>
    <dynamics damping="0.05" friction="0.0"/>
  </joint>

  <link name="shank_fr">
    <inertial>
      <origin xyz="0 0 -0.09" rpy="0 0 0"/>
      <mass value="0.25"/>
      <inertia ixx="0.000852" ixy="0" ixz="0" iyy="0.000852" iyz="0"
