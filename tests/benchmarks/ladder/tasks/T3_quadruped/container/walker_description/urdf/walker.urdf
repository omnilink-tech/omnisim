      <origin xyz="0 0 -0.10" rpy="0 0 0"/>
      <mass value="0.60"/>
      <inertia ixx="0.00208" ixy="0" ixz="0" iyy="0.00208" iyz="0"
               izz="0.00016"/>
    </inertial>
    <visual>
      <origin xyz="0 0 -0.10" rpy="0 0 0"/>
      <geometry><box size="0.04 0.04 0.20"/></geometry>
