    </visual>
    <visual>
      <origin xyz="0 0 -0.20" rpy="0 0 0"/>
      <geometry><sphere radius="0.022"/></geometry>
      <material name="foot_dark"/>
    </visual>
    <collision>
      <origin xyz="0 0 -0.20" rpy="0 0 0"/>
      <geometry><sphere radius="0.022"/></geometry>
    </collision>
  </link>
  <joint name="knee_fr_joint" type="revolute">
    <parent link="thigh_fr"/>
    <child link="shank_fr"/>
    <origin xyz="0 0 -0.20" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.50" upper="-0.20" effort="35.0" velocity="20.0"/>
    <dynamics damping="0.05" friction="0.0"/>
  </joint>

  <!-- =========================== rear left ========================== -->
  <link name="hip_rl">
