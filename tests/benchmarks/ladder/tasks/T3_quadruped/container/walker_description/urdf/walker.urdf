  <link name="shank_rr">
    <inertial>
      <origin xyz="0 0 -0.09" rpy="0 0 0"/>
      <mass value="0.25"/>
      <inertia ixx="0.000852" ixy="0" ixz="0" iyy="0.000852" iyz="0"
               izz="0.0000375"/>
