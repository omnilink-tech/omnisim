      <material name="limb_light"/>
    </visual>
    <visual>
      <origin xyz="0 0 -0.20" rpy="0 0 0"/>
      <geometry><sphere radius="0.022"/></geometry>
      <material name="foot_dark"/>
    </visual>
    <collision>
      <origin xyz="0 0 -0.20" rpy="0 0 0"/>
      <geometry><sphere radius="0.022"/></geometry>
    </collision>
  </link>
  <joint name="knee_rl_joint" type="revolute">
