    </visual>
  </link>
  <joint name="thigh_rl_joint" type="revolute">
    <parent link="hip_rl"/>
    <child link="thigh_rl"/>
    <origin xyz="0 0.055 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.60" upper="1.60" effort="30.0" velocity="20.0"/>
    <dynamics damping="0.05" friction="0.0"/>
  </joint>

  <link name="shank_rl">
    <inertial>
      <origin xyz="0 0 -0.09" rpy="0 0 0"/>
      <mass value="0.25"/>
      <inertia ixx="0.000852" ixy="0" ixz="0" iyy="0.000852" iyz="0"
