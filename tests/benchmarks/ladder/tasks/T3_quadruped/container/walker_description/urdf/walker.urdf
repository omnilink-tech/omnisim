  </link>
  <joint name="hip_fr_joint" type="revolute">
    <parent link="base_link"/>
    <child link="hip_fr"/>
    <origin xyz="0.18 -0.09 -0.02" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-0.70" upper="0.70" effort="25.0" velocity="20.0"/>
    <dynamics damping="0.05" friction="0.0"/>
  </joint>

  <link name="thigh_fr">
